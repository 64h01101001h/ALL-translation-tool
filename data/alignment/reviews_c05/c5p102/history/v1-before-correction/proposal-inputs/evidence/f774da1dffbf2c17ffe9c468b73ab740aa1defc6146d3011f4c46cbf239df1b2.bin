{
  "title": "Holy Geshe Michael Roach Dictionary (HGM Lexicon)",
  "version": "0.27.2",
  "date": "2026-08-04",
  "description": "Tibetan-English dictionary strictly anchored to the English equivalents used by Geshe Michael Roach (HGM). Entry format is a hybrid of the Illuminator Tibetan-English Dictionary (Tony Duff) entry style and Jeffrey Hopkins' Tibetan-Sanskrit-English Dictionary structure. Hopkins glosses are included as reference only; the hgm_gloss field is the locked, authoritative equivalent.",
  "sources": [
    {
      "id": "C01",
      "title": "ACI Course I: The Principal Teachings of Buddhism (Course Readings)",
      "note": "Root text of the Three Principal Paths (Lam gtso rnam gsum) of Je Tsongkapa with HGM translation; opening prayers; Khen Rinpoche Geshe Lobsang Tharchin foreword."
    },
    {
      "id": "HOPKINS",
      "title": "Jeffrey Hopkins, Tibetan-Sanskrit-English Dictionary (uma-tibet.org, June 2015)",
      "note": "Reference comparanda only. Never overrides hgm_gloss."

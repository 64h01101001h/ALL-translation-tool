import hashlib,json,pathlib
ROOT=pathlib.Path(__file__).resolve().parents[1];E=ROOT/'evidence'
def sha(b):return hashlib.sha256(b).hexdigest()
rows=json.loads((E/'spine-rows.json').read_text())
summ=json.loads((E/'mechanical-summary.json').read_text())
findings={
304:{'challenge':'Challenge first the d3 body-washing recast lus \'khrud pa → washes himself; it preserves the whole verb-object construction while avoiding a false lus → himself dictionary entry.','evidence':'The original master has blos rlom pa → imagination (glossary tier), dngos gnas pa → real, and \'khrud pa → washes. C15:449 matches all three ACIP/Wylie/English fields; P7:43 ends at his and supports only the shared extent.','omission':'Second mi/de and closing zer na are distributed in the English reference/claim frame and omitted. with the water is supplied. yin receives an explicit contraction-fusion null; null does not mean absent meaning.','errata':'No new erratum: physical lines 3025–3029 reproduce the original ACIP and, after whitespace joining, the complete English. No cap/heading class occurs. Exact C15 field identity establishes wording only, not independent publication or lineage.'},
305:{'challenge':'Challenge first yang → too across the sentence boundary: the additive comparison survives in For that too. First thal selects first then; final thal selects must.','evidence':'The original master has bsreg pa → sizzle, lto → stomach, blos rlom pa → imagination, and curated sdug bsngal → suffering. C15:450 matches ACIP/Wylie/English exactly; P7:44 preserves the English with differing Tibetan punctuation and DWAGS spelling.','omission':'Second yi dvags is pronominalized and omitted; source occurrence 3 owns final craving spirits. la/na are recast and omitted. The supplied pus and blood, modal can, auxiliary be, and emphatic at all remain unwrapped.','errata':'No new erratum: physical lines 3031–3035 confirm the selected wording. bsreg pa/sizzle is supported by the original HGM glossary. Registered-class and corpus checks give no source correction to file.'},
306:{'challenge':'Challenge first the d3 temporal/first-conjunct constructions pa\'i tshe, pa de\'i tshe, and gang zhig; they encode local grammar, while lexical look/looks stay d5.','evidence':'Master glossary explicitly supports bse ru → porcelain basin/basin, rab rib can → person with cataracts, skra shad → strand of hair, dbang po → sense power, and mtshungs pa → identical to. C15:451 matches three text fields; P7:45 has the same English with Tibetan differences. ILL:2323 preserves a differing verse with [vi.71a] and a different English rendering.','omission':'med selects n\'t in the second isn\'t, after look; the initial rhetorical Isn\'t is unwrapped. de ltar/par thal, possessor can, flowing \'bab, and zer na remain omitted as distributed/unresolved. Bracketed author, sit down, and expanded participants remain verbatim and unwrapped.','errata':'No new erratum: physical lines 3037–3049 confirm all wording. The bracketed [Master Dharmakirti\'s] attribution remains an unresolved source attribution, not an aligned claim. ILL:2319–2326 supplies contextual verse evidence but does not by itself establish a correction or independent publication. No authorship correction is filed.'}}
for m in summ:
 seq=m['seq'];f=findings[seq];row=rows[str(seq+1382)];p=ROOT/str(seq)
 review={'seq':seq,'status':'No new errata proposed; errata.json is empty.','five_grounds':[
 {'ground':'Exact selected-row reading','source_ref':'../evidence/spine-rows.json#'+str(row['id']),'acip_sha256':sha(row['acip'].encode()),'wylie_sha256':sha(row['wylie'].encode()),'english_sha256':sha(row['english'].encode()),'finding':f['errata']},
 {'ground':'Registered classes','source_ref':'../native/pin-docs__errata_register.json.stdout','query_ref':'../evidence/errata-register-queries.json','finding':'No re-filing. Target English is below the 1500-character cap; no following heading or English running-head row occurs in these selected segments.'},
 {'ground':'Available corpus parallels','source_ref':'../evidence/spine-queries.json','complete_original_rows_ref':'../evidence/spine-rows.json','original_corpus_map':'../evidence/corpus-original-record-map.json','finding':f['evidence']},
 {'ground':'HGM lexical evidence','source_ref':'../evidence/master-rows.json','query_ref':'../evidence/master-queries.json','span_ref':'../evidence/span-evidence-map.json','finding':'Original hgm_gloss/hgm_evidence tier fields retained. Comparative glosses do not supply GMR English; master evidence does not alone prove contextual correspondence.'},
 {'ground':'Original physical source and inference limit','source_ref':'../evidence/physical-C05ReadingASCII.txt','comparison_ref':'../evidence/physical-comparisons.json','finding':'ACIP occurs byte-exact. Physical English wraps across lines; whitespace-only joining matches the full selected English. Textual identity proves only compared fields; no publication-independence or ingestion-lineage conclusion is drawn.'}],
 'unbanked_uncertainty':f['omission']}
 (p/'errata-review.json').write_text(json.dumps(review,ensure_ascii=False,indent=2)+'\n')
# Evidence catalog lists each original evidence file once. Reports refer to this
# single catalog and per-span map rather than embedding the entire witness set.
catalog=[]
for p in sorted(E.iterdir()):
 if p.is_file() and p.name!='evidence-index.json':
  b=p.read_bytes();catalog.append({'path':str(p.relative_to(ROOT)),'bytes':len(b),'sha256':sha(b)})
index={'angle':'Tibetan-first','producer':'Codex (GPT-6 Astra)','original_source_origin':'ce646d0c48f9338ff47e40f46582ad14c8a3eaf4','original_acceptance_boundary':294,'future_acceptance_boundary':'Not claimed; through303 landing belongs to a separate root baseline.','source_and_governance':'Source/master/corpus/physical hashes verified independently. Mutable governance/build dependencies read from exact historical Git objects. No W mutation hold.','records':catalog,'deduplication':'134 complete original SQLite rows stored once, including raw. Each original corpus object was independently reopened and checked for full object equality with parsed raw, with field-order reconstruction recorded in corpus-original-record-map.json. 96 complete master objects retained with their original collection/index and producer tiers.','complete_mappings':['spine-queries.json','corpus-original-record-map.json','master-queries.json','span-evidence-map.json','physical-comparisons.json']}
(E/'evidence-index.json').write_text(json.dumps(index,ensure_ascii=False,indent=2)+'\n')
idxhash=sha((E/'evidence-index.json').read_bytes())
for m in summ:
 seq=m['seq'];f=findings[seq]
 lines=[f'C05:{seq} · independent Tibetan-first · Codex (GPT-6 Astra) · PROVISIONAL, unreviewed.',
 f'Original source origin ce646d0c48f9338ff47e40f46582ad14c8a3eaf4 through294; future through303 acceptance is not asserted.',
 f['challenge'],f['evidence'],f['omission'],f['errata'],
 f'Counts: {m["spans"]} spans; {m["nonnull"]} nonnull; {m["null"]} null; {m["d5"]} d5 ({m["nonnull_d5"]} nonnull); {m["errata"]} errata. Automatically generated d1 source envelopes are excluded from these counts.',
 f'Canonical result: EXIT={m["generator_exit"]}; stderr bytes={m["generator_stderr_bytes"]}; body bytes={m["body_bytes"]}. body.html equals ../native/gen-{seq}-v1.stdout byte for byte; input/command/stderr/exit are beside that file.',
 f'Hashes: spec.json SHA-256 {m["spec_sha256"]}; body.html SHA-256 {m["body_sha256"]}.',
 'Range proof: mechanical-proof.json; intended-ranges.json holds exact occurrence choices, ownership, depth and omissions. Full text reconstruction and historical builder parsing pass; these checks do not certify semantics.',
 f'Shared original evidence: ../evidence/evidence-index.json SHA-256 {idxhash}; per-span claims map through ../evidence/span-evidence-map.json; five errata grounds are in errata-review.json.',
 ('Landing allowance proposed: '+', '.join(r['page_span']+' licensed by '+r['tibetan_licensor'] for r in m['required_landing_allowances'])+'. No repository allowance was modified.' if m['required_landing_allowances'] else 'No article/hinge head allowance is requested for this segment.'),
 'Attempts: canonical generation passed on v1. Both preserved helper failures (collect-evidence-v1 decoding and write-reports-v1 quoting) have exact native errors and failed code in ../native/ and ../helpers/; v2 helpers succeeded. No canonical spec failed. Final freeze is ../freeze-manifest.json.']
 (ROOT/str(seq)/'report.md').write_text('\n\n'.join(lines)+'\n')
readme='''# Independent Tibetan-first proposals, C05:304–306

These are original Codex (GPT-6 Astra) proposals. All are PROVISIONAL and machine-matched; mechanical success is not semantic approval or hgm_gloss promotion.

The source origin is `ce646d0c48f9338ff47e40f46582ad14c8a3eaf4` through294. Source, context, original SQLite, external master/corpus and physical-source hashes were independently verified. The future through303 acceptance baseline is distinct and is not claimed here. Other angles and root judgments were not consulted. No source/repository files were changed, and work never required a W mutation hold.

Each segment folder contains `spec.json`, exact canonical `body.html`, `errata.json`, compact `report.md`, `intended-ranges.json`, `mechanical-proof.json`, and `errata-review.json`. Source witnesses are shared once in `evidence/`; `evidence-index.json` catalogs paths/hashes. All query selections have complete result-to-original mappings, including zero-match errata-register searches. Original corpus objects are reconstructable from verified-equal SQLite raw fields and original field-order metadata, avoiding a redundant second corpus body store.

`helpers/canonical_ro.py` executes the real worktree `tools/gen_alignment_page.py` after checking its exact historical hash. It loads unchanged historical `build_alignment_layer.py` and `hgm_tools.py` bytes, preserves their original module roots, and adapts only SQLite connections to mandatory URI `mode=ro`. It replaces no matching, depth, order, emission or refusal logic. Historical governance/builder objects are actual `git show COMMIT:path` outputs under `native/`, with command/stdin/stdout/stderr/exit retained. External originals are hashed as external bytes, never read through Git.

`native/gen-304-v1.*`, `native/gen-305-v1.*`, `native/gen-306-v1.*` preserve the actual canonical commands, exact input bytes, stdout, stderr and exits. `native/ranges-v1.*` preserves real canonical resolution checks against separately authored intended offsets plus independently parsed HTML ranges, d7 ownership/uniqueness/containment, full original text reconstruction, and historical builder span parsing. All pass. The two sogs → and so on d5 heads have explicit proposed licensors in the mechanical reports; repository allowance registration is a later landing step.

Two helper failures are retained: the report-writing v1 had an unescaped-apostrophe syntax error (exact code and native error saved), fixed without any spec change. The evidence extraction failure is retained: `native/collect-evidence-v1.*` failed on a physical-source byte that is not UTF-8. `helpers/collect_evidence-v1-failed.py` preserves the exact failed script. The successful v2 uses Latin-1 only as a reversible byte-to-codepoint view for ASCII searches, without asserting the publication's encoding. No source text was replaced. The full source bytes are preserved, and whitespace-only line joining proves complete English equality for the three selected physical paragraphs.

No new erratum is filed. In 306 the bracketed author is preserved unwrapped; the exact C15 text, differing ILL verse and nearby ILL context do not by themselves settle attribution or publication independence. No root/other-angle/semantic-stage file was read. A later correction must preserve this freeze and explicitly supersede it.
'''
(ROOT/'README.md').write_text(readme)
print(json.dumps({'reports':[str(ROOT/str(x)/'report.md') for x in [304,305,306]],'evidence_index_sha256':idxhash,'total_spans':sum(x['spans'] for x in summ),'total_null':sum(x['null'] for x in summ),'total_d5':sum(x['d5'] for x in summ),'total_nonnull_d5':sum(x['nonnull_d5'] for x in summ),'new_errata':0},indent=2))

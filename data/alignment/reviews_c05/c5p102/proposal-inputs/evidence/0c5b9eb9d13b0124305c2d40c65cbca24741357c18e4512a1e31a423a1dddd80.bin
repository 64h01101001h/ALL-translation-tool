import json,pathlib,re
ROOT=pathlib.Path(__file__).resolve().parents[1]
rows=json.loads((ROOT/'evidence/spine-rows.json').read_text())
def out(seq,title,items,note,omissions):
 row=rows[str(seq+1382)];spans=[];intents=[]
 for n,item in enumerate(items,1):
  tib,eng,d,reason,*opts=item;opt=opts[0] if opts else {}
  sp={'id':f'w{n}','d':d,'tib':tib,'eng':eng}
  if eng is None:sp.update({'cls':'case' if d in (6,7) else 'gram','nul':reason})
  if opt.get('subword'):sp['subword']=True
  spans.append(sp)
  intent={'id':sp['id'],'reason':reason,'tib_occurrence':opt.get('tib_occurrence',1),'eng_occurrence':opt.get('eng_occurrence',1) if eng is not None else None}
  for side,field,piece in [('tib','wylie',tib),('eng','english',eng)]:
   if piece is None:intent[side+'_range']=None;continue
   # A separately authored occurrence ledger. Canonical resolution is checked against it later.
   raw=list(re.finditer(re.escape(piece),row[field]));hits=[]
   for hit in raw:
    a,b=hit.span()
    if d==7 or opt.get('subword'):hits.append([a,b]);continue
    word=lambda c:bool(re.match('[A-Za-z0-9\\u0F00-\\u0FFF]',c))
    if word(piece[0]) and a and word(row[field][a-1]):continue
    if word(piece[-1]) and b<len(row[field]) and word(row[field][b]):continue
    hits.append([a,b])
   occ=intent[side+'_occurrence'];assert len(hits)>=occ,(seq,side,piece,hits,occ)
   intent[side+'_range']=hits[occ-1];intent[side+'_all_ranges']=hits
  intents.append(intent)
 english=sorted([i for i,s in zip(intents,spans) if s['eng'] is not None and s['d']!=7],key=lambda i:i['eng_range'])
 spec={'course':'C05','segments':[{'seq':seq,'title':title,'spans':spans,'eng_order':[i['id'] for i in english],'note':'PROVISIONAL machine alignment by Codex (GPT-6 Astra), independent Tibetan-first proposal; not human approved and no hgm_gloss promotion. '+note}]}
 dest=ROOT/str(seq)
 (dest/'spec.json').write_text(json.dumps(spec,ensure_ascii=False,indent=2)+'\n')
 (dest/'intended-ranges.json').write_text(json.dumps({'source_row_ref':'../evidence/spine-rows.json#'+str(row['id']),'offset_convention':'zero-based Unicode codepoint, end-exclusive','spans':intents,'omissions':omissions},ensure_ascii=False,indent=2)+'\n')
 (dest/'errata.json').write_text('[]\n')
 print(seq,len(spans),sum(s['eng'] is None for s in spans),'null',sum(s['d']==5 for s in spans),'d5')


(5,'gzugs','physical matter',2,1),(5,'yod par','exists'),(5,"'dod",'admit'),(5,'gzugs','matter',3,3),(5,'sems','mind',6,8),(3,'bzhin du','in the way'),(5,"'gro ba'i",'sentient beings'),(5,'byed pa po','prime creator',1,1),(5,'ma yin','not',2,3),
(3,'des na','Therefore',1,2),(5,'sems','mind',7,9),(5,'gzhan','other',1,2),(5,'byed pa po','creator',2,2),(5,'bzlog pa','opposite'),(5,'bkag','denying',1,1),(5,'phyi rol','outside'),(5,'gzugs','physical objects',4,1)

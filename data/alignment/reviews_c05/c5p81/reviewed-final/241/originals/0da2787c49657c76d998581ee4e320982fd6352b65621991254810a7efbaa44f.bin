import json,pathlib,sys,importlib.util
D=pathlib.Path(__file__).resolve().parent; B=D.parent;W=D.parents[3]/'campaign-worktree'
sys.path.insert(0,str(W/'tools'));import gen_alignment_page as G
rows={r['seq']:r for r in json.loads((D/'spine-originals.json').read_text())['rows']}
# d, exact Tibetan, exact English, intended Tibetan occurrence, intended English occurrence

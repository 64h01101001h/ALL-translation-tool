(5,'bshad pa','references',1,2),(5,'snga ma','former'),(5,'dgag phyogs','negative way'),(6,'dang','and',1,3),(5,'phyi ma','latter'),(5,'sgrub phyogs','positive way'),
(3,"de'i phyir",'Thus'),(5,"'gro ba",'life'),(3,"rab tu 'jug pa",'into motion'),(5,'sems','mind',3,4),(5,"gtso bo'i",'principal',1,1),(5,'rgyu','cause',1,1),
(5,'sems','mind',4,5),(6,'las','than',1,1),(5,'gzhan pa','other',1,1),(5,"gtso bo'i",'principal',2,2),(5,'rgyu','cause',2,2),(5,'min','not',1,1),

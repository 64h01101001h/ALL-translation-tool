(5,'nyan rang','Listener or Self-Made Buddha'),(5,'dgra bcom pa','enemy destroyers'),(5,'chos can','consider'),(5,'phyi rol pa','non-Buddhists'),(3,'bzhin du','like'),(5,'khams gsum','three realms'),(6,'na','in',1,1),(5,"spyod pa'i",'operate'),(5,'phra rgyas','widespread mental afflictions'),(5,'thams cad','all',1,1),(3,'ma spangs par','fail to eliminate'),

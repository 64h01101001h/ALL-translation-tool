  "master_meta": {
    "title": "Holy Geshe Michael Roach Dictionary (HGM Lexicon)",
    "version": "0.27.2",
    "date": "2026-08-04",
    "description": "Tibetan-English dictionary strictly anchored to the English equivalents used by Geshe Michael Roach (HGM). Entry format is a hybrid of the Illuminator Tibetan-English Dictionary (Tony Duff) entry style and Jeffrey Hopkins' Tibetan-Sanskrit-English Dictionary structure. Hopkins glosses are included as reference only; the hgm_gloss field is the locked, authoritative equivalent.",
    "sources": [
      {
        "id": "C01",
        "title": "ACI Course I: The Principal Teachings of Buddhism (Course Readings)",
        "note": "Root text of the Three Principal Paths (Lam gtso rnam gsum) of Je Tsongkapa with HGM translation; opening prayers; Khen Rinpoche Geshe Lobsang Tharchin foreword."
      },
      {
        "id": "HOPKINS",
        "title": "Jeffrey Hopkins, Tibetan-Sanskrit-English Dictionary (uma-tibet.org, June 2015)",
        "note": "Reference comparanda only. Never overrides hgm_gloss."
      },
      {
        "id": "HTG2016",
        "title": "Geshe Michael Hypertext Glossary (user-compiled, 2016-05-16)",
        "note": "8,028 ACIP-headword to HGM-English pairings mined from HGM translations. Bulk attestation layer."
      },
      {
        "id": "HOPKINS-SCAFFOLD",
        "title": "Hopkins Tibetan-Sanskrit-English Dictionary (June 2015) — headword scaffold ('the Great Dictionary')",
        "note": "21,751 unique headwords parsed span-level (16pt headword font anchor); Hopkins glosses reference-only."
      },
      {
        "id": "C01-ASCII",
        "title": "Course I Reading, ASCII/ACIP edition (C01ReadingASCII.txt)",
        "note": "889 ACIP Tibetan lines; 497 aligned Tibetan-English segments; makes the full Tibetan of Course I machine-readable and pairable."
      },
      {
        "id": "C02-C18-ASCII",
        "title": "Course II–XVIII Readings, ASCII/ACIP editions (17 files)",
        "note": "Full ACI formal-study corpus. 8983 aligned Tibetan-English segments across 18 courses."
      },
      {
        "id": "TCS-ASCII",
        "title": "The Course Series supplements (TCS01–TCS09 + practice texts, 16 ASCII/ACIP files)",
        "note": "Prayers, sadhanas, lama-devotion and long-life texts incl. Thousand Angels (dga' ldan lha brgya ma), Source of All My Good (yon tan gzhir ma), Naropa's Vajra Yogini sadhana, Pabongka sadhana, Naropa's Twelve Trials, Khen Rinpoche long-life prayer."
      },
      {
        "id": "TCS10-18-ASCII",
        "title": "The Course Series TCS10–TCS18 (11 ASCII/ACIP files)",
        "note": "Incl. the Lama Chupa (Offering to the Lama) root text and full commentary, Kali Wang initiation text, and TCS10–TCS17 supplements."
      },
      {
        "id": "SUNLIGHT",
        "title": "Sunlight on the Path to Freedom — Choney Lama Drakpa Shedrup's commentary on the Diamond Cutter Sutra, tr. HGM (Diamond Cutter Classics vol. 72, 2019)",
        "note": "Book-length translation; 1098 aligned segments incl. the quadrilingual Diamond Cutter Sutra appendix."
      },
      {
        "id": "LSG-C1-C4",
        "title": "ACI Tibetan Language Study Guides, Courses I–IV (vocabulary card decks, 4 PDFs)",
        "note": "323 GMR phonetic lines; used as pronunciation ground truth. Tibetan layer font-locked (as C01 PDF)."
      },
      {
        "id": "LSG-C5-C6",
        "title": "ACI Tibetan Language Study Guides, Courses V–VI (2 PDFs)",
        "note": "218 GMR phonetic lines; pronunciation ground truth pass 2."
      },

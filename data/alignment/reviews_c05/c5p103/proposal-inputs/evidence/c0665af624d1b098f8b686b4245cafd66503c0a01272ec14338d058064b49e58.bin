from pathlib import Path
import json, re

A=Path(__file__).resolve().parents[1]
sources={r['seq']:r for r in json.loads((A/'evidence/source.json').read_text())}
def write(seq,title,items,notes,omissions):
    source=sources[seq];spans=[];decisions=[];expected={};parent=None;cursor=0
    for n, item in enumerate(items,1):
        tib,eng,d,occ,reason=item
        sid=f'w{n}' if d==5 else f'm{n}' if d==7 else f'p{n}'
        sp={'id':sid,'d':d,'tib':tib,'eng':eng}
        if eng is None:sp.update(cls='grammar',nul=reason)
        spans.append(sp)
        start=source['wylie'].index(tib, parent[0] if d==7 else cursor)
        end=start+len(tib)
        if d==7: assert end<=parent[1]
        else:cursor=end
        if d==5:parent=(start,end)
        ee=None
        if eng is not None:
            # Author-declared occurrence; independent boundary enumeration,
            # retained to compare with actual canonical resolution and body.
            matches=[m.span() for m in re.finditer(r'(?<![A-Za-z0-9])'+re.escape(eng)+r'(?![A-Za-z0-9])',source['english'])]
            ee=matches[occ-1]
        expected[sid]={'tib':[start,end],'eng':list(ee) if ee else None,'english_occurrence_1based':occ if ee else None}
        decisions.append({'id':sid,'tib':tib,'eng':eng,'depth':d,'reason':reason,'expected_ranges':expected[sid]})
    order=sorted([s['id'] for s in spans if s['eng'] is not None and s['d']!=7],key=lambda sid:expected[sid]['eng'][0])
    for left,right in zip(order,order[1:]):assert expected[left]['eng'][1]<=expected[right]['eng'][0],(seq,left,right)
    spec={'course':'C05','segments':[{'seq':seq,'title':title,'spans':spans,'eng_order':order,'note':notes}]}
    p=A/str(seq)
    (p/'spec.json').write_text(json.dumps(spec,ensure_ascii=False,indent=2)+'\n')
    (p/'errata.json').write_text('[]\n')
    (p/'decisions.json').write_text(json.dumps({'schema':'c05-independent-proposal-decisions-v1','producer':'Codex (English-first)','status':'PROVISIONAL machine alignment; no semantic approval','seq':seq,'source_ref':'../evidence/full-original-rows.json','lexical_ref':'../evidence/lexical-full-records.json','spans':decisions,'omissions':omissions},ensure_ascii=False,indent=2)+'\n')

def w(t,e,reason='Local lexical correspondence, checked against original source and full HGM glossary evidence.',occ=1,d=5):return(t,e,d,occ,reason)

write(307,'actual objects and mistaken perception',[
 w('skyon','problem'),w('med','no'),
 w('dbu sems','schools of the Middle Way and the Mind-Only','Established abbreviation for the paired schools, explicitly attested as a whole in the glossary; full C15:452, P7:46, GIE:397 and TCS05:170 context checked.'),
 w('dbu','Middle Way','Unique strictly tighter member of abbreviated school compound.',d=7),
 w('sems','Mind-Only','Unique strictly tighter member of abbreviated school compound; here sems is a school abbreviation, not ordinary mind.',d=7),
 w('gnyis',None,'The count two is fused into the explicit two-school enumeration; there is no separate English numeral or independent exponent.'),
 w('don','object'),w('shes','perception'),w('yod','existing'),w('med','not existing'),
 w('mtshungs','equivalent','First positive mtshungs, in the existence comparison. The second, negative alternative is not separately banked.'),
 w('dpyod','examining'),w('skabs','section'),w('phyir','for','First reason marker introduces the explanation of the quotation.',d=6),
 w('dang','Moreover','First dang connects the additional reason, rendered Moreover.',d=6),
 w('yi dvags','craving spirit','Only the first English occurrence corresponds to the explicit Tibetan subject; later English repetition is supplied.'),
 w('mig shes','visual consciousness',occ=1),
 w('chu klung','stream of water',occ=1),
 w('chu','water','Unique member of first stream compound; English member order reverses.',d=7),
 w('klung','stream','Unique member of first stream compound.',d=7),
 w('rnag khrag','pus and blood',occ=1),
 w('rnag','pus','Unique pus member of first compound.',d=7),w('khrag','blood','Unique blood member of first compound.',d=7),
 w('tu','as','Resultative appearance frame: appears as pus and blood.',d=6),
 w('snang ba','appears'),w('de ltar','this way'),w('snang ba','sees','The second appearance is recast actively as sees; objects and participants remain outside.'),
 w('mig shes','visual consciousness',occ=2),w('tshad ma','valid perception'),w('ma','not','The negation in ma yin pa; positive copula left outside.',occ=2),
 w('dang','and','Second dang connects the two simultaneous assertions; resolves after valid perception.',occ=5,d=6),
 w('chu klung','stream of water',occ=2),
 w('chu','water','Unique member of second stream compound.',occ=2,d=7),w('klung','stream','Unique member of second stream compound.',occ=2,d=7),
 w('la','at','Object relation of looking, the at after looks.',occ=2,d=6),w('bltas pa','looks'),
 w('rnag khrag','pus and blood',occ=2),
 w('rnag','pus','Unique member of second pus-and-blood compound.',occ=2,d=7),w('khrag','blood','Unique member of second pus-and-blood compound.',occ=2,d=7),
 w('dngos gnas pa','actual'),w('yod pa','exist','Existence predicate, with supplied does and there unwrapped.'),
 w('mi','no','Negates inconsistency at the start of the final English sentence.',occ=2),
 w("'gal ba",'inconsistency','The Tibetan contradiction noun is rendered inconsistency; not tied to either earlier no/existence predicate.')
],
"PROVISIONAL machine alignment by Codex, independent English-first proposal. GMR English and the complete source remain verbatim. The abbreviated dbu sems names the two schools; gnyis has no separate English numeral because the count is fused into that enumeration. The second mi mtshungs alternative and the temporal/explanatory expansions are distributed and omitted. Only the first craving-spirit occurrence is linked; repeated streams, pus-and-blood compounds and visual consciousnesses retain their actual occurrences. Mechanical fidelity is not semantic approval.",[
 {'tib':'mi mtshungs','reason':'Negative alternative is distributed through the question of whether/either-both construction; not an affirmative no-exponent null.'},
 {'tib':"tshe na; de'i tshe na",'reason':'Temporal framing is expanded across situation, where, at the same time and when; no clean independent atom proposed.'},
 {'tib':"de; pa'i; yin pa'i; kyi; la (consciousness); yin pa; zhig; final phyir",'reason':'Routine explanatory, nominal, case and copular framing left unbanked; no null claim for unresolved separate exponents.'},
 {'english':'And yet; this quotation; question of whether; must; both; another fact; things; second craving spirit; does; there','reason':'Supplied or distributed explanatory wording has no separate claimed Tibetan atom.'}
])


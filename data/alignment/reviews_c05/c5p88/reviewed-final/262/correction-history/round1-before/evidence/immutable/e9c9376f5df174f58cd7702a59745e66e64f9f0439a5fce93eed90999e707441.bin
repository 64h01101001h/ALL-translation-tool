('chu','water',5,{'occ':2}),('phor pa','glass',5,{'occ':2}),('gang po',None,5,{'nul':'Fullness is not separately stated in the second English glass-of-water mention.'}),('dngos po','objects',5),('gsum','three',5,{'occ':2}),('ma','not',6),('yin pa','is',5,{'occ':2}),

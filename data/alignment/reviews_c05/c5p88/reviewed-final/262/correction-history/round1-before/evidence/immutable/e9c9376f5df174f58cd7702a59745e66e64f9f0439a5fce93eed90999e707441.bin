import json,pathlib,re
base=pathlib.Path(__file__).resolve().parent.parent
sources={r['seq']:r for r in json.loads((base.parent/'source.json').read_text())}
def build(seq,title,items,note):
 spans=[];positions={};intents=[]
 for n,item in enumerate(items,1):
  tib,eng,d,*extra=item;opts=extra[0] if extra else {};occ=opts.pop('occ',1);id='w'+str(n)
  sp={'id':id,'d':d,'tib':tib,'eng':eng,**opts};spans.append(sp)
  if eng is not None:
   hits=[m.start() for m in re.finditer(r'(?<![A-Za-z0-9])'+re.escape(eng)+r'(?![A-Za-z0-9])',sources[seq]['english'])]
   assert len(hits)>=occ,(seq,eng,occ,hits)
   positions[id]=hits[occ-1];intents.append({'id':id,'english_occurrence':occ,'english_offset':positions[id],'all_whole_word_offsets':hits})
 seg={'seq':seq,'title':title,'spans':spans,'eng_order':sorted(positions,key=positions.get),'note':'PROVISIONAL machine alignment by Codex, Tibetan-first proposal; no human semantic approval. '+note}
 p=base/str(seq);(p/'spec.json').write_text(json.dumps({'course':'C05','segments':[seg]},ensure_ascii=False,indent=2)+'\n');(p/'intended-occurrences.json').write_text(json.dumps(intents,indent=2)+'\n');(p/'errata.json').write_text('[]\n')

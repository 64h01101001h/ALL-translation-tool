for seq,rows in DATA.items():
 out=BASE/str(seq);out.mkdir(exist_ok=True);src=next(x for x in E['rows'] if x['seq']==seq);spans=[];occ=[];tc=0;parent=None
 for n,(t,en,d,num) in enumerate(rows,1):
  s={'id':f'w{n}','d':d,'tib':t,'eng':en};spans.append(s)
  ep=[m.start() for m in re.finditer(re.escape(en),src['english']) if (m.start()==0 or not src['english'][m.start()-1].isalnum()) and (m.end()==len(src['english']) or not src['english'][m.end()].isalnum())]
  a=ep[num-1]
  if d==7: b=src['wylie'].index(t,*parent)
  else:b=src['wylie'].index(t,tc);tc=b+len(t);parent=(b,tc)
  occ.append({'id':s['id'],'tib':[b,b+len(t)],'eng':[a,a+len(en)],'intended_english_occurrence':num,'english_occurrences':ep})
 order=[r['id'] for r in sorted([o for o in occ if next(s for s in spans if s['id']==o['id'])['d']!=7],key=lambda x:x['eng'][0])]
 spec={'course':'C05','segments':[{'seq':seq,'title':{262:'our position on three perceptions',263:'causes of blood and pus',264:'causes of water'}[seq],'spans':spans,'eng_order':order,'note':NOTES[seq]}]}

import pathlib,json,hashlib,runpy,re,html,datetime
BASE=pathlib.Path(__file__).resolve().parent.parent
root=BASE.parents[2]/'campaign-worktree';g=runpy.run_path(str(root/'tools/gen_alignment_page.py'),run_name='canonical_proof');sha=lambda f:hashlib.sha256(f.read_bytes()).hexdigest()
efile=BASE/'262/original-evidence.json';ev=json.loads(efile.read_text());assert sha(pathlib.Path(ev['db']))==ev['db_sha256']
concerns={262:'Challenge first the d3 common-locus recast. The noisy auto-aligned gzhi mthun gloss is not used; original prose and C05:279/286 corroborate the argument. The exact occurrence correction is preserved in attempts/01.',263:'Challenge first the shared byas pa → second provides and the omitted second three-part clause; both are explained in the note. The temporal phrase preserves the complete negative-until recast without falsely nulling ma.',264:'Challenge first initial gcig → Another in the contrastive list; continuation in C05:265 and HGM gcig includes another. Bound forms mi\'i/chur stay intact; expanded glass-of-water referents stay unclaimed.'}
for seq in [262,263,264]:
 out=BASE/str(seq);spec=json.loads((out/'spec.json').read_text())['segments'][0];occ=json.loads((out/'occurrences.json').read_text());sp=spec['spans'];byid={s['id']:s for s in sp};engsp=g['with_members'](sp,[byid[x] for x in spec['eng_order']],occ['source']['english']);actual={side:g['resolve'](occ['source']['wylie' if side=='tib' else 'english'],sp if side=='tib' else engsp,side,seq) for side in ['tib','eng']}
 for o in occ['spans']:
  for side in ['tib','eng']:assert list(actual[side][o['id']])==o[side],(seq,o,side)
 a=out/'attempts/02';inv=json.loads((a/'invocation.json').read_text());assert inv['exit']==0 and not (a/'stderr.txt').read_bytes() and (a/'stdout.html').read_bytes()==(out/'body.html').read_bytes()
 body=(out/'body.html').read_text();recovered={}
 for side in ['tib','eng']:
  frag=re.search(r'<div class="'+side+r'"><div class="lab">.*?</div>\n(.*?)\n</div>',body,re.S).group(1);recovered[side]=html.unescape(re.sub('<[^>]*>','',frag));assert recovered[side]==occ['source']['wylie' if side=='tib' else 'english']
 counts={'spec_spans':len(sp),'nulls':sum(x['eng'] is None for x in sp),'depth_5':sum(x['d']==5 for x in sp),'depth_6':sum(x['d']==6 for x in sp),'depth_7':sum(x['d']==7 for x in sp),'depth_3':sum(x['d']==3 for x in sp),'automatic_d1_containers_per_side':1,'errata':0}
 proof={'producer':'Codex / English-first independent proposal','counts':counts,'canonical_attempt':'attempts/02','stdout_bytes':inv['stdout_bytes'],'stderr_bytes':0,'exit':0,'body_matches_stdout':True,'canonical_resolved_ranges':actual,'all_intended_occurrences_match':True,'plain_text_recovered':recovered,'plain_text_matches_original':True,'original_evidence':{'path':str(efile),'sha256':sha(efile)},'hashes':{name:sha(out/name) for name in ['spec.json','body.html','errata.json','occurrences.json']},'db_sha256_unchanged':True,'governing_head':ev['governing_head'],'immutable_generated_baseline':ev['immutable_generated_baseline'],'semantic_approval':False}
 (out/'proof.json').write_text(json.dumps(proof,ensure_ascii=False,indent=2)+'\n')
 lines=[f'C05:{seq} — English-first original proposal by Codex; PROVISIONAL, not semantically approved.',concerns[seq],f"Counts: {counts['spec_spans']} spec spans; d5={counts['depth_5']}, d6={counts['depth_6']}, d7={counts['depth_7']}, d3={counts['depth_3']}; nulls=0; errata=0. Automatic d1 source containers are separate.",'Full original evidence: ../262/original-evidence.json (source C05:242–280, six-field snapshot verification, full original lexical entries and parameterized corpus results).',f'Original evidence SHA256: {sha(efile)}.','Exact occurrence ranges and repeated-hit indexes: occurrences.json; canonical ranges and verbatim text recovery: proof.json.','No new erratum found; original ACIP/Wylie/English and field-level parallels retained. No 1500-character cap or following heading in these rows. Identity does not prove independent publication or ingestion lineage.','The supplied wrapper enforces mode=ro only; local 262/canonical_readonly.py additionally enforces PRAGMA query_only. Canonical files unchanged; exact argv and all code hashes in attempts/02/invocation.json.',f"FINAL actual canonical stdout: attempts/02/stdout.html; stderr: attempts/02/stderr.txt (0 bytes); exit: attempts/02/exit.txt (0). EXIT=0; BODY_BYTES={inv['stdout_bytes']}.",f"spec.json SHA256 {sha(out/'spec.json')}",f"body.html SHA256 {sha(out/'body.html')}", 'Attempts 01 and 02 are preserved; 262:01 is mechanically passing but superseded for its incorrect intended occurrence/note, 263/264:02 reproduce unchanged proposals. Full body text remains verbatim.','Final proof boundary: freeze.json lists all deliverable and attempt bytes; later corrections must preserve and explicitly supersede this boundary.']
 (out/'report.md').write_text('\n'.join(lines)+'\n')
for seq in [262,263,264]:
 out=BASE/str(seq);files=sorted(p for p in out.rglob('*') if p.is_file() and p.name!='freeze.json');manifest={'frozen_at_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),'status':'FROZEN original proposal','producer':'Codex','files':{str(f.relative_to(out)):{'bytes':f.stat().st_size,'sha256':sha(f)} for f in files},'shared_original_evidence':{'path':str(efile),'sha256':sha(efile)}};(out/'freeze.json').write_text(json.dumps(manifest,indent=2)+'\n')
 for f in files+[out/'freeze.json']: f.chmod(0o444)
 print(seq,json.loads((out/'proof.json').read_text())['counts'],sha(out/'freeze.json'))

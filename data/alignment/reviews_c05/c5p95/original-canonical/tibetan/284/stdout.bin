<span class="u" data-d="1" data-l="s284S"><span class="u" data-d="5" data-l="s284w1">snga ma</span> yang de dang <span class="u" data-d="5" data-l="s284w2">mtshungs</span> te, <span class="u" data-d="5" data-l="s284w3"><span class="u" data-d="7" data-l="s284m4">rnag</span> <span class="u" data-d="7" data-l="s284m5">khrag</span></span> la <span class="u" data-d="5" data-l="s284w6">sogs</span> pa&#x27;i <span class="u" data-d="5" data-l="s284w7">dngos po</span> <span class="u" data-d="5" data-l="s284w8">gsum</span> po de, <span class="u" data-d="5" data-l="s284w9">brlan</span> <span class="u" data-d="6" data-l="s284p10">zhing</span> <span class="u" data-d="5" data-l="s284w11">gsher ba</span> <span class="u" data-d="5" data-l="s284w12">phor pa</span> <span class="u" data-d="5" data-l="s284w13">gang</span> po de&#x27;i <span class="u" data-d="5" data-l="s284w14">cha shas</span> <span class="u" data-d="5" data-l="s284w15">yin</span> pas de <span class="u" data-d="5" data-l="s284w16">gsum</span> <span class="u" data-d="5" data-l="s284w17">snang ba</span> <span class="u" data-d="6" data-l="s284p18">na</span>, <span class="u" data-d="5" data-l="s284w19">brlan</span> <span class="u" data-d="6" data-l="s284p20">zhing</span> <span class="u" data-d="5" data-l="s284w21">gsher ba</span> <span class="u" data-d="5" data-l="s284w22">phor pa</span> <span class="u" data-d="5" data-l="s284w23">gang</span> po de&#x27;i <span class="u" data-d="5" data-l="s284w24">steng</span> du <span class="u" data-d="5" data-l="s284w25">snang tshul</span> <span class="u" data-d="5" data-l="s284w26">mi &#x27;dra ba</span> <span class="u" data-d="5" data-l="s284w27">gsum</span> <span class="u" data-d="5" data-l="s284w28">snang</span> bar <span class="u" data-d="5" data-l="s284w29">&#x27;jog</span> pa&#x27;i phyir</span>

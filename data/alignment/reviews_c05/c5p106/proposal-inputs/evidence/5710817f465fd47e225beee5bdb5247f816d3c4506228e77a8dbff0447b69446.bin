def positions(text,piece,subword=False):
    hits=[]; start=0
    while (i:=text.find(piece,start))>=0:
        end=i+len(piece)
        if subword or ((not piece[0].isalnum() or i==0 or not text[i-1].isalnum()) and (not piece[-1].isalnum() or end==len(text) or not text[end].isalnum())): hits.append([i,end])
        start=i+1
    return hits
for seq,p in proposals.items():
    spans=[x[0] for x in p['spans']]
    spec=dict(course='C05',segments=[dict(seq=seq,title=p['title'],spans=spans,eng_order=p['order'],note=p['note'])])
    (B/str(seq)/'spec.json').write_text(json.dumps(spec,ensure_ascii=False,indent=2)+'\n')
    decisions=[]
    for sp,reason in p['spans']:
        decisions.append(dict(id=sp['id'],reason=reason,source_candidates=positions(sources[seq]['wylie'],sp['tib'],sp['d']==7 or sp.get('subword',False)),english_candidates=positions(sources[seq]['english'],sp['eng'],sp['d']==7 or sp.get('subword',False)) if sp['eng'] is not None else [],depth_basis='source word or established compound' if sp['d']==5 else 'standalone source particle' if sp['d']==6 else 'tighter compound member' if sp['d']==7 else 'complete nominal phrase'))
    (B/str(seq)/'decisions.json').write_text(json.dumps(dict(seq=seq,producer='Codex GPT-6',angle='Tibetan-first',source=sources[seq],spans=decisions,omissions=p['omissions']),ensure_ascii=False,indent=2)+'\n')
    (B/str(seq)/'errata.json').write_text('[]\n')
print('Authored specs and original occurrence candidates for',list(proposals))

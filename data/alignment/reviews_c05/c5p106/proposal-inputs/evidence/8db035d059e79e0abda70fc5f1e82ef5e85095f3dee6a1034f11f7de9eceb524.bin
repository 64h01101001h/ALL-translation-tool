    "rows": [
      {
        "id": 1698,
        "course": "C05",
        "seq": 316,
        "acip": ",MI DGE GZUGS DANG 'DOD GTOGS PA'I, ,DGE BA NYID NI RIM BZHIN DU, ,GNAG DANG DKAR DANG GNYIS KA'I LAS, ,DE ZAD BYED PA ZAG MED YIN,",
        "wylie": "mi dge gzugs dang 'dod gtogs pa'i, ,dge ba nyid ni rim bzhin du, ,gnag dang dkar dang gnyis ka'i las, ,de zad byed pa zag med yin",
        "english": "Non-virtue as well as virtue itself taken In by the form and desire represent Respectively deeds which are black, white, and both. The unstained is what brings it to an end.",
        "raw": "{\"course\": \"C05\", \"acip\": \",MI DGE GZUGS DANG 'DOD GTOGS PA'I, ,DGE BA NYID NI RIM BZHIN DU, ,GNAG DANG DKAR DANG GNYIS KA'I LAS, ,DE ZAD BYED PA ZAG MED YIN,\", \"wylie\": \"mi dge gzugs dang 'dod gtogs pa'i, ,dge ba nyid ni rim bzhin du, ,gnag dang dkar dang gnyis ka'i las, ,de zad byed pa zag med yin\", \"english\": \"Non-virtue as well as virtue itself taken In by the form and desire represent Respectively deeds which are black, white, and both. The unstained is what brings it to an end.\"}"
      },
      {
        "id": 1699,
        "course": "C05",
        "seq": 317,
        "acip": "[IV.237-40] ,'O NA LAS DE DAG GI NGO BO JI LTA BU ZHE NA, MI DGE BA NI GNAG LA RNAM PAR SMIN PA GNAG PA'I LAS YIN TE, RANG GI NGO BO NYON MONGS CAN YIN PAS GNAG LA, RNAM SMIN YID DU MI 'ONG BA 'BYIN PAS RNAM SMIN YANG GNAG PA'I PHYIR,",
        "wylie": "[iv.237-40] ,'o na las de dag gi ngo bo ji lta bu zhe na, mi dge ba ni gnag la rnam par smin pa gnag pa'i las yin te, rang gi ngo bo nyon mongs can yin pas gnag la, rnam smin yid du mi 'ong ba 'byin pas rnam smin yang gnag pa'i phyir",
        "english": "Just how do we describe these four types of deeds? Non-virtue represents a type of deed which is black and ripens into something black. It is black in that its very nature consists of something afflicted. It also ripens into something black, for it ripens forth into an undesirable result.",
        "raw": "{\"course\": \"C05\", \"acip\": \"[IV.237-40] ,'O NA LAS DE DAG GI NGO BO JI LTA BU ZHE NA, MI DGE BA NI GNAG LA RNAM PAR SMIN PA GNAG PA'I LAS YIN TE, RANG GI NGO BO NYON MONGS CAN YIN PAS GNAG LA, RNAM SMIN YID DU MI 'ONG BA 'BYIN PAS RNAM SMIN YANG GNAG PA'I PHYIR,\", \"wylie\": \"[iv.237-40] ,'o na las de dag gi ngo bo ji lta bu zhe na, mi dge ba ni gnag la rnam par smin pa gnag pa'i las yin te, rang gi ngo bo nyon mongs can yin pas gnag la, rnam smin yid du mi 'ong ba 'byin pas rnam smin yang gnag pa'i phyir\", \"english\": \"Just how do we describe these four types of deeds? Non-virtue represents a type of deed which is black and ripens into something black. It is black in that its very nature consists of something afflicted. It also ripens into something black, for it ripens forth into an undesirable result.\"}"
      },
      {
        "id": 1701,
        "course": "C05",
        "seq": 319,
        "acip": "'DOD PAR GTOGS PA'I DGE BA NI DKAR GNAG LA RNAM PAR SMIN PA YANG DKAR GNAG PA'I LAS YIN TE, RANG GI NGO BO NYON MONGS CAN MIN PAS DKAR, RGYUD GCIG LA NYON MONGS PA DANG 'DRES PAS GNAG, 'BRAS BU YID DU 'ONG BA 'BYIN PAS RNAM SMIN DKAR, RGYUD GCIG LA SDUG BSNGAL DANG 'DRES PAS RNAM SMIN GNAG PA'I PHYIR,",
        "wylie": "'dod par gtogs pa'i dge ba ni dkar gnag la rnam par smin pa yang dkar gnag pa'i las yin te, rang gi ngo bo nyon mongs can min pas dkar, rgyud gcig la nyon mongs pa dang 'dres pas gnag, 'bras bu yid du 'ong ba 'byin pas rnam smin dkar, rgyud gcig la sdug bsngal dang 'dres pas rnam smin gnag pa'i phyir",
        "english": "Virtue taken in by the realm of desire represents a type of deed which is both white and black, and which also ripens into something both white and black. Since its basic nature is free of affliction it is white but--since within a single mental stream it is also mixed with afflicted things--it is black as well. It ripens into something white because it gives forth a pleasant result but--since within the particular mental stream this is also mixed with suffering--we can also say it ripens into something black.",
        "raw": "{\"course\": \"C05\", \"acip\": \"'DOD PAR GTOGS PA'I DGE BA NI DKAR GNAG LA RNAM PAR SMIN PA YANG DKAR GNAG PA'I LAS YIN TE, RANG GI NGO BO NYON MONGS CAN MIN PAS DKAR, RGYUD GCIG LA NYON MONGS PA DANG 'DRES PAS GNAG, 'BRAS BU YID DU 'ONG BA 'BYIN PAS RNAM SMIN DKAR, RGYUD GCIG LA SDUG BSNGAL DANG 'DRES PAS RNAM SMIN GNAG PA'I PHYIR,\", \"wylie\": \"'dod par gtogs pa'i dge ba ni dkar gnag la rnam par smin pa yang dkar gnag pa'i las yin te, rang gi ngo bo nyon mongs can min pas dkar, rgyud gcig la nyon mongs pa dang 'dres pas gnag, 'bras bu yid du 'ong ba 'byin pas rnam smin dkar, rgyud gcig la sdug bsngal dang 'dres pas rnam smin gnag pa'i phyir\", \"english\": \"Virtue taken in by the realm of desire represents a type of deed which is both white and black, and which also ripens into something both white and black. Since its basic nature is free of affliction it is white but--since within a single mental stream it is also mixed with afflicted things--it is black as well. It ripens into something white because it gives forth a pleasant result but--since within the particular mental stream this is also mixed with suffering--we can also say it ripens into something black.\"}"
      },
      {
        "id": 1702,
        "course": "C05",
        "seq": 320,
        "acip": "ZAG MED KYI LAS NI MI DKAR MI GNAG RNAM PAR MI SMIN LA, NAG PO DE ZAD PAR BYED PA YIN NO,",
        "wylie": "zag med kyi las ni mi dkar mi gnag rnam par mi smin la, nag po de zad par byed pa yin no",
        "english": "Deeds which are unstained never ripen into anything either white or black. Their nature is to be what brings \"it\"--that is, the black kind of deed--to an end. 64 Bringing Black and White Deeds to an End",
        "raw": "{\"course\": \"C05\", \"acip\": \"ZAG MED KYI LAS NI MI DKAR MI GNAG RNAM PAR MI SMIN LA, NAG PO DE ZAD PAR BYED PA YIN NO,\", \"wylie\": \"zag med kyi las ni mi dkar mi gnag rnam par mi smin la, nag po de zad par byed pa yin no\", \"english\": \"Deeds which are unstained never ripen into anything either white or black. Their nature is to be what brings \\\"it\\\"--that is, the black kind of deed--to an end. 64 Bringing Black and White Deeds to an End\"}"
      },
      {
        "id": 1705,
        "course": "C05",
        "seq": 323,
        "acip": "BAR CHAD MED PA'I LAM DGU PA'I SEMS PA GANG YIN PA DE NI DKAR GNAG ZAD PAR BYED PA'I LAS YIN TE, 'DOD PA'I DGE BA LA 'DUN PA 'DOD CHAGS DANG BRAL BA'I SGO NAS SPONG , 'DOD PA'I NYON MONGS THOB PA CHAD PA'I TSUL GYIS SPONG BA'I PHYIR,",
        "wylie": "bar chad med pa'i lam dgu pa'i sems pa gang yin pa de ni dkar gnag zad par byed pa'i las yin te, 'dod pa'i dge ba la 'dun pa 'dod chags dang bral ba'i sgo nas spong , 'dod pa'i nyon mongs thob pa chad pa'i tshul gyis spong ba'i phyir",
        "english": "Next let's take that type which is the mental movement in the ninth instant of the uninterrupted path. This is a deed which acts to end the white and black, first of all because it eliminates desire-realm virtue by means of eliminating the aspiration, or the desire, for it. Secondly, it eliminates all the mental afflictions of the desire realm--the process here being that one stops the hold which retains them.",
        "raw": "{\"course\": \"C05\", \"acip\": \"BAR CHAD MED PA'I LAM DGU PA'I SEMS PA GANG YIN PA DE NI DKAR GNAG ZAD PAR BYED PA'I LAS YIN TE, 'DOD PA'I DGE BA LA 'DUN PA 'DOD CHAGS DANG BRAL BA'I SGO NAS SPONG , 'DOD PA'I NYON MONGS THOB PA CHAD PA'I TSUL GYIS SPONG BA'I PHYIR,\", \"wylie\": \"bar chad med pa'i lam dgu pa'i sems pa gang yin pa de ni dkar gnag zad par byed pa'i las yin te, 'dod pa'i dge ba la 'dun pa 'dod chags dang bral ba'i sgo nas spong , 'dod pa'i nyon mongs thob pa chad pa'i tshul gyis spong ba'i phyir\", \"english\": \"Next let's take that type which is the mental movement in the ninth instant of the uninterrupted path. This is a deed which acts to end the white and black, first of all because it eliminates desire-realm virtue by means of eliminating the aspiration, or the desire, for it. Secondly, it eliminates all the mental afflictions of the desire realm--the process here being that one stops the hold which retains them.\"}"
      },
      {
        "id": 1707,
        "course": "C05",
        "seq": 325,
        "acip": ",GZHAN NI DMYAL BA MYONG 'GYUR DANG , ,'DOD GZHAN MYONG 'GYUR GNYIS SU RIG,GZHAN NI MTHONG BAS SPANG BYA GNAG,'DOD PA LAS SKYES GZHAN DKAR",
        "wylie": "gzhan ni dmyal ba myong 'gyur dang , ,'dod gzhan myong 'gyur gnyis su rig,gzhan ni mthong bas spang bya gnag,'dod pa las skyes gzhan dkar",
        "english": "According to others, understood as those For a hell experience, the two for other desire. Others, what seeing eliminates is black; White and black, others that come from desire.",
        "raw": "{\"course\": \"C05\", \"acip\": \",GZHAN NI DMYAL BA MYONG 'GYUR DANG , ,'DOD GZHAN MYONG 'GYUR GNYIS SU RIG,GZHAN NI MTHONG BAS SPANG BYA GNAG,'DOD PA LAS SKYES GZHAN DKAR\", \"wylie\": \"gzhan ni dmyal ba myong 'gyur dang , ,'dod gzhan myong 'gyur gnyis su rig,gzhan ni mthong bas spang bya gnag,'dod pa las skyes gzhan dkar\", \"english\": \"According to others, understood as those For a hell experience, the two for other desire. Others, what seeing eliminates is black; White and black, others that come from desire.\"}"
      },
      {
        "id": 1708,
        "course": "C05",
        "seq": 326,
        "acip": "[IV.249-52] GNGSDE PA GZHAN NI DMYAL BA MYONG BAR 'GYUR BA'I LAS DE NAG PO DANG , 'DOD PA'I 'GRO BA GZHAN MYONG BAR 'GYUR BA'I LAS NI DKAR GNAG GNYIS KA'I LAS SU RIG GO ZHES ZER, YANG SDE PA GZHAN NI MTHONG BAS SPANG BAR BYA BA'I LAS DE GNAG PA DANG , 'DOD PA LAS SKYES PA GZHAN DKAR GNAG GNYIS KA'I LAS SU 'DOD DO,",
        "wylie": "[iv.249-52] gngsde pa gzhan ni dmyal ba myong bar 'gyur ba'i las de nag po dang , 'dod pa'i 'gro ba gzhan myong bar 'gyur ba'i las ni dkar gnag gnyis ka'i las su rig go zhes zer, yang sde pa gzhan ni mthong bas spang bar bya ba'i las de gnag pa dang , 'dod pa las skyes pa gzhan dkar gnag gnyis ka'i las su 'dod do",
        "english": "According to the claim of certain other groups, deeds which bring one an experience in the hells are to be understood as the \"black\" ones. And those that bring one an experience in some other birth in the desire realm are to be understood as the two: as deeds that are both white and black. Still other groups assert that those kinds of deeds which the path of seeing eliminates are the black ones, while the other deeds that come from the desire are both white and black. We turn next to our fifth group of deeds, which includes those divided on the basis of the person who possesses them. ********* 72 Three Types of Each Path of Action",
        "raw": "{\"course\": \"C05\", \"acip\": \"[IV.249-52] GNGSDE PA GZHAN NI DMYAL BA MYONG BAR 'GYUR BA'I LAS DE NAG PO DANG , 'DOD PA'I 'GRO BA GZHAN MYONG BAR 'GYUR BA'I LAS NI DKAR GNAG GNYIS KA'I LAS SU RIG GO ZHES ZER, YANG SDE PA GZHAN NI MTHONG BAS SPANG BAR BYA BA'I LAS DE GNAG PA DANG , 'DOD PA LAS SKYES PA GZHAN DKAR GNAG GNYIS KA'I LAS SU 'DOD DO,\", \"wylie\": \"[iv.249-52] gngsde pa gzhan ni dmyal ba myong bar 'gyur ba'i las de nag po dang , 'dod pa'i 'gro ba gzhan myong bar 'gyur ba'i las ni dkar gnag gnyis ka'i las su rig go zhes zer, yang sde pa gzhan ni mthong bas spang bar bya ba'i las de gnag pa dang , 'dod pa las skyes pa gzhan dkar gnag gnyis ka'i las su 'dod do\", \"english\": \"According to the claim of certain other groups, deeds which bring one an experience in the hells are to be understood as the \\\"black\\\" ones. And those that bring one an experience in some other birth in the desire realm are to be understood as the two: as deeds that are both white and black. Still other groups assert that those kinds of deeds which the path of seeing eliminates are the black ones, while the other deeds that come from the desire are both white and black. We turn next to our fifth group of deeds, which includes those divided on the basis of the person who possesses them. ********* 72 Three Types of Each Path of Action\"}"
      },
      {
        "id": 2602,
        "course": "C08",
        "seq": 257,
        "acip": "YANG RO MYAGS KYI 'DAM RKED PA NUB TZAM LA 'BU MCHU RNON ZHES BYA BA LUS DKAR ZHING MGO GNAG PAS LUS LA 'BIGS PAR BYED PA DANG , DE DANG 'BAB CHAGS PA NA SPU GRI GTAMS PA'I LAM PO CHE YOD LA, DE LA RKANG PA BZHAG PA NA SHA RUS 'JIG CING , BTEG PA NA GSOS PA DANG ,",
        "wylie": "yang ro myags kyi 'dam rked pa nub tsam la 'bu mchu rnon zhes bya ba lus dkar zhing mgo gnag pas lus la 'bigs par byed pa dang , de dang 'bab chags pa na spu gri gtams pa'i lam po che yod la, de la rkang pa bzhag pa na sha rus 'jig cing , bteg pa na gsos pa dang",
        "english": "Next is the Corpse Rot, a swamp hell of rotten corpses. You sink down to your waist and out come creatures called Sharpbeaks, with white bodies and black heads, to spear your body. Right up against the Swamp is the Razor- Studded Road, where again the flesh and bone of your feet are sliced away as you set your feet down, constantly regenerating as you raise them again.",
        "raw": "{\"course\": \"C08\", \"acip\": \"YANG RO MYAGS KYI 'DAM RKED PA NUB TZAM LA 'BU MCHU RNON ZHES BYA BA LUS DKAR ZHING MGO GNAG PAS LUS LA 'BIGS PAR BYED PA DANG , DE DANG 'BAB CHAGS PA NA SPU GRI GTAMS PA'I LAM PO CHE YOD LA, DE LA RKANG PA BZHAG PA NA SHA RUS 'JIG CING , BTEG PA NA GSOS PA DANG ,\", \"wylie\": \"yang ro myags kyi 'dam rked pa nub tsam la 'bu mchu rnon zhes bya ba lus dkar zhing mgo gnag pas lus la 'bigs par byed pa dang , de dang 'bab chags pa na spu gri gtams pa'i lam po che yod la, de la rkang pa bzhag pa na sha rus 'jig cing , bteg pa na gsos pa dang\", \"english\": \"Next is the Corpse Rot, a swamp hell of rotten corpses. You sink down to your waist and out come creatures called Sharpbeaks, with white bodies and black heads, to spear your body. Right up against the Swamp is the Razor- Studded Road, where again the flesh and bone of your feet are sliced away as you set your feet down, constantly regenerating as you raise them again.\"}"
      },
      {
        "id": 7395,
        "course": "C17",
        "seq": 357,
        "acip": "YANG RO MYAGS KYI 'DAM RKED PA NUB TZAM LA 'BU MCHU RNON ZHES BYA BA LUS DKAR ZHING MGO GNAG PAS LUS LA 'BIGS PAR BYED PA DANG , DE DANG 'BAB CHAGS PA NA SPU GRI GTAMS PA'I LAM PO CHE YOD LA, DE LA RKANG PA BZHAG PA NA SHA RUS 'JIG CING , BTEG PA NA GSOS PA DANG ,",
        "wylie": "yang ro myags kyi 'dam rked pa nub tsam la 'bu mchu rnon zhes bya ba lus dkar zhing mgo gnag pas lus la 'bigs par byed pa dang , de dang 'bab chags pa na spu gri gtams pa'i lam po che yod la, de la rkang pa bzhag pa na sha rus 'jig cing , bteg pa na gsos pa dang",
        "english": "Next is the Corpse Rot, a swamp hell of rotten corpses. You sink down to your waist and out come creatures called Sharpbeaks, with white bodies and black heads, to spear your body. Right up against the Swamp is the Razor- Studded Road, where again the flesh and bone of your feet are sliced away as you set your feet down, constantly regenerating as you raise them again.",
        "raw": "{\"course\": \"C17\", \"acip\": \"YANG RO MYAGS KYI 'DAM RKED PA NUB TZAM LA 'BU MCHU RNON ZHES BYA BA LUS DKAR ZHING MGO GNAG PAS LUS LA 'BIGS PAR BYED PA DANG , DE DANG 'BAB CHAGS PA NA SPU GRI GTAMS PA'I LAM PO CHE YOD LA, DE LA RKANG PA BZHAG PA NA SHA RUS 'JIG CING , BTEG PA NA GSOS PA DANG ,\", \"wylie\": \"yang ro myags kyi 'dam rked pa nub tsam la 'bu mchu rnon zhes bya ba lus dkar zhing mgo gnag pas lus la 'bigs par byed pa dang , de dang 'bab chags pa na spu gri gtams pa'i lam po che yod la, de la rkang pa bzhag pa na sha rus 'jig cing , bteg pa na gsos pa dang\", \"english\": \"Next is the Corpse Rot, a swamp hell of rotten corpses. You sink down to your waist and out come creatures called Sharpbeaks, with white bodies and black heads, to spear your body. Right up against the Swamp is the Razor- Studded Road, where again the flesh and bone of your feet are sliced away as you set your feet down, constantly regenerating as you raise them again.\"}"
      },
      {
        "id": 35464,
        "course": "DDA",
        "seq": 381,
        "acip": ",MKHAS NAS GNAG RDZI MO BAR GYI, ,SKYA SER PHAL CHER BLA MA LA, ,'BUL BA ZHABS TOG BYAS NAS SU, ,DON DU GNYER BYA ZAB DON ZHUS,",
        "wylie": "mkhas nas gnag rdzi mo bar gyi, ,skya ser phal cher bla ma la, ,'bul ba zhabs tog byas nas su, ,don du gnyer bya zab don zhus",
        "english": "From great masters Down to cowherds, And whether they be Laypeople or the ordained, People pay honor And make offerings To the Lamas, And ask for teachings About the most profound: The goals they wish To achieve. The key here is that oftentimes our spiritual seeking is infected by other motivations, such as the attention of others, or material gain of some kind.",
        "raw": "{\"course\": \"DDA\", \"acip\": \",MKHAS NAS GNAG RDZI MO BAR GYI, ,SKYA SER PHAL CHER BLA MA LA, ,'BUL BA ZHABS TOG BYAS NAS SU, ,DON DU GNYER BYA ZAB DON ZHUS,\", \"wylie\": \"mkhas nas gnag rdzi mo bar gyi, ,skya ser phal cher bla ma la, ,'bul ba zhabs tog byas nas su, ,don du gnyer bya zab don zhus\", \"english\": \"From great masters Down to cowherds, And whether they be Laypeople or the ordained, People pay honor And make offerings To the Lamas, And ask for teachings About the most profound: The goals they wish To achieve. The key here is that oftentimes our spiritual seeking is infected by other motivations, such as the attention of others, or material gain of some kind.\"}"
      },
      {
        "id": 24413,
        "course": "GIE",
        "seq": 901,
        "acip": "[C14] ,ZAB DANG G-YAS PHYOGS 'KHYIL BA DANG, ,KUN NAS BLTA NA SDUG PA DANG, ,KUN SPYOD GTZANG DANG SKU LA NI, ,SME BA GNAG BAG MED PA DANG,",
        "wylie": "[c14] ,zab dang g-yas phyogs 'khyil ba dang, ,kun nas blta na sdug pa dang, ,kun spyod gtsang dang sku la ni, ,sme ba gnag bag med pa dang",
        "english": "(M39) And spirals to the right. (M40) They are lovely to look upon; (M41) Their behavior is pure; (M42) And their body is free Of moles or spots.",
        "raw": "{\"course\": \"GIE\", \"acip\": \"[C14] ,ZAB DANG G-YAS PHYOGS 'KHYIL BA DANG, ,KUN NAS BLTA NA SDUG PA DANG, ,KUN SPYOD GTZANG DANG SKU LA NI, ,SME BA GNAG BAG MED PA DANG,\", \"wylie\": \"[c14] ,zab dang g-yas phyogs 'khyil ba dang, ,kun nas blta na sdug pa dang, ,kun spyod gtsang dang sku la ni, ,sme ba gnag bag med pa dang\", \"english\": \"(M39) And spirals to the right. (M40) They are lovely to look upon; (M41) Their behavior is pure; (M42) And their body is free Of moles or spots.\"}"
      },
      {
        "id": 24418,
        "course": "GIE",
        "seq": 906,
        "acip": "[C19] ,DPRAL BA LEGS PAR 'BYES PA DANG, ,DBYES CHE BA DANG DBU RGYAS DANG, ,DBU SKRA BUNG BA LTAR GNAG DANG, ,STUG DANG 'JAM DANG MA 'DZINGS DANG,",
        "wylie": "[c19] ,dpral ba legs par 'byes pa dang, ,dbyes che ba dang dbu rgyas dang, ,dbu skra bung ba ltar gnag dang, ,stug dang 'jam dang ma 'dzings dang",
        "english": "(M71) Their hairline is well defined; (M72) Their forehead broad; (M73) And the shape of their head is full. (M74) Their hair is black as a bee's bottom; (M75) Thick; (M76) soft; (M77) and untangled.",
        "raw": "{\"course\": \"GIE\", \"acip\": \"[C19] ,DPRAL BA LEGS PAR 'BYES PA DANG, ,DBYES CHE BA DANG DBU RGYAS DANG, ,DBU SKRA BUNG BA LTAR GNAG DANG, ,STUG DANG 'JAM DANG MA 'DZINGS DANG,\", \"wylie\": \"[c19] ,dpral ba legs par 'byes pa dang, ,dbyes che ba dang dbu rgyas dang, ,dbu skra bung ba ltar gnag dang, ,stug dang 'jam dang ma 'dzings dang\", \"english\": \"(M71) Their hairline is well defined; (M72) Their forehead broad; (M73) And the shape of their head is full. (M74) Their hair is black as a bee's bottom; (M75) Thick; (M76) soft; (M77) and untangled.\"}"
      },
      {
        "id": 24422,
        "course": "GIE",
        "seq": 910,
        "acip": "[C23] DBU GDUGS LTAR RGYAS PA DANG, DBU SKRA BUNG BA LTAR GNAG BA DANG, DBU SKRA STUG PA DANG, DBU SKRA 'JAM PA DANG, DBU SKRA MA 'DZINGS PA DANG, DBU SKRA MI GSHOR BA DANG, DBU SKRA DRI ZHIM PA STE DPE BYAD BDUN NI, GTZUG TOR DANG, SPU GA-YAS SU 'KHYIL BA DANG, SPU GYEN DU PHYOGS PA'I MTSAN GSUM GYI 'KHOR DANG,",
        "wylie": "[c23] dbu gdugs ltar rgyas pa dang, dbu skra bung ba ltar gnag ba dang, dbu skra stug pa dang, dbu skra 'jam pa dang, dbu skra ma 'dzings pa dang, dbu skra mi gshor ba dang, dbu skra dri zhim pa ste dpe byad bdun ni, gtsug tor dang, spu ga-yas su 'khyil ba dang, spu gyen du phyogs pa'i mtshan gsum gyi 'khor dang",
        "english": "Three major signs: (S23) The top of their skull has a crown ridge. (S16) The hairs of the body spiral right. (S10) The hairs of their body point out. Seven associated marks: (M73) The shape of their head is full, like a parasol. (M74) Their hair is black as a bee's bottom. (M75) Their hair is thick. (M76) Their hair is soft. (M77) Their hair is untangled. (M78) Their hair doesn't fly out. (M79) Their hair has a delightful scent. Group #3 Signs & marks relating to the Buddha's face",
        "raw": "{\"course\": \"GIE\", \"acip\": \"[C23] DBU GDUGS LTAR RGYAS PA DANG, DBU SKRA BUNG BA LTAR GNAG BA DANG, DBU SKRA STUG PA DANG, DBU SKRA 'JAM PA DANG, DBU SKRA MA 'DZINGS PA DANG, DBU SKRA MI GSHOR BA DANG, DBU SKRA DRI ZHIM PA STE DPE BYAD BDUN NI, GTZUG TOR DANG, SPU GA-YAS SU 'KHYIL BA DANG, SPU GYEN DU PHYOGS PA'I MTSAN GSUM GYI 'KHOR DANG,\", \"wylie\": \"[c23] dbu gdugs ltar rgyas pa dang, dbu skra bung ba ltar gnag ba dang, dbu skra stug pa dang, dbu skra 'jam pa dang, dbu skra ma 'dzings pa dang, dbu skra mi gshor ba dang, dbu skra dri zhim pa ste dpe byad bdun ni, gtsug tor dang, spu ga-yas su 'khyil ba dang, spu gyen du phyogs pa'i mtshan gsum gyi 'khor dang\", \"english\": \"Three major signs: (S23) The top of their skull has a crown ridge. (S16) The hairs of the body spiral right. (S10) The hairs of their body point out. Seven associated marks: (M73) The shape of their head is full, like a parasol. (M74) Their hair is black as a bee's bottom. (M75) Their hair is thick. (M76) Their hair is soft. (M77) Their hair is untangled. (M78) Their hair doesn't fly out. (M79) Their hair has a delightful scent. Group #3 Signs & marks relating to the Buddha's face\"}"
      },
      {
        "id": 24431,
        "course": "GIE",
        "seq": 919,
        "acip": "[C32] SKU 'KHRIL BAG CHAGS PA DANG, SKU BYI DOR BYAS PA LTA BU DANG, SKU RIM PAR 'TSAM PA DANG, SKU GTZANG BA DANG, SKU 'JAM PA DANG, SKU DAG PA DANG, MTSAN YONGS SU RDZOGS PA DANG, SKU'I KHO LAG YANGS SHING BZANG BA DANG, SKU SHA ZHUM PA MED PA DANG, SKU SHA RGYAS PA DANG, SKU SHIN TU GRIMS PA DANG, YAN LAG RNAM PAR 'BYES PA DANG, DKU ZLUM PA DANG, DKU SKABS PHYIN PA DANG, DKU MA RNYONGS PA DANG, PHYAL PHYANG NGE BA DANG, KUN NAS BLTA NA SDUG PA DANG, KUN SPYOD GTZANG BA DANG, SKU LA SME BA DANG GNAG PAG MED PA STE DPE BYAD BCU DGU NI, SKU CHE ZHING DRANG BA DANG, BDUN MTHO BA DANG, GSER MDOG 'DRA BA DANG, PAGS BA SRAB PA DANG, DPUNG MGO ZLUM PA DANG, THAL GONG RGYAS PA DANG, RO STOD SENG GE 'DRA BA DANG, N+YA GRO TA LTAR CHU ZHENG GAB PA'I MTSAN BRGYAD KYI 'KHOR DANG,",
        "wylie": "[c32] sku 'khril bag chags pa dang, sku byi dor byas pa lta bu dang, sku rim par 'tsham pa dang, sku gtsang ba dang, sku 'jam pa dang, sku dag pa dang, mtshan yongs su rdzogs pa dang, sku'i kho lag yangs shing bzang ba dang, sku sha zhum pa med pa dang, sku sha rgyas pa dang, sku shin tu grims pa dang, yan lag rnam par 'byes pa dang, dku zlum pa dang, dku skabs phyin pa dang, dku ma rnyongs pa dang, phyal phyang nge ba dang, kun nas blta na sdug pa dang, kun spyod gtsang ba dang, sku la sme ba dang gnag pag med pa ste dpe byad bcu dgu ni, sku che zhing drang ba dang, bdun mtho ba dang, gser mdog 'dra ba dang, pags ba srab pa dang, dpung mgo zlum pa dang, thal gong rgyas pa dang, ro stod seng ge 'dra ba dang, n+ya gro ta ltar chu zheng gab pa'i mtshan brgyad kyi 'khor dang",
        "english": "Eight major signs: (S8) Their body is large, and straight. (S5) Seven parts of their body are raised [backs of two hands and two feet; two shoulders; and forehead]. (S14) Their skin has a hue like gold. (S15) Their skin is smooth. (S19) Their shoulder bones are smooth. (S20) The muscles above their shoulders are strong. (S18) Their chest resembles that of a lion. (S22) Their body is well-proportioned, like the branches of a fig tree. Nineteen associated marks: (M18) They walk with infinite grace. (M19) Their gait is stately, as though stepping while sweeping. (M20) Their gait is measured. (M21) Their entire body is clean. (M22) Their entire body is soft. (M23) Their entire body is fresh and pure. (M24) The marks on their body are perfectly formed. (M25) Their entire form is broad and magnificent. (M29) No part of their body sags. (M30) Every part of their body is healthy and strong. (M31) Their body is tight and trim. (M32) Their limbs are well-defined. (M34) The sides of their body are nicely rounded. (M35) Their waist is slender. (M36) Their stomach does not protrude. (M37) Their stomach is nicely set. (M40) They are lovely to look upon. (M41) Their behavior is pure. (M42) Their body is free of moles or spots. Group #12 Signs & marks relating to the lower abdomen of the Buddha",
        "raw": "{\"course\": \"GIE\", \"acip\": \"[C32] SKU 'KHRIL BAG CHAGS PA DANG, SKU BYI DOR BYAS PA LTA BU DANG, SKU RIM PAR 'TSAM PA DANG, SKU GTZANG BA DANG, SKU 'JAM PA DANG, SKU DAG PA DANG, MTSAN YONGS SU RDZOGS PA DANG, SKU'I KHO LAG YANGS SHING BZANG BA DANG, SKU SHA ZHUM PA MED PA DANG, SKU SHA RGYAS PA DANG, SKU SHIN TU GRIMS PA DANG, YAN LAG RNAM PAR 'BYES PA DANG, DKU ZLUM PA DANG, DKU SKABS PHYIN PA DANG, DKU MA RNYONGS PA DANG, PHYAL PHYANG NGE BA DANG, KUN NAS BLTA NA SDUG PA DANG, KUN SPYOD GTZANG BA DANG, SKU LA SME BA DANG GNAG PAG MED PA STE DPE BYAD BCU DGU NI, SKU CHE ZHING DRANG BA DANG, BDUN MTHO BA DANG, GSER MDOG 'DRA BA DANG, PAGS BA SRAB PA DANG, DPUNG MGO ZLUM PA DANG, THAL GONG RGYAS PA DANG, RO STOD SENG GE 'DRA BA DANG, N+YA GRO TA LTAR CHU ZHENG GAB PA'I MTSAN BRGYAD KYI 'KHOR DANG,\", \"wylie\": \"[c32] sku 'khril bag chags pa dang, sku byi dor byas pa lta bu dang, sku rim par 'tsham pa dang, sku gtsang ba dang, sku 'jam pa dang, sku dag pa dang, mtshan yongs su rdzogs pa dang, sku'i kho lag yangs shing bzang ba dang, sku sha zhum pa med pa dang, sku sha rgyas pa dang, sku shin tu grims pa dang, yan lag rnam par 'byes pa dang, dku zlum pa dang, dku skabs phyin pa dang, dku ma rnyongs pa dang, phyal phyang nge ba dang, kun nas blta na sdug pa dang, kun spyod gtsang ba dang, sku la sme ba dang gnag pag med pa ste dpe byad bcu dgu ni, sku che zhing drang ba dang, bdun mtho ba dang, gser mdog 'dra ba dang, pags ba srab pa dang, dpung mgo zlum pa dang, thal gong rgyas pa dang, ro stod seng ge 'dra ba dang, n+ya gro ta ltar chu zheng gab pa'i mtshan brgyad kyi 'khor dang\", \"english\": \"Eight major signs: (S8) Their body is large, and straight. (S5) Seven parts of their body are raised [backs of two hands and two feet; two shoulders; and forehead]. (S14) Their skin has a hue like gold. (S15) Their skin is smooth. (S19) Their shoulder bones are smooth. (S20) The muscles above their shoulders are strong. (S18) Their chest resembles that of a lion. (S22) Their body is well-proportioned, like the branches of a fig tree. Nineteen associated marks: (M18) They walk with infinite grace. (M19) Their gait is stately, as though stepping while sweeping. (M20) Their gait is measured. (M21) Their entire body is clean. (M22) Their entire body is soft. (M23) Their entire body is fresh and pure. (M24) The marks on their body are perfectly formed. (M25) Their entire form is broad and magnificent. (M29) No part of their body sags. (M30) Every part of their body is healthy and strong. (M31) Their body is tight and trim. (M32) Their limbs are well-defined. (M34) The sides of their body are nicely rounded. (M35) Their waist is slender. (M36) Their stomach does not protrude. (M37) Their stomach is nicely set. (M40) They are lovely to look upon. (M41) Their behavior is pure. (M42) Their body is free of moles or spots. Group #12 Signs & marks relating to the lower abdomen of the Buddha\"}"
      },
      {
        "id": 24478,
        "course": "GIE",
        "seq": 966,
        "acip": "[C79] SEMS CAN THAMS CAD LA BU GCIG PA DANG 'DRA BAR GZIGS PAS SPYAN 'BRAS BUNG BA LTAR GNAG PA DANG,",
        "wylie": "[c79] sems can thams cad la bu gcig pa dang 'dra bar gzigs pas spyan 'bras bung ba ltar gnag pa dang",
        "english": "(S31) Because our Teacher learned to look upon every living thing as if they were his only child, he gained eyes which were dark as the bottom of a bee.",
        "raw": "{\"course\": \"GIE\", \"acip\": \"[C79] SEMS CAN THAMS CAD LA BU GCIG PA DANG 'DRA BAR GZIGS PAS SPYAN 'BRAS BUNG BA LTAR GNAG PA DANG,\", \"wylie\": \"[c79] sems can thams cad la bu gcig pa dang 'dra bar gzigs pas spyan 'bras bung ba ltar gnag pa dang\", \"english\": \"(S31) Because our Teacher learned to look upon every living thing as if they were his only child, he gained eyes which were dark as the bottom of a bee.\"}"
      },
      {
        "id": 24528,
        "course": "GIE",
        "seq": 1016,
        "acip": "[C129] SKYES BU CHUNG NGU LA STONG NYID STON PA SOGS DUS MIN DU GDUL BYA GDUL BA'AM NAG PO'I CHOS STON PA NI DUS MA YIN PA'I CHOS 'DUL BA YIN LA, DE DANG BRAL BA NYID KYIS SKU LA SME BA GNAG BAG MED PA SOGS BZHI DANG,",
        "wylie": "[c129] skyes bu chung ngu la stong nyid ston pa sogs dus min du gdul bya gdul ba'am nag po'i chos ston pa ni dus ma yin pa'i chos 'dul ba yin la, de dang bral ba nyid kyis sku la sme ba gnag bag med pa sogs bzhi dang",
        "english": "(M42–M45) There is a question of timing, where for example we try to help a person reach self-control by teaching them emptiness when they have not yet developed enough to hear it—or where we give a person a teaching on dark things.  Since our Teacher is completely free of all such tendencies, his body is “free of moles or spots”—which is grouped with the next three too.",
        "raw": "{\"course\": \"GIE\", \"acip\": \"[C129] SKYES BU CHUNG NGU LA STONG NYID STON PA SOGS DUS MIN DU GDUL BYA GDUL BA'AM NAG PO'I CHOS STON PA NI DUS MA YIN PA'I CHOS 'DUL BA YIN LA, DE DANG BRAL BA NYID KYIS SKU LA SME BA GNAG BAG MED PA SOGS BZHI DANG,\", \"wylie\": \"[c129] skyes bu chung ngu la stong nyid ston pa sogs dus min du gdul bya gdul ba'am nag po'i chos ston pa ni dus ma yin pa'i chos 'dul ba yin la, de dang bral ba nyid kyis sku la sme ba gnag bag med pa sogs bzhi dang\", \"english\": \"(M42–M45) There is a question of timing, where for example we try to help a person reach self-control by teaching them emptiness when they have not yet developed enough to hear it—or where we give a person a teaching on dark things.  Since our Teacher is completely free of all such tendencies, his body is “free of moles or spots”—which is grouped with the next three too.\"}"
      },
      {
        "id": 28826,
        "course": "ILL",
        "seq": 1507,
        "acip": "MI SHES PA'I GNYID KYIS YID RAB TU BSKYOD PA'I MU STEGS CAN YID LA PHYIN CI LOG GI GRUB MTHA' NGAN PA DANG, GTAN TSIGS LTAR SNANG GI GNOD PA YOD PA 'DI DAG NI, DE KHO NA NYID LA 'JUG PAR 'DOD PAS SKYE BO MA BYANG BA GNAG RDZI DANG BUD MED LA SOGS PA YAN CHAD LA GRAGS PA'I SKYE BA DANG, 'JIG PA LA SOGS PA PHYIN CI MA LOG PA MA BZUNG BAR, 'JIG RTEN PA RNAMS LAS PHUL DU BYUNG BAR 'GRO BAR 'DOD PAS,",
        "wylie": "mi shes pa'i gnyid kyis yid rab tu bskyod pa'i mu stegs can yid la phyin ci log gi grub mtha' ngan pa dang, gtan tshigs ltar snang gi gnod pa yod pa 'di dag ni, de kho na nyid la 'jug par 'dod pas skye bo ma byang ba gnag rdzi dang bud med la sogs pa yan chad la grags pa'i skye ba dang, 'jig pa la sogs pa phyin ci ma log pa ma bzung bar, 'jig rten pa rnams las phul du byung bar 'gro bar 'dod pas",
        "english": "Consider now those of lower views, whose minds are inspired by the sleep of misunderstanding—those with minds adversely affected by mistaken, undesirable schools of thought, or false forms of logic. They wish to rise above the everyday world: they hope to engage in the way things really are. But they want to do so without recognizing things like starting & stopping—in the way these are understood among those who have not applied themselves formally to philosophy, beginning for example from cowherds or women—as being unmistaken.",
        "raw": "{\"course\": \"ILL\", \"acip\": \"MI SHES PA'I GNYID KYIS YID RAB TU BSKYOD PA'I MU STEGS CAN YID LA PHYIN CI LOG GI GRUB MTHA' NGAN PA DANG, GTAN TSIGS LTAR SNANG GI GNOD PA YOD PA 'DI DAG NI, DE KHO NA NYID LA 'JUG PAR 'DOD PAS SKYE BO MA BYANG BA GNAG RDZI DANG BUD MED LA SOGS PA YAN CHAD LA GRAGS PA'I SKYE BA DANG, 'JIG PA LA SOGS PA PHYIN CI MA LOG PA MA BZUNG BAR, 'JIG RTEN PA RNAMS LAS PHUL DU BYUNG BAR 'GRO BAR 'DOD PAS,\", \"wylie\": \"mi shes pa'i gnyid kyis yid rab tu bskyod pa'i mu stegs can yid la phyin ci log gi grub mtha' ngan pa dang, gtan tshigs ltar snang gi gnod pa yod pa 'di dag ni, de kho na nyid la 'jug par 'dod pas skye bo ma byang ba gnag rdzi dang bud med la sogs pa yan chad la grags pa'i skye ba dang, 'jig pa la sogs pa phyin ci ma log pa ma bzung bar, 'jig rten pa rnams las phul du byung bar 'gro bar 'dod pas\", \"english\": \"Consider now those of lower views, whose minds are inspired by the sleep of misunderstanding—those with minds adversely affected by mistaken, undesirable schools of thought, or false forms of logic. They wish to rise above the everyday world: they hope to engage in the way things really are. But they want to do so without recognizing things like starting & stopping—in the way these are understood among those who have not applied themselves formally to philosophy, beginning for example from cowherds or women—as being unmistaken.\"}"
      },
      {
        "id": 30718,
        "course": "ILL",
        "seq": 3399,
        "acip": ",BDAG NI GZUGS LDAN MI 'DOD GANG PHYIR BDAG, ,YOD MIN DE PHYIR LDAN DON SBYOR BA MED, ,GZHAN NA GNAG LDAN GZHAN MIN GZUGS LDAN NA, ,BDAG NI GZUGS LAS DE NYID GZHAN NYID MED,",
        "wylie": "bdag ni gzugs ldan mi 'dod gang phyir bdag, ,yod min de phyir ldan don sbyor ba med, ,gzhan na gnag ldan gzhan min gzugs ldan na, ,bdag ni gzugs las de nyid gzhan nyid med",
        "english": "We do not accept That the self is something That could possess form; Why we say so Is that there is no Possibility of the self; Therefore the point of The connection possessed By them is not something That could exist. Suppose it were To something being other: “He is possessed of a blackie.” Suppose he was possessed Of a physical form where There was no separate thing. The relationship of the self To the form is neither the same; Nor are they essentially different.",
        "raw": "{\"course\": \"ILL\", \"acip\": \",BDAG NI GZUGS LDAN MI 'DOD GANG PHYIR BDAG, ,YOD MIN DE PHYIR LDAN DON SBYOR BA MED, ,GZHAN NA GNAG LDAN GZHAN MIN GZUGS LDAN NA, ,BDAG NI GZUGS LAS DE NYID GZHAN NYID MED,\", \"wylie\": \"bdag ni gzugs ldan mi 'dod gang phyir bdag, ,yod min de phyir ldan don sbyor ba med, ,gzhan na gnag ldan gzhan min gzugs ldan na, ,bdag ni gzugs las de nyid gzhan nyid med\", \"english\": \"We do not accept That the self is something That could possess form; Why we say so Is that there is no Possibility of the self; Therefore the point of The connection possessed By them is not something That could exist. Suppose it were To something being other: “He is possessed of a blackie.” Suppose he was possessed Of a physical form where There was no separate thing. The relationship of the self To the form is neither the same; Nor are they essentially different.\"}"
      },
      {
        "id": 30721,
        "course": "ILL",
        "seq": 3402,
        "acip": "'DI LTAR LDAN PA'I RKYEN YANG LHA SBYIN GNAG STE BA LANG DANG LDAN NO ZHES PA LTA BU NI, GZHAN NA STE NGO BO THA DAD PA LA SBYOR LA,",
        "wylie": "'di ltar ldan pa'i rkyen yang lha sbyin gnag ste ba lang dang ldan no zhes pa lta bu ni, gzhan na ste ngo bo tha dad pa la sbyor la",
        "english": "The fact that we could have this kind of factor here is something similar to the way in which we say that “John is possessed of a blackie” (referring to a kind of dark-colored cow). Which is to say, suppose we made the reference here to something being other, or essentially separate.",
        "raw": "{\"course\": \"ILL\", \"acip\": \"'DI LTAR LDAN PA'I RKYEN YANG LHA SBYIN GNAG STE BA LANG DANG LDAN NO ZHES PA LTA BU NI, GZHAN NA STE NGO BO THA DAD PA LA SBYOR LA,\", \"wylie\": \"'di ltar ldan pa'i rkyen yang lha sbyin gnag ste ba lang dang ldan no zhes pa lta bu ni, gzhan na ste ngo bo tha dad pa la sbyor la\", \"english\": \"The fact that we could have this kind of factor here is something similar to the way in which we say that “John is possessed of a blackie” (referring to a kind of dark-colored cow). Which is to say, suppose we made the reference here to something being other, or essentially separate.\"}"
      },
      {
        "id": 31787,
        "course": "ILL",
        "seq": 4468,
        "acip": "DBU MA LA 'JUG PA 'DI SBYAR BA YIN NO ZHES BSHAD PA 'PHAGS PA KLU SGRUB KYI ZAB MO RTOGS PA'I BLO'I RGYA MTSO SHIN TU RGYA CHE LA GTING DPAG PAR DKA' BA'I NGAM GNAG PA'I KHA DOG GIS 'JIGS PAS,",
        "wylie": "dbu ma la 'jug pa 'di sbyar ba yin no zhes bshad pa 'phags pa klu sgrub kyi zab mo rtogs pa'i blo'i rgya mtsho shin tu rgya che la gting dpag par dka' ba'i ngam gnag pa'i kha dog gis 'jigs pas",
        "english": "The fact is that people became frightened when they heard someone say, “I will now compose Entering the Middle Way”—frightened simply when they saw the shade of the ebony abyss of depths so impossible to fathom, within the vast expanse of the ocean of that mind which could plumb the deeps of Arya Nagarjuna.",
        "raw": "{\"course\": \"ILL\", \"acip\": \"DBU MA LA 'JUG PA 'DI SBYAR BA YIN NO ZHES BSHAD PA 'PHAGS PA KLU SGRUB KYI ZAB MO RTOGS PA'I BLO'I RGYA MTSO SHIN TU RGYA CHE LA GTING DPAG PAR DKA' BA'I NGAM GNAG PA'I KHA DOG GIS 'JIGS PAS,\", \"wylie\": \"dbu ma la 'jug pa 'di sbyar ba yin no zhes bshad pa 'phags pa klu sgrub kyi zab mo rtogs pa'i blo'i rgya mtsho shin tu rgya che la gting dpag par dka' ba'i ngam gnag pa'i kha dog gis 'jigs pas\", \"english\": \"The fact is that people became frightened when they heard someone say, “I will now compose Entering the Middle Way”—frightened simply when they saw the shade of the ebony abyss of depths so impossible to fathom, within the vast expanse of the ocean of that mind which could plumb the deeps of Arya Nagarjuna.\"}"
      },
      {
        "id": 31806,
        "course": "ILL",
        "seq": 4487,
        "acip": "YID KYI NAM MKHA' NYON MONGS PA'I TSOGS KYIS SNGO ZHING GNAG PAR BYAS PA'I DKYIL DU, STON KA'I RGYU SKAR LTAR SHIN TU DKAR BA'AM,",
        "wylie": "yid kyi nam mkha' nyon mongs pa'i tshogs kyis sngo zhing gnag par byas pa'i dkyil du, ston ka'i rgyu skar ltar shin tu dkar ba'am",
        "english": "The sky of my mind, thus far, had been sent into the gloom—darkened—by an entire mass of everything related to the negative emotions. But now, in the midst of that obscuration, something has come, shining in bright white light like a major star in the autumn heavens.",
        "raw": "{\"course\": \"ILL\", \"acip\": \"YID KYI NAM MKHA' NYON MONGS PA'I TSOGS KYIS SNGO ZHING GNAG PAR BYAS PA'I DKYIL DU, STON KA'I RGYU SKAR LTAR SHIN TU DKAR BA'AM,\", \"wylie\": \"yid kyi nam mkha' nyon mongs pa'i tshogs kyis sngo zhing gnag par byas pa'i dkyil du, ston ka'i rgyu skar ltar shin tu dkar ba'am\", \"english\": \"The sky of my mind, thus far, had been sent into the gloom—darkened—by an entire mass of everything related to the negative emotions. But now, in the midst of that obscuration, something has come, shining in bright white light like a major star in the autumn heavens.\"}"
      },
      {
        "id": 15342,
        "course": "TCS10",
        "seq": 543,
        "acip": "DBU SKRA NAG PO SIL BUR 'PHYANG BAS BDAG 'DZIN GYI MDUD PA GROL BAR MTSON, DBU SKRA STANG ZIL DANG BUNG BA LTAR GNAG CES PA'I STANG ZIL NI DNGUL RDO BCAG PA LTAR DANG, BUNG BA NI RGYA NAG NAS THON PA'I RDO GNAG LA SNUM PA ZHIG YIN GSUNGS,",
        "wylie": "dbu skra nag po sil bur 'phyang bas bdag 'dzin gyi mdud pa grol bar mtshon, dbu skra stang zil dang bung ba ltar gnag ces pa'i stang zil ni dngul rdo bcag pa ltar dang, bung ba ni rgya nag nas thon pa'i rdo gnag la snum pa zhig yin gsungs",
        "english": "Her holy hair is black, and it hangs down, flowing free.  This represents that She has succeeded in freeing the knots of grasping to a self nature in things.  Our Lama spoke a bit here about the expression \"holy hair black as the tangsil, black as bungwa.\"  He said that tangsil is a mineral that resembles a broken-open piece of what we in Tibet call \"silver-stone.\"  Bungwa, He said, is a kind of rock that comes from China; it is pitch black and has a sheen to it.",
        "raw": "{\"course\": \"TCS10\", \"acip\": \"DBU SKRA NAG PO SIL BUR 'PHYANG BAS BDAG 'DZIN GYI MDUD PA GROL BAR MTSON, DBU SKRA STANG ZIL DANG BUNG BA LTAR GNAG CES PA'I STANG ZIL NI DNGUL RDO BCAG PA LTAR DANG, BUNG BA NI RGYA NAG NAS THON PA'I RDO GNAG LA SNUM PA ZHIG YIN GSUNGS,\", \"wylie\": \"dbu skra nag po sil bur 'phyang bas bdag 'dzin gyi mdud pa grol bar mtshon, dbu skra stang zil dang bung ba ltar gnag ces pa'i stang zil ni dngul rdo bcag pa ltar dang, bung ba ni rgya nag nas thon pa'i rdo gnag la snum pa zhig yin gsungs\", \"english\": \"Her holy hair is black, and it hangs down, flowing free.  This represents that She has succeeded in freeing the knots of grasping to a self nature in things.  Our Lama spoke a bit here about the expression \\\"holy hair black as the tangsil, black as bungwa.\\\"  He said that tangsil is a mineral that resembles a broken-open piece of what we in Tibet call \\\"silver-stone.\\\"  Bungwa, He said, is a kind of rock that comes from China; it is pitch black and has a sheen to it.\"}"
      },
      {
        "id": 15377,
        "course": "TCS10",
        "seq": 578,
        "acip": "BUNG BA LTAR GNAG PA NI CHOS DBYINGS STONG PA NYID DU RO GCIG PA MTSON, BUNG BA NI RGYA SOG YUL NAS THON YONG BA'I RDO GNAG CING SNUM PA ZHIG YOD PAR GRAGS SHING, RGYAL BA LNGA PAS STANG ZIL BCAG PA'I DUM BU LTAR GNAG PA ZHES PA DNGUL RDO YIN PAR GSUNG,",
        "wylie": "bung ba ltar gnag pa ni chos dbyings stong pa nyid du ro gcig pa mtshon, bung ba ni rgya sog yul nas thon yong ba'i rdo gnag cing snum pa zhig yod par grags shing, rgyal ba lnga pas stang zil bcag pa'i dum bu ltar gnag pa zhes pa dngul rdo yin par gsung",
        "english": "Her hair is \"black as the bungwa.\"  This represents the realm of all things: the fact that all things are one in the realm of emptiness.  It is said that the bungwa is a very black and shiny stone that comes from China or Mongolia.  The Great Fifth Dalai Lama has noted that it has also been described \"black as a piece broken from a tangsil stone,\" which He says refers to the silverstone.",
        "raw": "{\"course\": \"TCS10\", \"acip\": \"BUNG BA LTAR GNAG PA NI CHOS DBYINGS STONG PA NYID DU RO GCIG PA MTSON, BUNG BA NI RGYA SOG YUL NAS THON YONG BA'I RDO GNAG CING SNUM PA ZHIG YOD PAR GRAGS SHING, RGYAL BA LNGA PAS STANG ZIL BCAG PA'I DUM BU LTAR GNAG PA ZHES PA DNGUL RDO YIN PAR GSUNG,\", \"wylie\": \"bung ba ltar gnag pa ni chos dbyings stong pa nyid du ro gcig pa mtshon, bung ba ni rgya sog yul nas thon yong ba'i rdo gnag cing snum pa zhig yod par grags shing, rgyal ba lnga pas stang zil bcag pa'i dum bu ltar gnag pa zhes pa dngul rdo yin par gsung\", \"english\": \"Her hair is \\\"black as the bungwa.\\\"  This represents the realm of all things: the fact that all things are one in the realm of emptiness.  It is said that the bungwa is a very black and shiny stone that comes from China or Mongolia.  The Great Fifth Dalai Lama has noted that it has also been described \\\"black as a piece broken from a tangsil stone,\\\" which He says refers to the silverstone.\"}"
      },
      {
        "id": 19214,
        "course": "TCS16KaliWang",
        "seq": 433,
        "acip": "ME CHU LJON SHING, CE SPYANG DANG, LTAS NGAN GYI BYA SNA TSOGS SKAD SGROG PA, 'BYUNG PO DANG SRIN PO SNA TSOGS RGYU ZHING STENG NAS CHAR SPRIN GNAG PAR GLOG 'KHYUG THOG SER 'BEBS PA,",
        "wylie": "me chu ljon shing, ce spyang dang, ltas ngan gyi bya sna tshogs skad sgrog pa, 'byung po dang srin po sna tshogs rgyu zhing steng nas char sprin gnag par glog 'khyug thog ser 'bebs pa",
        "english": "Trees feed on waters of fire; Wolves roam vicious, And even the birds Sing in curses. Crowds of demons And evil spirits speed aimlessly Here and then there; Bolts of lightning And sheets of hailstone Crash from a sky spread In blackest of clouds.",
        "raw": "{\"course\": \"TCS16KaliWang\", \"acip\": \"ME CHU LJON SHING, CE SPYANG DANG, LTAS NGAN GYI BYA SNA TSOGS SKAD SGROG PA, 'BYUNG PO DANG SRIN PO SNA TSOGS RGYU ZHING STENG NAS CHAR SPRIN GNAG PAR GLOG 'KHYUG THOG SER 'BEBS PA,\", \"wylie\": \"me chu ljon shing, ce spyang dang, ltas ngan gyi bya sna tshogs skad sgrog pa, 'byung po dang srin po sna tshogs rgyu zhing steng nas char sprin gnag par glog 'khyug thog ser 'bebs pa\", \"english\": \"Trees feed on waters of fire; Wolves roam vicious, And even the birds Sing in curses. Crowds of demons And evil spirits speed aimlessly Here and then there; Bolts of lightning And sheets of hailstone Crash from a sky spread In blackest of clouds.\", \"repair_wave\": \"tcs2-v25-1\"}"
      },
      {
        "id": 19244,
        "course": "TCS16KaliWang",
        "seq": 463,
        "acip": "ME CHU LJON SHING, CE SPYANG DANG, LTAS NGAN GYI BYA SNA TSOGS SKAD SGROG PA, 'BYUNG PO DANG SRIN PO SNA TSOGS RGYU ZHING STENG NAS CHAR SPRIN GNAG PAR GLOG 'KHYUG THOG SER 'BEBS PA,",
        "wylie": "me chu ljon shing, ce spyang dang, ltas ngan gyi bya sna tshogs skad sgrog pa, 'byung po dang srin po sna tshogs rgyu zhing steng nas char sprin gnag par glog 'khyug thog ser 'bebs pa",
        "english": "Trees feed on waters of fire; Wolves roam vicious, And even the birds Sing in curses. Crowds of demons And evil spirits speed aimlessly Here and then there; Bolts of lightning And sheets of hailstone Crash from a sky spread In blackest of clouds.",
        "raw": "{\"course\": \"TCS16KaliWang\", \"acip\": \"ME CHU LJON SHING, CE SPYANG DANG, LTAS NGAN GYI BYA SNA TSOGS SKAD SGROG PA, 'BYUNG PO DANG SRIN PO SNA TSOGS RGYU ZHING STENG NAS CHAR SPRIN GNAG PAR GLOG 'KHYUG THOG SER 'BEBS PA,\", \"wylie\": \"me chu ljon shing, ce spyang dang, ltas ngan gyi bya sna tshogs skad sgrog pa, 'byung po dang srin po sna tshogs rgyu zhing steng nas char sprin gnag par glog 'khyug thog ser 'bebs pa\", \"english\": \"Trees feed on waters of fire; Wolves roam vicious, And even the birds Sing in curses. Crowds of demons And evil spirits speed aimlessly Here and then there; Bolts of lightning And sheets of hailstone Crash from a sky spread In blackest of clouds.\", \"repair_wave\": \"tcs2-v25-1\"}"
      },
      {
        "id": 20633,
        "course": "TCS17",
        "seq": 771,
        "acip": "SNANG BA GSUM GYI DUS SU SNANG NGOR DKAR, DMAR, GNAG PA'I SNANG BA 'BYUNG YANG, NGES NGOR SNANG BA DE YANG BKAG NAS STONG NYID 'DZIN STANGS KYI YUL DU BYAS TE, RTZE GCIG TU SGOM PAR BYED PA YIN NO,,",
        "wylie": "snang ba gsum gyi dus su snang ngor dkar, dmar, gnag pa'i snang ba 'byung yang, nges ngor snang ba de yang bkag nas stong nyid 'dzin stangs kyi yul du byas te, rtse gcig tu sgom par byed pa yin no",
        "english": "At the point where we go through the three visions, what appears to our perceptions are visions of whiteness, redness, and blackness.  When we have stopped these visions from appearing to our perceptions, then we take emptiness as the object as we take it to be.  And then we remain in single-pointed meditation upon it.",
        "raw": "{\"course\": \"TCS17\", \"acip\": \"SNANG BA GSUM GYI DUS SU SNANG NGOR DKAR, DMAR, GNAG PA'I SNANG BA 'BYUNG YANG, NGES NGOR SNANG BA DE YANG BKAG NAS STONG NYID 'DZIN STANGS KYI YUL DU BYAS TE, RTZE GCIG TU SGOM PAR BYED PA YIN NO,,\", \"wylie\": \"snang ba gsum gyi dus su snang ngor dkar, dmar, gnag pa'i snang ba 'byung yang, nges ngor snang ba de yang bkag nas stong nyid 'dzin stangs kyi yul du byas te, rtse gcig tu sgom par byed pa yin no\", \"english\": \"At the point where we go through the three visions, what appears to our perceptions are visions of whiteness, redness, and blackness.  When we have stopped these visions from appearing to our perceptions, then we take emptiness as the object as we take it to be.  And then we remain in single-pointed meditation upon it.\"}"
      },
      {
        "id": 20874,
        "course": "TCS17",
        "seq": 1012,
        "acip": ",PADMA CAN NI MDOG DKAR PADMA'I DRI, ,PAD 'DAB BZHIN DU DKYUS RING MDZES PA'I MIG ,MGRIN PA RING ZHING SKRA NI GNAG LA SNUM, ,NU MA TA LA'I 'BRAS 'DRA BZHIN RAS RGYAS,",
        "wylie": "padma can ni mdog dkar padma'i dri, ,pad 'dab bzhin du dkyus ring mdzes pa'i mig ,mgrin pa ring zhing skra ni gnag la snum, ,nu ma ta la'i 'bras 'dra bzhin ras rgyas",
        "english": "A Lady of the Lotus has a body Of ivory white, and the fragrance of a lotus. Her eyes are lovely, long like lotus petals. Her neck is long as well, and Her hair Is deep black with a shining luster. Her breasts are full, like dates from the palm.",
        "raw": "{\"course\": \"TCS17\", \"acip\": \",PADMA CAN NI MDOG DKAR PADMA'I DRI, ,PAD 'DAB BZHIN DU DKYUS RING MDZES PA'I MIG ,MGRIN PA RING ZHING SKRA NI GNAG LA SNUM, ,NU MA TA LA'I 'BRAS 'DRA BZHIN RAS RGYAS,\", \"wylie\": \"padma can ni mdog dkar padma'i dri, ,pad 'dab bzhin du dkyus ring mdzes pa'i mig ,mgrin pa ring zhing skra ni gnag la snum, ,nu ma ta la'i 'bras 'dra bzhin ras rgyas\", \"english\": \"A Lady of the Lotus has a body Of ivory white, and the fragrance of a lotus. Her eyes are lovely, long like lotus petals. Her neck is long as well, and Her hair Is deep black with a shining luster. Her breasts are full, like dates from the palm.\"}"
      },
      {
        "id": 21191,
        "course": "TCS17",
        "seq": 1329,
        "acip": "BDE PA CHES NA GA-YON DU 'KHOR BAR BSAM MO, 'KHOR BA DRAG NA 'DZAG PA'I NYEN YOD DO, ,'DI BRTAN PAR BSGOMS NA PHYIS PHO NYA'I LAM BSGOM PA LA NI THOGS PA MED DO, ,'DI NI PHO NYA'I LAM DNGOS MA YIN TE, ,DE'I PHYOGS SU GTOGS PA'I GDAMS GNAG YIN NO,,",
        "wylie": "bde pa ches na ga-yon du 'khor bar bsam mo, 'khor ba drag na 'dzag pa'i nyen yod do, ,'di brtan par bsgoms na phyis pho nya'i lam bsgom pa la ni thogs pa med do, ,'di ni pho nya'i lam dngos ma yin te, ,de'i phyogs su gtogs pa'i gdams gnag yin no",
        "english": "If you want greater bliss, then imagine that it is being turned to the left.  If the turning is too strong, there's a risk that it will spill out.  If you do this meditation until it's strong, then later on it will be a breeze when you practice the path of the Messenger.  This practice itself though is not the actual path of the Messenger; rather, it is only a related instruction.",
        "raw": "{\"course\": \"TCS17\", \"acip\": \"BDE PA CHES NA GA-YON DU 'KHOR BAR BSAM MO, 'KHOR BA DRAG NA 'DZAG PA'I NYEN YOD DO, ,'DI BRTAN PAR BSGOMS NA PHYIS PHO NYA'I LAM BSGOM PA LA NI THOGS PA MED DO, ,'DI NI PHO NYA'I LAM DNGOS MA YIN TE, ,DE'I PHYOGS SU GTOGS PA'I GDAMS GNAG YIN NO,,\", \"wylie\": \"bde pa ches na ga-yon du 'khor bar bsam mo, 'khor ba drag na 'dzag pa'i nyen yod do, ,'di brtan par bsgoms na phyis pho nya'i lam bsgom pa la ni thogs pa med do, ,'di ni pho nya'i lam dngos ma yin te, ,de'i phyogs su gtogs pa'i gdams gnag yin no\", \"english\": \"If you want greater bliss, then imagine that it is being turned to the left.  If the turning is too strong, there's a risk that it will spill out.  If you do this meditation until it's strong, then later on it will be a breeze when you practice the path of the Messenger.  This practice itself though is not the actual path of the Messenger; rather, it is only a related instruction.\"}"
      }
    ]
  }
]

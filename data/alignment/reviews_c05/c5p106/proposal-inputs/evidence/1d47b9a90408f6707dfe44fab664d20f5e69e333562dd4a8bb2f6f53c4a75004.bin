      {
        "id": 36305,
        "course": "OSE",
        "seq": 277,
        "acip": "CES SANGS RGYAS BCOM LDAN 'DAS 'JIG RTEN THAMS CAD KYI MA 'DRES {%'DRIS} PA'I MDZA' BSHES CHEN PO STON PA BLA NA MED PA LA, ZAB MO RTEN CING 'BREL PAR 'BYUNG BA GSUNG PA'I SGO NAS BSTOD PA LEGS PAR BSHAD PA'I SNYING PO ZHES BYA BA 'DI NI,",
        "wylie": "ces sangs rgyas bcom ldan 'das 'jig rten thams cad kyi ma 'dres pa'i mdza' bshes chen po ston pa bla na med pa la, zab mo rten cing 'brel par 'byung ba gsung pa'i sgo nas bstod pa legs par bshad pa'i snying po zhes bya ba 'di ni",
        "english": "Lord Buddha, the Conquering One, is the matchless Teacher: that one dear friend which all beings in every world possess, without even realizing it. And here I have offered a work entitled \"The Essence of Eloquence,\" a praise to our Friend for his having described the deep truth about how events occur in a process of dependence and connection.",
        "raw": "{\"acip\": \"CES SANGS RGYAS BCOM LDAN 'DAS 'JIG RTEN THAMS CAD KYI MA 'DRES {%'DRIS} PA'I MDZA' BSHES CHEN PO STON PA BLA NA MED PA LA, ZAB MO RTEN CING 'BREL PAR 'BYUNG BA GSUNG PA'I SGO NAS BSTOD PA LEGS PAR BSHAD PA'I SNYING PO ZHES BYA BA 'DI NI,\", \"wylie\": \"ces sangs rgyas bcom ldan 'das 'jig rten thams cad kyi ma 'dres pa'i mdza' bshes chen po ston pa bla na med pa la, zab mo rten cing 'brel par 'byung ba gsung pa'i sgo nas bstod pa legs par bshad pa'i snying po zhes bya ba 'di ni\", \"english\": \"Lord Buddha, the Conquering One, is the matchless Teacher: that one dear friend which all beings in every world possess, without even realizing it. And here I have offered a work entitled \\\"The Essence of Eloquence,\\\" a praise to our Friend for his having described the deep truth about how events occur in a process of dependence and connection.\", \"course\": \"OSE\", \"source_wave\": \"gmr-volumes-2026-08\"}"
      }

def hits(text,part,member=False):
 out=[];start=0
 while True:
  i=text.find(part,start)
  if i<0:break
  j=i+len(part)
  word=lambda c: bool(re.match(r'[A-Za-z0-9\u0f00-\u0fff]',c))
  if member or ((not word(part[0]) or i==0 or not word(text[i-1])) and (not word(part[-1]) or j==len(text) or not word(text[j]))):out.append([i,j])
  start=i+1
 return out
for seq,draft in drafts.items():
 row=source[seq];spans=[];dec=[];cursor=0;parent=None
 for n,(tib,eng,d,occ,reason) in enumerate(draft,1):
  ident=f'w{n}' if d==5 else f'm{n}' if d==7 else f'p{n}'
  span=dict(id=ident,d=d,tib=tib,eng=eng);spans.append(span)
  th=hits(row['wylie'],tib,member=d==7)
  if d==7:
   valid=[x for x in th if parent['tib_range'][0]<=x[0] and x[1]<=parent['tib_range'][1]];assert len(valid)==1,(seq,ident,valid);tr=valid[0]
   eh=[x for x in hits(row['english'],eng,True) if parent['eng_range'][0]<=x[0] and x[1]<=parent['eng_range'][1]];assert len(eh)==1;(er,)=eh
  else:
   valid=[x for x in th if x[0]>=cursor];assert valid,(seq,ident,tib,cursor);tr=valid[0];cursor=tr[1]
   eh=hits(row['english'],eng);er=eh[occ-1]
  item=dict(id=ident,d=d,tib=tib,eng=eng,tib_range=tr,eng_range=er,english_occurrence_in_full_row=occ if d!=7 else None,all_english_occurrences=hits(row['english'],eng,member=d==7),parent=parent['id'] if d==7 else None,reason=reason)
  dec.append(item)
  if d==5:parent=item
 for a,b in zip([x for x in dec if x['d']!=7],[x for x in dec if x['d']!=7][1:]):assert a['tib_range'][1]<=b['tib_range'][0]
 ordered=sorted([x for x in dec if x['d']!=7],key=lambda x:x['eng_range'][0])
 for a,b in zip(ordered,ordered[1:]):assert a['eng_range'][1]<=b['eng_range'][0],(seq,a,b)
 note='PROVISIONAL machine alignment by Codex, independent English-first proposal. GMR English and source Wylie are preserved verbatim; no alignment is promoted to hgm_gloss. '+ ' '.join(x['reason'] for x in omissions[seq])
 seg=dict(seq=seq,title={316:'black white and unstained deeds',317:'black deeds and their results',318:'white deeds and unmixed results'}[seq],spans=spans,eng_order=[x['id'] for x in ordered],note=note)
 put(P/str(seq)/'spec.json',dict(course='C05',segments=[seg]))
 def gaps(field,ranges):
  out=[];cur=0
  for lo,hi in sorted(ranges):
   if lo>cur:out.append(dict(range=[cur,lo],text=row[field][cur:lo]))
   cur=max(cur,hi)
  if cur<len(row[field]):out.append(dict(range=[cur,len(row[field])],text=row[field][cur:]))
  return out
 put(P/str(seq)/'decisions.json',dict(angle='English-first',status='independent provisional proposal, not semantic acceptance',spans=dec,omissions=omissions[seq],complete_unwrapped_ranges={field:gaps(field,[x[key] for x in dec if x['d']!=7]) for field,key in [('wylie','tib_range'),('english','eng_range')]}))
 put(P/str(seq)/'source.json',row)
 put(P/str(seq)/'errata.json',[])
 print(json.dumps(dict(seq=seq,spans=len(spans),nulls=0,word_pairs=sum(x['d']==5 for x in spans),members=sum(x['d']==7 for x in spans))))

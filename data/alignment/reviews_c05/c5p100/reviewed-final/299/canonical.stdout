span class="u" data-d="3" data-l="s299w33">snang gzhir gyur pa&#x27;i</span> <span class="u" data-d="5" data-l="s299w34"><span class="u" data-d="7" data-l="s299w35">rnag</span> <span class="u" data-d="7" data-l="s299w36">khrag</span></span> <span class="u" data-d="5" data-l="s299w37">med</span> kyang , <span class="u" data-d="5" data-l="s299w38"><span class="u" data-d="7" data-l="s299w39">rnag</span> <span class="u" data-d="7" data-l="s299w40">khrag</span></span> tu <span class="u" data-d="5" data-l="s299w41">snang ba</span>&#x27;i <span class="u" data-d="5" data-l="s299w42">snang ba</span> <span class="u" data-d="6" data-l="s299w43">tsam</span> gyis <span class="u" data-d="5" data-l="s299w44"><span class="u" data-d="7" data-l="s299w45">bza&#x27;</span> <span class="u" data-d="7" data-l="s299w46">btung</span></span> gi <span class="u" data-d="5" data-l="s299w47">bya ba</span> <span class="u" data-d="5" data-l="s299w48">byed</span> <span class="u" data-d="5" data-l="s299w49">nus pa</span>&#x27;i <span class="u" data-d="6" data-l="s299w50">phyir</span></span>

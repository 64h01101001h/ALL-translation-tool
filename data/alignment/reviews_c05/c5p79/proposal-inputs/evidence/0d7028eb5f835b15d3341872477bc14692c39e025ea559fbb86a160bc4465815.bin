><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00AD6664"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>In a body of water—</w:t></w:r></w:p><w:p w14:paraId="1DE2EEDD" w14:textId="77777777" w:rsidR="00AD6664" w:rsidRPr="00AD6664" w:rsidRDefault="00AD6664" w:rsidP="00AD6664"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00AD6664"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And do not exist purely,</w:t></w:r></w:p><w:p w14:paraId="25F25301" w14:textId="77777777" w:rsidR="00AD6664" w:rsidRPr="00AD6664" w:rsidRDefault="00AD6664" w:rsidP="00AD6664"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00AD6664"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Neither having stopped—</w:t></w:r></w:p><w:p w14:paraId="5C67021D" w14:textId="77777777" w:rsidR="00AD6664" w:rsidRPr="00AD6664" w:rsidRDefault="00AD6664" w:rsidP="00AD6664"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00AD6664"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Are never stolen away</w:t></w:r></w:p><w:p w14:paraId="76C8E793" w14:textId="77777777" w:rsidR="00AD6664" w:rsidRPr="00AD6664" w:rsidRDefault="00AD6664" w:rsidP="00AD6664"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi
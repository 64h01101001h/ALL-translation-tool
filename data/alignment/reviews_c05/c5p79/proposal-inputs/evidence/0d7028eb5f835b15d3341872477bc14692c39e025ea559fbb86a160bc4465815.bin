ino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>At the beginning—</w:t></w:r></w:p><w:p w14:paraId="6483CD8D" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For those who seek suchness.</w:t></w:r></w:p><w:p w14:paraId="2F717869" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2F2513FC" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those who understand these things,</w:t></w:r></w:p><w:p w14:paraId="3C7C7B18" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And who are free of attachment,</w:t></w:r></w:p><w:p w14:paraId="0E8B2BAD" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Are candidates,</w:t></w:r></w:p><w:p w14:paraId="0C174B2A" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>At some later point,</w:t></w:r></w:p><w:p w14:paraId="74AB5063" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For sheer absence.</w:t></w:r></w:p><w:p w14:paraId="6B37E6C4" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRPr="002427B7" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5A9CD055" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRPr="002427B7" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="305FD91A" w14:textId="5225A87D" w:rsidR="00325DCD" w:rsidRDefault="00325DCD" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lan
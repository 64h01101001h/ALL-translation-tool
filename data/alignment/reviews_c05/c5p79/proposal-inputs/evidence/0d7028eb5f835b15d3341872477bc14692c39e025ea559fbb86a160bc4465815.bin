><w:t>[original Sanskrit unavailable]</w:t></w:r></w:p><w:p w14:paraId="6ECED210" w14:textId="77777777" w:rsidR="00084B23" w:rsidRPr="002427B7" w:rsidRDefault="00084B23" w:rsidP="00084B23"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0F5DA90D" w14:textId="77777777" w:rsidR="00084B23" w:rsidRPr="002427B7" w:rsidRDefault="00084B23" w:rsidP="00084B23"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>RIGS PA GANG GIS YOD NYID KYANG,</w:t></w:r></w:p><w:p w14:paraId="172B0728" w14:textId="1AC79C9A" w:rsidR="00084B23" w:rsidRPr="00F06A5B" w:rsidRDefault="00084B23" w:rsidP="00084B23"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">LDOG PAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>GYUR BA MNYAN PAR GYIS,</w:t></w:r></w:p><w:p w14:paraId="68BE3C2E" w14:textId="77777777" w:rsidR="00084B23" w:rsidRPr="00F06A5B" w:rsidRDefault="00084B23" w:rsidP="00084B23"><w:pPr><w:pStyle w:v
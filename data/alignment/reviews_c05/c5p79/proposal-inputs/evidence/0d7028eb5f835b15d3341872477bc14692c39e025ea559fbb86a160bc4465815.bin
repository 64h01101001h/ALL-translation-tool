AAACEAtoM4&#xD;&#xA;kv4AAADhAQAAEwAAAAAAAAAAAAAAAAAAAAAAW0NvbnRlbnRfVHlwZXNdLnhtbFBLAQItABQABgAI&#xD;&#xA;AAAAIQA4/SH/1gAAAJQBAAALAAAAAAAAAAAAAAAAAC8BAABfcmVscy8ucmVsc1BLAQItABQABgAI&#xD;&#xA;AAAAIQAMY2W0pgEAAEUDAAAOAAAAAAAAAAAAAAAAAC4CAABkcnMvZTJvRG9jLnhtbFBLAQItABQA&#xD;&#xA;BgAIAAAAIQByvbMT3wAAAA4BAAAPAAAAAAAAAAAAAAAAAAAEAABkcnMvZG93bnJldi54bWxQSwUG&#xD;&#xA;AAAAAAQABADzAAAADAUAAAAA&#xD;&#xA;" strokeweight=".1272mm"><o:lock v:ext="edit" shapetype="f"/><w10:wrap anchorx="page"/></v:line></w:pict></mc:Fallback></mc:AlternateContent></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the charm he had been carrying in his hand.  Thinking that the visitor could no longer leave the island, the priest gave him the instruction.  Using the leaf he had kept in the sole of his shoe, the monk then returned to Magadha.  He was thus able to provide Nalanda</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s monastic community amply with all their essential needs, through transmuting great quantities of iron to gold with the alchemical elixir.</w:t></w:r></w:p><w:p w14:paraId="3E0A8B62" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="35920598" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Some time</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> after this, Bhikshu </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Shr</w:t></w:r><w:r w:rsidRPr="00616DC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>i</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>manta</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> served as the abbot of Nalanda.  He paid great tribute to those members of the community who observed the three trainings</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="52"/></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>properly, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> expelled those full and novice monks who were morally corrupt.  He is reputed to have banished as many as 8,000 monks.</w:t></w:r></w:p><w:p w14:paraId="3DED6DA3" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5893E2C0" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">It was during this period as well that one Bhikshu </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Shankara</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> composed a scripture entitled the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>Ornament of Knowledge.</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  It was written in 12,000 verses and represented an attempt to discredit the doctrine of the greater way.</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="53"/></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  By means of logic, Bhikshu </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Shrimanta</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> was able to refute the argument completely.  He also disproved many other scriptures denying the validity of this higher way.  On one occasion, in a place called </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Jata</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Sanghata</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, he defeated 500 masters of other schools in debate, and brought them into the inner system by overcoming their false views.</w:t></w:r></w:p><w:p w14:paraId="3C6EC61A" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00B2B1EF" w14:textId="02B6D295" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">During that time when </w:t></w:r><w:r w:rsidR="00843098"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya was teaching the Dharma of the three baskets</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="54"/></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> widely to many followers, two youths who were </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>actually emanations</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> from the water-dragon beings, or </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">nagas, </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>came to him seeking the Dharma.  With their presence, the entire area became filled with the fragrance of sandalwood.  Upon their departure, it disappeared; and when they returned, the delightful scent reappeared as well.</w:t></w:r></w:p><w:p w14:paraId="6260D32C" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3792256A" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The Arya asked them the reason for this, and the youths replied that they were sons of the dragon king </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Taksaka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>.  They had anointed themselves with essence of sandalwood as immunization against human impurities.</w:t></w:r></w:p><w:p w14:paraId="7CB21E0F" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="58381B63" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The Arya then asked them to give him some of the sandalwood to fashion an image of Tara, and to assist him in constructing temples as well.  The two youths answered that they would have to ask their father, and then left.</w:t></w:r></w:p><w:p w14:paraId="7B7F7B0E" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="64A0BCF9" w14:textId="12186EEB" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The pair returned after two days to tell </w:t></w:r><w:r w:rsidR="002F44B1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya that only if he himself came to the Land of the Dragons could they do as he bade.  Aware of the benefit to all beings which would result from his going, </w:t></w:r><w:r w:rsidR="00655387"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya did indeed journey to this land, where King </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Taksaka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> and other righteous water dragons</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>presented him with innumerable offerings.</w:t></w:r></w:p><w:p w14:paraId="057E8416" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="619DFB7C" w14:textId="5D621272" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The great being preached the Dharma to the dragons in compliance with their every supplication, bringing them so much satisfaction that they entreated him to remain among them permanently.  He answered: “Because I have come here for the purpose of securing the sutra of the Perfection of Wisdom in 100,000 verses and </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>dragon clay</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>—which is needed for the construction of temples and offering shrines—I have no opportunity now to stay.  I shall perhaps be able to return in the future.”</w:t></w:r></w:p><w:p w14:paraId="04C5A66F" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D8E9065" w14:textId="0DC04408" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">When he </w:t></w:r><w:r w:rsidR="00C01EDC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>h</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">ad acquired the expanded version of the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>Mother</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> of the Victors</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>; several shorter texts of the Perfection of Wisdom</w:t></w:r><w:r w:rsidR="002A6B42"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>;</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> and great quantities of dragon clay, </w:t></w:r><w:r w:rsidR="00A24A14"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya prepared to return to our world: the continent of Jambu.  It is said that </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>in order to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> ensure </w:t></w:r><w:r w:rsidR="00A24A14"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s return to their land, the water dragons kept from him a small portion at the end of the 100,000 Verses.  The missing portion—the last two chapters</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="55"/></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> of the unabridged sutra on </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:lastRenderedPageBreak/><w:t>the Perfection of Wisdom—was therefore replaced by the corresponding chapters of the Perfection of Wisdom sutra in 8,000 verses.  This is why the final two chapters of each sutra are identical.</w:t></w:r></w:p><w:p w14:paraId="514642A4" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0F776027" w14:textId="01330BBB" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">After securing these sutras, </w:t></w:r><w:r w:rsidR="00DC385A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya greatly advanced the influence of the tradition of the greater way.  When he preached the Dharma in the monastery park, the dragons performed acts of reverence, such as six of them forming a parasol to shade him from the sun.</w:t></w:r></w:p><w:p w14:paraId="71B07216" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="19159F7E" w14:textId="757097EA" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Having thus </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>become</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the Lord of the Dragons, or Nagas, </w:t></w:r><w:r w:rsidR="00ED79E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya was named “The Naga.”  Because his skill at spreading the Dharma of the greater way resembled the shooting speed and mastery of the famed archer Arjuna, of ancient India, he became known as well as “The Arjuna.”  It is otherwise explained that he was called “Nagarjuna” because, by practicing the rituals for reaching the goddess Kurukulla, he gained authority over such </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">naga </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">dragons as King </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Taksaka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, and others.</w:t></w:r></w:p><w:p w14:paraId="6D947505" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="735A2F42" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Nagarjuna later travelled to the area of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Pundra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Vardhana</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> where—utilizing the practice of alchemy—he performed many acts of great generosity.  In particular, he bestowed great quantities of gold upon an elderly Brahmin couple and thus instilled them with great faith.  The Brahmin elder served Nagarjuna and listened to the Dharma from him; after his death, he was reborn as the Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Bodhinaga</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">.  </w:t></w:r></w:p><w:p w14:paraId="65D3ED23" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0E3D42CA" w14:textId="31C32E48" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Nagarjuna also constructed many temples.  Once, when he was preparing to transform a large, bell-shaped boulder into gold, an emanation of Tara with the form of an old woman appeared and said to him: “Instead of doing this, you should go to the Mountain of Splendor and </w:t></w:r><w:r w:rsidR="00032B6D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>practi</w:t></w:r><w:r w:rsidR="00032B6D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>c</w:t></w:r><w:r w:rsidR="00032B6D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>e</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the Dharma.”  Later he did go there, to perform the practices for reaching Tara.</w:t></w:r></w:p><w:p w14:paraId="5F380883" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="03AB6E39" w14:textId="46EC4C50" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">On another occasion, when he had accomplished the rites for invoking the goddess Chandika, the goddess herself carried </w:t></w:r><w:r w:rsidR="00EC61F6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya into the sky and attempted to take him to the celestial realms.</w:t></w:r></w:p><w:p w14:paraId="62B03202" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1C7B6480" w14:textId="78280246" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“I have not exerted myself in order to travel to the celestial realms,” he said to her.  “I have, rather, invoked you in order to provide support for the community of those who practice the greater way, for as long as the Buddha</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s teaching remains in this world.”</w:t></w:r></w:p><w:p w14:paraId="44CB39F2" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="437AE2A3" w14:textId="4AF47811" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> they returned to this world, and the goddess established herself to the near west of Nalanda, manifesting herself in the form of a noblewoman of the royal caste.  Nagarjuna instructed her, saying: “A great stake of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>khadira</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>wood, so large that a man can barely lift it, has been driven into the wall of a stone temple dedicated to Manjushri, the Gentle Voice.  Until that stake turns to ashes, you must provide subsistence for the temple</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s spiritual community.”</w:t></w:r></w:p><w:p w14:paraId="5C556C5E" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="542B343B" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">With articles of every sort, the lady made offerings to the spiritual community for twelve years.  During this time the steward of the monastery, a novice monk of evil nature, made continual promiscuous advances to her.  The noblewoman made no replies, until one day she finally said: “If the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>khadira</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>-wood stake ever turned to ashes, we could be united.”  The wicked one therefore set the stake afire.  When it had become ashes, the goddess herself vanished.</w:t></w:r></w:p><w:p w14:paraId="187F8C5C" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="70385F7D" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">There was another time when </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>a number of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> elephants were threatening to damage the Bodhi tree at </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Vajrasana</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, the “Seat of the Diamond” (present-day Bodhgaya).  Nagarjuna erected two stone columns behind the sacred tree, which provided protection for many years.</w:t></w:r></w:p><w:p w14:paraId="3DB435D9" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="45828DD7" w14:textId="1E51547F" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">When the elephants later returned, </w:t></w:r><w:r w:rsidR="007C7074"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya erected two images of Mahakala astride a lion, wielding a club.  This was also effective, but the danger nonetheless reappeared and a stone fence was built around the tree.  Outside the enclosure, </w:t></w:r><w:r w:rsidR="00796C19"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya constructed 108 offering shrines.  These stupas</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>were huge, and each one was crowned by a smaller</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>shrine containing sacred bone-relics of the Buddha.</w:t></w:r></w:p><w:p w14:paraId="3C8839F0" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="512374F1" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The Arya further constructed many temples and stupas in the six major cities of Magadha—</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Shravasta</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Saketa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Champaka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, Varanasi, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Rajagirha</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, and Vaishali.  He also provided teachers of the Dharma with all their needs.</w:t></w:r></w:p><w:p w14:paraId="584A29B3" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="302EA44D" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Above all, Nagarjuna knew that virtually no one understood the true meaning of the scriptures on the Perfection of Wisdom.  He also knew that, without having realized this meaning unerringly, there was no means for achieving liberation.</w:t></w:r></w:p><w:p w14:paraId="0861E383" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2E61BB48" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>He thus widely proclaimed the Middle Path, which asserts that emptiness (the essential meaning of dependent origination, that all things are totally void of a self-existent nature) is totally consistent with principles expressing an infallible relation between “black” and “white” karma and its consequences.</w:t></w:r></w:p><w:p w14:paraId="765A96D0" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0C58ABB7" w14:textId="19FCF27A" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="001642C3"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">By means of his five-part collection of works on logic </w:t></w:r><w:r w:rsidR="002C1480"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya clearly expounded the ultimate meaning of the Buddha</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s Wisdom.  This collection consists of the major treatise, the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>Root Text on the Middle Way</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, and its four limbs: the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Sixty Verses on the Reasoning of the Middle Way; </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Seventy Verses on Emptiness; Smashing Argument to Dust; </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>and</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> Defeating All Dispute</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="40C05296" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D2D2CCB" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">After this period, Arya Nagarjuna stayed for six months on Mount </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Ushira</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, to the north.  He was accompanied by a thousand disciples and sustained each one with a daily tablet of a quicksilver </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>rasayana</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>or elixir, that he had prepared.</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="56"/></w:r></w:p><w:p w14:paraId="391C3B97" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0B26F383" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">One day a disciple, Siddha </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Singkhi</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, respectfully touched the pill to his head but did not eat it.  The Arya asked why, and his follower answered: “I have no need of the pill.  If it pleases you, Arya, please prepare </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>a number of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> vessels by filling them with water.”  </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Thus</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> a thousand large containers were filled with water and placed there, in the forest.</w:t></w:r></w:p><w:p w14:paraId="7058B264" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15C0A350" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The siddha, or accomplished master, then added a drop of urine to each of the vessels, which transformed all the liquid into the “elixir of gold.”  The Arya took all the vessels and concealed them in a secluded, inaccessible cave, uttering a prayer that they might serve to benefit beings of the future.</w:t></w:r></w:p><w:p w14:paraId="1A45E6A4" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="06ADEC5C" w14:textId="3DB7DF6F" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">This Siddha </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Singkhi</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> had not always been so adept.  When he first met </w:t></w:r><w:r w:rsidR="00BC36E8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya, he was so dull-witted that he could not learn even a single verse over a period of many days.  The Arya then told him, in a jesting tone, to meditate that a horn had grown on top of his head.</w:t></w:r></w:p><w:p w14:paraId="59514389" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1D98CEDD" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The disciple did so, maintaining his object of meditation so sharply that he achieved the tangible and visible sign of having grown a horn.  He was therefore unable to leave the cave in which he was meditating, for the horn got caught on the sides of the entrance.  The siddha was then instructed to meditate that the horn was no longer present, and it subsequently disappeared.</w:t></w:r></w:p><w:p w14:paraId="0A44C3F0" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0B1D84E4" w14:textId="45FD91BC" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Realizing that his disciple</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s mental faculties had now become sharply developed, </w:t></w:r><w:r w:rsidR="00F4336B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya taught him several profound meanings of the secret mantras.  Nagarjuna then </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">instructed him to meditate once more, and the follower ultimately attained the Siddhi of the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Mahamudra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">: </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>the</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Great Seal of Emptiness.</w:t></w:r></w:p><w:p w14:paraId="067FC2DF" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6E63A6A5" w14:textId="3933CE7B" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Later </w:t></w:r><w:r w:rsidR="00F04367"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya travelled to the northern continent of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Kurava</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">.  Along the way, in a city named </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Salamana</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, he encountered several children playing in the road.  Nagarjuna read the palm of one of them, a boy named </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Jetaka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, and prophesied that he would become King.  On the return journey, following the accomplishment of his goal in </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Kurava</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="0067074D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya met the former youth, who had since become King.</w:t></w:r></w:p><w:p w14:paraId="7FFD0CA3" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="29DABD6E" w14:textId="7803C194" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">For three years Nagarjuna remained with the King, who bestowed upon </w:t></w:r><w:r w:rsidR="00FB38C8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya many precious jewels.  In return, he composed for the King a jewel of the Dharma: namely, the text named </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>A</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>String of Precious Jewels.</w:t></w:r></w:p><w:p w14:paraId="47A1F44F" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2B266240" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">It was then that Nagarjuna travelled south, as the emanation of Tara had advised him to do, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>in order to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> practice meditation at the Mountain of Splendor.  Here Nagarjuna also turned the Wheel of the Dharma, that of both the open and the secret teachings, extensively—and it was at this time that he composed</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, in particular, the</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> scripture entitled </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>A Praise of the Realm of All Things.</w:t></w:r></w:p><w:p w14:paraId="7A940C23" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1CA28138" w14:textId="664BFF88" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">In general, </w:t></w:r><w:r w:rsidR="00044653"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s compositions are divided into three collections:</w:t></w:r></w:p><w:p w14:paraId="21440767" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="49DCCDE3" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The Collection of Discourses, which includes such works as the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">String of Precious Jewels; </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Letter to a Friend; </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Hundred Verses on Wisdom; </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Tree Trunk of Wisdom, </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/></w:rPr><w:t>A Drop of Elixir for Healing All Beings.</w:t></w:r></w:p><w:p w14:paraId="36D364A4" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="66C8C5FC" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The Collection of Tributes, including </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">A Praise of the Realm of All Things; A Praise of Going Beyond the World; A Praise of the Inconceivable, </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>A Praise of the Ultimate.</w:t></w:r></w:p><w:p w14:paraId="3F604FA8" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="6CDCA437" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The Collection of Logic Writings—the afore-mentioned </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Root Text on the Middle Way </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>and associated works.</w:t></w:r></w:p><w:p w14:paraId="6794B70F" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4F3F95A3" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>In addition to these, Arya Nagarjuna composed other important treatises in explanation of both the open and secret teachings and—indeed—performed activities as though the Buddha himself had returned to this world.</w:t></w:r></w:p><w:p w14:paraId="555C6A3A" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="55640F02" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:lastRenderedPageBreak/><w:t>It is said that Nagarjuna made three “great proclamations of the Dharma.”  The first was his upholding the ethical discipline at Nalanda Monastery, as previously explained.  This was like the first turning of the Wheel of the Dharma by the victorious Buddha.</w:t></w:r></w:p><w:p w14:paraId="7AA094B1" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7D7549C0" w14:textId="17315683" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The second proclamation was his clear exposition of the Pure Middle View, through the composition of the collection of logic treatises and others.  This was </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>similar to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the Buddha</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s second turning of the Wheel.</w:t></w:r></w:p><w:p w14:paraId="179B49E8" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3B6F0633" w14:textId="110B094E" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The third great proclamation was constituted by </w:t></w:r><w:r w:rsidR="00201694"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s activities upon the Mountain of Splendor in the south, where he composed such works as the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>Praise of the Realm of All Things</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>.  This was akin to the final turning of the Wheel of the Dharma by Lord Buddha.</w:t></w:r></w:p><w:p w14:paraId="2D4D9FDB" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15FA596C" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Such extensive labors on behalf of the Dharma and living beings aroused great displeasure in the demoness Mara and the forces of evil.  A boy, Kumara </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Shaktiman</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, had earlier been born to the queen of King </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Udayibhadra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="404534F0" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3A0CB793" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Years later, the mother was presenting her son with a rare, fine garment when the boy told her: “Put this away for me.  I shall wear it when it is time for me to rule the kingdom.” </w:t></w:r></w:p><w:p w14:paraId="14EB5AD2" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2407EAA8" w14:textId="2803279E" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“You shall never rule,” replied his mother, “for Arya Nagarjuna has made it happen that your father and he are of a single life.  Your father will not die unless </w:t></w:r><w:r w:rsidR="00927409"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>he Arya does.”</w:t></w:r></w:p><w:p w14:paraId="5EC1E3A1" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4F4684F5" w14:textId="50A71E1F" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The boy was so overcome with grief that his mother continued: “Don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">t cry so! The Arya is a bodhisattva, and if you ask him for his head he will not refuse.  With that, your father will also die—and you shall acquire the kingdom.” </w:t></w:r></w:p><w:p w14:paraId="5F67934D" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="238AEB2F" w14:textId="6345AD9F" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The child followed his mother</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s suggestion and Nagarjuna did indeed agree to give his head.  Yet however much effort the boy </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>used,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> his sword could not cut Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s neck.</w:t></w:r></w:p><w:p w14:paraId="236D275E" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D8C0AF4" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The Arya then told the boy: “Long ago, while cutting some grass, I happened to kill an insect.  The force of that misdeed remains with me still, and you can thus sever my head by using a blade of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>kusha</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> grass.”</w:t></w:r></w:p><w:p w14:paraId="708D0941" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6DA901EA" w14:textId="630AA025" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>This the boy did, and so was able to cut off Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s head.  The blood which flowed from the wound turned to milk, and the following words issued from the dismembered head: “From here I depart to Sukhavati, the Heaven of Happiness.  In the future, I shall enter this body again.”</w:t></w:r></w:p><w:p w14:paraId="07BB5F3A" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3A40F93B" w14:textId="2894F450" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The wicked prince cast the head away at several leagues</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> distance, fearing that it would once more join the body.  Since </w:t></w:r><w:r w:rsidR="004276B2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he Arya had attained the practice of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>rasayana</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, however, his head and body became stone-hard.  The two are said to be coming nearer and nearer, one to the other, every year; in the end to be joined once more.  Nagarjuna will then again perform great works for the benefit of the Teaching and all living beings.</w:t></w:r></w:p><w:p w14:paraId="69A61902" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="241A53FF" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">As it is written in the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>Great Realization of Gentle Voice,</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Arya Nagarjuna lived for a total of six hundred years:</w:t></w:r></w:p><w:p w14:paraId="21151131" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="40413714" w14:textId="5DFCCD85" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">After I, the Tathagata, have passed away </w:t></w:r></w:p><w:p w14:paraId="20EACF89" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>And four hundred years have elapsed,</w:t></w:r></w:p><w:p w14:paraId="6B28895E" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>A full monk named “The Naga” shall appear,</w:t></w:r></w:p><w:p w14:paraId="0D2AC9BF" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Of great faith and benefit to the Teaching.</w:t></w:r></w:p><w:p w14:paraId="3D8A5BC2" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">He shall achieve the stage of Great Joy </w:t></w:r></w:p><w:p w14:paraId="7FEF043A" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>And for six hundred years remain alive.</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="57"/></w:r></w:p><w:p w14:paraId="0F8234B6" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="112CE58A" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00296187"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2FB27E19" w14:textId="77777777" w:rsidR="00296187" w:rsidRPr="002427B7" w:rsidRDefault="00296187" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3774C1A5" w14:textId="77777777" w:rsidR="0059162A" w:rsidRPr="002427B7" w:rsidRDefault="0059162A" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="566E2BB2" w14:textId="77777777" w:rsidR="00592ECA" w:rsidRPr="002427B7" w:rsidRDefault="00592ECA" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></
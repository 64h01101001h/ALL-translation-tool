/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve">4) </w:t></w:r><w:r w:rsidRPr="00A1116D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00A1116D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00A1116D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> they are not</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve"> things which are </w:t></w:r><w:r w:rsidRPr="00A1116D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t>sustained</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve"> through these three necessary factors.</w:t></w:r></w:p><w:p w14:paraId="00913214" w14:textId="77777777" w:rsidR="00F7183F" w:rsidRDefault="00F7183F" w:rsidP="006032BD"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5B2A3356" w14:textId="77777777" w:rsidR="005C6A94" w:rsidRPr="002427B7" w:rsidRDefault="005C6A94" w:rsidP="005C6A94"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4E6413B0" w14:textId="36124B78" w:rsidR="007827
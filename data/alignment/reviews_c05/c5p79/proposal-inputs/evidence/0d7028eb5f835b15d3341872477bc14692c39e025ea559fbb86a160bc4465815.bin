otype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>grants extensive</w:t></w:r><w:r w:rsidR="009C6B31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">teachings on the </w:t></w:r><w:r w:rsidRPr="009C6B31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:color w:val="000000"/></w:rPr><w:t>Jewel of Realizations,</w:t></w:r><w:r w:rsidR="009C6B31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>linking his explanation to the original</w:t></w:r><w:r w:rsidR="009C6B31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">sutra. </w:t></w:r><w:r w:rsidR="00B00C47"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>When these teachings are completed,</w:t></w:r><w:r w:rsidR="009C6B31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>he instructs his disciples to perform extensive offerings.</w:t></w:r></w:p><w:p w14:paraId="347CD926" w14:textId="77777777" w:rsidR="00FF17D6" w:rsidRDefault="00FF17D6" w:rsidP="006250CC"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2765552F" w14:textId="77777777" w:rsidR="00B00C47" w:rsidRDefault="00ED1256" w:rsidP="00B00C47"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr></w:pPr><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>The</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">disciples go to make butter lamps, and by the time </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Je comes to take a butter-lamp cup,</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>all the cups have already been carried</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">off by others. </w:t></w:r><w:r w:rsidR="00B00C47"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">And so </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> Je goes</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>and gets a huge basin; places some</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>clarified butter in the bottom; inserts</w:t></w:r><w:r w:rsidR="00B00C47"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>a great many cotton wicks; and offers</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>it to the Lord.</w:t></w:r></w:p><w:p w14:paraId="09FAC894" w14:textId="77777777" w:rsidR="00B00C47" w:rsidRDefault="00B00C47" w:rsidP="00B00C47"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr></w:pPr></w:p><w:p w14:paraId="08CFCB7F" w14:textId="0C42937C" w:rsidR="00016759" w:rsidRDefault="00ED1256" w:rsidP="00B00C47"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr></w:pPr><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Je Rinpoche gazes out</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>over all the butter lamps, and then says</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>to the assembly: “Let the butter of all</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>the lamps be poured into the basin.”</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">Then he gives his approval for </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>to undertake a special task: “I want th</w:t></w:r><w:r w:rsidR="008761BD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>e</w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="007F534B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>M</w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">aster of the </w:t></w:r><w:r w:rsidR="007F534B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>en</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="007F534B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>G</w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve">reat </w:t></w:r><w:r w:rsidR="007F534B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>B</w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>ooks here to write up a record of what we taught, and</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>compose a commentary based on these notes.”</w:t></w:r></w:p><w:p w14:paraId="76B75095" w14:textId="77777777" w:rsidR="00016759" w:rsidRDefault="00016759" w:rsidP="00B00C47"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5B2BF43E" w14:textId="261461E2" w:rsidR="00ED1256" w:rsidRPr="00DF0315" w:rsidRDefault="00ED1256" w:rsidP="00B00C47"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>In actuality,</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>what</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> is saying at this moment is “I hereby empower</w:t></w:r><w:r w:rsidR="00D7320C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00DF0315"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:t xml:space="preserve"> Je as my successor, my regent.”</w:t></w:r><w:r w:rsidR="00B763A6"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000"/></w:rPr><w:footnoteReference w:id="45"/></w:r></w:p><w:p w14:paraId="3B2E8646" w14:textId="243CCE68" w:rsidR="00ED1256" w:rsidRDefault="00ED1256" w:rsidP="000E32F1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="26189392" w14:textId="334A102F" w:rsidR="00266911" w:rsidRDefault="00E25088" w:rsidP="00E25088"><w:pPr><w:pStyle w:val="PlainText"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The light of a butter lamp is a powerful image across the entire length of the Asian wisdom tradition for the light of understanding; a</w:t></w:r><w:r w:rsidR="00266911"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nd </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00266911"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00266911"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> it would appear that Je Rinpoche is so sure of the selection of his successor that he makes this decision more than 15 years before his passi</w:t></w:r><w:r w:rsidR="008D1B01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ng</w:t></w:r><w:r w:rsidR="00E177DD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.  T</w:t></w:r><w:r w:rsidR="008D1B01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">his sensitivity to </w:t></w:r><w:r w:rsidR="00F06162"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">prepare his succession well ahead of time is another of countless </w:t></w:r><w:r w:rsidR="001D6E73"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>indications of his mastery not just as a teacher, but as the leader of a lineage</w:t></w:r><w:r w:rsidR="00E177DD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of wisdom</w:t></w:r><w:r w:rsidR="001D6E73"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="08D6393E" w14:textId="77777777" w:rsidR="00F94A91" w:rsidRDefault="00F94A91" w:rsidP="00FF17D6"><w:pPr><w:pStyle w:val="PlainText"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="57D1A6D8" w14:textId="0E924568" w:rsidR="00F94A91" w:rsidRDefault="00F94A91" w:rsidP="00F94A91"><w:pPr><w:pStyle w:val="PlainText"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Aside from massive tasks such as undertaking the construction of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ganden</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Monastery itself at his master</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t x
tino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We have mentioned that by the great master Chandrakirti,</w:t></w:r><w:r w:rsidR="00A94469"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> around 650</w:t></w:r><w:r w:rsidR="00A94469" w:rsidRPr="00A94469"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:smallCaps/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ad</w:t></w:r><w:r w:rsidR="00A94469"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, entitled simply </w:t></w:r><w:r w:rsidR="00E81A8F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A Commentary to the Sixty Verses on Reasoning (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00E81A8F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Yukti</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00E81A8F" w:rsidRPr="00E81A8F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00E81A8F" w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatino" w:cs="Cambria"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ṣ</w:t></w:r><w:r w:rsidR="00E81A8F" w:rsidRPr="00E81A8F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:r w:rsidR="00E81A8F" w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatino" w:cs="Cambria"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ṣ</w:t></w:r><w:r w:rsidR="00A36C0C" w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatin
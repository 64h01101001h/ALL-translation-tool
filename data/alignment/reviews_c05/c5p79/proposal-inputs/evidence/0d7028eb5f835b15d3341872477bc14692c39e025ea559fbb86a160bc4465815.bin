w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>A Catalogue of the Tohoku University Collection of Tibetan Works on Buddhism</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:i/><w:iCs/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">.  </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">These catalog numbers have become standard for the works of major Tibetan </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>authors, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve"> are therefore utilized in the standard catalog numbers of the Asian Legacy Library (ALL).  The translations of the titles into English are by the two translators of the present volume, as is the breakdown into subject categories.  The folio numbers are as reported in the Tohoku Catalog and are given only to indicate the comparative quantities of material.</w:t></w:r></w:p><w:p w14:paraId="7265ED40" w14:textId="77777777" w:rsidR="000022FE" w:rsidRDefault="000022FE" w:rsidP="000022FE"><w:pPr><w:pStyle w:val="PlainText"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4B4BB2B3" w14:textId="77777777" w:rsidR="000022FE" w:rsidRDefault="000022FE" w:rsidP="000022FE"><w:pPr><w:pStyle w:val="PlainText"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><
="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6CD95BF4" w14:textId="62C7036A" w:rsidR="00C1525D" w:rsidRDefault="00F601AE" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>He gained a total grasp</w:t></w:r></w:p><w:p w14:paraId="07DAEE40" w14:textId="599AD231" w:rsidR="00F601AE" w:rsidRDefault="00F601AE" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Of those profound depths</w:t></w:r></w:p><w:p w14:paraId="237E795B" w14:textId="7200FD3A" w:rsidR="00F601AE" w:rsidRDefault="00F601AE" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of the treasure hoard of the Dharma,</w:t></w:r></w:p><w:p w14:paraId="2AFF982D" w14:textId="34DDA608" w:rsidR="00F601AE" w:rsidRDefault="00F601AE" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And in his compassion</w:t></w:r></w:p><w:p w14:paraId="363760E4" w14:textId="3F1AA4C1" w:rsidR="00F601AE" w:rsidRDefault="00F601AE" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Passed it on to others.</w:t></w:r></w:p><w:p w14:paraId="7C2F5BF9" w14:textId="3FE853D2" w:rsidR="00C54D50" w:rsidRDefault="00C54D50" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4EE47C93" w14:textId="02C8A192" w:rsidR="00C54D50" w:rsidRDefault="00CB7D85" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And still in this world</w:t></w:r></w:p><w:p w14:paraId="65EB1363" w14:textId="39E3961F" w:rsidR="00CB7D85" w:rsidRDefault="00CB7D85" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The fires of his viewpoints</w:t></w:r></w:p><w:p w14:paraId="6B02E75F" w14:textId="286C51FC" w:rsidR="00CB7D85" w:rsidRDefault="00CB7D85" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Consume the firewood</w:t></w:r></w:p><w:p w14:paraId="5E91E9F1" w14:textId="78F2829E" w:rsidR="00CB7D85" w:rsidRDefault="00CB7D85" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of</w:t></w:r><w:r w:rsidR="0095434C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00E26D81"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>textual</w:t></w:r><w:r w:rsidR="0095434C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> traditions of </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0095434C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>others;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="790B0BA6" w14:textId="38581B24" w:rsidR="0095434C" w:rsidRDefault="0095434C" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Lighting </w:t></w:r><w:r w:rsidR="00180DD0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and destroying </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the darkness</w:t></w:r></w:p><w:p w14:paraId="1EDC2A7F" w14:textId="0E9E020C" w:rsidR="0095434C" w:rsidRDefault="0095434C" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Within the minds of all.</w:t></w:r></w:p><w:p w14:paraId="5EC13E2E" w14:textId="06EFB4BF" w:rsidR="0095434C" w:rsidRDefault="0095434C" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="34F5C40D" w14:textId="3FEF0DC1" w:rsidR="009E5218" w:rsidRDefault="00ED0706" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">He employs the </w:t></w:r><w:r w:rsidR="00581D7D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>archer regiments</w:t></w:r></w:p><w:p w14:paraId="50EF7057" w14:textId="227F9648" w:rsidR="00581D7D" w:rsidRDefault="00581D7D" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of his teachings on the wisdom</w:t></w:r></w:p><w:p w14:paraId="13B513E9" w14:textId="5F63DED7" w:rsidR="00581D7D" w:rsidRDefault="00581D7D" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Beyond all thoughts of two</w:t></w:r></w:p><w:p w14:paraId="1568B9F8" w14:textId="2056F60A" w:rsidR="00581D7D" w:rsidRDefault="00581D7D" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>To direct his kingdom perfectly</w:t></w:r></w:p><w:p w14:paraId="43299B26" w14:textId="71A16945" w:rsidR="00581D7D" w:rsidRDefault="00581D7D" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here in the world of his disciples</w:t></w:r></w:p><w:p w14:paraId="27A8D3E8" w14:textId="3477B0C0" w:rsidR="00581D7D" w:rsidRDefault="00581D7D" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of all three realms, with the gods.</w:t></w:r></w:p><w:p w14:paraId="6EC4798F" w14:textId="02784B8E" w:rsidR="00527015" w:rsidRDefault="00527015" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5BF72993" w14:textId="15023B0A" w:rsidR="00527015" w:rsidRDefault="00527015" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Thus</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> do I bow to Nagarjuna,</w:t></w:r></w:p><w:p w14:paraId="119FBAFD" w14:textId="6A96A597" w:rsidR="00527015" w:rsidRDefault="00527015" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Who smashed the entire army</w:t></w:r></w:p><w:p w14:paraId="305B91FC" w14:textId="35DB753A" w:rsidR="00527015" w:rsidRDefault="00527015" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of our enemy, this suffering life.</w:t></w:r><w:r w:rsidR="00C47EC8"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="12"/></w:r></w:p><w:p w14:paraId="774CADC6" w14:textId="77777777" w:rsidR="00581D7D" w:rsidRDefault="00581D7D" w:rsidP="00D84BC8"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6FFFC54F" w14:textId="0D03F6DF" w:rsidR="00BF04BD" w:rsidRDefault="001541CC" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We might finally note, in closing, the use of the word </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">arjuna </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to refer to the</w:t></w:r><w:r w:rsidR="008D66B8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Indian</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> tree</w:t></w:r><w:r w:rsidR="00D84BC8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s </w:t></w:r><w:r w:rsidR="00D84BC8" w:rsidRPr="004B50F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Myrobalan Arjuna</w:t></w:r><w:r w:rsidR="00D84BC8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> or </w:t></w:r><w:r w:rsidR="00D84BC8" w:rsidRPr="004B50F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Terminalia Arjuna,</w:t></w:r><w:r w:rsidR="00D84BC8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> due to the shining white color of the inner bark, which is incidentally used as a medicine to improve the heart.  </w:t></w:r><w:r w:rsidR="005D5BF2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The </w:t></w:r><w:r w:rsidR="007A3311"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>former</w:t></w:r><w:r w:rsidR="005D5BF2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> is of course the source of the medicinal </w:t></w:r><w:r w:rsidR="005D5BF2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">arura </w:t></w:r><w:r w:rsidR="0028263A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>fruit</w:t></w:r><w:r w:rsidR="005D5BF2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="000D3856"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">beloved </w:t></w:r><w:r w:rsidR="001B15BB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>substance of the Medicine Buddha</w:t></w:r><w:r w:rsidR="008F5E90"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, filling his bowl.</w:t></w:r><w:r w:rsidR="00167939"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  Thus in the early Chinese translations we see The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00167939"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s name rendered either as “he with power or authority over the nagas” </w:t></w:r><w:r w:rsidR="00A85F8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(</w:t></w:r><w:r w:rsidR="00A85F8C"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t>龙猛</w:t></w:r><w:r w:rsidR="00A85F8C"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00BB202A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t>L</w:t></w:r><w:r w:rsidR="00A85F8C" w:rsidRPr="008153BF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><
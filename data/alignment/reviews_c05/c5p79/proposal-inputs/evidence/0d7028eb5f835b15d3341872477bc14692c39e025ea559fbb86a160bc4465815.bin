w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="78EFE700" w14:textId="6D75B78A" w:rsidR="0095643E" w:rsidRPr="002427B7" w:rsidRDefault="00D80F9E" w:rsidP="0095643E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">We can also describe the correct form of deceptive reality as the objects and subjects involved with the six powers of sense, when they are free of any </w:t></w:r><w:r w:rsidR="0010722B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>defect.</w:t></w:r></w:p><w:p w14:paraId="0585D755" w14:textId="09BD727D" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7AA28B34" w14:textId="77777777" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="725D11D6" w14:textId="24435B59" w:rsidR="00CC1DFD" w:rsidRDefault="00CC1DFD" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S369]</w:t></w:r></w:p><w:p w14:paraId="48C333FD" w14:textId="3F2C7AA4" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="
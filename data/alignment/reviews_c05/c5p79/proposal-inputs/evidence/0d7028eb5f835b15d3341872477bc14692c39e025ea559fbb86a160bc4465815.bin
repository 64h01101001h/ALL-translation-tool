Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>DANG</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="000E22F8" w:rsidRPr="00037D8F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> PO NI, LOG SOGS BZHI LA,</w:t></w:r></w:p><w:p w14:paraId="11195841" w14:textId="77777777" w:rsidR="00255A56" w:rsidRPr="00443E23" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="145B80FE" w14:textId="609DA2A2" w:rsidR="00255A56" w:rsidRDefault="0069012E" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ll cover the first of these in two steps of </w:t></w:r><w:r w:rsidR="000E22F8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a description of (1) how we engage in the cycle of pain; and then of (2) how we disengage from it.</w:t></w:r><w:r w:rsidR="005517AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  The first of these is </w:t></w:r><w:r w:rsidR="00AC4676"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>treat</w:t></w:r><w:r w:rsidR="005517AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ed in the four lines [of the Tibetan, </w:t></w:r><w:r w:rsidR="002D7CDA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ten in the English] which include the words “mistaken understanding”—</w:t></w:r></w:p><w:p w14:paraId="5A73338B" w14:textId="518047C4" w:rsidR="00255A56" w:rsidRPr="00A946FC" w:rsidRDefault="00255A56" w:rsidP="00C75EC4"><w:pPr><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6B736F58" w14:textId="77777777" w:rsidR="002D7CDA" w:rsidRDefault="002D7CDA" w:rsidP="00C75EC4"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="65E92741" w14:textId="21318B43" w:rsidR="00397305" w:rsidRDefault="00397305" w:rsidP="00C75EC4"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N234]</w:t></w:r></w:p><w:p w14:paraId="09B57D20" w14:textId="414E1474" w:rsidR="002D7CDA" w:rsidRPr="002427B7" w:rsidRDefault="002D7CDA" w:rsidP="002D7CDA"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(49)</w:t></w:r></w:p><w:p w14:paraId="128DF78A" w14:textId="77777777" w:rsidR="002D7CDA" w:rsidRPr="002427B7" w:rsidRDefault="002D7CDA" w:r
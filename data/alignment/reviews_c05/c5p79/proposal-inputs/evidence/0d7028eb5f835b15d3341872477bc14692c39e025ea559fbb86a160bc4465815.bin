" w:rsidRDefault="00730D8C" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="445066E7" w14:textId="28B354BC" w:rsidR="00730D8C" w:rsidRPr="00B97918" w:rsidRDefault="00B97918" w:rsidP="00B7084C"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">How can you reconcile the fact that here in this text you are presenting an explanation which says that these thinkers take no position at all; while you still assert that you accept the position taken by </w:t></w:r><w:r w:rsidR="006A7470"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>T</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">he Arya himself in </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Wisdom, </w:t></w:r><w:r w:rsidR="00DE7FE7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>as he denies the four extremes?</w:t></w:r><w:r w:rsidR="007D35D1"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="188"/></w:r></w:p><w:p w14:paraId="274E16B2" w14:textId="6ECF9F0B" w:rsidR="005308D4" w:rsidRPr="002427B7" w:rsidRDefault="005308D4" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rP
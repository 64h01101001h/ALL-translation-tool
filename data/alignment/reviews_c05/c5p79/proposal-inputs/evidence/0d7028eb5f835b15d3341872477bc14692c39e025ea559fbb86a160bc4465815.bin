="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>RO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="0FF4BFD7" w14:textId="77777777" w:rsidR="00704E3B" w:rsidRDefault="00704E3B" w:rsidP="00A51BC6"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5FBFAD93" w14:textId="374BAF0E" w:rsidR="00704E3B" w:rsidRPr="002427B7" w:rsidRDefault="00704E3B" w:rsidP="00A51BC6"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00141111"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">How then </w:t></w:r><w:r w:rsidR="00E765A8" w:rsidRPr="00141111"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">could you ever come to some “realization” that </w:t></w:r><w:r w:rsidR="000B5039"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">these </w:t></w:r><w:r w:rsidR="00E765A8" w:rsidRPr="00141111"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>things existed</w:t></w:r><w:r w:rsidR="00E765A8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> through some nature of their own</w:t></w:r><w:r w:rsidR="00E765A8" w:rsidRPr="00141111"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>?</w:t></w:r><w:r w:rsidR="00E765A8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidR="00293D4A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>If a thing ever could exist through such a nature, then it would be totally impossible for it to change into something else.</w:t></w:r></w:p><w:p w14:paraId="37690EA4" w14:textId="77777777" w:rsidR="00A51BC6" w:rsidRDefault="00A51BC6" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3F0CF28A" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6EC17F28" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1038185F" w14:textId="3841DA6C" w:rsidR="00C77464" w:rsidRPr="004A71DA" w:rsidRDefault="004A71DA" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nothing very strange</w:t></w:r></w:p><w:p w14:paraId="77345A7C" w1
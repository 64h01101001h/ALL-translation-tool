atino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(4) </w:t></w:r><w:r w:rsidR="00B15C1C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the fourth </w:t></w:r><w:r w:rsidR="00F17275"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">clarifies who </w:t></w:r><w:r w:rsidR="004B56C8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">it was that </w:t></w:r><w:r w:rsidR="002A5DFA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>described this nature.</w:t></w:r></w:p><w:p w14:paraId="6C876CD8" w14:textId="77777777" w:rsidR="00815CCE" w:rsidRDefault="00815CCE" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="799A61C4" w14:textId="77777777" w:rsidR="00815CCE" w:rsidRDefault="00815CCE" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="483377C6" w14:textId="4F993242" w:rsidR="006F4CD3" w:rsidRDefault="006F4CD3" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S623]</w:t></w:r></w:p><w:p w14:paraId="39FB1DDD" w14:textId="607BB214" w:rsidR="00FC0CDC" w:rsidRDefault="004A4401" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:r
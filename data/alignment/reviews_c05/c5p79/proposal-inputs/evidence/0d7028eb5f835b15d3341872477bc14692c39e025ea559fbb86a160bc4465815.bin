ng w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Source of all help &amp; happiness—</w:t></w:r></w:p><w:p w14:paraId="4AAA015D" w14:textId="77777777" w:rsidR="00F8560D" w:rsidRDefault="00F8560D" w:rsidP="00F8560D"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="77031D2E" w14:textId="77777777" w:rsidR="00F8560D" w:rsidRDefault="00F8560D" w:rsidP="00F8560D"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Might flourish, and every being</w:t></w:r></w:p><w:p w14:paraId="4D836A17" w14:textId="77777777" w:rsidR="00F8560D" w:rsidRDefault="00F8560D" w:rsidP="00F8560D"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Come to take their fill</w:t></w:r></w:p><w:p w14:paraId="4589E246" w14:textId="77777777" w:rsidR="00F8560D" w:rsidRDefault="00F8560D" w:rsidP="00F8560D"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of the finest fruits that grow there:</w:t></w:r></w:p><w:p w14:paraId="55BA832D" w14:textId="77777777" w:rsidR="00F8560D" w:rsidRDefault="00F8560D" w:rsidP="00F8560D"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino L
hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="28923624" w14:textId="28D0EB2B" w:rsidR="002240D4" w:rsidRDefault="00EA5F68" w:rsidP="001F601E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">They never fall under the power of influences brought on by negativities, where they are tortured by mistaken </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>perceptions;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="69F8C2FF" w14:textId="77777777" w:rsidR="00EA5F68" w:rsidRDefault="00EA5F68" w:rsidP="001F601E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3010FCE2" w14:textId="29028366" w:rsidR="00EA5F68" w:rsidRDefault="004421B0" w:rsidP="001F601E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because they have realized, directly, that both entities and the lack of entities have no nature of their own.</w:t></w:r></w:p><w:p w14:paraId="25E73C80" w14:textId="77777777" w:rsidR="009E5398" w:rsidRDefault="009E5398" w:rsidP="00AD5806"><w:pPr><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:h
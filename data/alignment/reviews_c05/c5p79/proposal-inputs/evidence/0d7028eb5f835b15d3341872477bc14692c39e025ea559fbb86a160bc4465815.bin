406"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Do, in fact, exist</w:t></w:r></w:p><w:p w14:paraId="66B34EDE" w14:textId="77777777" w:rsidR="00643406" w:rsidRPr="00643406" w:rsidRDefault="00643406" w:rsidP="00643406"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="07E5758A" w14:textId="77777777" w:rsidR="00643406" w:rsidRPr="00643406" w:rsidRDefault="00643406" w:rsidP="00643406"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00643406"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Will be made,</w:t></w:r></w:p><w:p w14:paraId="08DAEF46" w14:textId="77777777" w:rsidR="00643406" w:rsidRPr="00643406" w:rsidRDefault="00643406" w:rsidP="00643406"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00643406"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>At the beginning—</w:t></w:r></w:p><w:p w14:paraId="521A167D" w14:textId="77777777" w:rsidR="00643406" w:rsidRPr="00643406" w:rsidRDefault="00643406" w:rsidP="00643406"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00643406"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For those who seek suchness.</w:t></w:r></w:p><w:p w14:paraId="4DDD8CE1" w14:textId="77777777" w:rsidR="00643406" w:rsidRPr="00643406" w:rsidRDefault="00643406" w:rsidP="00643406"><
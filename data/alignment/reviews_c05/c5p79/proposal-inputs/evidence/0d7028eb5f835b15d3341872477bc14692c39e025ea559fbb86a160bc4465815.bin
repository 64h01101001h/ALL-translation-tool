cii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Even though they had eliminated within themselves each </w:t></w:r><w:r w:rsidR="00B9144E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> every trace of the view of destruction,</w:t></w:r><w:r w:rsidR="009636C2"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="172"/></w:r><w:r w:rsidR="00662F2E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00662F2E" w:rsidRPr="0055573F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the Victors</w:t></w:r><w:r w:rsidR="003F0EAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—those perfectly and fully enlightened Buddhas—</w:t></w:r><w:r w:rsidR="00662F2E" w:rsidRPr="003F02C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">did indeed describe a “me” and </w:t></w:r><w:r w:rsidR="005968AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a </w:t></w:r><w:r w:rsidR="00662F2E" w:rsidRPr="003F02C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“mine</w:t></w:r><w:r w:rsidR="00BD32F1" w:rsidRPr="003F02C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00662F2E" w:rsidRPr="003F02C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidR="00BD32F1" w:rsidRPr="003F02C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> but</w:t></w:r><w:r w:rsidR="00BD32F1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00BD32F1" w:rsidRPr="00892504"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">only </w:t></w:r><w:r w:rsidR="00FA473D" w:rsidRPr="00892504"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>because they had something else in mind</w:t></w:r><w:r w:rsidR="00B36C0E" w:rsidRPr="00892504"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="00B36C0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  That is, they did so only as a method for helping disciples to </w:t></w:r><w:r w:rsidR="00FB4C44"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>realize how nothing ever starts.</w:t></w:r></w:p><w:p w14:paraId="10C3C4F6" w14:textId="77777777" w:rsidR="00D45739" w:rsidRDefault="00D45739" w:rsidP="005C6A94"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:
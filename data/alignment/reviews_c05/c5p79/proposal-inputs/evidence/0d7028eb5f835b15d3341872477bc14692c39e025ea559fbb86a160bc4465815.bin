" w14:textId="77777777" w:rsidR="00962F08" w:rsidRPr="002427B7" w:rsidRDefault="00962F08" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6B527FFD" w14:textId="6F338132" w:rsidR="00753FAD" w:rsidRDefault="00836876" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As for the first, one may ask how it is that </w:t></w:r><w:r w:rsidR="000C7062"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> belief that things could start through some nature of their own </w:t></w:r><w:r w:rsidR="000C7062"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>stands in contradiction to the concept of dependence:</w:t></w:r></w:p><w:p w14:paraId="0CAC87D7" w14:textId="77777777" w:rsidR="000C7062" w:rsidRPr="002427B7" w:rsidRDefault="000C7062" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6484381D" w14:textId="3F7E19B6" w:rsidR="0071586A" w:rsidRPr="002427B7" w:rsidRDefault="0071586A" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="365C2354" w14:textId="40F307A4" w:rsidR="005E6CF7" w:rsidRDefault="005E6CF7" w:rsidP="005E6CF7"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="
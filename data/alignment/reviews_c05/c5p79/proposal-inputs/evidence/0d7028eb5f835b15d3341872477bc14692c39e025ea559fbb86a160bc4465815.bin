B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DRA BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I DBYE BA MED PAS BDEN PA MNGON PAR RTOGS PA NI SKAD CIG MA GCIG TU ZAD </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="68B8B69D" w14:textId="77777777" w:rsidR="000C4210" w:rsidRPr="002427B7" w:rsidRDefault="000C4210" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="740AB524" w14:textId="6A065ADE" w:rsidR="00CE5800" w:rsidRDefault="00930258" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As such we can say that there are no different aspects to the real nature of things that occur in </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>dependence;</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to their emptiness, to their lack of any nature of their own.  </w:t></w:r><w:r w:rsidR="0026559E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And we can say then, in turn, that the realization of the truth is completed, in essence, in a single second of time.</w:t></w:r></w:p><w:p w14:paraId="7C4F5B31" w14:textId="77777777" w:rsidR="00930258" w:rsidRPr="002427B7" w:rsidRDefault="00930258" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="44D56651" w14:textId="77777777" w:rsidR="000C4210" w:rsidRPr="002427B7" w:rsidRDefault="000C4210" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5802431F" w14:textId="76E9AE08" w:rsidR="00155D1D" w:rsidRPr="00F06A5B" w:rsidRDefault="00155D1D" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>[S305]</w:t></w:r></w:p><w:p w14:paraId="49C2FA55" w14:textId="4B69BF46" w:rsidR="000C4210" w:rsidRPr="00F06A5B" w:rsidRDefault="00204B17" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="000C4210" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>O NA SKAD CIG MA BCU DRUG TU BZHAG PA JI LTA BU ZHE NA,</w:t></w:r></w:p><w:p w14:paraId="2B4EC069" w14:textId="77777777" w:rsidR="00071E20" w:rsidRPr="00F06A5B" w:rsidRDefault="00071E20" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="20DC1DFA" w14:textId="00711FEA" w:rsidR="000C4210" w:rsidRDefault="00730945" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>With this, someone may pose the following question:</w:t></w:r></w:p><w:p w14:paraId="12681927" w14:textId="77777777" w:rsidR="00730945" w:rsidRDefault="00730945" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="260103B3" w14:textId="319165BB" w:rsidR="00730945" w:rsidRDefault="001534AF" w:rsidP="001534AF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>If that</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s the case, then what about that presentation of sixteen different seconds of time?</w:t></w:r><w:r w:rsidR="00177A72"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="139"/></w:r></w:p><w:p w14:paraId="316DD749" w14:textId="0D6DA163" w:rsidR="00095E84" w:rsidRPr="002427B7" w:rsidRDefault="00095E84" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="14FD109B" w14:textId="77777777" w:rsidR="00071E20" w:rsidRPr="002427B7" w:rsidRDefault="00071E20" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7DC66489" w14:textId="55A61B58" w:rsidR="00155D1D" w:rsidRDefault="00155D1D" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>[S306]</w:t></w:r></w:p><w:p w14:paraId="3776C61B" w14:textId="5091B252" w:rsidR="000C4210" w:rsidRDefault="000C4210" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DE NI LDOG PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"
w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For even but a moment,</w:t></w:r></w:p><w:p w14:paraId="77CD6932" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Then the mountain of extreme views—</w:t></w:r></w:p><w:p w14:paraId="1E499582" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The ideas that things could exist forever</w:t></w:r></w:p><w:p w14:paraId="07F956E6" w14:textId="1BA1FBC3" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Or </w:t></w:r><w:r w:rsidR="001339C2" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">might </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>not exist at all—</w:t></w:r></w:p><w:p w14:paraId="038771A7" w14:textId="351F5B93" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Crumbles and falls</w:t></w:r><w:r w:rsidR="000F1855" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to the ground.</w:t></w:r></w:p><w:p w14:paraId="7E1FBAB4" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="224A7D95" w14:textId="0D842D8F" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I bow to the one</w:t></w:r><w:r w:rsidR="00E22C07" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> who leads me</w:t></w:r></w:p><w:p w14:paraId="1EC09014" w14:textId="4C32DBBA" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00E22C07" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A</w:t></w:r><w:r w:rsidR="00C51737" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>long the matchless path</w:t></w:r></w:p><w:p w14:paraId="5C6405AA" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Of the highest </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>way;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="043A1FA8" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I bow down to the feet</w:t></w:r></w:p><w:p w14:paraId="44DD1BCA" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C5173
Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>actually represents</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> nirvana when we </w:t></w:r><w:r w:rsidR="00754317"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>achieve a cessation where we are free of adventitious</w:t></w:r><w:r w:rsidR="003D323C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00754317"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> or manufactured</w:t></w:r><w:r w:rsidR="003D323C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00754317"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> impurities</w:t></w:r><w:r w:rsidR="008D2251"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00754317"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00B73B16"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">because we have been accustoming our thoughts </w:t></w:r><w:r w:rsidR="00493B3A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to the realization that this suffering life itself has no nature of its own.</w:t></w:r></w:p><w:p w14:paraId="04D7A8E7" w14:textId="296CCBD5" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRD
w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The idea that things could exist or not,</w:t></w:r></w:p><w:p w14:paraId="54F037D2" w14:textId="77777777" w:rsidR="007D41FA" w:rsidRPr="002427B7" w:rsidRDefault="007D41FA" w:rsidP="007D41FA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And who no longer dwell there,</w:t></w:r></w:p><w:p w14:paraId="1E9A5886" w14:textId="77777777" w:rsidR="007D41FA" w:rsidRPr="002427B7" w:rsidRDefault="007D41FA" w:rsidP="007D41FA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Understand that the meaning</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:color w:val="FF0000"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of a cause</w:t></w:r></w:p><w:p w14:paraId="2242C002" w14:textId="77777777" w:rsidR="007D41FA" w:rsidRPr="002427B7" w:rsidRDefault="007D41FA" w:rsidP="007D41FA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Is the profound truth</w:t></w:r></w:p><w:p w14:paraId="75CCD075" w14:textId="77777777" w:rsidR="007D41FA" w:rsidRPr="002427B7" w:rsidRDefault="007D41FA" w:rsidP="007D41FA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That there is nothing at all to see.</w:t></w:r></w:p><w:p w14:paraId="1A321C52" w14:textId="77777777" w:rsidR="007C0381" w:rsidRPr="002427B7" w:rsidRDefault="007C0381" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0F7523B9" w14:textId="77777777" w:rsidR="007C0381" w:rsidRPr="002427B7" w:rsidRDefault="007C0381" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1811E9F9" w14:textId="2E38465B" w:rsidR="00796B50" w:rsidRPr="00F06A5B" w:rsidRDefault="00796B50" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>[N16]</w:t></w:r></w:p><w:p w14:paraId="1BE830F3" w14:textId="069E8F1D" w:rsidR="007C0381" w:rsidRPr="00F06A5B" w:rsidRDefault="007C0381" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts 
02567CC" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DI LA BDEN PA GNYIS KA TSANG STE, RTAGS SU BZUNG BA</w:t></w:r><w:r w:rsidR="00BD704E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KUN RDZOB DANG, CHOS SU BZUNG BA</w:t></w:r><w:r w:rsidR="00BD704E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DON DAM PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I BDEN </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="1FA6D1FF" w14:textId="77777777" w:rsidR="00FE13EA" w:rsidRDefault="00FE13EA" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="015065A3" w14:textId="0243E6ED" w:rsidR="00FE13EA" w:rsidRDefault="00FE13EA" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">These descriptions are something </w:t></w:r><w:r w:rsidR="0043665E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which can be understood from the three points of the original condition; the path; and the result of the path here.</w:t></w:r><w:r w:rsidR="006E3BF6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  Which is to say—</w:t></w:r></w:p><w:p w14:paraId="231CEA8A" w14:textId="77777777" w:rsidR="006E3BF6" w:rsidRDefault="006E3BF6" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6E4A96DE" w14:textId="1822A88E" w:rsidR="006E3BF6" w:rsidRDefault="006E3BF6" w:rsidP="006E3BF6"><w:pPr><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Consider all that simply appears before us.</w:t></w:r></w:p><w:p w14:paraId="63ECE2B7" w14:textId="77777777" w:rsidR="006E3BF6" w:rsidRDefault="006E3BF6" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6A2F4D5D" w14:textId="543F713F" w:rsidR="006E3BF6" w:rsidRPr="002427B7" w:rsidRDefault="00441290" w:rsidP="00441290"><w:pPr><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It has no nature of its </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>own;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="5D669EFB" w14:textId="44EDF5D3" w:rsidR="006212C5" w:rsidRPr="002427B7" w:rsidRDefault="006212C5" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="56ABCC42" w14:textId="596197F8" w:rsidR="001867AC" w:rsidRDefault="00441290" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>Because it is based upon a dependent relationship.</w:t></w:r></w:p><w:p w14:paraId="4C109DB0" w14:textId="77777777" w:rsidR="00441290" w:rsidRDefault="00441290" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="77FC760B" w14:textId="6A2F890E" w:rsidR="006212C5" w:rsidRDefault="00D333CF" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Both of the two</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> types of reality are complete in this one syllogism of necessity.  </w:t></w:r><w:r w:rsidR="00442C81"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The </w:t></w:r><w:r w:rsidR="00401B7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>term that we have put forth as the reason</w:t></w:r><w:r w:rsidR="00401B7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:softHyphen/></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00401B7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—“</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00401B7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>it is based upon a dependent relationship”—represents deceptive reality; whereas the term we have put forth as the quality we wish to prove—“no nature of its own”—represents ultimate reality.</w:t></w:r></w:p><w:p w14:paraId="5671EBBA" w14:textId="77777777" w:rsidR="00EE4DBF" w:rsidRPr="002427B7" w:rsidRDefault="00EE4DBF" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="193EB495" w14:textId="77777777" w:rsidR="00854ACC" w:rsidRPr="002427B7" w:rsidRDefault="00854ACC" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="52D85C88" w14:textId="2845BD68" w:rsidR="00672717" w:rsidRDefault="00672717" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S399]</w:t></w:r></w:p><w:p w14:paraId="145EA2D5" w14:textId="47F1A6DA" w:rsidR="005555C8" w:rsidRDefault="00854ACC" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DE LA RTEN </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>BREL RTOGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I BLO RANG BZHIN MED PAR RTOGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I THABS SU </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GYUR BA YIN TE, BSGRUB BYA RTOGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I BLO RTAGS RTOGS PA LAS SKYE DGOS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="3BDF9351" w14:textId="77777777" w:rsidR="006C1347" w:rsidRDefault="006C1347" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="67FE140C" w14:textId="5F5ADA37" w:rsidR="006C1347" w:rsidRPr="002427B7" w:rsidRDefault="006C1347" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This argument serves as a method for the state of mind which realizes the fact of dependent relationship to go further and realize how things have no nature of their own.  And this is because the state of mind which realizes the truth of a statement arises from a realization of the reason presented.</w:t></w:r></w:p><w:p w14:paraId="4FF3D697" w14:textId="77777777" w:rsidR="00025512" w:rsidRPr="002427B7" w:rsidRDefault="00025512" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="53B87B7D" w14:textId="77777777" w:rsidR="005555C8" w:rsidRPr="002427B7" w:rsidRDefault="005555C8" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="16800C1C" w14:textId="095180CC" w:rsidR="00672717" w:rsidRDefault="00672717" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S400]</w:t></w:r></w:p><w:p w14:paraId="7EDA8E8D" w14:textId="5818BCDC" w:rsidR="001C1872" w:rsidRPr="002427B7" w:rsidRDefault="00854ACC" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">BLO DANG PO DE GOMS PAR BYAS PAS LAM GYI SKABS SU BSOD NAMS KYI TSOGS SU </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GYUR LA PHYI MA GOMS PAS YE SHES KYI TSOGS SU </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GYUR BA YIN LA, RGYAS PAR NA PHA ROL TU PHYIN PA DRUG GO</w:t></w:r></w:p><w:p w14:paraId="1DB39B92" w14:textId="0E63FA99" w:rsidR="00FC491F" w:rsidRDefault="00FC491F" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2DD3E8F1" w14:textId="0D5AE501" w:rsidR="006C1347" w:rsidRDefault="006C1347" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>When we have accustomed ourselves to the first state of mind, then in the context of the spiritual path, it becomes the accumulation of merit.  And when we have accustomed ourselves to the latter, it becomes the accumulation of wisdom.  To describe this in more detail, we can turn to the six perfections.</w:t></w:r><w:r><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="157"/></w:r></w:p><w:p w14:paraId="6CB92F46" w14:textId="5CB5110D" w:rsidR="001C1872" w:rsidRDefault="001C1872" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7727EE7B" w14:textId="77777777" w:rsidR="00CB50A0" w:rsidRPr="002427B7" w:rsidRDefault="00CB50A0" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="61174530" w14:textId="0881ACC4" w:rsidR="005E6CF7" w:rsidRDefault="005E6CF7" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S401]</w:t></w:r></w:p><w:p w14:paraId="01E9B8A7" w14:textId="04BC2971" w:rsidR="00073976" w:rsidRPr="002427B7" w:rsidRDefault="00854ACC" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,RTEN</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>BREL GYIS BSDUS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I SHES BYA JI SNYED PA LA SGRIB PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I NYON MONGS PA CAN MA YIN PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I MI SHES PA RANG BZHIN MED PAR RTOGS PAS SEL BAR BYED PA BLO DE NYID SANGS RGYAS KYI SAR THABS GOMS PAS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GYUR BAR BYED PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="693D6A46" w14:textId="1BC66BF9" w:rsidR="00073976" w:rsidRPr="002427B7" w:rsidRDefault="00073976" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="466F569A" w14:textId="58F891BB" w:rsidR="001C0A13" w:rsidRDefault="00306098" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We use the realization that things have no nature of their own to clear away that form of not knowing things which is not involved with negative emotions—a state of mind which blocks us from seeing the total number of knowable things subsumed by dependence.</w:t></w:r><w:r w:rsidR="00086C92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  This state of mind comes about at the level of a Buddha, when we have accustomed ourselves to the method side of things.</w:t></w:r></w:p><w:p w14:paraId="09F09467" w14:textId="77777777" w:rsidR="00306098" w:rsidRPr="002427B7" w:rsidRDefault="00306098" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1F596235" w14:textId="77777777" w:rsidR="004045C0" w:rsidRPr="002427B7" w:rsidRDefault="004045C0" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="71CDA169" w14:textId="209947C4" w:rsidR="005E6CF7" w:rsidRDefault="005E6CF7" w:rsidP="00BC483E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S402]</w:t></w:r></w:p><w:p w14:paraId="3F3A97D7" w14:textId="143FB43A" w:rsidR="00BC483E" w:rsidRPr="002427B7" w:rsidRDefault="00854ACC" w:rsidP="00BC483E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DE GNYIS THABS DANG THABS BYUNG</w:t></w:r><w:r w:rsidR="006971F4" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>YIN TE,</w:t></w:r><w:r w:rsidR="00BC483E" w:rsidRPr="00BC483E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00BC483E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DBU MA LA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="00BC483E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>JUG PAR THA SNYAD BDEN PA THABS SU GYUR PA DANG, DON DAM BDEN PA THABS BYUNG GYUR PA STE, ZHES DANG,</w:t></w:r></w:p><w:p w14:paraId="2DFF1B4E" w14:textId="45DFE2AE" w:rsidR="00994732" w:rsidRPr="002427B7" w:rsidRDefault="00994732" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D8A497E" w14:textId="223BE3EB" w:rsidR="00994732" w:rsidRDefault="00935661" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>These two then represent the method, and what results from employing the method.</w:t></w:r><w:r w:rsidR="00757F18"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidR="00C01F4F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Entering the Middle Way </w:t></w:r><w:r w:rsidR="00C01F4F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>puts it this way:</w:t></w:r></w:p><w:p w14:paraId="48F37044" w14:textId="77777777" w:rsidR="00E115E0" w:rsidRDefault="00E115E0" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="716A1A29" w14:textId="50C32834" w:rsidR="00E115E0" w:rsidRDefault="00E115E0" w:rsidP="00E115E0"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Conventional reality represents a method; whereas ultimate reality represents what results from employing that method.</w:t></w:r><w:r><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="158"/></w:r></w:p><w:p w14:paraId="666AEF02" w14:textId="77777777" w:rsidR="00AF1653" w:rsidRDefault="00AF1653" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="12B361CC" w14:textId="77777777" w:rsidR="00AF1653" w:rsidRDefault="00AF1653" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><
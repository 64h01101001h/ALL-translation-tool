ino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">KHOR BA BLO YUL DU </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>CHAR BA LA BLTOS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="6FAD505A" w14:textId="77777777" w:rsidR="004262B7" w:rsidRPr="002427B7" w:rsidRDefault="004262B7" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6AA956BD" w14:textId="2220F8AF" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="004262B7" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">In the same way, </w:t></w:r><w:r w:rsidR="00E93405" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">achieving nirvana—going beyond grief—is not something that could exist in &amp; of itself; rather, </w:t></w:r><w:r w:rsidR="00343B59" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that fact that the cycle of pain has no nature of its own is itself nirvana.  </w:t></w:r><w:r w:rsidR="0045767D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As such, </w:t></w:r><w:r w:rsidR="00CB5471" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>forming a mental image of nirvana is something that relies upon forming a mental image of the cycle.</w:t></w:r></w:p><w:p w14:paraId="15C489B4" w14:textId="3DDC731F" w:rsidR="00140194" w:rsidRPr="002427B7" w:rsidRDefault="00140194" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4BDD7F4D" w14:textId="77777777" w:rsidR="000336AA" w:rsidRPr="002427B7" w:rsidRDefault="000336AA" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="040F56AA" w14:textId="48ABE8FA" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="00476525" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S2</w:t></w:r><w:r w:rsidR="00140194" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>2</w:t></w:r><w:r w:rsidR="008D71A5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><
:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s consider the protector, Nagarjuna.</w:t></w:r></w:p><w:p w14:paraId="657D136C" w14:textId="77777777" w:rsidR="004E2B35" w:rsidRDefault="004E2B35" w:rsidP="004E2B35"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7C8DBCA0" w14:textId="41E91872" w:rsidR="004E2B35" w:rsidRDefault="004E2B35" w:rsidP="004E2B35"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">There is a specific reason why he sings the praises of, and bows down to, the Teacher—here as he first begins the composition of this classical </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>commentary;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="239F8C22" w14:textId="77777777" w:rsidR="004E2B35" w:rsidRDefault="004E2B35" w:rsidP="004E2B35"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="50120BE3" w14:textId="02C8BF94" w:rsidR="004E2B35" w:rsidRPr="002427B7" w:rsidRDefault="000A0AC2" w:rsidP="004E2B35"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">Because he wishes to sing his praises to the Able One, the Buddha, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>for the reason that</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> this Conqueror has described, </w:t></w:r><w:r w:rsidR="00B2459E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">independently, </w:t></w:r><w:r w:rsidR="000554C8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that principle of dependent relationship which serves to </w:t></w:r><w:r w:rsidR="00AA02E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">overthrow the idea that the starting </w:t></w:r><w:r w:rsidR="006B1C36"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r w:rsidR="00AA02E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> stopping of things could occur through some nature of </w:t></w:r><w:r w:rsidR="00393F31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>their</w:t></w:r><w:r w:rsidR="00
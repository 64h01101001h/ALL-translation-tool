sidR="00195E87" w:rsidRDefault="008472DE" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Reviewing the </w:t></w:r><w:r w:rsidR="00536D25"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>personal history of each of the 60 verses here</w:t></w:r><w:r w:rsidR="00FB22EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—as we did for the closing verse—</w:t></w:r><w:r w:rsidR="00536D25"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">would </w:t></w:r><w:r w:rsidR="00A8705A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">be too much.  A more practical approach might be to </w:t></w:r><w:r w:rsidR="00A7436A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">highlight the verses that </w:t></w:r><w:r w:rsidR="00A90DD6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">we believe (and this is an admittedly subjective evaluation) </w:t></w:r><w:r w:rsidR="004A2C72"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The Arya would have felt were most important.  </w:t></w:r><w:r w:rsidR="00A3644D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And then we trace </w:t></w:r><w:r w:rsidR="003B4C9A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>how healthy these verses remained over the millen</w:t></w:r><w:r w:rsidR="008A7344"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>n</w:t></w:r><w:r w:rsidR="003B4C9A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ia.</w:t></w:r></w:p><w:p w14:paraId="62DBCF4D" w14:textId="77777777" w:rsidR="00195E87" w:rsidRDefault="00195E87" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="763FA534" w14:textId="6D4CEB41" w:rsidR="004F3BD5" w:rsidRDefault="008A7344" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Inevitably, this exercise </w:t></w:r><w:r w:rsidR="00715142"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>will lead each of us, in our own journey,</w:t></w:r><w:r w:rsidR="000F2890"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to </w:t></w:r><w:r w:rsidR="00901EB0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">do our best to appreciate and reinvigorate these </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00901EB0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>particular concepts</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00901EB0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="62E8901A" w14:textId="0EED1C8D" w:rsidR="00B92C6E" w:rsidRDefault="00B92C6E" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="43353C33" w14:textId="7D6AE04F" w:rsidR="004F1FF4" w:rsidRDefault="00B92C6E" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We made an executive decision to stick to a Top Ten, partly because The Arya </w:t></w:r><w:r w:rsidR="00361159"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>seems to have favored</w:t></w:r><w:r w:rsidR="00833A72"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> multiples of ten—</w:t></w:r><w:r w:rsidR="005853AB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">witness not just his </w:t></w:r><w:r w:rsidR="005853AB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses, </w:t></w:r><w:r w:rsidR="005853AB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">but also </w:t></w:r><w:r w:rsidR="00E272CF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">his </w:t></w:r><w:r w:rsidR="00E272CF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Seventy Verses on Emptiness, </w:t></w:r><w:r w:rsidR="00E272CF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">or </w:t></w:r><w:r w:rsidR="00C938DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(if it </w:t></w:r><w:r w:rsidR="00C938DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is </w:t></w:r><w:r w:rsidR="00C938DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">his) the </w:t></w:r><w:r w:rsidR="00C938DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Fifty Verses on Novice Monks.</w:t></w:r></w:p><w:p w14:paraId="082C3615" w14:textId="23236F04" w:rsidR="00A81C2B" w:rsidRDefault="00A81C2B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2166A673" w14:textId="7A0C53E1" w:rsidR="00A81C2B" w:rsidRDefault="00A81C2B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="45FAD13B" w14:textId="0CEF1A9D" w:rsidR="00A81C2B" w:rsidRPr="00A81C2B" w:rsidRDefault="00A81C2B" w:rsidP="00A81C2B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Top Ten </w:t></w:r><w:r w:rsidR="009C5114"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Verse</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> #1</w:t></w:r></w:p><w:p w14:paraId="37A0DE6E" w14:textId="77777777" w:rsidR="004236B9" w:rsidRDefault="004236B9" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="68E65243" w14:textId="77777777" w:rsidR="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>(1)</w:t></w:r></w:p><w:p w14:paraId="66EEBF73" w14:textId="77777777" w:rsidR="004236B9" w:rsidRPr="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those whose minds</w:t></w:r><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>have gone beyond</w:t></w:r></w:p><w:p w14:paraId="70337E88" w14:textId="77777777" w:rsidR="004236B9" w:rsidRPr="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The idea that things could exist or not,</w:t></w:r></w:p><w:p w14:paraId="028A2CDC" w14:textId="77777777" w:rsidR="004236B9" w:rsidRPr="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And who no longer dwell there,</w:t></w:r></w:p><w:p w14:paraId="09E7945F" w14:textId="77777777" w:rsidR="004236B9" w:rsidRPr="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Understand that the meaning</w:t></w:r><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:color w:val="FF0000"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of a cause</w:t></w:r></w:p><w:p w14:paraId="1433A695" w14:textId="77777777" w:rsidR="004236B9" w:rsidRPr="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Is the profound truth</w:t></w:r></w:p><w:p w14:paraId="1C8A50BA" w14:textId="77777777" w:rsidR="004236B9" w:rsidRPr="004236B9" w:rsidRDefault="004236B9" w:rsidP="004236B9"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004236B9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That there is nothing at all to see.</w:t></w:r></w:p><w:p w14:paraId="33E8D586" w14:textId="3181E5A9" w:rsidR="00E379A4" w:rsidRDefault="00E379A4" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5F545ADC" w14:textId="51CFF6A3" w:rsidR="004236B9" w:rsidRDefault="004236B9" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The first winner of our Top Ten Verses award is, not surprisingly, the very first verse (again, not counting the preface verse).  </w:t></w:r><w:r w:rsidR="00144CA2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00144CA2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ve already seen that this verse</w:t></w:r><w:r w:rsidR="008E571A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—and its core message, that emptiness and dependence are</w:t></w:r><w:r w:rsidR="00812510"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> themselves</w:t></w:r><w:r w:rsidR="008E571A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> interdependent—</w:t></w:r><w:r w:rsidR="00144CA2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">did </w:t></w:r><w:r w:rsidR="00144CA2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>survive the test of time.</w:t></w:r></w:p><w:p w14:paraId="32365E66" w14:textId="779CDB5B" w:rsidR="008E571A" w:rsidRDefault="008E571A" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="57981EDA" w14:textId="01E48783" w:rsidR="00A81C2B" w:rsidRDefault="00A81C2B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="372F58CC" w14:textId="4ADA59DD" w:rsidR="00A81C2B" w:rsidRPr="00A81C2B" w:rsidRDefault="00A81C2B" w:rsidP="00A81C2B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Top Ten </w:t></w:r><w:r w:rsidR="009C5114"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Verse</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> #2</w:t></w:r></w:p><w:p w14:paraId="2C228024" w14:textId="429AA225" w:rsidR="00144CA2" w:rsidRDefault="00144CA2" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6B88557D" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(11)</w:t></w:r></w:p><w:p w14:paraId="68447F3D" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">That </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>in itself is</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> nirvana</w:t></w:r></w:p><w:p w14:paraId="26D2377B" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As something </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>seen;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="69A727DF" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>It also means that we have</w:t></w:r></w:p><w:p w14:paraId="4CB18D13" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Done what we had to do.</w:t></w:r></w:p><w:p w14:paraId="527DDD6E" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="41A4A266" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Suppose that,</w:t></w:r></w:p><w:p w14:paraId="63F6E9EF" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Subsequent to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the point</w:t></w:r></w:p><w:p w14:paraId="12796F96" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Where we perceive things,</w:t></w:r></w:p><w:p w14:paraId="57BA8756" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>There were for this</w:t></w:r></w:p><w:p w14:paraId="29E6D0C6" w14:textId="77777777" w:rsidR="00CA2ECD" w:rsidRPr="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00CA2ECD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Various aspects.</w:t></w:r></w:p><w:p w14:paraId="16E4104D" w14:textId="5AA39778" w:rsidR="00CA2ECD" w:rsidRDefault="00CA2ECD" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="50F6AE8F" w14:textId="77777777" w:rsidR="0049643A" w:rsidRDefault="0049643A" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="41DE3A9E" w14:textId="5EE4EC27" w:rsidR="007917FB" w:rsidRPr="00A07BF9" w:rsidRDefault="007917FB" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>particular verse</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00D11D56"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">has had an anemic history over the centuries; it was almost never </w:t></w:r><w:r w:rsidR="003B5EFD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ci</w:t></w:r><w:r w:rsidR="00D11D56"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ted</w:t></w:r><w:r w:rsidR="00301AA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—in fact, only by Arya Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00301AA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s disciple, Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00301AA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Aryadeva</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00301AA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="0049643A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And then somehow it seems to have been overlooked, along with its tremendous core idea: that if what is truly real is only </w:t></w:r><w:r w:rsidR="00046BDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that which we see in the direct perception of emptiness, </w:t></w:r><w:r w:rsidR="00A7349D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>then the rest (including everything in a normal person</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00A7349D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s whole life) is somehow </w:t></w:r><w:r w:rsidR="00A7349D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>not even there.</w:t></w:r></w:p><w:p w14:paraId="52698B5F" w14:textId="3614A7EF" w:rsidR="00B20C19" w:rsidRDefault="00B20C19" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="517B4F4B" w14:textId="30A088AF" w:rsidR="00B20C19" w:rsidRDefault="00B20C19" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And so how then could we ever lead a successful life?</w:t></w:r></w:p><w:p w14:paraId="19A86011" w14:textId="6B7A3262" w:rsidR="004717F7" w:rsidRDefault="004717F7" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="73721AA8" w14:textId="1535B555" w:rsidR="004717F7" w:rsidRDefault="004717F7" w:rsidP="004717F7"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As evidence, The Arya points to the perfect homogeneity of what we see in the direct perception, as opposed to the kaleidoscope of a single normal day.</w:t></w:r><w:r w:rsidR="00C70C3A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00C07A2D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00072292"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00072292"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je takes pains here to debunk the idea that emptiness refers to </w:t></w:r><w:r w:rsidR="00060D02"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">common </w:t></w:r><w:r w:rsidR="00072292"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nothingness, and </w:t></w:r><w:r w:rsidR="00336EF6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidR="00072292"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nearly countless ridiculous </w:t></w:r><w:r w:rsidR="00921825"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">schools in history that </w:t></w:r><w:r w:rsidR="001D5E9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">have </w:t></w:r><w:r w:rsidR="00921825"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>tried to practice it this way.</w:t></w:r><w:r w:rsidR="00C70C3A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  As we will see, this is one of several topics he </w:t></w:r><w:r w:rsidR="006C538E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">decides to expand on spontaneously, within his commentary to the </w:t></w:r><w:r w:rsidR="006C538E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sixty.</w:t></w:r></w:p><w:p w14:paraId="6468CA79" w14:textId="232C82F4" w:rsidR="006C538E" w:rsidRDefault="006C538E" w:rsidP="004717F7"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="637D1949" w14:textId="60A02930" w:rsidR="00EC0450" w:rsidRDefault="00180F63" w:rsidP="00CA2ECD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Each one of us can contribute to the </w:t></w:r><w:r w:rsidR="00DD7CA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">revival of this verse by focusing on this </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="003D3791"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>really crucial</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="003D3791"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00DD7CA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>topic</w:t></w:r><w:r w:rsidR="00AA3DE3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> in our teaching and personal practice</w:t></w:r><w:r w:rsidR="00DD7CA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, as did </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00DD7CA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00DD7CA1"><w:rPr><w:rFonts w:ascii="Palatino Lino
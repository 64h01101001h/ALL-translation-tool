ers, and not for ourselves.</w:t></w:r></w:p><w:p w14:paraId="18D92C52" w14:textId="77777777" w:rsidR="00F02AF5" w:rsidRPr="002427B7" w:rsidRDefault="00F02AF5" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3AE0A2EF" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="56D61CCA" w14:textId="631CA72A" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S729]</w:t></w:r></w:p><w:p w14:paraId="56D78244" w14:textId="43C9628B" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DE LTAR NA MNYAM PAR BZHAG PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">O SNYAM PA YANG RANG SNANG LA MED PAS, MNYAM GZHAG KYANG GZHAN SNANG KHO NAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GYUR BAS, RJES THOB GZHAN SNANG ZHES KHYAD PAR DU BYAS PA MI RIGS </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>SO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="24AD4392" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="26A8B9D9" w14:textId="7CA745A2" w:rsidR="003F32B8" w:rsidRDefault="00BE40EC" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Well let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s use your same </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>logic, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> look at those periods where we are thinking to go into </w:t></w:r><w:r w:rsidR="00550B02"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>that</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> deep state of meditation</w:t></w:r><w:r w:rsidR="00550B02"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, at which point we cannot appear to our</w:t></w:r><w:r w:rsidR="00EF4C8A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> own mind.  </w:t></w:r><w:r w:rsidR="00E914C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">According to you, that meditation would then have to be something </w:t></w:r><w:r w:rsidR="002205F6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">which </w:t></w:r><w:r w:rsidR="00E914C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">could appear only to others.  </w:t></w:r><w:r w:rsidR="006174E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And then it would be wrong for us to make that common distinction where we say that “the period </w:t></w:r><w:r w:rsidR="006174E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:i/><w:iCs/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">after </w:t></w:r><w:r w:rsidR="006174E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">we come out of that deep meditation </w:t></w:r><w:r w:rsidR="00C577F0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is the only one that others can </w:t></w:r><w:r w:rsidR="006F3BBF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>observe</w:t></w:r><w:r w:rsidR="00C577F0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.”</w:t></w:r></w:p><w:p w14:paraId="494128E7" w14:textId="77777777" w:rsidR="00E8660B" w:rsidRPr="002427B7" w:rsidRDefault="00E8660B" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Microsoft Himalaya"/><w:szCs w:val="34"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="42CD17AE" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5D45E081" w14:textId="354934A9" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S730]</w:t></w:r></w:p><w:p w14:paraId="51124161" w14:textId="28853C66" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">DES NI DE DAG GIS NI RANG SNANG LA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DUS BYAS SOGS KYIS SNANG BA MTHA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> DAG NUB PA DANG, RANG RGYUD LA YE SHES YOD PA MI </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GAL BAR KHONG DU MA CHUD </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="5FEECF29" w14:textId="678E4DAE" w:rsidR="00DC77C5" w:rsidRPr="002427B7" w:rsidRDefault="00DC77C5" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0D01E9D0" w14:textId="103F5CB1" w:rsidR="009E4623" w:rsidRDefault="006E2269" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">People who make assertions like that last one </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>have</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> yet to </w:t></w:r><w:r w:rsidR="001C347D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">grasp the fact that it is no contradiction to say </w:t></w:r><w:r w:rsidR="00F42C18"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>that, to one</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00F42C18"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s own perceptions, </w:t></w:r><w:r w:rsidR="00FE7590"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">each </w:t></w:r><w:r w:rsidR="00650B40"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r w:rsidR="00FE7590"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> every appearance of a produced thing—or anything of the like—</w:t></w:r><w:r w:rsidR="00742140"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>has at that point entirely subsided; while at the same time our own hearts are filled with wisdom.</w:t></w:r></w:p><w:p w14:paraId="147DB4EB" w14:textId="77777777" w:rsidR="00526021" w:rsidRDefault="00526021" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4801B6DA" w14:textId="77777777" w:rsidR="00526021" w:rsidRPr="002427B7" w:rsidRDefault="00526021" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4E83CD66" w14:textId="63F9B0DD" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S731]</w:t></w:r></w:p><w:p w14:paraId="727AF25D" w14:textId="761305E7" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">CHOS THAMS CAD MNGON SUM DU GZIGS PA DANG SNANG MED LAS YE MI BZHES PA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GAL LO ZHE NA,</w:t></w:r></w:p><w:p w14:paraId="71B0D3C4" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3F69DD30" w14:textId="681DD9AB" w:rsidR="00DC77C5" w:rsidRDefault="00F95E65" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here comes a new objection:</w:t></w:r></w:p><w:p w14:paraId="6060E709" w14:textId="77777777" w:rsidR="00F95E65" w:rsidRDefault="00F95E65" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1ACDA573" w14:textId="07CAE614" w:rsidR="00F95E65" w:rsidRDefault="00170A93" w:rsidP="00170A93"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Isn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t it a contradiction, though, to say that an Enlightened Being is observing every object in the universe directly, while at the same time saying that “nothing appears”—and thus refusing that anything could be?</w:t></w:r></w:p><w:p w14:paraId="3541880C" w14:textId="77777777" w:rsidR="00F67E86" w:rsidRPr="002427B7" w:rsidRDefault="00F67E86" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7E8E28AA" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7D0304F8" w14:textId="54BC423C" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S732]</w:t></w:r></w:p><w:p w14:paraId="2EBB0496" w14:textId="7FB98D24" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">MI </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GAL TE, SO </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>SO</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> SKYE BO</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I SKABS SU YANG MNGON SUM GYI GZHAL BYA SNANG BAS MA KHYAB NA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PHAGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I SKABS SU SMOS CI DGOS,</w:t></w:r></w:p><w:p w14:paraId="57ABA7A9" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4F1A4048" w14:textId="3F5363C5" w:rsidR="009E4623" w:rsidRDefault="00D06DDD" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>But there is no contradiction here.</w:t></w:r><w:r w:rsidR="00CF1162"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  If it is the case that—even during that period when someone is still an ordinary being</w:t></w:r><w:r w:rsidR="00041FE9"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="199"/></w:r><w:r w:rsidR="00CF1162"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—there is no </w:t></w:r><w:r w:rsidR="0000023A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">certainty that any perceivable object </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0000023A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>has to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="0000023A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> be appearing to them directly; </w:t></w:r><w:r w:rsidR="00CE1E03"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>then what need to mention what might be happening at the point when they have become a realized being?</w:t></w:r></w:p><w:p w14:paraId="5F4A4930" w14:textId="77777777" w:rsidR="00D06DDD" w:rsidRPr="002427B7" w:rsidRDefault="00D06DDD" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3D20F4EE" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5545DFA6" w14:textId="626941B3" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S733]</w:t></w:r></w:p><w:p w14:paraId="027CB569" w14:textId="02EF4044" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DER NI DNGOS SHUGS KYI RTOGS BYA RTOGS BYED YOD PAS SO ZHE NA, </w:t></w:r></w:p><w:p w14:paraId="003FE47E" w14:textId="2E2D564B" w:rsidR="006D2C90" w:rsidRPr="002427B7" w:rsidRDefault="006D2C90" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="05482C47" w14:textId="268F8AD5" w:rsidR="009E4623" w:rsidRDefault="00D45C19" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>“But isn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t it the case,” one may </w:t></w:r><w:r w:rsidR="00274F14"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>insist, “that there is perception going on, at that point, of both kinds: direct and indirect?”</w:t></w:r></w:p><w:p w14:paraId="638024D3" w14:textId="77777777" w:rsidR="00F60046" w:rsidRPr="002427B7" w:rsidRDefault="00F60046" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3CD75CF0" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7B0A5BD9" w14:textId="28A10D58" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S734]</w:t></w:r></w:p><w:p w14:paraId="2D15360D" w14:textId="48C91B0F" w:rsidR="009E4623" w:rsidRPr="00443E23" w:rsidRDefault="00204B17" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="009E4623" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>DIR YANG SPROS BRAL DU DNGOS SU RTOGS SHING JI SNYED PA LA BSGRIBS PA</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="009E4623" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>I DRI MA MTHA</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="009E4623" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> DAG ZAD PAS </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="009E4623" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>SO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="21C7573B" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="00443E23" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="438CD025" w14:textId="7216656E" w:rsidR="009E4623" w:rsidRDefault="00557332" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>But what</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s going on here is that everything is being perceived in a state of realization that sees them without the slightest elaborations of self-existence.  </w:t></w:r><w:r w:rsidR="00B9609E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And each </w:t></w:r><w:r w:rsidR="00E07913"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r w:rsidR="00B9609E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> every impurity which might obstruct </w:t></w:r><w:r w:rsidR="00C30676"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">us from perceiving the total number of objects that exist in the universe </w:t></w:r><w:r w:rsidR="00F748EB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>has been finished.</w:t></w:r></w:p><w:p w14:paraId="6D13DCBC" w14:textId="77777777" w:rsidR="00557332" w:rsidRPr="002427B7" w:rsidRDefault="00557332" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0C19FC2D" w14:textId="77777777" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4589AB48" w14:textId="0B1261FA" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S735]</w:t></w:r></w:p><w:p w14:paraId="263E2B70" w14:textId="44693D5B" w:rsidR="00BD23A9" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DES NA SANGS RGYAS LA RANG SNANG YOD NA MA RIG PA MA SPANGS PAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GYUR LA, DE MED KYANG SHES BYA THAMS CAD MNGON SUM DU GZIGS PAS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GAL BA YE MED LA</w:t></w:r></w:p><w:p w14:paraId="1B81390E" w14:textId="4776921F" w:rsidR="005A154A" w:rsidRPr="002427B7" w:rsidRDefault="005A154A" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0064A93E" w14:textId="5022003B" w:rsidR="009E4623" w:rsidRDefault="00CF6DD2" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>If it were the way you</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">re describing it, </w:t></w:r><w:r w:rsidR="00CC0CFC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>then if there were anything appearing personally to a Buddha, then they could not have eliminated misunderstanding.</w:t></w:r><w:r w:rsidR="00D73EA0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  The fact is though that they have no misunderstanding at all; </w:t></w:r><w:r w:rsidR="0035429A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and there is no contradiction at all to saying that </w:t></w:r><w:r w:rsidR="00FB043E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">at the </w:t></w:r><w:r w:rsidR="00970314"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:r w:rsidR="00FB043E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ame time </w:t></w:r><w:r w:rsidR="0035429A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">they see, directly, each </w:t></w:r><w:r w:rsidR="00CF0121"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r w:rsidR="0035429A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> every object in the universe.</w:t></w:r></w:p><w:p w14:paraId="38B5CC65" w14:textId="77777777" w:rsidR="003751DF" w:rsidRDefault="003751DF" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0E044B78" w14:textId="77777777" w:rsidR="003751DF" w:rsidRDefault="003751DF" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5B4578D4" w14:textId="0EA0EF89" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="003751DF"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S736]</w:t></w:r></w:p><w:p w14:paraId="300387A0" w14:textId="6C0FFB20" w:rsidR="003751DF" w:rsidRDefault="00204B17" w:rsidP="003751DF"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="003751DF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GAL BAR SEMS PA DE DAG GIS NI GZIGS NA SNANG DGOS SNYAM DU BSAM </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="003751DF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="003751DF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,</w:t></w:r><w:r w:rsidR="00165FFE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="092B6038" w14:textId="77777777" w:rsidR="004F1D89" w:rsidRDefault="004F1D89" w:rsidP="003751DF"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6A67D964" w14:textId="13507A9E" w:rsidR="004F1D89" w:rsidRPr="008E5FB5" w:rsidRDefault="00036F69" w:rsidP="003751DF"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Those who do hold there to be a contradiction here </w:t></w:r><w:r w:rsidR="008E5FB5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">seem to be thinking that—if an Enlightened Being does see something—then it must be appearing </w:t></w:r><w:r w:rsidR="008E5FB5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">to </w:t></w:r><w:r w:rsidR="008E5FB5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>them.</w:t></w:r></w:p><w:p w14:paraId="26B605A6" w14:textId="77777777" w:rsidR="003751DF" w:rsidRDefault="003751DF" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3882FD92" w14:textId="77777777" w:rsidR="009F21EA" w:rsidRDefault="009F21EA" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="64E08937" w14:textId="21E444F2" w:rsidR="00F71E91" w:rsidRDefault="0034204C" w:rsidP="0034204C"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:noProof/><w:lang w:eastAsia="en-US" w:bidi="ar-SA"/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="114300" distR="114300" simplePos="0" relativeHeight="251665408" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" wp14:anchorId="30D75D0E" wp14:editId="1EB7F01B"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="column"><wp:posOffset>1880870</wp:posOffset></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>208280</wp:posOffset></wp:positionV><wp:extent cx="2120900" cy="261620"/><wp:effectExtent l="0" t="0" r="0" b="5080"/><wp:wrapSquare wrapText="bothSides"/><wp:docPr id="1748283612" name="Picture 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.open
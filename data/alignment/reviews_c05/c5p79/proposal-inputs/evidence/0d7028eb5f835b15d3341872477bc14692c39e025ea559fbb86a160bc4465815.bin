<w:r w:rsidR="00A612D5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>all of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00A612D5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> this output were translated into English, it would require something over 100,000 pages</w:t></w:r><w:r w:rsidR="00657294"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">; </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00657294"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00657294"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je by himself has written some 3,014 folios (6,028 pages), or the equivalent of over 24,000 English pages.</w:t></w:r><w:r w:rsidR="00065024"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="50"/></w:r><w:r w:rsidR="00C003F5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And there is no fluff here</w:t></w:r><w:r w:rsidR="00657294"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—quite the opposite, as anyone who has spent any substantial time with these three gentlemen can tell you.</w:t></w:r></w:p><w:p w14:paraId="4B0206D7" w14:textId="77777777" w:rsidR="00F96F16" w:rsidRDefault="00F96F16" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="07F7BE26" w14:textId="52619B5E" w:rsidR="00657294" w:rsidRDefault="00467801" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Here is a breakdown of the subject matter for </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s works:</w:t></w:r></w:p><w:p w14:paraId="1190B450" w14:textId="67B55962" w:rsidR="00467801" w:rsidRDefault="00467801" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="54810100" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>1) Secret teachings: 7 titles in 157 folios (20% of total titles,</w:t></w:r></w:p><w:p w14:paraId="74104BE4" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>5% of total folios)</w:t></w:r></w:p><w:p w14:paraId="303C6370" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>2) General rituals: 2 titles in 36ff (6% of titles, 1% of folios)</w:t></w:r></w:p><w:p w14:paraId="17BF9209" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>3) Middle way (higher Madhyamika): 9 titles in 509ff (26% of titles,</w:t></w:r></w:p><w:p w14:paraId="2B522EA6" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>17% of folios)</w:t></w:r></w:p><w:p w14:paraId="0AD465CF" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">4) Perfection of wisdom (lower Madhyamika): 4 titles in 446ff </w:t></w:r></w:p><w:p w14:paraId="11525EF7" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(11% of titles, 15% of folios)</w:t></w:r></w:p><w:p w14:paraId="2011D604" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>5) Mind only (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Chittamatra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, or Yogacara): 2 titles in 445ff </w:t></w:r></w:p><w:p w14:paraId="674C1857" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(6% of titles, 15% of folios)</w:t></w:r></w:p><w:p w14:paraId="6D4EA6FB" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>6) Logic &amp; perceptual theory (Pramana): 11 titles in 1,421ff (31%</w:t></w:r></w:p><w:p w14:paraId="7D68E22B" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00DE798C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>of titles, 47% of folios)</w:t></w:r></w:p><w:p w14:paraId="09E5EB50" w14:textId="77777777" w:rsidR="00DE798C" w:rsidRDefault="00DE798C" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1435B5DC" w14:textId="5A475663" w:rsidR="00657294" w:rsidRDefault="00D838AF" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">There are some general notes we can make here.  First of all, as a Master of the Ten Books, or early equivalent of a </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>geshe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>, we would have expected at least some coverage of the categories of vowed morality (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>vinaya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>) and higher knowledge (</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>abhidharma</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">); but here </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Je seems to be following Arya Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>s own example, focusing his time and efforts on crucial, difficult subjects relating to emptiness as the core of the method for leading beings out of the suffering world.</w:t></w:r></w:p><w:p w14:paraId="11EC7709" w14:textId="77777777" w:rsidR="000C046E" w:rsidRDefault="000C046E" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr></w:p><w:p w14:paraId="759B9007" w14:textId="52A83171" w:rsidR="000C046E" w:rsidRDefault="000C046E" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">Secondly, we can see that he is </w:t></w:r><w:r w:rsidR="00636136"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>heavily favoring the category of logic &amp; perceptual theory</w:t></w:r><w:r w:rsidR="004570D5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>—</w:t></w:r><w:r w:rsidR="00636136"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">we know from his biography above that in his own study this was his first exposure to the classics; </w:t></w:r><w:r w:rsidR="004570D5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">that he loved polemic both in his writings and on the monastic debate ground; </w:t></w:r><w:r w:rsidR="00A7430A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">that he was publicly known as a logician and even met his Root Lama at a logic lecture.  And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00A7430A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>of course</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00A7430A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> he has set many of his writings on other topics in debate format, as here in his commentary to the </w:t></w:r><w:r w:rsidR="00A7430A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Sixty Verses.</w:t></w:r></w:p><w:p w14:paraId="4C22D29D" w14:textId="77777777" w:rsidR="00600908" w:rsidRDefault="00600908" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr></w:p><w:p w14:paraId="08C0FCA5" w14:textId="35E821D9" w:rsidR="00600908" w:rsidRPr="00F11FA1" w:rsidRDefault="00600908" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">We might also note that in many of his colophons, </w:t></w:r><w:r w:rsidR="008C672E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">the full name that </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Je </w:t></w:r><w:r w:rsidR="008C672E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>prefer</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">s to </w:t></w:r><w:r w:rsidR="008C672E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">us for </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">himself </w:t></w:r><w:r w:rsidR="008C672E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>i</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">s </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Rikpa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Mawa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Darma </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Rinchen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> (Rigs-pa </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>smra-ba</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Dar-ma Rin-</w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>chen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidR="00F11FA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">: </w:t></w:r><w:r w:rsidR="00F11FA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">Darma </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00F11FA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Rinchen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00F11FA1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>, Logic Whisperer.</w:t></w:r></w:p><w:p w14:paraId="6C03223C" w14:textId="77777777" w:rsidR="00F47DE0" w:rsidRDefault="00F47DE0" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr></w:p><w:p w14:paraId="693EFD73" w14:textId="4755C244" w:rsidR="0069156F" w:rsidRDefault="00F47DE0" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">Third, there is an almost odd absence of anything but </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">major </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">works here.  In Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> collected writings, for example, we have one “work”</w:t></w:r><w:r w:rsidR="00D454AA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> listed</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> which is </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>actually 135</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00D454AA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">brief pieces.  These include personal letters and brief poems or eulogies or the like.  However, we cannot call them “minor works,” as some have been wont to do—for they include pieces like </w:t></w:r><w:r w:rsidR="0080273C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>the</w:t></w:r><w:r w:rsidR="00D454AA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Three Principal Paths </w:t></w:r><w:r w:rsidR="0080273C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">that have become recognized as great spiritual </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0080273C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>classics in their own right</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="0080273C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="00117481"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00117481"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00117481"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Je </w:t></w:r><w:r w:rsidR="0077518B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">though </w:t></w:r><w:r w:rsidR="00117481"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>has nothing but hundreds-of-pages monsters.</w:t></w:r></w:p><w:p w14:paraId="556A6E22" w14:textId="77777777" w:rsidR="0069156F" w:rsidRDefault="0069156F" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr></w:p><w:p w14:paraId="03F57BFC" w14:textId="68EBA7F4" w:rsidR="0069156F" w:rsidRDefault="0069156F" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">At any rate, we can say about </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Je that his habit was to take major topics—major classics—and write major commentaries about them.</w:t></w:r><w:r w:rsidR="00214744"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">  He fearlessly tackled the most difficult </w:t></w:r><w:r w:rsidR="00173167"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>subjects</w:t></w:r><w:r w:rsidR="00214744"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">; in the inter-monastic competitions at the annual winter debates between the cream of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00214744"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>geshe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00214744"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> candidates from the Great Three monasteries of the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00214744"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Tsongkapian</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00214744"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> tradition, </w:t></w:r><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">the standard text used is </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">s </w:t></w:r><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Sunlight on the Path to Freedom</w:t></w:r><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">—his extraordinary explanation of Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>Dharmakirti</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="000618E9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:i/><w:iCs/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">Commentary on Accurate Perception.  </w:t></w:r><w:r w:rsidR="0088168A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">In a month of </w:t></w:r><w:r w:rsidR="009A3607"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>all-day</w:t></w:r><w:r w:rsidR="0088168A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> public debate, sometimes going all night</w:t></w:r><w:r w:rsidR="009A3607"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve"> as well</w:t></w:r><w:r w:rsidR="0088168A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">, it is </w:t></w:r><w:r w:rsidR="008D5247"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t xml:space="preserve">rare to </w:t></w:r><w:r w:rsidR="00AD7C33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>cover more than the first few pages of this deep commentary</w:t></w:r><w:r w:rsidR="007D12E0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr><w:t>—which we may consider the greatest of all his works.</w:t></w:r></w:p><w:p w14:paraId="25DA8EB7" w14:textId="77777777" w:rsidR="007D12E0" w:rsidRDefault="007D12E0" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7D22988D" w14:textId="5AC6EB57" w:rsidR="001B4861" w:rsidRDefault="001B4861" w:rsidP="00586915"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Courier New"/><w:lang w:eastAsia="en-US"/></
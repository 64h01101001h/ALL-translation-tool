C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Suppose that,</w:t></w:r></w:p><w:p w14:paraId="194B3E9A" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Subsequent to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the point</w:t></w:r></w:p><w:p w14:paraId="76AD6A0A" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Where we perceive things,</w:t></w:r></w:p><w:p w14:paraId="75CA0880" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>There were for this</w:t></w:r></w:p><w:p w14:paraId="62B514E7" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Various aspects.</w:t></w:r></w:p><w:p w14:paraId="57EFCC3D" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="257B36B3" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those who truly have no wisdom—</w:t></w:r></w:p><w:p w14:paraId="02EE3225" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those who imagine</w:t></w:r></w:p><w:p w14:paraId="07066300" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That there is a starting</w:t></w:r></w:p><w:p w14:paraId="1B10BB44" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Even to entities</w:t></w:r></w:p><w:p w14:paraId="6BECD604" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Which are extremely subtle—</w:t></w:r></w:p><w:p w14:paraId="77DB3C7E" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Have failed to see</w:t></w:r></w:p><w:p w14:paraId="30AC988C" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>What it means</w:t></w:r></w:p><w:p w14:paraId="6865068D" w14:textId="77777777" w:rsidR="00135C38" w:rsidRDefault="00135C38" w:rsidP="00135C38"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For things to arise from factors.</w:t></w:r></w:p><w:p w14:paraId="6F5429AF" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0AD01E8E" w14:textId="00DE33F1" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4A3E8CE8" w14:textId="5DE9DD7D" w:rsidR="004D7236" w:rsidRDefault="004D7236" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N80]</w:t></w:r></w:p><w:p w14:paraId="6D30EA5A" w14:textId="7F5DDAFE" w:rsidR="00BE64E0" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DE KHO NA NYID LA MI MKHAS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I DNGOS SMRA BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I LUGS MA MTHONG BA DES, RKYEN RTEN CING </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">BREL PAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>BYUNG BA RO GCIG PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I DON MNGON DU MA MTHONG BAR THAL, DNGOS PO SHIN TU PHRA BA RTEN CING </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">BREL BAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>BYUNG BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I RDUL PHRA RAB LA SOGS PA RANG GI MTSAN NYID KYIS SKYE BA RNAM PAR BTAGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00806DDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="037FFC6C" w14:textId="77777777" w:rsidR="001039CE" w:rsidRDefault="001039CE" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7E5F11ED" w14:textId="7EAE9685" w:rsidR="001039CE" w:rsidRDefault="001039CE" w:rsidP="0098699E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s consider those who belong to schools of thought where they say that </w:t></w:r><w:r w:rsidR="0043398C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>functioning things exist in &amp; of themselves; that is, schools of thought for those who are not wise in the ways of suchness: those who cannot see.</w:t></w:r></w:p><w:p w14:paraId="07765601" w14:textId="77777777" w:rsidR="0098699E" w:rsidRDefault="0098699E" w:rsidP="0098699E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="37F4619E" w14:textId="00DAE473" w:rsidR="0098699E" w:rsidRDefault="002701B1" w:rsidP="0098699E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>They cannot have seen, directly, that “single taste” of factors, of things that occur in a dependent relationship.</w:t></w:r></w:p><w:p w14:paraId="49E077EE" w14:textId="77777777" w:rsidR="002701B1" w:rsidRDefault="002701B1" w:rsidP="0098699E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="337F6697" w14:textId="1D5731FF" w:rsidR="002701B1" w:rsidRDefault="003D49B8" w:rsidP="0098699E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And that</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s because they </w:t></w:r><w:r w:rsidR="00FE3986"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>fantasize that there is a way that extremely subtle entities—atomic particles or the like which occur in a process of dependent relationship—</w:t></w:r><w:r w:rsidR="00905DAE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arise through some quality of their own.</w:t></w:r></w:p><w:p w14:paraId="4DE8A0FA" w14:textId="77777777" w:rsidR="0067328B" w:rsidRDefault="0067328B" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2C3EA24C" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="12FBBE87" w14:textId="5EFAED6F" w:rsidR="004D7236" w:rsidRDefault="004D7236" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N81]</w:t></w:r></w:p><w:p w14:paraId="79E5199F" w14:textId="69912705" w:rsidR="00BE64E0" w:rsidRPr="00C866C5" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>KHYAB PAR THAL, RANG GI MTSAN NYID KYIS SKYE BA YO</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>D NA CHOS DON DAM PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I BDEN PA SNGAR MA SHES GSAR DU SHES PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I MJUG THOGS SU [f. 5a] MI RTAG PA LA SOGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I DON DAM PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I BDEN PA MTHONG LAM GYI SKABS DER, RNAM PA MI </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DRA BA SO SOR GCOD DGOS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00C866C5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="6514D033" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6A841841" w14:textId="1F68CF54" w:rsidR="00BE64E0" w:rsidRDefault="00DC4799" w:rsidP="003C24A4"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And </w:t></w:r><w:r w:rsidR="003C24A4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the reason we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="003C24A4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ve given</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> here certainly does imply our conclusion,</w:t></w:r></w:p><w:p w14:paraId="08B485DC" w14:textId="77777777" w:rsidR="003C24A4" w:rsidRDefault="003C24A4" w:rsidP="003C24A4"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="19AF1EF8" w14:textId="290DCD2B" w:rsidR="003C24A4" w:rsidRPr="002427B7" w:rsidRDefault="003568FC" w:rsidP="003C24A4"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Because if there did exist such a thing as things starting through some quality of their own, </w:t></w:r><w:r w:rsidR="007C29A4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">then following upon </w:t></w:r><w:r w:rsidR="00F9675C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>our</w:t></w:r><w:r w:rsidR="007C29A4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> new </w:t></w:r><w:r w:rsidR="00F9675C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>understanding of what we did not understand before—about “things</w:t></w:r><w:r w:rsidR="004B26FB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">,” or ultimate reality; then </w:t></w:r><w:r w:rsidR="00311A13"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">at that point in time, upon the path where we see, see the ultimate truth about things like impermanence and the rest, </w:t></w:r><w:r w:rsidR="00F332A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">we would have to perceive those things in different aspects: we would have to be </w:t></w:r><w:r w:rsidR="009C3958"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>breaking things into these dissimilar aspects.</w:t></w:r></w:p><w:p w14:paraId="68A36CBF" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="608FD43F" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5B739FBA" w14:textId="269E222A" w:rsidR="004D7236" w:rsidRDefault="004D7236" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N82]</w:t></w:r></w:p><w:p w14:paraId="08CE4E34" w14:textId="593B71FD" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">YANG NA, DNGOS PO SMRA BA DE DAG GIS RTEN CING </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">BREL PAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>BYUNG BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I DON PHYIN CI MA LOG PA MA MTHONG ZHES </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="6D9AE825" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2807F4EF" w14:textId="0F0FBD02" w:rsidR="00574E9D" w:rsidRDefault="00574E9D" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>You could also gloss these lines as</w:t></w:r><w:r w:rsidR="006A2A72"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="007A52CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">describing how those that hold functioning things to exist in &amp; of themselves </w:t></w:r><w:r w:rsidR="005629A6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>have not yet seen the unmistaken meaning of how things occur in a dependent relationship.</w:t></w:r></w:p><w:p w14:paraId="0FAC91C1" w14:textId="77777777" w:rsidR="00574E9D" w:rsidRDefault="00574E9D" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:color w:val="000000" w:themeColor="text1"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0EA2E949" w14:textId="77777777" w:rsidR="00574E9D" w:rsidRPr="002427B7" w:rsidRDefault="00574E9D" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5BC44BFF" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="14A46163" w14:textId="39456D93" w:rsidR="00BE64E0" w:rsidRDefault="00882452" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>How the ending of something</w:t></w:r></w:p><w:p w14:paraId="3157005C" w14:textId="1A494617" w:rsidR="00882452" w:rsidRDefault="00882452" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>cannot exist</w:t></w:r></w:p><w:p w14:paraId="625A24DA" w14:textId="77777777" w:rsidR="00B76B3B" w:rsidRDefault="00B76B3B" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1B915AC2" w14:textId="39574CBF" w:rsidR="004D7236" w:rsidRDefault="004D7236" w:rsidP="00B76B3B"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N83]</w:t></w:r></w:p><w:p w14:paraId="7CFF75D2" w14:textId="4C6E9B83" w:rsidR="00B76B3B" w:rsidRPr="002427B7" w:rsidRDefault="00B76B3B" w:rsidP="00B76B3B"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GNYIS PA LA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GAG PA RDZAS GRUB </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DGAG ,SGYU</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> MA LTA BU</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GOG PA SGRUB PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,,</w:t></w:r></w:p><w:p w14:paraId="6F57E615" w14:textId="77777777" w:rsidR="00B76B3B" w:rsidRDefault="00B76B3B" w:rsidP="00B76B3B"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="283A0166" w14:textId="229A3FDF" w:rsidR="00A820FB" w:rsidRDefault="00FC6090" w:rsidP="00A820FB"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This brings us to our </w:t></w:r><w:r w:rsidR="002525CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">second point in this discussion on nirvana, which is </w:t></w:r><w:r w:rsidR="00A820FB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>showing how our own position on the question is correct.</w:t></w:r><w:r w:rsidR="002525CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  Here we proceed in two steps</w:t></w:r><w:r w:rsidR="00605F88"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of</w:t></w:r><w:r w:rsidR="002525CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (1) </w:t></w:r><w:r w:rsidR="00C0683E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">denying that there could be such a thing as a cessation which existed in a substantial way; and (2) proving the idea of a cessation that </w:t></w:r><w:r w:rsidR="00AC6955"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>i</w:t></w:r><w:r w:rsidR="00C0683E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00C0683E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>similar to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00C0683E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a magical illusion.</w:t></w:r></w:p><w:p w14:paraId="38D0F6B7" w14:textId="77777777" w:rsidR="00C0683E" w:rsidRDefault="00C0683E" w:rsidP="00A820FB"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="54F64074" w14:textId="77777777" w:rsidR="00B76B3B" w:rsidRPr="002427B7" w:rsidRDefault="00B76B3B" w:rsidP="00B76B3B"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="65281B25" w14:textId="5BE5B5C0" w:rsidR="004D7236" w:rsidRDefault="004D7236" w:rsidP="00B76B3B"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N84]</w:t></w:r></w:p><w:p w14:paraId="5FC0A825" w14:textId="06138F64" w:rsidR="00B76B3B" w:rsidRPr="002427B7" w:rsidRDefault="00B76B3B" w:rsidP="00B76B3B"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-
<w:proofErr w:type="spellEnd"/><w:r w:rsidR="00DD7EC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> by The Arya himself.  </w:t></w:r><w:r w:rsidR="00723332"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>But we have not found any other full explanation of the text from ancient India.</w:t></w:r></w:p><w:p w14:paraId="383863DC" w14:textId="665BD1FA" w:rsidR="00723332" w:rsidRDefault="00723332" w:rsidP="002D6B6E"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6B93429A" w14:textId="7A10C92D" w:rsidR="00723332" w:rsidRDefault="00AA1D77" w:rsidP="002D6B6E"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Buton Rinpoche mentions “a short piece drawn from the </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and explained in brief,” </w:t></w:r><w:r w:rsidR="001F1C4D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">written by Acharya </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="001F1C4D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Vairochana</w:t></w:
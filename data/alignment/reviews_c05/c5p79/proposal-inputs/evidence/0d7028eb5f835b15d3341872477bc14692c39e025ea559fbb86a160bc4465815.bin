"gramEnd"/><w:r w:rsidR="00A01797"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, according to the dictates of their karma, and their negative emotions.  </w:t></w:r><w:r w:rsidR="00BA51C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We can also refer to them as </w:t></w:r><w:r w:rsidR="0076080C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“those who keep</w:t></w:r><w:r w:rsidR="00EA59CF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to</w:t></w:r><w:r w:rsidR="0076080C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a real self,” </w:t></w:r><w:r w:rsidR="00571836"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>since they hold to themselves as being inseparable from the parts that make them up.</w:t></w:r></w:p><w:p w14:paraId="6546B188" w14:textId="77777777" w:rsidR="00BA51C9" w:rsidRDefault="00BA51C9" w:rsidP="005C6A94"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="299A04BE" w14:textId="77777777" w:rsidR="00BA51C9" w:rsidRDefault="00BA51C9" w:rsidP="005C6A94"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4848B39A" w14:textId="1833D807" w:rsidR="0078273E" w:rsidRPr="00F06A5B" w:rsidRDefault="0078273E" w:rsidP="00BA51C9"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/>
r><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And that is true because those things which comprise the complete opposites that people hold to—that things could </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>actually be</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="002C5973"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>happiness</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> or the like—</w:t></w:r><w:r w:rsidR="00615B7E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">do not exist </w:t></w:r><w:r w:rsidR="00607254" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">even in a deceptive way as </w:t></w:r><w:r w:rsidR="00C37F0E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>composites of th</w:t></w:r><w:r w:rsidR="002812D5" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ese supposed qualities</w:t></w:r><w:r w:rsidR="00607254" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="13B84FEE" w14:textId="77777777" w:rsidR="00B00F0C" w:rsidRPr="002427B7" w:rsidRDefault="00B00F0C" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5DC53294" w14:textId="77777777" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="00342327" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="713238A5" w14:textId="209B08C0" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="00476525" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S2</w:t></w:r><w:r w:rsidR="004F4E7D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>2</w:t></w:r><w:r w:rsidR="00342327" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="2EB40CD3" w14:textId="37C8FE5F" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="00342327" w:rsidP="00342327"><w:
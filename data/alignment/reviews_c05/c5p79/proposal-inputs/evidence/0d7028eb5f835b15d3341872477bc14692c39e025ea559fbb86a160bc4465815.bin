:rsidR="00E77B0D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I TSANGS PA SOGS LA BDEN PAR SNANG BA DE DAG </w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="00E77B0D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PHAGS PA RNAMS KYIS RDZUN PAR GZIGS ZHES PA SANGS RGYAS KYIS GSUNGS PA</w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00E77B0D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="494E1472" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5373423D" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It is indeed the case that there is not the slightest factor in the universe left over, if you eliminate all those which are </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>similar to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a magical illusion,</w:t></w:r></w:p><w:p w14:paraId="07C0FC6C" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="11A0820B" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because—let us consider the perceptions of beings such as Pure One: perceptions which are considered, among those of the world, to be accurate, and which these beings use to see objects which are far beyond the normal powers of sense.  Things appear, to these perceptions, to exist in reality; whereas the Buddha stated that realized beings see that the perceptions themselves are nothing but a lie.</w:t></w:r></w:p><w:p w14:paraId="55A9AC6C" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="69488F90" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1FB86979" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRPr="002427B7" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00B2F87D" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Logical</w:t></w:r><w:r w:rsidRPr="00A4300D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>support</w:t></w:r></w:p><w:p w14:paraId="6CF3895B" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRPr="002427B7" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>for the stages of sight</w:t></w:r></w:p><w:p w14:paraId="55E95FDE" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRPr="002427B7" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15C59847" w14:textId="4AB221AC" w:rsidR="00325DCD" w:rsidRDefault="00325DCD" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val=
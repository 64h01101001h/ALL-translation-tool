r></w:p><w:p w14:paraId="605EDBE7" w14:textId="46BB001D" w:rsidR="00A658FC" w:rsidRPr="002427B7" w:rsidRDefault="00A658FC" w:rsidP="00A658FC"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And this is why the Master himself has said,</w:t></w:r></w:p><w:p w14:paraId="0F0039DF" w14:textId="16B8D19E" w:rsidR="00842F78" w:rsidRPr="002427B7" w:rsidRDefault="00842F78" w:rsidP="00A658FC"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4B4E5751" w14:textId="2E967E77" w:rsidR="00842F78" w:rsidRPr="002427B7" w:rsidRDefault="00842F78" w:rsidP="008372BB"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I have no debate with you,</w:t></w:r></w:p><w:p w14:paraId="5E7E5BBE" w14:textId="2680C042" w:rsidR="00842F78" w:rsidRPr="002427B7" w:rsidRDefault="00842F78" w:rsidP="008372BB"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Whether you seek to prove</w:t></w:r></w:p><w:p w14:paraId="345C71D4" w14:textId="6CBEA5A2" w:rsidR="00842F78" w:rsidRPr="002427B7" w:rsidRDefault="00842F78" w:rsidP="008372BB"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Or disprove that these things</w:t></w:r></w:p><w:p w14:paraId="68E517AF" w14:textId="3F3D8678" w:rsidR="00842F78" w:rsidRPr="002427B7" w:rsidRDefault="00842F78" w:rsidP="008372BB"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Could be seen,</w:t></w:r><w:r w:rsidR="0004484A" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> in </w:t></w:r><w:r w:rsidR="00F33358"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r w:rsidR="0004484A" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of</w:t></w:r><w:r w:rsidR="00C91A7D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> themselves,</w:t></w:r></w:p><w:p w14:paraId="5735A8A1" w14:textId="0184779F" w:rsidR="00C56F30" w:rsidRPr="002427B7" w:rsidRDefault="00C91A7D" w:rsidP="00C91A7D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>B</w:t></w:r><w:r w:rsidR="0004484A" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>y a perception</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> t</w:t></w:r><w:r w:rsidR="0004484A" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>hat was direct</w:t></w:r><w:r w:rsidR="007F3C4C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r></w:p><w:p w14:paraId="2BA7F0A5" w14:textId="5948C469" w:rsidR="0004484A" w:rsidRPr="002427B7" w:rsidRDefault="00C56F30" w:rsidP="008372BB"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O</w:t></w:r><w:r w:rsidR="0004484A" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>r any</w:t></w:r><w:r w:rsidR="00DB04AE" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">other </w:t></w:r><w:r w:rsidR="007153F8" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>kind.</w:t></w:r><w:r w:rsidR="000C1101" w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="243"/></w:r></w:p><w:p w14:paraId="0528B2B4" w14:textId="18170574" w:rsidR="00842F78" w:rsidRPr="002427B7" w:rsidRDefault="00842F78" w:rsidP="00672738"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="463900EB" w14:textId="77777777" w:rsidR="00672738" w:rsidRPr="002427B7" w:rsidRDefault="00672738" w:rsidP="00672738"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="461EEE69" w14:textId="43F332C0" w:rsidR="000A1EA8" w:rsidRPr="002427B7" w:rsidRDefault="000A1EA8" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A68</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="52F4AD8B" w14:textId="552243A7" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GANG GI PHYIR DE LTAR PHYIN CI LOG PA DANG PHYIN CI MA LOG PA DAG THA DAD PA DE</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR, PHYIN CI MA LOG PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I GNAS SKABS NA PHYIN CI LOG YOD PA MA YIN PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR NA, GANG ZHIG CHOS CAN NYID DU </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GYUR BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I MIG KUN RDZOB PA GA LA YOD,</w:t></w:r></w:p><w:p w14:paraId="1DE40DF7" w14:textId="50F86E42" w:rsidR="00815AB9" w:rsidRPr="002427B7" w:rsidRDefault="00815AB9" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="65AAB649" w14:textId="660C5A24" w:rsidR="00815AB9" w:rsidRPr="002427B7" w:rsidRDefault="00445F60" w:rsidP="00F732A6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Now suppose it really is the case that a state of mind which is entirely mistaken is </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>completely separate</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> from one which is not mistaken in any way.</w:t></w:r><w:r w:rsidR="00771948" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  This means that—in an instance where the mind was not mistaken</w:t></w:r><w:r w:rsidR="00A83640" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—there could not be present a state of mind which was mistaken.  </w:t></w:r><w:r w:rsidR="007B1DCF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>How then could we have a sense power of the eye which was deceptive, and which was supplying this very subject to be considered?</w:t></w:r></w:p><w:p w14:paraId="02EAF2A5" w14:textId="3C16CD16" w:rsidR="006E4817" w:rsidRPr="002427B7" w:rsidRDefault="006E4817" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="51C68B0D" w14:textId="77777777" w:rsidR="006E4817" w:rsidRPr="002427B7" w:rsidRDefault="006E4817" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0F488C34" w14:textId="33DD1688" w:rsidR="006E4817" w:rsidRPr="002427B7" w:rsidRDefault="006E4817" w:rsidP="006E4817"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A69</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="365AB0A8" w14:textId="73F18A76" w:rsidR="006E4817" w:rsidRPr="002427B7" w:rsidRDefault="006E4817" w:rsidP="006E4817"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DE</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR GZHI MA GRUB PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYOGS KYI SKYON DANG GZHI MA GRUB PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I GTAN TSIGS KYI SKYON LDOG PA MED PAS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DI LAN MA YIN PA NYID DO</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, ,ZHES</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> GSUNGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I</w:t></w:r></w:p><w:p w14:paraId="1F584FFB" w14:textId="1A01083C" w:rsidR="006E4817" w:rsidRPr="002427B7" w:rsidRDefault="006E4817" w:rsidP="006E4817"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="34A5942E" w14:textId="6A961278" w:rsidR="006E4817" w:rsidRPr="002427B7" w:rsidRDefault="002764A6" w:rsidP="001C26DE"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As such, your proposed solution is no solution at all</w:t></w:r><w:r w:rsidR="00DE16BE" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—for you cannot escape the </w:t></w:r><w:r w:rsidR="00570462" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">defect of your subject here where it simply cannot exist; and neither </w:t></w:r><w:r w:rsidR="00835869" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">then </w:t></w:r><w:r w:rsidR="00570462" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">can you escape the same </w:t></w:r><w:r w:rsidR="001B3EC1" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">defect with </w:t></w:r><w:r w:rsidR="00FF5F00" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>your syllogism itself</w:t></w:r><w:r w:rsidR="0011132E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="0FB29D71" w14:textId="7721D881" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="006827A6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:tabs><w:tab w:val="left" w:pos="494"/></w:tabs><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4151812C" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:b/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="75B085C4" w14:textId="6CBA8A70" w:rsidR="000A1EA8" w:rsidRPr="002427B7" w:rsidRDefault="000A1EA8" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A70</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Li
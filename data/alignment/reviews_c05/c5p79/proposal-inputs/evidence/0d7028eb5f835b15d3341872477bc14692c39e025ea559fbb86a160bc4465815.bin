Pr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">these things are </w:t></w:r><w:r w:rsidR="00B3259E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">established only </w:t></w:r><w:r w:rsidR="0092318E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">towards their consciousness; </w:t></w:r><w:r w:rsidR="00EF1695"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">even </w:t></w:r><w:r w:rsidR="00C813C4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>as</w:t></w:r><w:r w:rsidR="00EF1695"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> that consciousness is </w:t></w:r><w:r w:rsidR="00CB0B6C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">itself </w:t></w:r><w:r w:rsidR="00A35012"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>only attributed to them.</w:t></w:r></w:p><w:p w14:paraId="6577FFAE" w14:textId="77777777" w:rsidR="00CD2EF0" w:rsidRDefault="00CD2EF0" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="460B6FAA" w14:textId="77777777" w:rsidR="00CD2EF0" w:rsidRDefault="00CD2EF0" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="05BF1B20" w14:textId="77777777" w:rsidR="00255A56" w:rsidRD
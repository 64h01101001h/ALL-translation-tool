"720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00137C97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of their very nature,</w:t></w:r></w:p><w:p w14:paraId="7DC3249F" w14:textId="77777777" w:rsidR="00137C97" w:rsidRPr="00137C97" w:rsidRDefault="00137C97" w:rsidP="00137C97"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4260E3EB" w14:textId="77777777" w:rsidR="00137C97" w:rsidRPr="00137C97" w:rsidRDefault="00137C97" w:rsidP="00137C97"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00137C97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And he also taught these two,</w:t></w:r></w:p><w:p w14:paraId="1A148777" w14:textId="77777777" w:rsidR="00137C97" w:rsidRPr="00137C97" w:rsidRDefault="00137C97" w:rsidP="00137C97"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00137C97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Where there is no more arising.</w:t></w:r></w:p><w:p w14:paraId="595232E7" w14:textId="77777777" w:rsidR="00B1772B" w:rsidRDefault="00B1772B" w:rsidP="00CC26AB"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="59B61196" w14:textId="77777777" w:rsidR="00B1772B" w:rsidRDefault="00B1772B
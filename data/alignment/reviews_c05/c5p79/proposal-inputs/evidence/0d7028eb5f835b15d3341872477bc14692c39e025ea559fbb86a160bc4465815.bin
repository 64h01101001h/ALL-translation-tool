alatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Since at the point where we have reached nirvana with nothing left over it would be incorrect to say that there was any longer someone doing the achieving, then </w:t></w:r><w:r w:rsidR="003D6C3C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">there would be </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">no one </w:t></w:r><w:r w:rsidR="007B583B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">at all </w:t></w:r><w:r w:rsidR="003D6C3C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>who was bringing the nirvana about.</w:t></w:r></w:p><w:p w14:paraId="1C18EE12" w14:textId="77777777" w:rsidR="00A7202A" w:rsidRPr="002427B7" w:rsidRDefault="00A7202A" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5F21564A" w14:textId="77777777" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="00342327" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="009E3FD9" w14:textId="33D4AA24" w:rsidR="00140194" w:rsidRPr="002427B7" w:rsidRDefault="00476525" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang
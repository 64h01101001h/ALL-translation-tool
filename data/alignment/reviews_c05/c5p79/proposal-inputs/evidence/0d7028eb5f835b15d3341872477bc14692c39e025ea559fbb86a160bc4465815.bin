otype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Or maybe you could propose some other unacceptable theory, like saying that it all just </w:t></w:r><w:r w:rsidR="00ED01EC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>blinks out of existence</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>?</w:t></w:r></w:p><w:p w14:paraId="6BB4AAAD" w14:textId="77777777" w:rsidR="009E4623" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5D1F2319" w14:textId="77777777" w:rsidR="00151A8A" w:rsidRPr="002427B7" w:rsidRDefault="00151A8A" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0C467C3F" w14:textId="699A12F4" w:rsidR="004F028F" w:rsidRDefault="004F028F" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S728]</w:t></w:r></w:p><w:p w14:paraId="0D049940" w14:textId="1B7101BA" w:rsidR="009E4623" w:rsidRPr="002427B7" w:rsidRDefault="009E4623" w:rsidP="009E4623"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,CHOS</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="P
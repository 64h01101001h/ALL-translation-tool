><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>To hearing about it.</w:t></w:r></w:p><w:p w14:paraId="4F45DB46" w14:textId="77777777" w:rsidR="00FB5886" w:rsidRDefault="00FB5886" w:rsidP="00FB5886"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="45F9E346" w14:textId="77777777" w:rsidR="00FB5886" w:rsidRDefault="00FB5886" w:rsidP="00FB5886"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those worst of the worst,</w:t></w:r></w:p><w:p w14:paraId="1E90BBEA" w14:textId="77777777" w:rsidR="00FB5886" w:rsidRDefault="00FB5886" w:rsidP="00FB5886"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Who stop performing merit,</w:t></w:r></w:p><w:p w14:paraId="64CE24C6" w14:textId="3185BE6D" w:rsidR="00255A56" w:rsidRDefault="00FB5886" w:rsidP="00FB5886"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ruin their life.</w:t></w:r></w:p><w:p w14:paraId="26FD6946" w14:textId="77777777" w:rsidR="00FB5886" w:rsidRPr="006C608E" w:rsidRDefault="00FB5886" w:rsidP="00FB5886"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype
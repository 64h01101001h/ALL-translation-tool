<w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t>1</w:t></w:r><w:r w:rsidR="00DD67A0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve">) </w:t></w:r><w:r w:rsidRPr="00FA3CCC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidR="00DD67A0" w:rsidRPr="00FA3CCC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t>hey have no “place,”</w:t></w:r><w:r w:rsidR="00DD67A0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve"> or basis, which is real.</w:t></w:r></w:p><w:p w14:paraId="67D69684" w14:textId="77777777" w:rsidR="00427E67" w:rsidRDefault="00427E67" w:rsidP="00427E67"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2EE2E0DD" w14:textId="1C227056" w:rsidR="00427E67" w:rsidRDefault="00427E67" w:rsidP="006032BD"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve">2) </w:t></w:r><w:r w:rsidR="006032BD" w:rsidRPr="003E4601"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/><w:i/><w:iCs/></w:rPr><w:t>Neither do they have any object of focus</w:t></w:r><w:r w:rsidR="006032BD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Ü-k‘˛"/></w:rPr><w:t xml:space="preserve"> which is something that really exists.</w:t></w:r></w:p><w:p w14:paraId="54915115" w14:textId="77777777" w:rsidR="00
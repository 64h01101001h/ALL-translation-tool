pe" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> they are not sustained.</w:t></w:r></w:p><w:p w14:paraId="06439CE1" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6AE61F27" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>They pour forth</w:t></w:r></w:p><w:p w14:paraId="19461CF2" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>From their cause,</w:t></w:r></w:p><w:p w14:paraId="31D13A78" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Of </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>misunderstanding;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="42BCDD2B" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>They have left behind</w:t></w:r></w:p><w:p w14:paraId="627D90B6" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Any starting, middle, or finish.</w:t></w:r></w:p><w:p w14:paraId="06258B02" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="69528CFD" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>They are like shoots of bamboo,</w:t></w:r></w:p><w:p w14:paraId="1EF7A7C5" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">With no essence </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>inside;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="1DEBEC96" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>They resemble the city</w:t></w:r></w:p><w:p w14:paraId="7EDFFCEC" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of the craving spirits.</w:t></w:r></w:p><w:p w14:paraId="71F6E00B" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="26FDFF02" w14:textId="77777777" w:rsidR="009D2F40" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>It is all a city of the ignorant,</w:t></w:r></w:p><w:p w14:paraId="46A2CEBB" w14:textId="792CB0B0" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="009D2F40" w:rsidP="009D2F40"><w:pPr><w:jc w:val="cent
ype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is perhaps the biggest winner, with over 20 references.  </w:t></w:r><w:r w:rsidR="00B358CB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here is how it reads:</w:t></w:r></w:p><w:p w14:paraId="237C6E1A" w14:textId="7798A9BE" w:rsidR="00B358CB" w:rsidRDefault="00B358CB" w:rsidP="00EB1DD2"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6910CA8F" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We observe what we call</w:t></w:r></w:p><w:p w14:paraId="4437CA02" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The wearing out,</w:t></w:r></w:p><w:p w14:paraId="2B4D8472" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Or coming to a rest,</w:t></w:r></w:p><w:p w14:paraId="57DEDB76" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>From the simple wearing out</w:t></w:r></w:p><w:p w14:paraId="1B9613BD" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of the cause.</w:t></w:r></w:p><w:p w14:paraId="677FF347" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="32A4DEC8" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>How could you ever say</w:t></w:r></w:p><w:p w14:paraId="7A037F63" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That something which</w:t></w:r></w:p><w:p w14:paraId="733AE5E8" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Could never have worn out</w:t></w:r></w:p><w:p w14:paraId="3592F9AE" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Through any nature of its own</w:t></w:r></w:p><w:p w14:paraId="6281608D" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00004D5A" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00004D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Wore out?</w:t></w:r></w:p><w:p w14:paraId="1861E0FC" w14:textId="441B56B0" w:rsidR="0066475B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="67D977A0" w14:textId="77777777" w:rsidR="008A6A10" w:rsidRDefault="008A6A10" w:rsidP="0066475B"><w:pPr><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="54BD4021" w14:textId="46B04DB1" w:rsidR="0035588D" w:rsidRDefault="008A6A10" w:rsidP="00E77CB1"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Conventional wisdom in the Eastern classics tells us that a cessation or stopping of, for example, an undesirable human quality </w:t></w:r><w:r w:rsidR="00E77CB1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is the simple absence of that quality, and thus </w:t></w:r><w:r w:rsidR="00CF3CF0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>represents</w:t></w:r><w:r w:rsidR="00E77CB1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> an unchanging </w:t></w:r><w:r w:rsidR="004255BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>thing—since you can</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="004255BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t be </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="004255BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>more or less absent</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="004255BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, when you</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="004255BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>re absent.</w:t></w:r></w:p><w:p w14:paraId="08B18646" w14:textId="1D78DC9F" w:rsidR="004255BA" w:rsidRDefault="004255BA" w:rsidP="00E77CB1"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5A21F7F1" w14:textId="6A396A87" w:rsidR="00D33448" w:rsidRDefault="009E430A" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Remember though that this verse appe</w:t></w:r><w:r w:rsidR="00057FEF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ared, in our topical summary above, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00057FEF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>inbetween</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00057FEF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a clarification of dependence, and a demonstration that the Buddha</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00057FEF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s earliest description</w:t></w:r><w:r w:rsidR="00D33448"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:r w:rsidR="00057FEF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of this principle </w:t></w:r><w:r w:rsidR="00D33448"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>were spoken with a grander scheme in mind</w:t></w:r><w:r w:rsidR="00BE5C44"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>: to bring the student further on towards the sacred space of emptiness.</w:t></w:r></w:p><w:p w14:paraId="6AC2435D" w14:textId="399F3E39" w:rsidR="00B47EFF" w:rsidRDefault="00B47EFF" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D22D8B7" w14:textId="6872DBC2" w:rsidR="00B47EFF" w:rsidRDefault="00B47EFF" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As such, the absence referred to here involves two very different vacancies</w:t></w:r><w:r w:rsidR="00D2063A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  </w:t></w:r><w:r w:rsidR="00DF2856"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">First, </w:t></w:r><w:r w:rsidR="00437F6A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the absence of any stopping of a changing entity which has </w:t></w:r><w:r w:rsidR="00437F6A" w:rsidRPr="005C01E8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>not</w:t></w:r><w:r w:rsidR="00437F6A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> resulted </w:t></w:r><w:r w:rsidR="008C2438"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>from the wearing out of its causes.  We have only to look at a worn-out shoe; or a sock with a hole in it; or a</w:t></w:r><w:r w:rsidR="003D0766"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">n uncooperative, aging automobile to appreciate this </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="003D0766"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>particular kind</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="003D0766"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of emptiness.</w:t></w:r></w:p><w:p w14:paraId="196591B9" w14:textId="546D2E04" w:rsidR="003D0766" w:rsidRDefault="00F200C4" w:rsidP="00F200C4"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/></w:r></w:p><w:p w14:paraId="1539D9C8" w14:textId="53083194" w:rsidR="003D0766" w:rsidRDefault="00151483" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Second, all absences—like all presences, in fact—reflect the “causes” of an ultimate stopping, which is </w:t></w:r><w:r w:rsidR="0096453A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the non-presence </w:t></w:r><w:r w:rsidR="0096453A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in every entity in the universe </w:t></w:r><w:r w:rsidR="0096453A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of existing from its own side, rather than from the seeds in our mind.</w:t></w:r></w:p><w:p w14:paraId="7C62E41D" w14:textId="78D61535" w:rsidR="004B5A2A" w:rsidRDefault="004B5A2A" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="47F88904" w14:textId="3F97B79A" w:rsidR="004B5A2A" w:rsidRDefault="004B5A2A" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here—at the juncture between the old school</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s dear principle of dependence, and the new school</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s cherished emptiness—the existential stopping in all entities allows the stopping of everything negative in life, and all suffering.  </w:t></w:r><w:r w:rsidR="0013643E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Once we understand that everything and everybody we ever meet is flowing from our own mental seeds, </w:t></w:r><w:r w:rsidR="0083795E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>it becomes pointless ever to blame anyone, or hurt anyone.</w:t></w:r></w:p><w:p w14:paraId="57C722DE" w14:textId="0D919543" w:rsidR="00B57CF1" w:rsidRDefault="00B57CF1" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2517F36C" w14:textId="431BD5A9" w:rsidR="00B57CF1" w:rsidRDefault="00B57CF1" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And when there</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s no longer any point to hurting anyone, we never again plant a negative seed.  </w:t></w:r><w:r w:rsidR="00C9797C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Without its seeds, suffering itself ceases in our world.</w:t></w:r></w:p><w:p w14:paraId="548B7D9C" w14:textId="065E9979" w:rsidR="00C9797C" w:rsidRDefault="00C9797C" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="76327B97" w14:textId="09BC3862" w:rsidR="00C9797C" w:rsidRDefault="00C9797C" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="03FCBDF6" w14:textId="0F02A33F" w:rsidR="00DC7CE7" w:rsidRDefault="00DC7CE7" w:rsidP="00805BEB"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nirvana, clarified</w:t></w:r></w:p><w:p w14:paraId="4E17EC9E" w14:textId="7000789A" w:rsidR="00C9671B" w:rsidRDefault="00E2432E" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Another particularly persistent verse from the </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>is the 35</w:t></w:r><w:r w:rsidRPr="00E2432E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:vertAlign w:val="superscript"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>th</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, which </w:t></w:r><w:r w:rsidR="009F0B9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>describes what this ceasing of suffering is like; in other words, which informs us of nirvana—</w:t></w:r></w:p><w:p w14:paraId="5D1FA434" w14:textId="21EB4D43" w:rsidR="009F0B9C" w:rsidRDefault="009F0B9C" w:rsidP="00BE5C44"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3DE78369" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The Victors have described nirvana</w:t></w:r></w:p><w:p w14:paraId="75A92D48" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As the only thing which is </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>true;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="763B10B3" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="52FC9272" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That being the case,</w:t></w:r></w:p><w:p w14:paraId="3E8AFD26" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>What person could there ever be</w:t></w:r></w:p><w:p w14:paraId="751E7D8F" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Who was wise</w:t></w:r></w:p><w:p w14:paraId="2DC3C03A" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And who thought</w:t></w:r></w:p><w:p w14:paraId="49B22C7D" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00882A22" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That the rest of things</w:t></w:r></w:p><w:p w14:paraId="536192D2" w14:textId="6082F355" w:rsidR="0066475B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Were</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00882A22"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> not things which were wrong?</w:t></w:r></w:p><w:p w14:paraId="1ABDFA31" w14:textId="0533FC60" w:rsidR="00882A22" w:rsidRDefault="00882A22" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3665A8CC" w14:textId="279FF812" w:rsidR="00882A22" w:rsidRDefault="000C5DDF" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">In our topical summary </w:t></w:r><w:r w:rsidR="007C4260"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>earlier on</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, we saw that this verse lies within what we called “the feeling of discovery,” </w:t></w:r><w:r w:rsidR="00327231"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">or the sensation of finally understanding </w:t></w:r><w:r w:rsidR="00692492"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>what the Teacher meant for us to learn all along, even when she or he was skirting the pith of the matter until they felt we were truly ready for it.</w:t></w:r></w:p><w:p w14:paraId="0EA14E1F" w14:textId="5D3EB388" w:rsidR="00DB199B" w:rsidRDefault="00DB199B" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="497A520E" w14:textId="53DBBBA3" w:rsidR="00DB199B" w:rsidRDefault="00DB199B" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The question of just what nirvana is has stood starkly </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>inbetween</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the old and new ways of Buddhism.  The main thrust of thinking before Nagarjuna said that—when a person achieves this </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>particular freedom</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> from the suffering world—it is because their physical form and mental processes have simply shut down, forever.  It sort of feels like cutting off your </w:t></w:r><w:r w:rsidR="00C35F1A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">whole </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arm, to cure a</w:t></w:r><w:r w:rsidR="00432A18"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">n open </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">cut on your </w:t></w:r><w:r w:rsidR="00F939AB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>palm</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="5F34B1C1" w14:textId="03941FB2" w:rsidR="00DB199B" w:rsidRDefault="00DB199B" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="64909653" w14:textId="4B08221B" w:rsidR="00DB199B" w:rsidRDefault="0071322F" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Nagarjuna and his ilk rejected this description of nirvana, and instead asserted that </w:t></w:r><w:r w:rsidR="003B06AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in its simpler form, </w:t></w:r><w:r w:rsidR="00D41949"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>nirvana</w:t></w:r><w:r w:rsidR="003B06AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> was the end of negative thoughts brought about by realizing how there is nothing in our life that is not coming from our own mental seeds: which is </w:t></w:r><w:r w:rsidR="003B06AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">not </w:t></w:r><w:r w:rsidR="003B06AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>my own fault.  Again, how can I strive against another person</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="003B06AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s behavior towards me, when I realize that this behavior is coming from myself?</w:t></w:r></w:p><w:p w14:paraId="2708E1FA" w14:textId="1AD1F130" w:rsidR="003B06AE" w:rsidRDefault="003B06AE" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="031E8F37" w14:textId="0A5C33DD" w:rsidR="003B06AE" w:rsidRDefault="00307CE7" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>In its deeper form</w:t></w:r><w:r w:rsidR="00446996"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—as we sense reflected in the </w:t></w:r><w:r w:rsidR="003D6677"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>opening lines of this verse—</w:t></w:r><w:r w:rsidR="00663C74"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nirvana as </w:t></w:r><w:r w:rsidR="00FD5B01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">freedom from unwanted baggage </w:t></w:r><w:r w:rsidR="006F5F3B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">does not require us to disappear physically and mentally from the world.  </w:t></w:r><w:r w:rsidR="008E4F86"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">When we stand in the presence of highest truth during the direct perception of reality, </w:t></w:r><w:r w:rsidR="00FB4A2F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">we stand </w:t></w:r><w:r w:rsidR="00703084"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">without </w:t></w:r><w:r w:rsidR="00703084"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">any </w:t></w:r><w:r w:rsidR="00703084"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">perception of </w:t></w:r><w:r w:rsidR="00703084"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">anything </w:t></w:r><w:r w:rsidR="00703084"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which is not totally real.</w:t></w:r><w:r w:rsidR="00744AD7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And it is in this sense that we have shed the suffering world.</w:t></w:r></w:p><w:p w14:paraId="0E3E6ECB" w14:textId="0C2D1C7E" w:rsidR="00DC7CE7" w:rsidRDefault="00DC7CE7" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="39AAD0D6" w14:textId="733D65A0" w:rsidR="00DC7CE7" w:rsidRDefault="00DC7CE7" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15709EBE" w14:textId="2BD0754B" w:rsidR="00805BEB" w:rsidRDefault="00E46854" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Imagination twins</w:t></w:r></w:p><w:p w14:paraId="3F1C10BA" w14:textId="7542D07F" w:rsidR="00805BEB" w:rsidRPr="00805BEB" w:rsidRDefault="00805BEB" w:rsidP="000C5DDF"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Another </w:t></w:r><w:r w:rsidR="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>bestselling verse that strongly survived the test of time during this last millennium follows closely after that last one about nirvana—</w:t></w:r></w:p><w:p w14:paraId="2E701941" w14:textId="77777777" w:rsidR="0066475B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Helvetica" w:hAnsi="Helvetica" w:cs="Helvetica"/><w:b/><w:bCs/><w:lang w:bidi="hi-IN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1D859AEC" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00885A20" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00885A20"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(37)</w:t></w:r></w:p><w:p w14:paraId="54FF651E" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The Buddhas have stated</w:t></w:r></w:p><w:p w14:paraId="64D705D7" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That the world is rooted</w:t></w:r></w:p><w:p w14:paraId="2807F00F" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>In misunderstanding.</w:t></w:r></w:p><w:p w14:paraId="539138F4" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0542C9C0" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Why then would it ever be</w:t></w:r></w:p><w:p w14:paraId="6E428DCF" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Incorrect to say</w:t></w:r></w:p><w:p w14:paraId="0A472DD9" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="0053349B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That this entire world</w:t></w:r></w:p><w:p w14:paraId="67B683D2" w14:textId="56881258" w:rsidR="0066475B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0053349B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Is our imagination?</w:t></w:r></w:p><w:p w14:paraId="3D348E43" w14:textId="24428771" w:rsidR="00F53981" w:rsidRDefault="00F53981" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2752D17E" w14:textId="3BE3080B" w:rsidR="00F53981" w:rsidRDefault="00F53981" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">When we read ancient texts that talk about the world we live in as being a figment of our imagination, then naturally </w:t></w:r><w:r w:rsidR="00AB48D9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">this can </w:t></w:r><w:r w:rsidR="00CA12D4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">invite feelings of </w:t></w:r><w:r w:rsidR="00EA784F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>nihilism: What</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00EA784F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s the point of being alive, if my whole life is just an unreal dream?</w:t></w:r></w:p><w:p w14:paraId="161BAE23" w14:textId="3EF43B5F" w:rsidR="00EA784F" w:rsidRDefault="00EA784F" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3A96905E" w14:textId="384C1C73" w:rsidR="00EA784F" w:rsidRDefault="00004F76" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">A careful reading of this </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>particular verse</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> corrects th</w:t></w:r><w:r w:rsidR="0064561D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>at</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="0064561D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">overly </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">extreme interpretation.  </w:t></w:r><w:r w:rsidR="00AB443D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">When we say that the world is a “product of our imagination,” </w:t></w:r><w:r w:rsidR="008F2CD9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>we have one of two things in mind.</w:t></w:r></w:p><w:p w14:paraId="5AEC2EBC" w14:textId="31C9BCA9" w:rsidR="008F2CD9" w:rsidRDefault="008F2CD9" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="23577B7C" w14:textId="6BD0FE2A" w:rsidR="008F2CD9" w:rsidRDefault="008F2CD9" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">One, </w:t></w:r><w:r w:rsidR="0094555E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">we </w:t></w:r><w:r w:rsidR="0094555E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">are </w:t></w:r><w:r w:rsidR="0094555E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">living in a world created by our own mind, but only in the sense that seeds planted within our mind by past moral or immoral behavior towards others are ripening and organizing the raw data around us into </w:t></w:r><w:r w:rsidR="00DD2DE3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>correspondingly pleasant or unpleasant objects.  Which is, of course, why some people say a song is fantastic when the same song sounds like a train wreck to someone else, possessed of different seeds.</w:t></w:r></w:p><w:p w14:paraId="4BB36FD1" w14:textId="3DD587C2" w:rsidR="00DD2DE3" w:rsidRDefault="00DD2DE3" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="43C5E75B" w14:textId="31DE7E1F" w:rsidR="00DD2DE3" w:rsidRDefault="00DD2DE3" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Please note: In this case the world around me is a result, in a way, of my imagination; but that </w:t></w:r><w:r w:rsidR="005E5300"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>absolutely doesn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="005E5300"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t make it anything less than real.  If you think it does, go out on a highway and stand in front of a speeding car and see if the steel bumper that </w:t></w:r><w:r w:rsidR="00DD6209"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>crushes</w:t></w:r><w:r w:rsidR="005E5300"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> your knee is real or not.</w:t></w:r></w:p><w:p w14:paraId="076ECDF4" w14:textId="5C8B8F23" w:rsidR="005E5300" w:rsidRDefault="005E5300" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="70FF16DE" w14:textId="6D2E13A1" w:rsidR="00DD6209" w:rsidRDefault="009C6BCF" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">On a deeper level, we live in a world of sheer imagination when we fail to recognize this other sense of imagination, this world created by my own mental seeds.  </w:t></w:r><w:r w:rsidR="0051506E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This is a different kind of imagination, where we think something is there that could never be there.  </w:t></w:r><w:r w:rsidR="00D0149C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A mirage in the desert—and nothing there to drink.</w:t></w:r></w:p><w:p w14:paraId="1BB3FF60" w14:textId="2ECEE972" w:rsidR="00D0149C" w:rsidRDefault="00D0149C" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="52DE8F9B" w14:textId="3F381B4E" w:rsidR="00AA5D1F" w:rsidRDefault="00AA5D1F" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="667C4BB0" w14:textId="15791920" w:rsidR="00AA5D1F" w:rsidRDefault="00D70265" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>It takes one to know one</w:t></w:r></w:p><w:p w14:paraId="581F9B8E" w14:textId="56DD2E41" w:rsidR="00CA734B" w:rsidRPr="00892961" w:rsidRDefault="00892961" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Our next popular survivor of the centuries appears </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>early on in the</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sixty Verses—</w:t></w:r></w:p><w:p w14:paraId="616359FB" w14:textId="3B7FE38D" w:rsidR="00D0149C" w:rsidRDefault="00D0149C" w:rsidP="00F53981"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="78EFF48C" w14:textId="14751FDE" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="004B3870"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(4)</w:t></w:r></w:p><w:p w14:paraId="25451181" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When we look at things</w:t></w:r></w:p><w:p w14:paraId="65BD448C" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As if they existed,</w:t></w:r></w:p><w:p w14:paraId="28FBA207" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We can never reach </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>liberation;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="5883A0FC" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4CC3D776" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When we look at them</w:t></w:r></w:p><w:p w14:paraId="102DA3A2" w14:textId="72D7EC53" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As if they didn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t exist,</w:t></w:r></w:p><w:p w14:paraId="41EB488E" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We can never escape</w:t></w:r></w:p><w:p w14:paraId="495B54F6" w14:textId="4CD14C9E" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="004B3870"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This cycle of pain.</w:t></w:r></w:p><w:p w14:paraId="4FD73D01" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0F4C2ED3" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Great beings</w:t></w:r></w:p><w:p w14:paraId="78AD17DC" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Achieve liberation</w:t></w:r></w:p><w:p w14:paraId="23795081" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="004B3870" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>By understanding, fully,</w:t></w:r></w:p><w:p w14:paraId="001228D4" w14:textId="21C749A9" w:rsidR="0066475B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="004B3870"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Things and the absence of things.</w:t></w:r></w:p><w:p w14:paraId="7561A33F" w14:textId="76EF1F05" w:rsidR="00E77A49" w:rsidRPr="005D157E" w:rsidRDefault="00E77A49" w:rsidP="005D157E"><w:pPr><w:pStyle w:val="NoSpacing"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1FE11001" w14:textId="1CBCD691" w:rsidR="00E77A49" w:rsidRDefault="00624594" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">According to our topical outline above, these lines are part of </w:t></w:r><w:r w:rsidR="00AD1788"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a section of our text</w:t></w:r><w:r w:rsidR="0074402A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> where we learn that there are two—and only two—types of people in the universe.  Some have come to see, directly, that there is nothing at all out there which is </w:t></w:r><w:r w:rsidR="0074402A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">not </w:t></w:r><w:r w:rsidR="0074402A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">flowing from the seeds in our own mind; and </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0074402A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>thus</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="0074402A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> they have undergone the ultimately precious direct perception of emptiness.  Throughout this section, Nagarjuna refers to these people as “great beings,” </w:t></w:r><w:r w:rsidR="00657615"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">using the Sanskrit word </w:t></w:r><w:r w:rsidR="00657615"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">mahatma, </w:t></w:r><w:r w:rsidR="00871620"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>as it was rightfully used with Mahatma Gandhi.</w:t></w:r></w:p><w:p w14:paraId="13803991" w14:textId="392D2EB1" w:rsidR="00871620" w:rsidRDefault="00871620" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15650CED" w14:textId="631E2C68" w:rsidR="00871620" w:rsidRDefault="00944B8F" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Then there are people who have yet to see that life and the world are flowing from their own mental seeds; and throughout our texts here they are referred to as “infants,” in the sense of a very young child who simply doesn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t understand what is going on around them.  </w:t></w:r><w:r w:rsidR="009E3E50"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The kind of child who makes faces at the other baby in the mirror; as you and I do </w:t></w:r><w:r w:rsidR="00892CFC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>when, for example, “another” person criticizes us.</w:t></w:r></w:p><w:p w14:paraId="1C39DCBC" w14:textId="72D5D762" w:rsidR="00892CFC" w:rsidRDefault="00892CFC" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="10B4C88F" w14:textId="46BFFBE1" w:rsidR="00892CFC" w:rsidRDefault="0001453E" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Great beings have seen that nothing that is </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">not </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">coming from my own mental seeds was ever there; and they have seen that whatever they </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">do </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">see </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">coming from their seeds.  Throughout the ancient literature, such beings are referred to with the Sanskrit word </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00A95118"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which</w:t></w:r><w:r w:rsidR="00A95118"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> despite its profane use </w:t></w:r><w:r w:rsidR="00ED1B12"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">historically by the Nazi </w:t></w:r><w:r w:rsidR="00D41F13"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>political p</w:t></w:r><w:r w:rsidR="00ED1B12"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arty of the Second World War</w:t></w:r><w:r w:rsidR="006B1AB6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—</w:t></w:r><w:r w:rsidR="000C33E0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">does indeed refer to a “higher person,” but only in the sense of one who </w:t></w:r><w:r w:rsidR="0051332E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>has seen emptiness directly</w:t></w:r><w:r w:rsidR="00712574"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>;</w:t></w:r><w:r w:rsidR="0051332E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> and thus seen</w:t></w:r><w:r w:rsidR="000C33E0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> for example the ultimate </w:t></w:r><w:r w:rsidR="00E26F9F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>and correct self-interest</w:t></w:r><w:r w:rsidR="00AD4F7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of in fact </w:t></w:r><w:r w:rsidR="00AD4F7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">refusing </w:t></w:r><w:r w:rsidR="0042295C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ever </w:t></w:r><w:r w:rsidR="00AD4F7F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to harm another person.</w:t></w:r></w:p><w:p w14:paraId="4D202291" w14:textId="64DB055E" w:rsidR="00A42E94" w:rsidRDefault="00A42E94" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4169C82E" w14:textId="020C40A9" w:rsidR="00A42E94" w:rsidRPr="00AD4F7F" w:rsidRDefault="00220539" w:rsidP="0074402A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It takes one to know one, and throughout the 20 or so centuries after Nagarjuna lived, he has been known by the moniker of “The Arya,” </w:t></w:r><w:r w:rsidR="00815506"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">implying correctly that </w:t></w:r><w:r w:rsidR="00815506"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">he was perhaps the greatest of all people in history to directly see and </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00815506"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>then teach</w:t></w:r><w:r w:rsidR="00B5531D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00B5531D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to all of us,</w:t></w:r><w:r w:rsidR="00815506"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> emptiness.</w:t></w:r></w:p><w:p w14:paraId="3567015A" w14:textId="0413C1F8" w:rsidR="000C20CE" w:rsidRDefault="000C20CE" w:rsidP="00E77A49"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0504E8D1" w14:textId="77777777" w:rsidR="002E5133" w:rsidRDefault="002E5133" w:rsidP="00E77A49"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="112368B1" w14:textId="19539E06" w:rsidR="002E5133" w:rsidRDefault="002E5133" w:rsidP="00E77A49"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>The greatest hit of all time</w:t></w:r></w:p><w:p w14:paraId="37E1FA30" w14:textId="0EFB770F" w:rsidR="00813968" w:rsidRDefault="00766040" w:rsidP="00813968"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>By a huge amount, t</w:t></w:r><w:r w:rsidR="00813968"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">he most quoted lines, of all the lines, in the </w:t></w:r><w:r w:rsidR="00813968"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses </w:t></w:r><w:r w:rsidR="00813968"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">are those </w:t></w:r><w:r w:rsidR="0037395A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of</w:t></w:r><w:r w:rsidR="00813968"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the final, sixtieth verse—</w:t></w:r></w:p><w:p w14:paraId="73DD7A8E" w14:textId="77290661" w:rsidR="004866F3" w:rsidRDefault="004866F3" w:rsidP="004046FF"><w:pPr><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="543251A3" w14:textId="6D6FC4CA" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>By the goodness</w:t></w:r></w:p><w:p w14:paraId="2972B34E" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of what I have just done,</w:t></w:r></w:p><w:p w14:paraId="3055900D" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>May all beings</w:t></w:r></w:p><w:p w14:paraId="5D841EF5" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="30A48DD9" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Complete the collection</w:t></w:r></w:p><w:p w14:paraId="33E28670" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of merit &amp; wisdom,</w:t></w:r></w:p><w:p w14:paraId="144C50E7" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4EC87C11" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And thus gain the two</w:t></w:r></w:p><w:p w14:paraId="7C4C8352" w14:textId="77777777" w:rsidR="0066475B" w:rsidRPr="00761A33" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ultimate bodies</w:t></w:r></w:p><w:p w14:paraId="1E56D741" w14:textId="5E549281" w:rsidR="0066475B" w:rsidRDefault="0066475B" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00761A33"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That merit &amp; wisdom make.</w:t></w:r></w:p><w:p w14:paraId="6D854237" w14:textId="1C188D3F" w:rsidR="008B2422" w:rsidRDefault="008B2422" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="74EF624E" w14:textId="77777777" w:rsidR="00F73644" w:rsidRDefault="00F73644" w:rsidP="0066475B"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="35857E64" w14:textId="5A7EB487" w:rsidR="008B2422" w:rsidRDefault="008B2422" w:rsidP="004866F3"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As noted above in our topical summary,</w:t></w:r><w:r w:rsidR="004866F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> these are the</w:t></w:r><w:r w:rsidR="004866F3" w:rsidRPr="004866F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> “</w:t></w:r><w:r w:rsidR="004866F3" w:rsidRPr="004866F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>do it for a higher purpose”</w:t></w:r><w:r w:rsidR="004866F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> lines</w:t></w:r><w:r w:rsidR="008E74FD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.  Arya Nagarjuna knew—even before the impact study numbers came out—that he had done a great goodness for the world, for centuries to come</w:t></w:r><w:r w:rsidR="00B75478"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, by writing his </w:t></w:r><w:r w:rsidR="00B75478"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sixty Verses</w:t></w:r><w:r w:rsidR="008E74FD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.  As with everything else he ever owned (including his own head</w:t></w:r><w:r w:rsidR="00C43240"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, as we </w:t></w:r><w:r w:rsidR="00B43802"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>shall</w:t></w:r><w:r w:rsidR="00C43240"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> see</w:t></w:r><w:r w:rsidR="008E74FD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">), </w:t></w:r><w:r w:rsidR="00C43240"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">he decided to share this extraordinary act of good karma with </w:t></w:r><w:r w:rsidR="000C1CE1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">everyone in the world around him, </w:t></w:r><w:r w:rsidR="004450E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">to help </w:t></w:r><w:r w:rsidR="004450E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">them </w:t></w:r><w:r w:rsidR="004450E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>become fully Enlightened Being</w:t></w:r><w:r w:rsidR="00210D08"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:r w:rsidR="004450E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="6F3B1F3A" w14:textId="4A29D9AC" w:rsidR="008C79B3" w:rsidRDefault="008C79B3" w:rsidP="004866F3"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="42908103" w14:textId="1D19422A" w:rsidR="008C79B3" w:rsidRDefault="008C79B3" w:rsidP="004866F3"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And so thus, even today, it is a custom in Buddhist monasteries throughout Tibet to </w:t></w:r><w:r w:rsidR="00DF0BE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">repeat this last verse at the end of </w:t></w:r><w:r w:rsidR="00BC3A6F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>each &amp; every</w:t></w:r><w:r w:rsidR="00DF0BE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> virtuous activity—especially that of attending a </w:t></w:r><w:r w:rsidR="00A51F4D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Buddhist lesson with our own Teacher.</w:t></w:r><w:r w:rsidR="00736265"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  Are you curious, with us, how this custom may have started?  Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00736265"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s go on a side trip there</w:t></w:r><w:r w:rsidR="00A777B2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00736265"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidR="00FB52E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">then return to see if there are any </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00FB52E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>absolutely vital</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00FB52E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> verses or concepts that may </w:t></w:r><w:r w:rsidR="00FB52E1" w:rsidRPr="009E244B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>not</w:t></w:r><w:r w:rsidR="00FB52E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> have survived the last 20 centuries so robustly.</w:t></w:r></w:p><w:p w14:paraId="404F7042" w14:textId="5B43E899" w:rsidR="00FB52E1" w:rsidRDefault="00FB52E1" w:rsidP="00FB52E1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="573F24A0" w14:textId="77777777" w:rsidR="00FB52E1" w:rsidRDefault="00FB52E1" w:rsidP="00FB52E1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="03360303" w14:textId="2C6CEF4F" w:rsidR="00FB52E1" w:rsidRDefault="00FB52E1" w:rsidP="00FB52E1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Verse 60 as a universal prayer</w:t></w:r></w:p><w:p w14:paraId="6A2573BA" w14:textId="39D59218" w:rsidR="00FB52E1" w:rsidRDefault="00FB52E1" w:rsidP="00FB52E1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="51526F4B" w14:textId="1DA872A9" w:rsidR="00FB52E1" w:rsidRDefault="00616A35" w:rsidP="00FB52E1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">Who started—and who passed on—the custom of using the final verse of the </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">as an all-purpose dedication </w:t></w:r><w:r w:rsidR="003A13EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> any good karma we ever perform?  </w:t></w:r><w:r w:rsidR="009D33EC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">You may be interested to know that </w:t></w:r><w:r w:rsidR="001613F
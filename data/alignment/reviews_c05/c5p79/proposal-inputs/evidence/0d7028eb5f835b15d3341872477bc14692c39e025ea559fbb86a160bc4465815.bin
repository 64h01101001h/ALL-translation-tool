8CA" w:rsidRPr="006175A9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>One might ask themselves</w:t></w:r><w:r w:rsidR="00FA18CA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the following question—</w:t></w:r></w:p><w:p w14:paraId="6B4C5308" w14:textId="77777777" w:rsidR="00FA18CA" w:rsidRDefault="00FA18CA" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0E1CCBA6" w14:textId="51AE0C3A" w:rsidR="00FA18CA" w:rsidRPr="00FA18CA" w:rsidRDefault="00A50128" w:rsidP="00FA52E2"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">If we can eliminate all our negative emotions by </w:t></w:r><w:r w:rsidR="00FA52E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">coming to an understanding of how nothing has any nature of its own, </w:t></w:r><w:r w:rsidR="00FA52E2" w:rsidRPr="00BB600A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>how is it that we reach that kind of understanding?</w:t></w:r></w:p><w:p w14:paraId="50F7FFA1" w14:textId="77777777" w:rsidR="00FC0CDC" w:rsidRDefault="00FC0CDC" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="60ACA507" w14:textId="77777777" w:rsidR="00FC0CDC" w:rsidRDefault="00FC0CDC" w:r
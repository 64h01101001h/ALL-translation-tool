ii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>You would accept the necessity of the conclusion here.  As for how it is mistaken, I will not expand on that here, as we will be covering it below.</w:t></w:r></w:p><w:p w14:paraId="45D78DE3" w14:textId="77777777" w:rsidR="00DD76E3" w:rsidRPr="002427B7" w:rsidRDefault="00DD76E3" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="479A93E2" w14:textId="77777777" w:rsidR="00B425B5" w:rsidRPr="002427B7" w:rsidRDefault="00B425B5" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="42C10102" w14:textId="77777777" w:rsidR="00B16735" w:rsidRPr="002427B7" w:rsidRDefault="00B16735" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="01509507" w14:textId="0B71E538" w:rsidR="00B16735" w:rsidRPr="002427B7" w:rsidRDefault="00B16735" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A summary of the praise</w:t></w:r></w:p><w:p w14:paraId="796B0B76" w14:textId="77777777" w:rsidR="00DD76E3" w:rsidRPr="002427B7" w:rsidRDefault="00DD76E3" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:par
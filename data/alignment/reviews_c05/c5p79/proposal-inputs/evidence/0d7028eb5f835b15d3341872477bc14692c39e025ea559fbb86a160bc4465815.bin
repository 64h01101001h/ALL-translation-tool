4E0" w:rsidRPr="00F06A5B" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5A482F2C" w14:textId="6A3A5CE8" w:rsidR="00BE64E0" w:rsidRDefault="006A5D39" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Which brings us to our second point, </w:t></w:r><w:r w:rsidR="003060D0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the problems of failing to realize that things have no nature of their own.  This is covered in the next verse of the root text; the one which includes the words </w:t></w:r><w:r w:rsidR="00EB0F25"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“individual, ordinary”—</w:t></w:r></w:p><w:p w14:paraId="31FFB15C" w14:textId="77777777" w:rsidR="00EB0F25" w:rsidRDefault="00EB0F25" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1600F2CC" w14:textId="77777777" w:rsidR="00DC1F86" w:rsidRDefault="00DC1F86" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="29210466" w14:textId="6D69EEE8" w:rsidR="00325DCD" w:rsidRDefault="00325DCD" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype
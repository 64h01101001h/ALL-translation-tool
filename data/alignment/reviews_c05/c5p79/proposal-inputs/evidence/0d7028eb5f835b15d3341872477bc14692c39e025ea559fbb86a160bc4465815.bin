latino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> with our example, in three steps: a brief introduction; the actual point; and then a clarification of </w:t></w:r><w:r w:rsidR="006762A1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>what the example refers to.</w:t></w:r></w:p><w:p w14:paraId="1BBA5061" w14:textId="77777777" w:rsidR="003A0ED0" w:rsidRPr="002427B7" w:rsidRDefault="003A0ED0" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="259C4C5B" w14:textId="3340573A" w:rsidR="000C4210" w:rsidRPr="002427B7" w:rsidRDefault="000C4210" w:rsidP="000C4210"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="187E402B" w14:textId="54634B24" w:rsidR="00CC1DFD" w:rsidRDefault="00CC1DFD" w:rsidP="00F94DFC"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S339]</w:t></w:r></w:p><w:p w14:paraId="5F026B88" w14:textId="77777777" w:rsidR="00F94DFC" w:rsidRDefault="000C4210" w:rsidP="00F94DFC"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DANG PO NI,</w:t></w:r></w:p><w:p w14:paraId="7EB72781" w14:textId="77BE862A" 
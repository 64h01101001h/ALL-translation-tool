o Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4D36B648" w14:textId="5CBAAB70" w:rsidR="00D45255" w:rsidRDefault="00D45255" w:rsidP="00C821ED"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>He has stated though</w:t></w:r></w:p><w:p w14:paraId="12D0BAE7" w14:textId="25F9BBEC" w:rsidR="00D45255" w:rsidRDefault="00D45255" w:rsidP="00C821ED"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That these same things,</w:t></w:r></w:p><w:p w14:paraId="5613C82E" w14:textId="5FE94DCD" w:rsidR="00D45255" w:rsidRDefault="00D45255" w:rsidP="00C821ED"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>To realized beings,</w:t></w:r></w:p><w:p w14:paraId="729936F8" w14:textId="1DA66B66" w:rsidR="00D45255" w:rsidRDefault="00D45255" w:rsidP="00C821ED"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Are nothing but a lie.</w:t></w:r></w:p><w:p w14:paraId="63150E54" w14:textId="77777777" w:rsidR="00902629" w:rsidRDefault="00902629" w:rsidP="00C821ED"><w:pPr><w:jc w:val="center"/><w:
CN"/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="0A18734B" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="47ED21DF" w14:textId="1FFEFCCB" w:rsidR="00C77464" w:rsidRDefault="002D0CA6" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As for the first part, </w:t></w:r><w:r w:rsidR="009F15F1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="009F15F1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ll proceed in two steps: </w:t></w:r><w:r w:rsidR="00BC3572"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(1) </w:t></w:r><w:r w:rsidR="00B06206"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">showing how the idea that things arise in dependence, </w:t></w:r><w:r w:rsidR="00F17A6D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and the idea that nothing has any nature of its own, </w:t></w:r><w:r w:rsidR="00F17104"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in no way contradict each other; and </w:t></w:r><w:r w:rsidR="0040278F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(2) </w:t></w:r><w:r w:rsidR="008E5700"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a demonstration that—when we do think of these two ideas as opposed to each other—it brings </w:t></w:r><w:r w:rsidR="0008322D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>about all the problems we ever face.</w:t></w:r></w:p><w:p w14:paraId="3CD55457" w14:textId="77777777" w:rsidR="00C274A9" w:rsidRDefault="00C274A9" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6F3934BC" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6E1F276A" w14:textId="217210CA" w:rsidR="006F4CD3" w:rsidRDefault="006F4CD3" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:lastRenderedPageBreak/><w:t>[S620]</w:t></w:r></w:p><w:p w14:paraId="00A91081" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DANG PO NI,</w:t></w:r></w:p><w:p w14:paraId="70EAD03E" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7B43E13E" w14:textId="48B1DCF4" w:rsidR="00C77464" w:rsidRDefault="00177487" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The former of these last two points is covered in the next verse of the root text—</w:t></w:r></w:p><w:p w14:paraId="770B4054" w14:textId="77777777" w:rsidR="00267F1E" w:rsidRPr="002427B7" w:rsidRDefault="00267F1E" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="76250387" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="2FFADF43" w14:textId="65019
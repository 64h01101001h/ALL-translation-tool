 w14:paraId="4F7F4801" w14:textId="54FD4DAF" w:rsidR="00BE64E0" w:rsidRDefault="0052031D" w:rsidP="0052031D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And what else could be left over?</w:t></w:r></w:p><w:p w14:paraId="7892855F" w14:textId="77777777" w:rsidR="0052031D" w:rsidRPr="002427B7" w:rsidRDefault="0052031D" w:rsidP="008A2766"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="60FA28A6" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="27B63D69" w14:textId="1073D35E" w:rsidR="00325DCD" w:rsidRDefault="00325DCD" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N14</w:t></w:r><w:r w:rsidR="005826EB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>7</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="48DFB5CB" w14:textId="24F5217B" w:rsidR="00E77B0D" w:rsidRDefault="00204B17" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linot
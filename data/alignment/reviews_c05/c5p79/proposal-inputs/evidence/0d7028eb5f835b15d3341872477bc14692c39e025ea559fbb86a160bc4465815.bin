7" w:rsidR="00F45558" w:rsidRPr="002427B7" w:rsidRDefault="00F45558" w:rsidP="00F45558"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The complete understanding</w:t></w:r></w:p><w:p w14:paraId="19A50C14" w14:textId="77777777" w:rsidR="00F45558" w:rsidRPr="002427B7" w:rsidRDefault="00F45558" w:rsidP="00F45558"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of the cycle of existence</w:t></w:r></w:p><w:p w14:paraId="6BCD17CE" w14:textId="77777777" w:rsidR="00F45558" w:rsidRPr="002427B7" w:rsidRDefault="00F45558" w:rsidP="00F45558"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Is itself what we call</w:t></w:r></w:p><w:p w14:paraId="623045E2" w14:textId="3617310C" w:rsidR="00BE64E0" w:rsidRDefault="00F45558" w:rsidP="00F45558"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nirvana, beyond all grief.</w:t></w:r></w:p><w:p w14:paraId="7E73C3AB" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRDefault="00106B6D" w:rsidP="00F45558"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0A6ADB5E" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When a functional thing</w:t></w:r></w:p><w:p w14:paraId="406E50AF" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That started later ends,</w:t></w:r></w:p><w:p w14:paraId="631A1181" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We label that as “stopping.”</w:t></w:r></w:p><w:p w14:paraId="7A1E6A16" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7BD8C13B" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>In the same way,</w:t></w:r></w:p><w:p w14:paraId="4579DC36" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The holy ones also</w:t></w:r></w:p><w:p w14:paraId="6F01CD1F" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Take the position</w:t></w:r></w:p><w:p w14:paraId="3326FF5F" w14:textId="77777777" w:rsidR="00106B6D" w:rsidRPr="002427B7" w:rsidRDefault="00106B6D" w:rsidP="00106B6D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><
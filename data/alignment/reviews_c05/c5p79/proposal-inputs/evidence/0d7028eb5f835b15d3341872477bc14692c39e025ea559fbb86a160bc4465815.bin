/w:t></w:r></w:p><w:p w14:paraId="61D584CD" w14:textId="77777777" w:rsidR="009278F2" w:rsidRDefault="009278F2" w:rsidP="009278F2"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And stopped them from</w:t></w:r></w:p><w:p w14:paraId="57549452" w14:textId="77777777" w:rsidR="009278F2" w:rsidRDefault="009278F2" w:rsidP="009278F2"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This jumping,</w:t></w:r></w:p><w:p w14:paraId="6A168709" w14:textId="77777777" w:rsidR="00034F4D" w:rsidRDefault="00034F4D" w:rsidP="0081741A"><w:pPr><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7D474F6A" w14:textId="77777777" w:rsidR="00034F4D" w:rsidRDefault="00034F4D" w:rsidP="00034F4D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Can cross safely over</w:t></w:r></w:p><w:p w14:paraId="33BE8BF8" w14:textId="77777777" w:rsidR="00034F4D" w:rsidRDefault="00034F4D" w:rsidP="00034F4D"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The ocean of sufferi
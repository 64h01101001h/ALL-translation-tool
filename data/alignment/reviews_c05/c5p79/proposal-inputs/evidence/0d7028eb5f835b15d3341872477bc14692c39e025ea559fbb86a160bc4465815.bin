/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to write, when things got too busy at </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00E715F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ganden</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00DF3A48"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Monastery</w:t></w:r><w:r w:rsidR="00E715F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="63B3BE6F" w14:textId="77777777" w:rsidR="00E715F9" w:rsidRDefault="00E715F9" w:rsidP="006E3BA2"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1301B226" w14:textId="201E66F8" w:rsidR="00E715F9" w:rsidRDefault="007C46B7" w:rsidP="006E3BA2"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>With the exception of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> his explanations of the secret teaching of the Wheel of Time</w:t></w:r><w:r w:rsidR="0008595D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (where the colophons give no place of composition), </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi
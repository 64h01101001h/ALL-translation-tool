 w14:textId="77777777" w:rsidR="00632CCB" w:rsidRDefault="00632CCB" w:rsidP="00632CCB"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="19FDECBC" w14:textId="1CAADE32" w:rsidR="00632CCB" w:rsidRDefault="006F3DF0" w:rsidP="009C0A17"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>They</w:t></w:r><w:r w:rsidR="0033403C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> come to</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> cross safely over the ocean </w:t></w:r><w:r w:rsidR="004B2C83"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">of suffering life, </w:t></w:r><w:r w:rsidR="009C0A17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>e</w:t></w:r><w:r w:rsidR="002E39CF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">mbroiled </w:t></w:r><w:r w:rsidR="007A065E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">as it is </w:t></w:r><w:r w:rsidR="002E39CF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">with the great serpent </w:t></w:r><w:r w:rsidR="000152BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">of the negative </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="000152BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>emotions;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="19316F03" w14:textId="77777777" w:rsidR="008D2826" w:rsidRDefault="008D2826" w:rsidP="009C0A17"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6E0CF642" w14:textId="6CE7D6DF" w:rsidR="00B219D2" w:rsidRDefault="008D2826" w:rsidP="002A3870"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because they have taken the various thoughts that are jumping around—</w:t></w:r><w:r w:rsidR="00786970"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the thoughts that say “These things do have a nature of their own”—and </w:t></w:r><w:r w:rsidR="008C7C18"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>stopped them from this jumping</w:t></w:r><w:r w:rsidR="002F0F12"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">; </w:t></w:r><w:r w:rsidR="000E42FA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">by </w:t></w:r><w:r w:rsidR="00943537"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>realizing, directly,</w:t></w:r><w:r w:rsidR="000E42FA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> that they have no nature of their own.</w:t></w:r></w:p><w:p w14:paraId="58FCB36E" w14:textId="77777777" w:rsidR="00B219D2" w:rsidRDefault="00B219D2" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2BD84101" w14:textId="77777777" w:rsidR="00255A56" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="33E47436" w14:textId="77777777" w:rsidR="002A3870" w:rsidRDefault="002A3870" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="22428FA4" w14:textId="501A8B9F" w:rsidR="00255A56" w:rsidRDefault="002B662C" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A dedication</w:t></w:r></w:p><w:p w14:paraId="1D416E9C" w14:textId="23806A7F" w:rsidR="002B662C" w:rsidRPr="007D30E8" w:rsidRDefault="002B662C" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to enlightenment</w:t></w:r></w:p><w:p w14:paraId="6E8D5CF8" w14:textId="77777777" w:rsidR="00255A56" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="75347A35" w14:textId="6E1B5B48" w:rsidR="00DB181F" w:rsidRDefault="00DB181F" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N273]</w:t></w:r></w:p><w:p w14:paraId="4034807E" w14:textId="4DCAEF44" w:rsidR="00255A56" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00E4630B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GSUM PA BRTZAMS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00E4630B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I DGE BA BYANG</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00E4630B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>CHUB TU BSNGO BA NI, DGE BA SOGS BZHI LA THOB PAR SHOG</w:t></w:r></w:p><w:p w14:paraId="393238EA" w14:textId="77777777" w:rsidR="00255A56" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="56BE4C5D" w14:textId="3EFF524B" w:rsidR="00255A56" w:rsidRDefault="00540732" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> we have come to the third and final division of the entire work: </w:t></w:r><w:r w:rsidR="006241BC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:r w:rsidR="002B662C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> dedication of the good deed of composing the text to enlightenment</w:t></w:r><w:r w:rsidR="00C13A14"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  </w:t></w:r><w:r w:rsidR="00862B54"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This is found in the four lines [of the Tibetan, </w:t></w:r><w:r w:rsidR="00960FF8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>eight lines of the English]</w:t></w:r><w:r w:rsidR="00310CAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> which mention “the goodness,” and how beings might “thus gain.”</w:t></w:r></w:p><w:p w14:paraId="5D846014" w14:textId="77777777" w:rsidR="00255A56" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="103A97AC" w14:textId="5E1A501D" w:rsidR="00C16767" w:rsidRDefault="00C16767" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2A89B984" w14:textId="365E0801" w:rsidR="00DB181F" w:rsidRDefault="00DB181F" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N274]</w:t></w:r></w:p><w:p w14:paraId="64324337" w14:textId="77777777" w:rsidR="00170B4C" w:rsidRPr="002427B7" w:rsidRDefault="00170B4C" w:rsidP="00170B4C"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(60)</w:t></w:r></w:p><w:p w14:paraId="774987B1" w14:textId="77777777" w:rsidR="00170B4C" w:rsidRPr="002427B7" w:rsidRDefault="00170B4C" w:rsidP="00170B4C"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5AE79506" w14:textId="77777777" w:rsidR="00170B4C" w:rsidRPr="002427B7" w:rsidRDefault="00170B4C" w:rsidP="00170B4C"><w:pPr><w:jc w:val="center"/><w:rPr><w:rF
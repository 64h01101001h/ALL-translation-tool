ial"/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr></w:pPr><w:r w:rsidRPr="007125B0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t>Erin &amp; Veronica. </w:t></w:r></w:p><w:p w14:paraId="21A200CD" w14:textId="77777777" w:rsidR="00C42FAA" w:rsidRPr="007125B0" w:rsidRDefault="00C42FAA" w:rsidP="00C42FAA"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr></w:pPr><w:r w:rsidRPr="007125B0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t>And the one illuminating the way</w:t></w:r></w:p><w:p w14:paraId="5F05899E" w14:textId="77777777" w:rsidR="00C42FAA" w:rsidRPr="007125B0" w:rsidRDefault="00C42FAA" w:rsidP="00C42FAA"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr></w:pPr><w:r w:rsidRPr="007125B0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t>for future generations,</w:t></w:r></w:p><w:p w14:paraId="727D67BC" w14:textId="77777777" w:rsidR="00C42FAA" w:rsidRPr="007125B0" w:rsidRDefault="00C42FAA" w:rsidP="00C42FAA"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr></w:pPr><w:r w:rsidRPr="007125B0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr><w:t>Amalie.</w:t></w:r></w:p><w:p w14:paraId="5A707B68" w14:textId="77777777" w:rsidR="003F2FCB" w:rsidRPr="002427B7" w:rsidRDefault="00967196" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr><w:br w:type="column"/></w:r></w:p><w:p w14:paraId="7EF5CCB9" w14:textId="77777777" w:rsidR="003F2FCB" w:rsidRPr="002427B7" w:rsidRDefault="003F2FCB" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4E611C62" w14:textId="4503C828" w:rsidR="00296187" w:rsidRDefault="00C77705" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="36"/><w:szCs w:val="36"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Introduction</w:t></w:r></w:p><w:p w14:paraId="7CB6817C" w14:textId="00927241" w:rsidR="00E42968" w:rsidRDefault="00E42968" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0D35D300" w14:textId="3BECF034" w:rsidR="00E42968" w:rsidRDefault="00E42968" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Welcome to our translation of </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses on the Logic for Proving Emptiness, </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">certainly one of the greatest works in the history of Asia, and the world.  It was composed almost 2,000 years ago by Arya Nagarjuna, who is one of the </w:t></w:r><w:r w:rsidR="008A10EA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>most wonderful</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> thinkers of all time.  It is a difficult book, since emptiness itself is a difficult subject, but as with so many difficult things in the world, the rewards of happily attacking the difficulty are substantial.</w:t></w:r></w:p><w:p w14:paraId="0DEAF49E" w14:textId="09B7149D" w:rsidR="00E42968" w:rsidRDefault="00E42968" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4F9E7BE3" w14:textId="067DAF82" w:rsidR="00E42968" w:rsidRDefault="00E42968" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1EC2CD52" w14:textId="42397AF1" w:rsidR="009A6719" w:rsidRDefault="009A6719" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tools included in this volume</w:t></w:r></w:p><w:p w14:paraId="322E5681" w14:textId="36B95C5E" w:rsidR="009A6719" w:rsidRDefault="009A6719" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00196342" w14:textId="6318644E" w:rsidR="009A6719" w:rsidRDefault="00172A33" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We have prepared for you </w:t></w:r><w:r w:rsidR="00811803"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">not just a translation, but </w:t></w:r><w:r w:rsidR="00A73FF0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>one</w:t></w:r><w:r w:rsidR="00811803"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> can say an entire manual for getting the most out of Master Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00811803"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s classic.  </w:t></w:r><w:r w:rsidR="006A36D0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This wisdom manual can be broken down into </w:t></w:r><w:r w:rsidR="0071480D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>nine</w:t></w:r><w:r w:rsidR="006A36D0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> different sections:</w:t></w:r></w:p><w:p w14:paraId="4E744D5B" w14:textId="5EC881F6" w:rsidR="006A36D0" w:rsidRDefault="006A36D0" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4D2E9568" w14:textId="0AE7EC2A" w:rsidR="006A36D0" w:rsidRDefault="006A36D0" w:rsidP="004F0FC6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>1) The introduction</w:t></w:r></w:p><w:p w14:paraId="21582159" w14:textId="08D7F7F2" w:rsidR="006A36D0" w:rsidRDefault="006A36D0" w:rsidP="004F0FC6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here in the introduction, we offer you first some information about our three authors: Arya Naga
></w:rPr><w:t xml:space="preserve">.  He is a person who protects his own practice of the three trainings with the same infinite care that others might </w:t></w:r><w:r w:rsidR="000D4191"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">show in </w:t></w:r><w:r w:rsidR="00A611FA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>protect</w:t></w:r><w:r w:rsidR="000D4191"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ing</w:t></w:r><w:r w:rsidR="00A611FA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> their own eyes</w:t></w:r><w:r w:rsidR="00F54BF4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> from something that might hurt them.  </w:t></w:r><w:r w:rsidR="00146C9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Yes, I am speaking of the glorious one, the omniscient </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00146C9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Lobsang</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00146C9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00146C9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Drakpa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00146C9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00D876E4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">who possesses </w:t></w:r><w:r w:rsidR="002526F2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a massive form of compassion</w:t></w:r><w:r w:rsidR="000A03D9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—a compassion </w:t></w:r><w:r w:rsidR="001863DB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which</w:t></w:r><w:r w:rsidR="000A03D9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> cannot bear at all to see people like </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="000A03D9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>myself</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="000A03D9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00175061"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">people so far from being holy ones, </w:t></w:r><w:r w:rsidR="00292761"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>engaging in a whole mountain of mistaken deeds.</w:t></w:r></w:p><w:p w14:paraId="4B962953" w14:textId="77777777" w:rsidR="000D1483" w:rsidRPr="002427B7" w:rsidRDefault="000D1483" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><
="332DF167" w14:textId="4FBB6D4A" w:rsidR="00AF6A85" w:rsidRPr="002427B7" w:rsidRDefault="00AF6A85" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>Here is what Master Chandrakirti means when he s</w:t></w:r><w:r w:rsidR="00A272AD" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>tates</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve"> that </w:t></w:r><w:r w:rsidR="00A272AD" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">“it would be illogical </w:t></w:r><w:r w:rsidR="009B082D" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">to say that </w:t></w:r><w:r w:rsidR="00D934DF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">these </w:t></w:r><w:r w:rsidR="00A272AD" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>things which are beyond the world</w:t></w:r><w:r w:rsidR="00304590" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve"> are equivalent to things of the world.”  </w:t></w:r><w:r w:rsidR="00B6584B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">The expression “things of the world” refers to things which are established following the way this is done in the normal world.  </w:t></w:r><w:r w:rsidR="00497FDB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>But there are things which cannot be established using this same way of the world: things like the impermanence of things; emptiness; and the fact that things are not themselves.</w:t></w:r></w:p><w:p w14:paraId="31754250" w14:textId="645C879F" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="4CCBD380" w14:textId="77777777" w:rsidR="00497FDB" w:rsidRPr="002427B7" w:rsidRDefault="00497FDB" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="7A7DC8CE" w14:textId="37327472" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="00931936"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A13]</w:t></w:r></w:p><w:p w14:paraId="468D8D8F" w14:textId="70A333A1" w:rsidR="004F7A60" w:rsidRPr="00443E23" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr></w:pPr><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t xml:space="preserve">DES NI </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t xml:space="preserve">JIG RTEN LAS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t xml:space="preserve">DAS PA DANG </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t xml:space="preserve">JIG RTEN PA DAG CHOS MTSUNGS PAR MI </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>GYUR PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>O</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:as
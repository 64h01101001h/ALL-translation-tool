latino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">RNAM PA SHAR BA MA GTOGS PHYI DON YOD PAR BZHAG MI NUS TE, MO GSHAM GYI BU LA SOGS PA YANG YOD PAR THAL BAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GYUR </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>RO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="73367750" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0B8C301A" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Beyond appearing to be that way, we cannot say that any of these things exist as outer objects.  If they did, then we would have to say that things like the child of a barren woman also existed.</w:t></w:r></w:p><w:p w14:paraId="1C1E0879" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4737D82F" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="446D4ED4" w14:textId="4C8F7E5B" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="00D467FF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>S540]</w:t></w:r></w:p><w:p w14:paraId="3075E6FF" w14:textId="00397AA4" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>SHES PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">I </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>DZIN RNAM YOD DAM MED, DANG PO LTAR NA, GZUNG RNAM YANG KHAS BLANGS PAS NANG DU PHYOGS PA DANG PHYIR PHYOGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>I CHA GNYIS KHAS BLANGS PAS</w:t></w:r></w:p><w:p w14:paraId="362B7F28" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="3DB9F60D" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>Now suppose someone comes and raises the following issue:</w:t></w:r></w:p><w:p w14:paraId="2221265E" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="0A25C9ED" w14:textId="77777777" w:rsidR="00A941C6" w:rsidRDefault="006B0382" w:rsidP="0096121C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>So does our awareness possess an aspect of being what grasps its object, or not?  If it does, then we would also have to accept that there was an aspect here of something which is grasped.  And then we would have to accept the idea of one part of awareness that focused inwardly, and another part which focused outwardly.</w:t></w:r></w:p><w:p w14:paraId="7B199FF4" w14:textId="77777777" w:rsidR="00A941C6" w:rsidRDefault="00A941C6" w:rsidP="009C4D5B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="1264EEED" w14:textId="77777777" w:rsidR="009C4D5B" w:rsidRDefault="009C4D5B" w:rsidP="009C4D5B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="0AF82CAB" w14:textId="0F7F40FD" w:rsidR="00A941C6" w:rsidRPr="009C4D5B" w:rsidRDefault="009C4D5B" w:rsidP="009C4D5B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="00D467FF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>S541</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="535EFF3E" w14:textId="20A75329" w:rsidR="00A941C6" w:rsidRDefault="00A941C6" w:rsidP="00A941C6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">RANG RIG KHAS BLANGS LA, PHYI MA LTAR NA GZUNG RNAM MI </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>THAD DO ZHE NA,</w:t></w:r></w:p><w:p w14:paraId="157C3F45" w14:textId="77777777" w:rsidR="00A941C6" w:rsidRDefault="00A941C6" w:rsidP="0096121C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="6CC9AF39" w14:textId="523AF376" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="0096121C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>And in that case, we would have accepted the concept of apperception: the ability of the mind to focus upon itself</w:t></w:r><w:r w:rsidR="004E5B71"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>, in a single moment</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">.  But if on the other hand we say that awareness does not possess an aspect of being what </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>grasps its object, then the idea of there being an aspect where something is grasped would also be called into question.</w:t></w:r></w:p><w:p w14:paraId="10541E10" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="06120523" w14:textId="50956965" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="7C5BC177" w14:textId="6EEB4EFF" w:rsidR="006B0382" w:rsidRPr="002427B7" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="00D467FF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>S542</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="6719E372" w14:textId="609EE1EE" w:rsidR="006B0382" w:rsidRPr="00F06A5B" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>SHES PAS YUL RIG PA GRUB PA RIG PA TZAM GRUB ZIN PAS RIG PA GRUB PAR BYA BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">I PHYIR TU RANG GI </w:t></w:r><w:r w:rsidR="00C46BDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">{%GIS?} </w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t xml:space="preserve">RIG GAM GZHAN GYIS RIG DPYOD PAR MI RIGS TE, DE LTAR NA SHES PA BEM POR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr><w:t>GYUR TE, SGRON MES BUM PA GSAL DGOS PA BZHIN,</w:t></w:r></w:p><w:p w14:paraId="673777EF" w14:textId="77777777" w:rsidR="006B0382" w:rsidRPr="00F06A5B" w:rsidRDefault="006B0382" w:rsidP="006B0382"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7C289186" w14:textId="3884E920" w:rsidR="008F6A3B" w:rsidRPr="00E01D55" w:rsidRDefault="006B0382" w:rsidP="00E01D55"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>When we know an object with our awareness, then this knowing itself is already established!  It</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">s not necessary that we go from further from there, and in order to establish that there </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">was </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">a knowing, examine the question of whether the knowing is done through a process of the mind </w:t></w:r><w:r w:rsidR="00901B02"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>being known by</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve"> itself</w:t></w:r><w:r w:rsidR="00FC2E24"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:footnoteReference w:id="175"/></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve"> or through a process of the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">mind  </w:t></w:r><w:r w:rsidR="00A91E15"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>being</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00A91E15"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve"> known by </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>something other than itself.  In such a case then awareness itself would become a physical thing—something that had to be illuminated, in the way that a lamp illuminates a water pitcher.</w:t></w:r></w:p><w:p w14:paraId="7E483EE1" w14:textId="77777777" w:rsidR="008F6A3B" w:rsidRDefault="008F6A3B" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="50BB92AB" w14:textId="77777777" w:rsidR="00332CA5" w:rsidRDefault="00332CA5" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5A4BA785" w14:textId="77777777" w:rsidR="00C77464" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1859078A" w14:textId="2914C3CC" w:rsidR="00D05AD8" w:rsidRDefault="00D05AD8" w:rsidP="00D05AD8"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Scriptural support for saying there was</w:t></w:r></w:p><w:p w14:paraId="236675B4" w14:textId="2A82E604" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00D05AD8" w:rsidP="00D05AD8"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>something else in mind</w:t></w:r></w:p><w:p w14:paraId="2CBE52CF" w14:textId="49FEEBF0" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00A67926" w:rsidP="00A67926"><w:pPr><w:tabs><w:tab w:val="left" w:pos="3193"/></w:tabs><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/></w:r></w:p><w:p w14:paraId="54427AB5" w14:textId="11102082" w:rsidR="00D467FF" w:rsidRDefault="00D467FF" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S543]</w:t></w:r></w:p><w:p w14:paraId="1C7B8F91" w14:textId="77777777" w:rsidR="00C77464" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GNYIS PA NI,</w:t></w:r></w:p><w:p w14:paraId="48BC21CC" w14:textId="77777777" w:rsidR="005210FE" w:rsidRDefault="005210FE" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="087F1FE3" w14:textId="1158299A" w:rsidR="005210FE" w:rsidRPr="002427B7" w:rsidRDefault="005210FE" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This then brings us to our second point here: the scriptural support.</w:t></w:r></w:p><w:p w14:paraId="4773371D" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2A16243C" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="32BBC676" w14:textId="11781DA5" w:rsidR="00D467FF" w:rsidRDefault="00D467FF" w:rsidP="00D467FF"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S544]</w:t></w:r></w:p><w:p w14:paraId="2E78DD53" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(35)</w:t></w:r></w:p><w:p w14:paraId="6DCF9696" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"
<w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We have now reached the supporting logic for the stages in which realized beings see things.  This is presented in the four lines [of the Tibetan, nine in the English] that mention “the world”—</w:t></w:r></w:p><w:p w14:paraId="30F3182B" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="78F300D6" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6D8E5546" w14:textId="7CC3B7AE" w:rsidR="00325DCD" w:rsidRPr="002427B7" w:rsidRDefault="00325DCD" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N14</w:t></w:r><w:r w:rsidR="005826EB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>9</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="1D73FC11" w14:textId="77777777" w:rsidR="00E77B0D" w:rsidRPr="002427B7" w:rsidRDefault="00E77B0D" w:rsidP="00E77B0D"><w:pPr><w:jc w:val="center"/><w:rPr><w:
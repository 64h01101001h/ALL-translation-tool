/w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="09E290DE" w14:textId="77777777" w:rsidR="0047077E" w:rsidRDefault="0047077E" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4426CC8A" w14:textId="7A134C35" w:rsidR="0047077E" w:rsidRDefault="0047077E" w:rsidP="0047077E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And wouldn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t our reason here indeed prove our assertion?</w:t></w:r></w:p><w:p w14:paraId="75295737" w14:textId="77777777" w:rsidR="0047077E" w:rsidRDefault="0047077E" w:rsidP="0047077E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="02768B6E" w14:textId="58E53D48" w:rsidR="0047077E" w:rsidRDefault="0095005A" w:rsidP="0047077E"><w:pPr><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because isn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t it the case that—so long as we are led astray by attending to things the wrong way—we have yet to pass beyond the clutches of the demons who threaten the very life power of our wisdom, the wisdom of the realized ones?</w:t></w:r></w:p><w:p w14:paraId="0029857C" w14:textId="77777777" w:rsidR="001A0F07" w:rsidRDefault="001A0F07" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1CB37E76" w14:textId="77777777" w:rsidR="001A0F07" w:rsidRDefault="001A0F07" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="543BF540" w14:textId="77777777" w:rsidR="00255A56" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1B3C6B6C" w14:textId="2886F096" w:rsidR="00255A56" w:rsidRDefault="0003587B" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>How things come this way</w:t></w:r></w:p><w:p w14:paraId="77F1D989" w14:textId="77777777" w:rsidR="00255A56" w:rsidRPr="005D1CC9" w:rsidRDefault="00255A56" w:rsidP="00255A56"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3977E15F" w14:textId="5EA91493" w:rsidR="00077B71" w:rsidRPr="00F06A5B" w:rsidRDefault="00077B71" w
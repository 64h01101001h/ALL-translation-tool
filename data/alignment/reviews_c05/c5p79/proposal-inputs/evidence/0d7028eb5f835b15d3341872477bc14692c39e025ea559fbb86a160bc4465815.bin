ang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">re describing accept the existence of a common referent, </w:t></w:r><w:r w:rsidR="001D3DFC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>you must be accepting here the concept of an actual referent</w:t></w:r><w:r w:rsidR="002B272D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> out there.</w:t></w:r></w:p><w:p w14:paraId="1F198A76" w14:textId="27C4283C" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="31E196DA" w14:textId="66E04329" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="00015BFF"><w:pPr><w:tabs><w:tab w:val="left" w:pos="2567"/></w:tabs><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="460964B2" w14:textId="4DDE8EB0" w:rsidR="00672717" w:rsidRDefault="00672717" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S384]</w:t></w:r></w:p><w:p w14:paraId="3664F5B3" w14:textId="0D12505E" w:rsidR="002747BC" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:asci
 that object which is considered by </w:t></w:r><w:r w:rsidR="00007491"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that wisdom which comprehends the various objects in the deep meditation </w:t></w:r><w:r w:rsidR="00853B5C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of a realized being.</w:t></w:r></w:p><w:p w14:paraId="71321FA5" w14:textId="77777777" w:rsidR="00D767A7" w:rsidRDefault="00D767A7" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="13D7AE14" w14:textId="77777777" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="14B85AA8" w14:textId="0F2BE9BA" w:rsidR="00CC1DFD" w:rsidRDefault="00CC1DFD" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S365]</w:t></w:r></w:p><w:p w14:paraId="543DF661" w14:textId="3FB516DC" w:rsidR="002747BC" w:rsidRPr="002427B7" w:rsidRDefault="002747BC" w:rsidP="002747BC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GNYIS PA DBYE BA LA KUN RDZOB DANG, DON DAM BDEN PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:asci
"Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> known as </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Rendawa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00566960"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">: an omniscient being </w:t></w:r><w:r w:rsidR="005814DF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>possessed of immeasurable compassion</w:t></w:r><w:r w:rsidR="006966BD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">; and who, in particular, has grasped, in its entirety, </w:t></w:r><w:r w:rsidR="00EF72D5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the principles of those things that occur in dependence, so like the image of the moon reflected on the surface of the water.</w:t></w:r></w:p><w:p w14:paraId="216D6919" w14:textId="77777777" w:rsidR="00476CD0" w:rsidRPr="002427B7" w:rsidRDefault="00476CD0" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="340842A2" w14:textId="77777777" w:rsidR="00CA4E30" w:rsidRPr="002427B7" w:rsidRDefault="00CA4E30" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7E33D06E" w14:textId="11F9EC1F" w:rsidR="00110399" w:rsidRDefault="00110399" w:rsidP="00854ACC"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:r
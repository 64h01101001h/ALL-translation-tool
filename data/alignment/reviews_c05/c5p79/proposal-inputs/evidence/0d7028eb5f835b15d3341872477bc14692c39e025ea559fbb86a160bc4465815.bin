t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="73120F88" w14:textId="77777777" w:rsidR="00714EDA" w:rsidRDefault="00714EDA" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="479B110F" w14:textId="7C57EAF8" w:rsidR="00714EDA" w:rsidRPr="0013382F" w:rsidRDefault="00714EDA" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And suppose you say that there is no problem, since you </w:t></w:r><w:r w:rsidR="005A2C53"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>agree</w:t></w:r><w:r w:rsidR="00BB3EEC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  But then </w:t></w:r><w:r w:rsidR="00BB3EEC" w:rsidRPr="002E23D4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">who is it that </w:t></w:r><w:r w:rsidR="009667A3" w:rsidRPr="002E23D4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>brings about th</w:t></w:r><w:r w:rsidR="002E23D4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>is</w:t></w:r><w:r w:rsidR="009667A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> nirvana where nothing is left over?  </w:t></w:r><w:r w:rsidR="0013382F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It would be incorrect to say that anyone </w:t></w:r><w:r w:rsidR="0013382F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">did </w:t></w:r><w:r w:rsidR="0013382F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>bring it about.  Because it would be incorrect to say that the sentence even existed: “Oh! I have brought about my nirvana!”</w:t></w:r></w:p><w:p w14:paraId="3D21E87E" w14:textId="77777777" w:rsidR="0084378C" w:rsidRPr="002427B7" w:rsidRDefault="0084378C" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="728ACCDB" w14:textId="2214BEFF" w:rsidR="00342327" w:rsidRPr="002427B7" w:rsidRDefault="00342327" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="10F01026" w14:textId="23115AEA" w:rsidR="00140194" w:rsidRPr="002427B7" w:rsidRDefault="00476525" w:rsidP="00342327"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S2</w:t></w:r><w:r w:rsidR="00140194" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>4</w:t></w:r><w:r w:rsidR="008D71A5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w
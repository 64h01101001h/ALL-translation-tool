:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KHOR BA YIN LA, DE RGYUN CHAD PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I DNGOS MED MYA NGAN LAS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DAS PA YIN PAS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">KHOR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DAS MED PAR YANG MA GRUB STE, DE MED NA </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>BLANG DOR BYA BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR STON PAR MI RIGS PA LA, BCOM LDAN </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DAS KYIS GSUNGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR CE NA, </w:t></w:r></w:p><w:p w14:paraId="7108E3B2" w14:textId="77777777" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="00320C19" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="081E33EB" w14:textId="2EB186E3" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="004F377B" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here is the first.  Now someone may come and make the following argument:</w:t></w:r></w:p><w:p w14:paraId="6B908C3A" w14:textId="23607E24" w:rsidR="004F377B" w:rsidRPr="002427B7" w:rsidRDefault="004F377B" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="47D3E24D" w14:textId="098AC227" w:rsidR="004F377B" w:rsidRPr="002427B7" w:rsidRDefault="00E110A9" w:rsidP="002448E0"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Things and the absence of things do indeed exist,</w:t></w:r></w:p><w:p w14:paraId="2B470A71" w14:textId="5F685456" w:rsidR="00E110A9" w:rsidRPr="002427B7" w:rsidRDefault="00E110A9" w:rsidP="002448E0"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4078456D" w14:textId="6A0E1ADC" w:rsidR="00E110A9" w:rsidRPr="002427B7" w:rsidRDefault="002448E0" w:rsidP="002448E0"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because the cycle of pain, and nirvana, do exist.</w:t></w:r></w:p><w:p w14:paraId="10446356" w14:textId="3A2962EF" w:rsidR="004F377B" w:rsidRPr="002427B7" w:rsidRDefault="004F377B" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="60C52BB6" w14:textId="5AC3F9B8" w:rsidR="002448E0" w:rsidRPr="002427B7" w:rsidRDefault="002448E0" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>And the one does follow from the other,</w:t></w:r></w:p><w:p w14:paraId="2B4FDD1D" w14:textId="31E27023" w:rsidR="002448E0" w:rsidRPr="002427B7" w:rsidRDefault="002448E0" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="56F4B6F2" w14:textId="64BCAABC" w:rsidR="002448E0" w:rsidRPr="002427B7" w:rsidRDefault="002448E0" w:rsidP="003079C1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because “things”—as represented by the five parts to a person that we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ve taken on—are the cycle of pain; whereas “the absence of things”—</w:t></w:r><w:r w:rsidR="001F63AB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">as represented by </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the discontinuation of these parts—is nirvana.</w:t></w:r><w:r w:rsidR="003079C1" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And as such, you cannot say that neither the cycle, nor nirvana, exists.</w:t></w:r></w:p><w:p w14:paraId="584C1844" w14:textId="7A4BC6BC" w:rsidR="00004784" w:rsidRPr="002427B7" w:rsidRDefault="00004784" w:rsidP="003079C1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="481418ED" w14:textId="649D1932" w:rsidR="00004784" w:rsidRPr="002427B7" w:rsidRDefault="009932DF" w:rsidP="003079C1"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">For if they did </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">not </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>exist, then it would be incorrect to teach about them, in order t</w:t></w:r><w:r w:rsidR="006355DB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">hat </w:t></w:r><w:r w:rsidR="000724FB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>disciples</w:t></w:r><w:r w:rsidR="006355DB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> could</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> reach the one and </w:t></w:r><w:r w:rsidR="00BF760B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>abandon the other</w:t></w:r><w:r w:rsidR="00DD111A" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—</w:t></w:r><w:r w:rsidR="00BF760B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">whereas Lord Buddha </w:t></w:r><w:r w:rsidR="00BF760B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">did </w:t></w:r><w:r w:rsidR="00BF760B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>describe them.</w:t></w:r></w:p><w:p w14:paraId="0FA73AC3" w14:textId="77777777" w:rsidR="002448E0" w:rsidRPr="002427B7" w:rsidRDefault="002448E0" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="09BA83D5" w14:textId="77777777" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="00320C19" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="53604477" w14:textId="4909BB89" w:rsidR="00320C19" w:rsidRPr="00F06A5B" w:rsidRDefault="003436C4" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>[S1</w:t></w:r><w:r w:rsidR="002D442D" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>9</w:t></w:r><w:r w:rsidR="00476525" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>3</w:t></w:r><w:r w:rsidR="00320C19" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="2F2F6B03" w14:textId="63B09229" w:rsidR="00320C19" w:rsidRPr="00F06A5B" w:rsidRDefault="00204B17" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="00320C19" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>PHAGS PA LA BSTAN PA</w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00320C19" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR ZER NA MA GRUB STE, </w:t></w:r></w:p><w:p w14:paraId="49292D81" w14:textId="77777777" w:rsidR="00320C19" w:rsidRPr="00F06A5B" w:rsidRDefault="00320C19" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="24EF7072" w14:textId="0FA6D82D" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="00EA2F14" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Now suppose you continue this argument with:</w:t></w:r></w:p><w:p w14:paraId="0EBFE1BC" w14:textId="7243A34A" w:rsidR="00EA2F14" w:rsidRPr="002427B7" w:rsidRDefault="00EA2F14" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="27DC3E5A" w14:textId="782C96C1" w:rsidR="00EA2F14" w:rsidRPr="002427B7" w:rsidRDefault="008E4373" w:rsidP="008E4373"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because he described them to realized beings.</w:t></w:r></w:p><w:p w14:paraId="61A064C5" w14:textId="6146C0BE" w:rsidR="008E4373" w:rsidRPr="002427B7" w:rsidRDefault="008E4373" w:rsidP="008E4373"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="725D176E" w14:textId="5B59F36D" w:rsidR="008E4373" w:rsidRPr="002427B7" w:rsidRDefault="00C53CFA" w:rsidP="00C53CFA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>In that case, we would have to say, “We disagree.”</w:t></w:r></w:p><w:p w14:paraId="10B99B83" w14:textId="061D8FA5" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="00320C19" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="371C715A" w14:textId="77777777" w:rsidR="002027FE" w:rsidRPr="002427B7" w:rsidRDefault="002027FE" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3B8F98C1" w14:textId="79658AEF" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="003436C4" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S1</w:t></w:r><w:r w:rsidR="00320C19" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>9</w:t></w:r><w:r w:rsidR="00476525"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Li
yle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And the esteemed Chandrakirti answers with this:</w:t></w:r></w:p><w:p w14:paraId="49B8641B" w14:textId="4E548D5F" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1CC046F6" w14:textId="66B107ED" w:rsidR="008C45CC" w:rsidRPr="002427B7" w:rsidRDefault="008C45CC" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>Consider your statement itself.</w:t></w:r></w:p><w:p w14:paraId="3089EE68" w14:textId="368BE76B" w:rsidR="008C45CC" w:rsidRPr="002427B7" w:rsidRDefault="008C45CC" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3039D355" w14:textId="1B90651F" w:rsidR="008C45CC" w:rsidRPr="002427B7" w:rsidRDefault="008C45CC" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t xml:space="preserve">There is no need to add the qualifier “in an ultimate sense” to </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>it;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="0D841D86" w14:textId="206D4731" w:rsidR="008C45CC" w:rsidRPr="002427B7" w:rsidRDefault="008C45CC" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1B50EE68" w14:textId="2EDB0562" w:rsidR="008C45CC" w:rsidRPr="002427B7" w:rsidRDefault="00CD4A69" w:rsidP="00CD4A69"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> first of all, there is no need to apply it to the quality you are trying to prove.  And neither is there any need to apply it to the subject under consideration.</w:t></w:r></w:p><w:p w14:paraId="236A43F7" w14:textId="77777777" w:rsidR="00CD4A69" w:rsidRPr="002427B7" w:rsidRDefault="00CD4A69" w:rsidP="00CD4A69"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0B2C5BDF" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3FCD379A" w14:textId="4262B5EF" w:rsidR="004F7A60" w:rsidRPr="00F06A5B" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES"/></w:rPr><w:t>A32</w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:val="es-ES"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="3EDAF4A0" w14:textId="46E436AD" w:rsidR="004F7A60" w:rsidRPr="00F06A5B" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">DANG PO GRUB STE, SNGA RGOL LA LTOS NA YANG DGOS PA MED, PHYI RGOL LA LTOS NAS KYANG DGOS PA MED, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">JIG RTEN PA LA LTOS NAS KYANG </w:t></w:r><w:r w:rsidR="00DA1AF1" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">[f. </w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>43</w:t></w:r><w:r w:rsidR="00DA1AF1" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a] </w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>DGOS PA MED PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00F06A5B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="77E0C28D" w14:textId="04949330" w:rsidR="00352D21" w:rsidRPr="00F06A5B" w:rsidRDefault="00352D21" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="52DF501C" w14:textId="28ECC2C4" w:rsidR="00352D21" w:rsidRPr="002427B7" w:rsidRDefault="00352D21" w:rsidP="00352D21"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I disagree that there is no need to apply the phrase “in an ultimate sense” to the quality we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>re trying to prove.</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="230"/></w:r></w:p><w:p w14:paraId="6B30C3AE" w14:textId="48CFEC96" w:rsidR="00321CB0" w:rsidRPr="002427B7" w:rsidRDefault="00321CB0" w:rsidP="00352D21"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6BB4126D" w14:textId="36783B32" w:rsidR="00321CB0" w:rsidRPr="002427B7" w:rsidRDefault="00321CB0" w:rsidP="00352D21"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And </w:t></w:r><w:r w:rsidR="00D22AC6" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>yet there is no need,</w:t></w:r></w:p><w:p w14:paraId="3D83B339" w14:textId="007F652E" w:rsidR="00D22AC6" w:rsidRPr="002427B7" w:rsidRDefault="00D22AC6" w:rsidP="00352D21"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="32595686" w14:textId="75B707A1" w:rsidR="00D22AC6" w:rsidRPr="002427B7" w:rsidRDefault="00D22AC6" w:rsidP="00352D21"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> first of all, there is no need for it relative to the person presenting the argument.  Neither is there any need relative to the person to </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>whom the argument is being presented.  And finally, even in terms of the everyday world, there is no need.</w:t></w:r></w:p><w:p w14:paraId="69154FA3" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="719D060A" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2FFDA811" w14:textId="44D779B2" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A33</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="31256686" w14:textId="66D1977F" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DANG PO GRUB STE, SNGA RGOL DBU MA PAS BDAG SKYE KUN RDZOB TU YANG KHAS MA BLANGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="29F762AD" w14:textId="1291493D" w:rsidR="005865EF" w:rsidRPr="002427B7" w:rsidRDefault="005865EF" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6AB35A16" w14:textId="61C68C87" w:rsidR="005865EF" w:rsidRPr="002427B7" w:rsidRDefault="005865EF" w:rsidP="005865EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I disagree that—relative to the person presenting the argument—there is no need to add </w:t></w:r><w:r w:rsidR="003E5B54" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the expression </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“in an ultimate sense.”</w:t></w:r></w:p><w:p w14:paraId="02DAEE10" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1D582D68" w14:textId="7E8E1E20" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="005865EF" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/><w:t>And yet there is no need,</w:t></w:r></w:p><w:p w14:paraId="2D26B0DB" w14:textId="405B8585" w:rsidR="005865EF" w:rsidRPr="002427B7" w:rsidRDefault="005865EF" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="121E0F7E" w14:textId="0494E639" w:rsidR="005865EF" w:rsidRPr="002427B7" w:rsidRDefault="003651D1" w:rsidP="00FD00AF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Because</w:t></w:r><w:r w:rsidR="00FD00AF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> where the person presenting the argument is a member of the Middle Way School, the idea of something growing from itself would never be accepted, even if we were just speaking of it happening in a deceptive way, and not an ultimate way.</w:t></w:r></w:p><w:p w14:paraId="705B1596" w14:textId="77777777" w:rsidR="005865EF" w:rsidRPr="002427B7" w:rsidRDefault="005865EF" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5AD2B211" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="107FB274" w14:textId="42BE2D28" w:rsidR="004C32B8" w:rsidRPr="002427B7" w:rsidRDefault="004C32B8" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A34</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="6006145C" w14:textId="0B559127" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GNYIS PA GRUB STE, BDEN PA GNYIS LAS NYAMS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I MU STEGS NI BDEN PA GNYIS CHAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GOG PAR RIGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR</w:t></w:r><w:r w:rsidR="002B19C6" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r></w:p><w:p w14:paraId="75D2C4EA" w14:textId="77777777" w:rsidR="002B19C6" w:rsidRPr="002427B7" w:rsidRDefault="002B19C6" w:rsidP="002B19C6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1A29A1A6" w14:textId="32299111" w:rsidR="002B19C6" w:rsidRPr="002427B7" w:rsidRDefault="002B19C6" w:rsidP="002B19C6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Well </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>then</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> I disagree </w:t></w:r><w:r w:rsidR="00DC2B6C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to the second part of your reason.  I disagree that</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—relative to the person </w:t></w:r><w:r w:rsidR="00DC2B6C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to whom</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the argument</w:t></w:r><w:r w:rsidR="00DC2B6C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> is being presented</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—there is no need to add </w:t></w:r><w:r w:rsidR="003E5B54" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the expression </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“in an ultimate sense.”</w:t></w:r></w:p><w:p w14:paraId="7FAEFC75" w14:textId="7718190D" w:rsidR="003F612C" w:rsidRPr="002427B7" w:rsidRDefault="003F612C" w:rsidP="002B19C6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="54C179D9" w14:textId="5F01824D" w:rsidR="003F612C" w:rsidRPr="002427B7" w:rsidRDefault="003F612C" w:rsidP="003F612C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And yet even in this second </w:t></w:r><w:r w:rsidR="006223FF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>context</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> there is no need for </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>it;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="56364C81" w14:textId="7C21E0BA" w:rsidR="003F612C" w:rsidRPr="002427B7" w:rsidRDefault="003F612C" w:rsidP="003F612C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3AB7470B" w14:textId="0F0E4C84" w:rsidR="003F612C" w:rsidRPr="002427B7" w:rsidRDefault="003F612C" w:rsidP="003F612C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Because </w:t></w:r><w:r w:rsidR="0025773C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in </w:t></w:r><w:r w:rsidR="00D57C87" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:r w:rsidR="0025773C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> case where the opponent is a follower of a non-Buddhist school and has failed even to grasp the concept of two realities—deceptive </w:t></w:r><w:r w:rsidR="00A056AA" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp;</w:t></w:r><w:r w:rsidR="0025773C" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> ultimate—it is appropriate to make our refutation from the point of view of both of those realities at once.</w:t></w:r></w:p><w:p w14:paraId="1564D771" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="58A9C95D" w14:textId="77
002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">When the Lord of the Able Ones </w:t></w:r></w:p><w:p w14:paraId="687E512E" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Passed beyond this world,</w:t></w:r></w:p><w:p w14:paraId="50FD4F5D" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">His teachings descended to the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>dregs;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="20DA9414" w14:textId="77777777" w:rsidR="00C51737" w:rsidRPr="002427B7" w:rsidRDefault="00C51737" w:rsidP="00032A0B"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And there was only one</w:t></w:r></w:p><w:p w14:paraId="7C6F8F51" w14:textId="77777777" w:rs
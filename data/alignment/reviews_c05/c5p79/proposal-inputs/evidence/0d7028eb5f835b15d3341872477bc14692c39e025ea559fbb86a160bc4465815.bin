l:space="preserve">If they take, as </w:t></w:r><w:r w:rsidR="00A62E51" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">part of </w:t></w:r><w:r w:rsidR="008C67F2" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the subject under their consideration, </w:t></w:r><w:r w:rsidR="007B4A2E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a kind of impermanence where the</w:t></w:r><w:r w:rsidR="005E2001" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> later destruction of the sound depends on no </w:t></w:r><w:r w:rsidR="00AD480B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">separate, </w:t></w:r><w:r w:rsidR="005E2001" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">later </w:t></w:r><w:r w:rsidR="00AD480B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">factor, </w:t></w:r><w:r w:rsidR="00E12AE2" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">then </w:t></w:r><w:r w:rsidR="004F244E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">this subject will not be acceptable to the Detailer.  And yet if they take, as </w:t></w:r><w:r w:rsidR="00B2460F" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">part of this </w:t></w:r><w:r w:rsidR="004F244E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">subject, a kind of </w:t></w:r><w:r w:rsidR="00B2460F" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">impermanence where that later destruction does depend on a separate, later factor, then </w:t></w:r><w:r w:rsidR="00321943" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the subject under consideration will be unacceptable to the Buddhist.</w:t></w:r></w:p><w:p w14:paraId="36386562" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5B46D478" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="194A4CCB" w14:textId="771E58F7" w:rsidR="00461D7A" w:rsidRPr="002427B7" w:rsidRDefault="00461D7A" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts 
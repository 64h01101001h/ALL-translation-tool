:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I DE KHO NA NYID </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>DZIN PA LA RAG LAS PAR BZHED PA GNYIS KA MTHUN KYANG, ZLA BA GRAGS PAS DE LTA BU MI SRID PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR, RANG RGYUD KYI GTAN TSIGS MI BZHED PA YIN </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>NO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="6F6F1071" w14:textId="12D6C420" w:rsidR="00D04A80" w:rsidRPr="002427B7" w:rsidRDefault="00D04A80" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="542EC9E1" w14:textId="2FFD4666" w:rsidR="00D04A80" w:rsidRPr="002427B7" w:rsidRDefault="00D04A80" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Master Chandrakirti and Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Dignaga</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00530C31" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>are the same in asserting that</w:t></w:r><w:r w:rsidR="009D05E1" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—if something were an independently effective syllogism—then the very root of the accurate perception which confirmed its three necessary elements</w:t></w:r><w:r w:rsidR="00335B3F" w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="115"/></w:r><w:r w:rsidR="009D05E1" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00DB44C0" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is that it </w:t></w:r><w:r w:rsidR="00580002" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>would have to depend on a perception of suchness that existed without any false elaboration by the mind.</w:t></w:r><w:r w:rsidR="00C322ED" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  Chandrakirti though would say that such a </w:t></w:r><w:r w:rsidR="00335B3F" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">thing was impossible; and for this </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00335B3F" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>reason</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00335B3F" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> would deny the idea of an independently effective syllogism.</w:t></w:r><w:r w:rsidR="00580002" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r></w:p><w:p w14:paraId="206CF8D8" w14:textId="328E02F6" w:rsidR="00C4460A" w:rsidRPr="002427B7" w:rsidRDefault="00C4460A" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="64A07F9C" w14:textId="77777777" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="00320C19" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7C4C5D22" w14:textId="46F86DDF" w:rsidR="00320C19" w:rsidRPr="002427B7" w:rsidRDefault="003436C4" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S1</w:t></w:r><w:r w:rsidR="00320C19" w:rsidRPr="00242
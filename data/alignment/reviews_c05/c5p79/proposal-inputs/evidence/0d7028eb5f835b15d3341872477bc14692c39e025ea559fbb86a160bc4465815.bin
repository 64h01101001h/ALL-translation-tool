 w14:textId="185976A4" w:rsidR="009E7ADA" w:rsidRPr="002427B7" w:rsidRDefault="009E7ADA" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Which brings us to </w:t></w:r><w:r w:rsidR="00F74EAE" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">second step in our presentation of the reasoning that we use </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to  refute</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the extreme view that things could exist the way they appear</w:t></w:r><w:r w:rsidR="002A61FD" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.  This is where we cover incidental points on this topic.</w:t></w:r></w:p><w:p w14:paraId="3B29365D" w14:textId="33BF44EB" w:rsidR="007F5341" w:rsidRPr="002427B7" w:rsidRDefault="007F5341" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4BC3BC38" w14:textId="2F1889CF" w:rsidR="00543EF6" w:rsidRPr="002427B7" w:rsidRDefault="00543EF6" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5B6B9F64" w14:textId="0C7FE7D9" w:rsidR="00543EF6" w:rsidRPr="002427B7" w:rsidRDefault="00543EF6" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="75DC1580" w14:textId="1990C78A" w:rsidR="00543EF6" w:rsidRPr="002427B7" w:rsidRDefault="008A5383" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">How those who </w:t></w:r><w:r w:rsidR="00E71785" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>have not overcome</w:t></w:r></w:p><w:p w14:paraId="6243C602" w14:textId="4ADC0405" w:rsidR="00E71785" w:rsidRPr="002427B7" w:rsidRDefault="00E71785" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the discrepancy cannot be free</w:t></w:r></w:p><w:p w14:paraId="4C37F86D" w14:textId="77777777" w:rsidR="007F5341" w:rsidRPr="002427B7" w:rsidRDefault="007F5341" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1679879D" w14:textId="4346DE93" w:rsidR="007F5341" w:rsidRPr="002427B7" w:rsidRDefault="003436C4" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[S1</w:t></w:r><w:r w:rsidR="007F5341" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>7</w:t></w:r><w:r w:rsidR="00476525"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>8</w:t></w:r><w:r w:rsidR="007F5341" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="55A85CB3" w14:textId="6D64A63C" w:rsidR="005E4A3D" w:rsidRPr="002427B7" w:rsidRDefault="007F5341" w:rsidP="007F5341"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GNYIS SU LTA BAS MI GROL BAR BSTAN PA DANG, GNYIS MED RTOGS PAS GROL BAR BSTAN </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>O,,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> DANG PO NI,</w:t></w:r></w:p><w:p w14:paraId="0D332EB6" w14:textId="77777777" w:rsidR="005E4A3D" w:rsidRPr="002427B7" w:rsidRDefault="005E4A3D" w:rsidP="007F5341"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="618D3753" w14:textId="6A4B6A60" w:rsidR="005E4A3D" w:rsidRPr="002427B7" w:rsidRDefault="00CB5DDC" w:rsidP="007F5341"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">These incidental points themselves come in two parts: demonstrating that a person can never reach liberation </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>as long as</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> there is still a discrepancy between what they see and what</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s really there; </w:t></w:r><w:r w:rsidR="009438C3" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>and then demonstrating that</w:t></w:r><w:r w:rsidR="00E43D8B" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—when a person comes to a realization where there is no longer any such discrepancy—</w:t></w:r><w:r w:rsidR="00244037" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">they </w:t></w:r><w:r w:rsidR="00244037" w:rsidRPr="003A6115"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>can</w:t></w:r><w:r w:rsidR="00244037" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> then reach liberation.  </w:t></w:r><w:r w:rsidR="00E676CF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The first of these is expressed in the following lines of Arya Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00E676CF" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s root text:</w:t></w:r></w:p><w:p w14:paraId="1BEF19AF" w14:textId="77777777" w:rsidR="005E4A3D" w:rsidRPr="002427B7" w:rsidRDefault="005E4A3D" w:rsidP="007F5341"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype
s/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“It is liberation</w:t></w:r></w:p><w:p w14:paraId="71F72234" w14:textId="77777777" w:rsidR="00E97F42" w:rsidRDefault="00E97F42" w:rsidP="00E97F42"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When those as well</w:t></w:r></w:p><w:p w14:paraId="30E82505" w14:textId="77777777" w:rsidR="00E97F42" w:rsidRDefault="00E97F42" w:rsidP="00E97F42"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Have come to a stop for them</w:t></w:r></w:p><w:p w14:paraId="54E0FB85" w14:textId="77777777" w:rsidR="00E97F42" w:rsidRDefault="00E97F42" w:rsidP="00E97F42"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here in this life.”</w:t></w:r></w:p><w:p w14:paraId="0F3ADB6F" w14:textId="5EFCB430" w:rsidR="00BE64E0" w:rsidRDefault="00BE64E0" w:rsidP="00E95ABF"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6000DC55" w14:textId="77777777" w:rsidR="00BE64E0" w:rsidRPr="002427B7" w:rsidRDefault="00BE64E0" w:rsidP="00BE64E0"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang 
val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00035BC0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Had yet to be stopped,</w:t></w:r></w:p><w:p w14:paraId="13FE76D3" w14:textId="77777777" w:rsidR="004A2F1C" w:rsidRDefault="004A2F1C" w:rsidP="004A2F1C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Then even if we had finished off</w:t></w:r></w:p><w:p w14:paraId="24213AFF" w14:textId="77777777" w:rsidR="004A2F1C" w:rsidRDefault="004A2F1C" w:rsidP="004A2F1C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Our negative emotions,</w:t></w:r></w:p><w:p w14:paraId="29E100E9" w14:textId="77777777" w:rsidR="004A2F1C" w:rsidRDefault="004A2F1C" w:rsidP="004A2F1C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>We would still not have</w:t></w:r></w:p><w:p w14:paraId="37ECADEE" w14:textId="77777777" w:rsidR="004A2F1C" w:rsidRPr="00035BC0" w:rsidRDefault="004A2F1C" w:rsidP="004A2F1C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr
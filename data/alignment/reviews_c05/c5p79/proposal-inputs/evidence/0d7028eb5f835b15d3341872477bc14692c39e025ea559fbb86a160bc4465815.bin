Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That all these things are empty,</w:t></w:r></w:p><w:p w14:paraId="13F116C0" w14:textId="35A325FF" w:rsidR="00865F2F" w:rsidRDefault="00865F2F" w:rsidP="00865F2F"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And then go on</w:t></w:r></w:p><w:p w14:paraId="3ABA1F66" w14:textId="49BE3F15" w:rsidR="00865F2F" w:rsidRDefault="00865F2F" w:rsidP="00865F2F"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>To rely on the laws</w:t></w:r></w:p><w:p w14:paraId="2D8AF1AB" w14:textId="4D27D73B" w:rsidR="00865F2F" w:rsidRDefault="00865F2F" w:rsidP="00865F2F"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of karma and its consequences,</w:t></w:r></w:p><w:p w14:paraId="126C5DA8" w14:textId="77777777" w:rsidR="00865F2F" w:rsidRDefault="00865F2F" w:rsidP="00865F2F"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="70D27E0D" w14:textId="03D86D02" w:rsidR="00865F2F" w:rsidRDefault="00865F2F" w:rsidP="00865F2F"><w:pPr><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotyp
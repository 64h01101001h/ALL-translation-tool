lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">When those who accept the concept of dependence—who rely upon the path of the Buddha—take </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">this </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">heap of physical form </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">or that </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">heap of feelings, and </w:t></w:r><w:r w:rsidRPr="00E630A1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>really examine any of them</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> with logical thinking, then not the slightest self-nature can be observed in any of them.</w:t></w:r></w:p><w:p w14:paraId="616CF08D" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2B5546DD" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0BD33BE2" w14:textId="54E3E228" w:rsidR="00E44765" w:rsidRDefault="00E44765" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S582]</w:t></w:r></w:p><w:p w14:paraId="018C4682" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="00443E23" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">RANG BZHIN </w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>MI DMIGS NA</w:t></w:r><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> GZHAN LA BSTAN PAR MI NUS </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00443E23"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr><w:t>SO,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="7D79A1DE" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="00443E23" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4A481045" w14:textId="328261EC" w:rsidR="00C77464" w:rsidRDefault="004D487B" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And if a self-nature </w:t></w:r><w:r w:rsidRPr="00E27CC6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>cannot be observed,</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> then no one would ever be able to show it to another person.</w:t></w:r></w:p><w:p w14:paraId="6C056CC8" w14:textId="77777777" w:rsidR="004D487B" w:rsidRPr="002427B7" w:rsidRDefault="004D487B" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="49A51510" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4567F79E" w14:textId="05BA1DA7" w:rsidR="00E44765" w:rsidRDefault="00E44765" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S583]</w:t></w:r></w:p><w:p w14:paraId="5D25D32A" w14:textId="2C0C42BF" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">BSTAN PAR MI NUS PA DE NI </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linot
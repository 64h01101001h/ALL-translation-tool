N"/></w:rPr><w:t xml:space="preserve">22 </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">years after their </w:t></w:r><w:r w:rsidR="00A70CD1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">first </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>meeting.</w:t></w:r></w:p><w:p w14:paraId="361F6C4A" w14:textId="77777777" w:rsidR="00AC3D8E" w:rsidRDefault="00AC3D8E" w:rsidP="00F94A91"><w:pPr><w:pStyle w:val="PlainText"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="54866773" w14:textId="02E2E9A9" w:rsidR="002D7D06" w:rsidRDefault="00AC3D8E" w:rsidP="00F94A91"><w:pPr><w:pStyle w:val="PlainText"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Reading the colophons of first carvings of Je Rinpoche</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s works, we constantly see </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s name mentioned as the scribe who took down the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>notes, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> labored to turn them into polished philosophical works of their own.  </w:t></w:r><w:r w:rsidR="00303FEE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">One of our favorites among these transcripts is the extraordinary record of teachings </w:t></w:r><w:r w:rsidR="00BB14C4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">granted by </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00BB14C4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="24"/><w:szCs w:val="24"/><w:lang w:bidi="
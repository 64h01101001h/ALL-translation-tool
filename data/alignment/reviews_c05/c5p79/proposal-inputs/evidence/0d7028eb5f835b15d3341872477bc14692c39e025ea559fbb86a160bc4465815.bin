nts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00615783"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>work</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00615783"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> which is the main body, and that the </w:t></w:r><w:r w:rsidR="00615783"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Root Verses on Wisdom </w:t></w:r><w:r w:rsidR="00615783"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is itself the expansion.  You should understand that these two positions are </w:t></w:r><w:r w:rsidR="00B82F97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>mistaken.</w:t></w:r><w:r w:rsidR="00CB3536"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="20"/></w:r></w:p><w:p w14:paraId="045017ED" w14:textId="314A823F" w:rsidR="003053D1" w:rsidRDefault="003053D1" w:rsidP="008F2975"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="12738315" w14:textId="77777777" w:rsidR="00BA4CA3" w:rsidRDefault="00BA4CA3" w:rsidP="008F2975"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="298AC4D7" w14:textId="320CD4BF" 
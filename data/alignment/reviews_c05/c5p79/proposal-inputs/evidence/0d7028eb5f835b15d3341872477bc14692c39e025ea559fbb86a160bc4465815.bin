/></w:rPr></w:pPr><w:r w:rsidRPr="00B22EBA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“It is liberation</w:t></w:r></w:p><w:p w14:paraId="58C3C658" w14:textId="77777777" w:rsidR="00B22EBA" w:rsidRPr="00B22EBA" w:rsidRDefault="00B22EBA" w:rsidP="00B22EBA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00B22EBA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When those as well</w:t></w:r></w:p><w:p w14:paraId="699D11CE" w14:textId="77777777" w:rsidR="00B22EBA" w:rsidRPr="00B22EBA" w:rsidRDefault="00B22EBA" w:rsidP="00B22EBA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00B22EBA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Have come to a stop for them</w:t></w:r></w:p><w:p w14:paraId="68B8AE0D" w14:textId="49C104FF" w:rsidR="00772A1C" w:rsidRDefault="00B22EBA" w:rsidP="00B22EBA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00B22EBA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Here in this life.”</w:t></w:r></w:p><w:p w14:paraId="5D1F14CF" w14:textId="77777777" w:rsidR="00B22EBA" w:rsidRDefault="00B22EBA" w:rsidP="00B22EBA"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w
hAnsi="Palatino Linotype"/></w:rPr><w:t>teaching in the temples and monasteries around town.</w:t></w:r><w:r w:rsidR="0087508A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> People are</w:t></w:r><w:r w:rsidR="0087508A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>flocking to hear him, which of course stirs a bit of jealousy among</w:t></w:r><w:r w:rsidR="003C104C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>some of the other monks.</w:t></w:r></w:p><w:p w14:paraId="6BBD888D" w14:textId="77777777" w:rsidR="003C104C" w:rsidRPr="00191ADE" w:rsidRDefault="003C104C" w:rsidP="003C104C"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3BFF6004" w14:textId="00A62399" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="003C104C"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“One of these is </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je (who was of course at that time</w:t></w:r><w:r w:rsidR="003C104C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">known by his original name, Darma </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Rinchen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">). </w:t></w:r><w:r w:rsidR="003C104C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s already</w:t></w:r><w:r w:rsidR="003C104C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">probably the most famous logician in </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>all of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> central Tibet by</w:t></w:r><w:r w:rsidR="003C104C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>this time, and he starts to get irritated that everyone</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s talking about</w:t></w:r><w:r w:rsidR="003C104C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>this new guy instead.</w:t></w:r></w:p><w:p w14:paraId="107145C3" w14:textId="77777777" w:rsidR="003C104C" w:rsidRPr="00191ADE" w:rsidRDefault="003C104C" w:rsidP="003C104C"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="42756904" w14:textId="59D1D34F" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00421836"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“One day </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je hears that Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> going to be giving a teaching at a temple not far from his home. </w:t></w:r><w:r w:rsidR="009F740D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>So</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> he puts on his</w:t></w:r><w:r w:rsidR="00AF2EDA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>fanciest robes and highest pandit</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s hat (a </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>wizardish</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> pointed cap reserved for the greatest thinkers).</w:t></w:r><w:r w:rsidR="00045D9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> He</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s running a little late, so he decides</w:t></w:r><w:r w:rsidR="00421836"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>to cut across some fields to get there quicker.</w:t></w:r></w:p><w:p w14:paraId="3E0C00EE" w14:textId="77777777" w:rsidR="00421836" w:rsidRPr="00191ADE" w:rsidRDefault="00421836" w:rsidP="00421836"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="18D626EE" w14:textId="4330F48E" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="0088121D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“Then something weird happens, this kind of shift in the world that happens around high Lamas, and </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je suddenly finds</w:t></w:r><w:r w:rsidR="00421836"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>himself lost amongst a bunch of rolling, grass-covered hills that all look the same.</w:t></w:r><w:r w:rsidR="006C17FC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> To his relief, a herd of milk cows crests one of the hills,</w:t></w:r><w:r w:rsidR="00AD395D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>and behind it comes a decidedly shabby shepherd girl, who smells much</w:t></w:r><w:r w:rsidR="0088121D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>like her mooing charges.</w:t></w:r></w:p><w:p w14:paraId="71DD640E" w14:textId="77777777" w:rsidR="00C764B5" w:rsidRPr="00191ADE" w:rsidRDefault="00C764B5" w:rsidP="0088121D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="75347616" w14:textId="6F47A578" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00392FC1"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“So </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je walks up to the girl and demands, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>You there! I</w:t></w:r><w:r w:rsidR="00C764B5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>need some help here! I</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">ve heard that that new guy, Big Nose </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>From</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the</w:t></w:r><w:r w:rsidR="00C764B5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>East,</w:t></w:r><w:r w:rsidR="00C85183"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="47"/></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> is giving a teaching somewhere around here today. </w:t></w:r><w:r w:rsidR="00002C79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>If you know</w:t></w:r><w:r w:rsidR="00392FC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>which way I need to go to get there, tell me now, and make it snappy!</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="7167D0CA" w14:textId="77777777" w:rsidR="00392FC1" w:rsidRPr="00191ADE" w:rsidRDefault="00392FC1" w:rsidP="00392FC1"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="65C51E08" w14:textId="507FE4A0" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00392FC1"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“The girl looks him shyly up and down, in all his monastic grandeur,</w:t></w:r><w:r w:rsidR="00392FC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">then replies, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>And may I ask, esteemed sir, who you yourself may</w:t></w:r><w:r w:rsidR="00392FC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>be?</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="76B80DB6" w14:textId="77777777" w:rsidR="00392FC1" w:rsidRPr="00191ADE" w:rsidRDefault="00392FC1" w:rsidP="00392FC1"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5CB3E7C5" w14:textId="7C9EE0C0" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00392FC1"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je puffs up his chest and declares, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>I am the master</w:t></w:r><w:r w:rsidR="00392FC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Darma </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Rinchen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, quite probably the greatest logician ever seen in the</w:t></w:r><w:r w:rsidR="00392FC1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>entire Land of Snows!</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="06E5AB7D" w14:textId="77777777" w:rsidR="00392FC1" w:rsidRDefault="00392FC1" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="385AAE98" w14:textId="3C26678D" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00627065"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“The girl looks down demurely and says softly, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Oh my! </w:t></w:r><w:r w:rsidR="00715C5F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>How wonderful for a wretch like me</w:t></w:r><w:r w:rsidR="00434EAE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">to meet your esteemed self! </w:t></w:r><w:r w:rsidR="00627065"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">In </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>fact</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> I have dreamed of this day for years, because I have a burning</w:t></w:r><w:r w:rsidR="00627065"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>philosophical question that I have longed to ask a sage the likes of you.</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="1D588031" w14:textId="77777777" w:rsidR="00627065" w:rsidRPr="00191ADE" w:rsidRDefault="00627065" w:rsidP="00627065"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="417B8F8E" w14:textId="25E5FB8E" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="002F1F0E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je beams and gives her a condescending look of pleasure. </w:t></w:r><w:r w:rsidR="002F1F0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Of course, my child,</w:t></w:r><w:r w:rsidR="002F1F0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>you may ask any question you please, however difficult it may be.</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="477991D4" w14:textId="77777777" w:rsidR="002F1F0E" w:rsidRPr="00191ADE" w:rsidRDefault="002F1F0E" w:rsidP="002F1F0E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5D6C4F55" w14:textId="34965808" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="002F1F0E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“The shepherd girl looks around for a moment, then points over to one of the cows.</w:t></w:r><w:r w:rsidR="002F1F0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>There! That one! Look, right now!</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="7F826632" w14:textId="77777777" w:rsidR="002F1F0E" w:rsidRPr="00191ADE" w:rsidRDefault="002F1F0E" w:rsidP="002F1F0E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1C205DB5" w14:textId="321988F1" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="009364AC"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je turns to see a huge, brown, doe-eyed momma cow slowly lift her tail up high</w:t></w:r><w:r w:rsidR="002F1F0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">in the air. </w:t></w:r><w:r w:rsidR="009F740D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">And you know what that means. </w:t></w:r><w:r w:rsidR="00CE1542"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Her bunghole comes up straight to the sky, and out</w:t></w:r><w:r w:rsidR="00CE1542"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">squeezes a big turd, which (respecting the laws of gravity) then does that sort of a </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>back-flip</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> and</w:t></w:r><w:r w:rsidR="009364AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>falls to the ground in a huge flat pile—</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00707D50"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>foof</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00707D50"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>!</w:t></w:r></w:p><w:p w14:paraId="53CD2EA7" w14:textId="77777777" w:rsidR="00D20CC0" w:rsidRPr="00191ADE" w:rsidRDefault="00D20CC0" w:rsidP="009364AC"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="432464BD" w14:textId="696F69CD" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00D20CC0"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>What I wanted to ask</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:hint="eastAsia"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> smiles the young maiden as she flutters her tender eyelids, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>is</w:t></w:r><w:r w:rsidR="00D20CC0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>this.</w:t></w:r></w:p><w:p w14:paraId="0C4D6A8A" w14:textId="77777777" w:rsidR="00D20CC0" w:rsidRPr="00191ADE" w:rsidRDefault="00D20CC0" w:rsidP="00D20CC0"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="45EF8C96" w14:textId="6DD18C09" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="003B1C01"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">We can see that, when the cowpie is </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>actually coming</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> out of the cow, then for a short time</w:t></w:r><w:r w:rsidR="003B1C01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>the cowpie</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s bottom becomes its top. </w:t></w:r><w:r w:rsidR="009F740D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Do you follow me?</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="03EADD76" w14:textId="77777777" w:rsidR="003B1C01" w:rsidRPr="00191ADE" w:rsidRDefault="003B1C01" w:rsidP="003B1C01"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6E92AAA2" w14:textId="5451CA4F" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="003B1C01"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je nods, concentrating fiercely.</w:t></w:r><w:r w:rsidR="003B1C01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>But then</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:hint="eastAsia"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> she says, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>when it topples over and</w:t></w:r><w:r w:rsidR="003B1C01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">plops on the grass, the top—as it were—changes into the bottom. </w:t></w:r><w:r w:rsidR="008A57FF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Do you see?</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="131A24CA" w14:textId="77777777" w:rsidR="006B6318" w:rsidRPr="00191ADE" w:rsidRDefault="006B6318" w:rsidP="003B1C01"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0BA8F3C7" w14:textId="5289C349" w:rsidR="00C44919" w:rsidRPr="00191ADE" w:rsidRDefault="00C44919" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je nods instantly. </w:t></w:r><w:r w:rsidR="009F740D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>His genius is rising.</w:t></w:r></w:p><w:p w14:paraId="03499EDF" w14:textId="77777777" w:rsidR="006B6318" w:rsidRDefault="006B6318" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7A9365C9" w14:textId="68EC514E" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="002064DE"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>And so</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:hint="eastAsia"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> she concludes cutely, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>I was wondering if you could tell me—which is the top of</w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>the cowpie, and which its bottom?</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="7CB4FF2C" w14:textId="77777777" w:rsidR="002064DE" w:rsidRPr="00191ADE" w:rsidRDefault="002064DE" w:rsidP="002064DE"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="769677BF" w14:textId="3FCB7845" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00617B3E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je takes a step back, glances into her eyes, looks over at the innocent, inquisitive</w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>face of the cow, and then leans over the cowpie to inspect it.</w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> And in that moment, for the</w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">first time in his life, his mind goes utterly blank. </w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>No assertion, no major premise, no minor</w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">premise, no analogies, no valid reason, and no…logical conclusion. </w:t></w:r><w:r w:rsidR="002064DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>He looks back up at the girl,</w:t></w:r><w:r w:rsidR="00617B3E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>blankly.</w:t></w:r></w:p><w:p w14:paraId="3BEF889D" w14:textId="77777777" w:rsidR="00617B3E" w:rsidRPr="00191ADE" w:rsidRDefault="00617B3E" w:rsidP="00617B3E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="057CDBF1" w14:textId="61143C89" w:rsidR="00C44919" w:rsidRPr="00191ADE" w:rsidRDefault="00C44919" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Well</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> I…well I…well I don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>t know</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="00133715"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:hint="eastAsia"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> he stutters.</w:t></w:r><w:r w:rsidR="00617B3E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>I can</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>t really say.</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="3DA5F976" w14:textId="77777777" w:rsidR="00617B3E" w:rsidRDefault="00617B3E" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="647C8617" w14:textId="07D6F48B" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="009B160D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“The girl nods once, and when her eyes rise again to meet </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s they hold the fury</w:t></w:r><w:r w:rsidR="009B160D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>of the fire that ends this very world: suddenly she is the Angel of Death herself, wrapped in hellfire</w:t></w:r><w:r w:rsidR="009B160D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>blazing crimson like the sun.</w:t></w:r></w:p><w:p w14:paraId="02769F3C" w14:textId="77777777" w:rsidR="009B160D" w:rsidRPr="00191ADE" w:rsidRDefault="009B160D" w:rsidP="009B160D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="106FDEA3" w14:textId="72428A6A" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00C7468D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“She turns around and drops to her knees. </w:t></w:r><w:r w:rsidR="009F740D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Suddenly there is a bouquet of burning incense</w:t></w:r><w:r w:rsidR="009B160D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>sticks in her hands; she throws herself flat on the ground, points the sticks in her clasped palms</w:t></w:r><w:r w:rsidR="009B160D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">to the east, and cries out, </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>I don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">t know about anybody by the name of Big Nose </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>From</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the East.</w:t></w:r><w:r w:rsidR="00C7468D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>But if you seek the Great One, Our Matchless Lord and Savior, that Incomparable Light of</w:t></w:r><w:r w:rsidR="00C7468D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Wisdom for Our Entire Planet and The Very Cosmos Itself, well then, sir, you must walk on in</w:t></w:r><w:r w:rsidR="00C7468D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>the direction that I pay my unworthy obeisance.</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r></w:p><w:p w14:paraId="315A9871" w14:textId="77777777" w:rsidR="00C7468D" w:rsidRPr="00191ADE" w:rsidRDefault="00C7468D" w:rsidP="00C7468D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1197208D" w14:textId="6835059A" w:rsidR="00C44919" w:rsidRPr="00191ADE" w:rsidRDefault="00C44919" w:rsidP="00C7468D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je is blinded by the light for a moment and, by the time his eyes recover, the girl</w:t></w:r><w:r w:rsidR="00C7468D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">and her cows are way off behind him, halfway up the next hill. </w:t></w:r><w:r w:rsidR="00C7468D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>He shakes his skull to clear it,</w:t></w:r><w:r w:rsidR="00C7468D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>hitches up his robes, and marches straight ahead, too bull-headed and proud to be dissuaded.</w:t></w:r></w:p><w:p w14:paraId="66E20612" w14:textId="77777777" w:rsidR="005B5B9C" w:rsidRDefault="005B5B9C" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7927536F" w14:textId="736329E2" w:rsidR="00B075A6" w:rsidRDefault="00C44919" w:rsidP="00B075A6"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“Now I </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>wanna</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> say it was the other great disciple—</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Kedrup</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je—but that</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s a bit early</w:t></w:r><w:r w:rsidR="00E37530"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">so I think it was </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Tsako</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Wonpo</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, or somebody like that, who was already at the temple helping</w:t></w:r><w:r w:rsidR="007C54A2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">to get the place ready for the teachings. </w:t></w:r><w:r w:rsidR="00B075A6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>He has clairvoyance and can read people</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s minds;</w:t></w:r><w:r w:rsidR="00B075A6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">he sees </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je coming and knows he has an act of arrogance planned: he will enter the</w:t></w:r><w:r w:rsidR="00B075A6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>temple and refuse to doff his pandit</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s hat to Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="71B33626" w14:textId="77777777" w:rsidR="00B075A6" w:rsidRDefault="00B075A6" w:rsidP="00B075A6"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4A347484" w14:textId="51251C58" w:rsidR="00C44919" w:rsidRDefault="00B075A6" w:rsidP="002752CB"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidR="00C44919" w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">You </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00C44919" w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>gotta</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00C44919" w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> realize what a huge</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00C44919" w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>breach of etiquette this is in Tibet—sort of like showing up in a church for a talk by His</w:t></w:r><w:r w:rsidR="002752CB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00C44919" w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Holiness the Pope wearing nothing but your underwear, and fire-red underwear at that.</w:t></w:r></w:p><w:p w14:paraId="5AA14C82" w14:textId="77777777" w:rsidR="0074100D" w:rsidRPr="00191ADE" w:rsidRDefault="0074100D" w:rsidP="002752CB"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4F75701B" w14:textId="53C089D7" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="0074100D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“So </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Tsako</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Wonpo</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> climbs up on the roof of the temple, right over the front door.</w:t></w:r><w:r w:rsidR="0074100D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je is late—everyone</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s already seated, and when he steps up to the temple doors</w:t></w:r><w:r w:rsidR="0074100D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>everybody turns around, awed to witness the arrival of the Great Logician.</w:t></w:r></w:p><w:p w14:paraId="2857EA03" w14:textId="77777777" w:rsidR="0074100D" w:rsidRPr="00191ADE" w:rsidRDefault="0074100D" w:rsidP="0074100D"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="331CCEF1" w14:textId="0EBE0407" w:rsidR="00C44919" w:rsidRPr="00191ADE" w:rsidRDefault="00C44919" w:rsidP="007F6B64"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">“At this moment, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Tsako</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Wonpo</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> lowers a thread with a fishhook tied to it.</w:t></w:r><w:r w:rsidR="00A844C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>He snares</w:t></w:r><w:r w:rsidR="00A844C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s pandit hat and it falls off into </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s hands.</w:t></w:r><w:r w:rsidR="007F6B64"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>A murmur passes through</w:t></w:r><w:r w:rsidR="007F6B64"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">the crowd: If even the great </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Je removes his hat to him, then this new teacher has</w:t></w:r><w:r w:rsidR="007F6B64"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>got to be something special!</w:t></w:r></w:p><w:p w14:paraId="2DE44F74" w14:textId="77777777" w:rsidR="007F6B64" w:rsidRDefault="007F6B64" w:rsidP="003B36CF"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="74B43233" w14:textId="166DAF73" w:rsidR="00C44919" w:rsidRDefault="00C44919" w:rsidP="00404E0E"><w:pPr><w:autoSpaceDE w:val="0"/><w:autoSpaceDN w:val="0"/><w:adjustRightInd w:val="0"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r w:rsidRPr="00191ADE"><w:rPr><w:rFonts w:ascii="Palatino Lin
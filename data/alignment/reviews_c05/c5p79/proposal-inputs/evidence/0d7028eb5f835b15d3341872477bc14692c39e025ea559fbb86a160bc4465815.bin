ype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>He taught a path</w:t></w:r></w:p><w:p w14:paraId="66FC6DE1" w14:textId="77777777" w:rsidR="00F26B34" w:rsidRPr="00933426" w:rsidRDefault="00F26B34" w:rsidP="00F26B34"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00933426"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Based on starting &amp; ending</w:t></w:r></w:p><w:p w14:paraId="7D102BD9" w14:textId="77777777" w:rsidR="00F26B34" w:rsidRPr="00933426" w:rsidRDefault="00F26B34" w:rsidP="00F26B34"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00933426"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Simply as a means</w:t></w:r></w:p><w:p w14:paraId="706F1F3C" w14:textId="77777777" w:rsidR="00F26B34" w:rsidRPr="00933426" w:rsidRDefault="00F26B34" w:rsidP="00F26B34"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00933426"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>To an end.</w:t></w:r></w:p><w:p w14:paraId="720E474A" w14:textId="65A6C6DC" w:rsidR="00F26B34" w:rsidRDefault="00F26B34" w:rsidP="00F26B34"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4A27D20B" w14:textId="20AF6FBC" w:rsidR=
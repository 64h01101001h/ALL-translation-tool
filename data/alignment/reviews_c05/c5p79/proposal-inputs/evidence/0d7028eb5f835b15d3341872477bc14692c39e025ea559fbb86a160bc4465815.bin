w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This or that,</w:t></w:r></w:p><w:p w14:paraId="35995E71" w14:textId="029F6873" w:rsidR="002A3F8E" w:rsidRDefault="000F28AF" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>It cannot be observed.</w:t></w:r></w:p><w:p w14:paraId="3D724983" w14:textId="77777777" w:rsidR="000F28AF" w:rsidRDefault="000F28AF" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5D78F162" w14:textId="5F3B7BE9" w:rsidR="000F28AF" w:rsidRDefault="000E5A0F" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>What wise person then</w:t></w:r></w:p><w:p w14:paraId="0A7E0668" w14:textId="034AF9A4" w:rsidR="000E5A0F" w:rsidRDefault="000E5A0F" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Would ever talk this way,</w:t></w:r></w:p><w:p w14:paraId="33D1050C" w14:textId="5E3F8112" w:rsidR="000E5A0F" w:rsidRDefault="000E5A0F" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Arguing about it,</w:t></w:r></w:p><w:p w14:paraId="64094D36" w14:textId="57FDDB64" w:rsidR="000E5A0F" w:rsidRDefault="000E5A0F" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Saying this or that</w:t></w:r></w:p><w:p w14:paraId="7CB1ABC1" w14:textId="315A8A37" w:rsidR="000E5A0F" w:rsidRPr="002427B7" w:rsidRDefault="000E5A0F" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Was real?</w:t></w:r></w:p><w:p w14:paraId="262D0138" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="27948EE5" w14:textId="77777777" w:rsidR="00C77464" w:rsidRPr="002427B7" w:rsidRDefault="00C77464" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D557147" w14:textId="40836555" w:rsidR="00E44765" w:rsidRDefault="00E44765" w:rsidP="00C77464"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[S581]</w:t></w:r></w:p><w:p w1
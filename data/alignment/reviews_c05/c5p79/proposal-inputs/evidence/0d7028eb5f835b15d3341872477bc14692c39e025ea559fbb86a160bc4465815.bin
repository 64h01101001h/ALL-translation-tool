:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Through an understanding</w:t></w:r></w:p><w:p w14:paraId="489153B7" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of starting,</w:t></w:r></w:p><w:p w14:paraId="0A457BC9" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We can also understand ending.</w:t></w:r></w:p><w:p w14:paraId="26AA7B81" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7550C127" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When we understand</w:t></w:r></w:p><w:p w14:paraId="360EE556" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ending,</w:t></w:r></w:p><w:p w14:paraId="7480EAEE" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We understand impermanence.</w:t></w:r></w:p><w:p w14:paraId="10C1B2BC" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="71F29CF4" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Once we know</w:t></w:r></w:p><w:p w14:paraId="037C2180" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>How to engage in impermanence,</w:t></w:r></w:p><w:p w14:paraId="4C1DCB7E" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And the very nature,</w:t></w:r></w:p><w:p w14:paraId="2E14901E" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="65E9A597" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>We can also realize</w:t></w:r></w:p><w:p w14:paraId="4F8271C3" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00C25F92" w:rsidRDefault="00EC0450" w:rsidP="00C25F92"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00C25F92"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That highest of things.</w:t></w:r></w:p><w:p w14:paraId="5A5332DC" w14:textId="18B6A65C" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3218C8BA" w14:textId="77777777" w:rsidR="00151DC6" w:rsidRDefault="00151DC6" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2EFF46A2" w14:textId="77777777" w:rsidR="003713DE" w:rsidRDefault="00151DC6" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This verse and the previous one have performed, over the ages, at a similar level</w:t></w:r><w:r w:rsidR="001320E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—not too exciting.  </w:t></w:r><w:r w:rsidR="00A20ABB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">But as a strategy, the </w:t></w:r><w:r w:rsidR="00AA3EDC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">lines are </w:t></w:r><w:r w:rsidR="00AA3EDC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">extremely </w:t></w:r><w:r w:rsidR="00AA3EDC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>exciting.</w:t></w:r></w:p><w:p w14:paraId="0D35DF61" w14:textId="77777777" w:rsidR="003713DE" w:rsidRDefault="003713DE" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2CF01527" w14:textId="7939435E" w:rsidR="00E214DB" w:rsidRPr="00AA3EDC" w:rsidRDefault="00425C38" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>It</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s all tied up, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>similar to</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> what we have described already, in the </w:t></w:r><w:r w:rsidR="009779A8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">emptiness of starting &amp; stopping.  </w:t></w:r><w:r w:rsidR="006E101F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Again, since maybe the #1 suffering of life is (as Lord Buddha himself noted) impermanence, </w:t></w:r><w:r w:rsidR="00015ADB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">then it would seem to be the most exciting thing in the world to have a verse that really tears it apart, for us to </w:t></w:r><w:r w:rsidR="009C0D89"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>deal with in a new &amp; successful manner.</w:t></w:r></w:p><w:p w14:paraId="520D273C" w14:textId="5DA702EF" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0A9E9D6C" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="00C3204C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0209E1AD" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRPr="00A81C2B" w:rsidRDefault="00C3204C" w:rsidP="00C3204C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Top Ten Verse #7</w:t></w:r></w:p><w:p w14:paraId="5023481E" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="00C3204C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0D878C38" w14:textId="12066EF4" w:rsidR="00EC0450" w:rsidRPr="000A4BB3" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(30)</w:t></w:r></w:p><w:p w14:paraId="241AF924" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Statements about how</w:t></w:r></w:p><w:p w14:paraId="39D4A7C8" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>All these things</w:t></w:r></w:p><w:p w14:paraId="2E3564FF" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Do, in fact, exist</w:t></w:r></w:p><w:p w14:paraId="51704D19" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5C4A9657" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Will be made,</w:t></w:r></w:p><w:p w14:paraId="347674C7" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>At the beginning—</w:t></w:r></w:p><w:p w14:paraId="3F6AC2B8" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For those who seek suchness.</w:t></w:r></w:p><w:p w14:paraId="7DBCF12B" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="547D0724" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those who understand these things,</w:t></w:r></w:p><w:p w14:paraId="5B87C81E" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And who are free of attachment,</w:t></w:r></w:p><w:p w14:paraId="03151127" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Are candidates,</w:t></w:r></w:p><w:p w14:paraId="5A3FA802" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>At some later point,</w:t></w:r></w:p><w:p w14:paraId="571D4053" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00F91F79" w:rsidRDefault="00EC0450" w:rsidP="00F91F79"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00F91F79"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For sheer absence.</w:t></w:r></w:p><w:p w14:paraId="18399AB4" w14:textId="743EDF9F" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2B15CC53" w14:textId="32A51906" w:rsidR="00F91F79" w:rsidRDefault="002D4892" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This verse lays almost exactly in the same mediocre </w:t></w:r><w:r w:rsidR="008C62C9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">citation percentile as </w:t></w:r><w:r w:rsidR="00F050D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">our last two.  </w:t></w:r><w:r w:rsidR="0083703C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">But not only does it reiterate the concept of certain teachings as a “means to an end,” </w:t></w:r><w:r w:rsidR="007D7377"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">it goes further in describing what later became known as a “proper vessel”: </w:t></w:r><w:r w:rsidR="00F04194"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>candidates for deeper teachings.</w:t></w:r><w:r w:rsidR="00A409A0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  Even calling people “candidates” </w:t></w:r><w:r w:rsidR="007C797D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in the context of emptiness </w:t></w:r><w:r w:rsidR="00C60D66"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">instruction </w:t></w:r><w:r w:rsidR="00A409A0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>is earth</w:t></w:r><w:r w:rsidR="000A61EA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>-shattering.</w:t></w:r><w:r w:rsidR="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And the expression, “sheer absence” as what we hold back, and then grant!  These lines are a grand lesson plan for the universe!</w:t></w:r></w:p><w:p w14:paraId="7F032DE4" w14:textId="2D0CFDC7" w:rsidR="0063548A" w:rsidRDefault="0063548A" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1DFF930A" w14:textId="1D04E63B" w:rsidR="0063548A" w:rsidRDefault="0063548A" w:rsidP="00EC0450"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7BDF1308" w14:textId="3F1858C0" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="0063548A"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Top Ten Verse #8</w:t></w:r></w:p><w:p w14:paraId="65AF854A" w14:textId="50B48793" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1999447F" w14:textId="12CB1F58" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(36)</w:t></w:r></w:p><w:p w14:paraId="27E58318" w14:textId="002E6857" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>So long as we have</w:t></w:r></w:p><w:p w14:paraId="2AE30A15" w14:textId="77790097" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The misled state of mind,</w:t></w:r></w:p><w:p w14:paraId="6306A3B7" w14:textId="23094A6C" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>It will become a playground</w:t></w:r></w:p><w:p w14:paraId="10C38664" w14:textId="18010D43" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For the very demons.</w:t></w:r></w:p><w:p w14:paraId="380754D0" w14:textId="259CAECD" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0C4D8908" w14:textId="628877C4" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>If it</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s as we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ve described it,</w:t></w:r></w:p><w:p w14:paraId="158EA6BD" w14:textId="1DF349DF" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Who could ever deny</w:t></w:r></w:p><w:p w14:paraId="1C9F684B" w14:textId="0C929D5C" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That this possesses</w:t></w:r></w:p><w:p w14:paraId="2A70D19A" w14:textId="03C80202" w:rsidR="00EC0450" w:rsidRPr="0063548A" w:rsidRDefault="00EC0450" w:rsidP="0063548A"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="0063548A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>None of those problems?</w:t></w:r></w:p><w:p w14:paraId="4525B7F1" w14:textId="3AD16F49" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4FFCB571" w14:textId="4498B814" w:rsidR="002827E0" w:rsidRDefault="00BA7546" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:noProof/><w:lang w:eastAsia="en-US" w:bidi="ar-SA"/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="114300" distR="114300" simplePos="0" relativeHeight="251669504" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" wp14:anchorId="3D0BDF29" wp14:editId="70821856"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="column"><wp:posOffset>5532755</wp:posOffset></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>3175</wp:posOffset></wp:positionV><wp:extent cx="236855" cy="236855"/><wp:effectExtent l="0" t="0" r="4445" b="4445"/><wp:wrapSquare wrapText="bothSides"/><wp:docPr id="2" name="Picture 2"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="2" name="Picture 2"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="236855" cy="236855"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic><wp14:sizeRelH relativeFrom="page"><wp14:pctWidth>0</wp14:pctWidth></wp14:sizeRelH><wp14:sizeRelV relativeFrom="page"><wp14:pctHeight>0</wp14:pctHeight></wp14:sizeRelV></wp:anchor></w:drawing></w:r><w:r w:rsidR="00D4422F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">This poor verse is </w:t></w:r><w:r w:rsidR="00D4422F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">very </w:t></w:r><w:r w:rsidR="00D4422F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>close to being never quoted, in the entire lineage</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (only once).  </w:t></w:r><w:r w:rsidR="00653D8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It contains though an extremely valuable concept within the </w:t></w:r><w:r w:rsidR="00653D8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses, </w:t></w:r><w:r w:rsidR="00653D8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which is of a “viper” or “demon.”</w:t></w:r></w:p><w:p w14:paraId="31DAB8F9" w14:textId="2EF7085E" w:rsidR="00FA4BE5" w:rsidRDefault="00FA4BE5" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5608C4CE" w14:textId="1C35DE66" w:rsidR="00FA4BE5" w:rsidRDefault="00FA4BE5" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A huge part of human suffering has nothing to do with physical misery; rather, it</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s the turmoil within our minds created by our own negative thoughts, minute-to-minute.  </w:t></w:r><w:r w:rsidR="00B76AF4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A big theme of Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00B76AF4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s here in the </w:t></w:r><w:r w:rsidR="00B76AF4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty </w:t></w:r><w:r w:rsidR="007F7DAB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is that there are certain </w:t></w:r><w:r w:rsidR="004F0338"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">states of </w:t></w:r><w:r w:rsidR="004F0338"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">misunderstanding </w:t></w:r><w:r w:rsidR="004F0338"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that are particularly fertile ground for the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="004F0338"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arisal</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="004F0338"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> and maintenance of unhappy thoughts.</w:t></w:r></w:p><w:p w14:paraId="7EB17612" w14:textId="790B8067" w:rsidR="004F0338" w:rsidRDefault="004F0338" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4949F6F7" w14:textId="1B788110" w:rsidR="004F0338" w:rsidRDefault="004F0338" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Misunderstanding is seen here as an opportunity or opening for emotions like anger, greed, jealousy, improper desire.  </w:t></w:r><w:r w:rsidR="00C93FBD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It makes the mind a “playground for the very demons.”  </w:t></w:r><w:r w:rsidR="00454426"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">If we were more aware of that—and if we had studied books like the </w:t></w:r><w:r w:rsidR="00454426"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty Verses </w:t></w:r><w:r w:rsidR="00454426"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>and understood misunderstanding well—</w:t></w:r><w:r w:rsidR="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>we could stop leaving openings for the demons.  And that would be well on our way to constant happiness.</w:t></w:r></w:p><w:p w14:paraId="78FC135B" w14:textId="797F9460" w:rsidR="00D15AE0" w:rsidRDefault="00D15AE0" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2E6C0CB4" w14:textId="2B66103D" w:rsidR="00D15AE0" w:rsidRDefault="00D15AE0" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s bring this verse back!</w:t></w:r></w:p><w:p w14:paraId="3DFC413F" w14:textId="115FEFAC" w:rsidR="00D15AE0" w:rsidRDefault="00D15AE0" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="38B8F6E1" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="110E5B8F" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRPr="00A81C2B" w:rsidRDefault="00C3204C" w:rsidP="00C3204C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Top Ten Verse #9</w:t></w:r></w:p><w:p w14:paraId="161B8807" w14:textId="77777777" w:rsidR="00D15AE0" w:rsidRDefault="00D15AE0" w:rsidP="00BE31D6"><w:pPr><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="69F47576" w14:textId="68B580D0" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(50)</w:t></w:r></w:p><w:p w14:paraId="624B17F1" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Those who are great beings</w:t></w:r></w:p><w:p w14:paraId="75E25DDA" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Take no position,</w:t></w:r></w:p><w:p w14:paraId="08376438" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And never engage in dispute.</w:t></w:r></w:p><w:p w14:paraId="500C5ABC" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0501C673" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>How could there be</w:t></w:r></w:p><w:p w14:paraId="3026EFB0" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Some other position,</w:t></w:r></w:p><w:p w14:paraId="60C5F878" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="00D15AE0" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>For those who have</w:t></w:r></w:p><w:p w14:paraId="25DA0304" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00D15AE0"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00D15AE0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>No position themselves?</w:t></w:r></w:p><w:p w14:paraId="37B267C0" w14:textId="00F18E7A" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4DF38DF9" w14:textId="1B95ECAB" w:rsidR="00FF33B2" w:rsidRPr="00E82B10" w:rsidRDefault="007358BD" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ve noted above, this particular verse has been a darling of </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>people</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> over the course of history—unfortunately, often in discussions of why it </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>doesn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>mean that those of us who back the idea of emptiness don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t or shouldn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t </w:t></w:r><w:r w:rsidR="00DC2C47"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">define </w:t></w:r><w:r w:rsidR="009D0051"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp; stick</w:t></w:r><w:r w:rsidR="00DC2C47"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to that position.</w:t></w:r><w:r w:rsidR="00E82B10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00E82B10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00E82B10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> although we don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00E82B10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">t need to launch a campaign to bring back awareness of these lines, we </w:t></w:r><w:r w:rsidR="00E82B10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">do </w:t></w:r><w:r w:rsidR="00E82B10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>have to be vigilant that they are read &amp; used accurately.</w:t></w:r></w:p><w:p w14:paraId="27E29516" w14:textId="3A7E4675" w:rsidR="00FF33B2" w:rsidRDefault="00FF33B2" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="13B0CC86" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="00C3204C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="00A2FFA9" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRPr="00A81C2B" w:rsidRDefault="00C3204C" w:rsidP="00C3204C"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Top Ten Verse #10</w:t></w:r></w:p><w:p w14:paraId="0F742817" w14:textId="77777777" w:rsidR="00C3204C" w:rsidRDefault="00C3204C" w:rsidP="00EC0450"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="75F78DE5" w14:textId="0A3B1555" w:rsidR="00EC0450" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(60)</w:t></w:r></w:p><w:p w14:paraId="350B7484" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>By the goodness</w:t></w:r></w:p><w:p w14:paraId="1381BC34" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of what I have just done,</w:t></w:r></w:p><w:p w14:paraId="731DDEF8" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>May all beings</w:t></w:r></w:p><w:p w14:paraId="5BFFC641" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7E6596AF" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Complete the collection</w:t></w:r></w:p><w:p w14:paraId="1A52A712" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of merit &amp; wisdom,</w:t></w:r></w:p><w:p w14:paraId="6FE01BCD" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="03978582" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And thus gain the two</w:t></w:r></w:p><w:p w14:paraId="66E96D6B" w14:textId="77777777" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Ultimate bodies</w:t></w:r></w:p><w:p w14:paraId="24178D9F" w14:textId="17AE084B" w:rsidR="00EC0450" w:rsidRPr="007F00AD" w:rsidRDefault="00EC0450" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="007F00AD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>That merit &amp; wisdom make.</w:t></w:r></w:p><w:p w14:paraId="0A80D162" w14:textId="0AED4F8E" w:rsidR="007F00AD" w:rsidRDefault="007F00AD" w:rsidP="007F00AD"><w:pPr><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4D11C1D8" w14:textId="3F5C6E46" w:rsidR="007F00AD" w:rsidRDefault="007F00AD" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The final verse of the 60, as we have well documented, </w:t></w:r><w:r w:rsidR="00994F25"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">has a well-deserved place within the many thousands of wisdom books and oral wisdom teachings over the centuries.  </w:t></w:r><w:r w:rsidR="004F3D4C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The idea that we are dedicating our study of a book that the author himself dedicated the writing of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="004F3D4C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="004F3D4C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> countless beings is particularly sweet.</w:t></w:r></w:p><w:p w14:paraId="57FF39C9" w14:textId="7558C35C" w:rsidR="004F3D4C" w:rsidRDefault="004F3D4C" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="694B9D7A" w14:textId="19283AA5" w:rsidR="004F3D4C" w:rsidRDefault="004F3D4C" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">If we want to go deeper here, we need to turn (as we mentioned above) to </w:t></w:r><w:r w:rsidR="00CC2D61"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">working with the </w:t></w:r><w:r w:rsidR="00F770A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">philosophical </w:t></w:r><w:r w:rsidR="00CC2D61"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">references </w:t></w:r><w:r w:rsidR="00F770A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to</w:t></w:r><w:r w:rsidR="00CC2D61"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the verse—understand</w:t></w:r><w:r w:rsidR="00F770A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> more clearly just what</w:t></w:r><w:r w:rsidR="00CC2D61"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00F770A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">merit &amp; wisdom are; </w:t></w:r><w:r w:rsidR="00CC2D61"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and understand their specific results apropos the two </w:t></w:r><w:r w:rsidR="005C2237"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>resulting bodies of an Enlightened Being.</w:t></w:r><w:r w:rsidR="00DA680D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  A starting point here is an appreciation of the first three of the six perfections of a bodhisattva </w:t></w:r><w:r w:rsidR="00AC498A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>as method; the last two as wisdom; and the fourth as a bridge between the two.  Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00AC498A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s do our homework!</w:t></w:r></w:p><w:p w14:paraId="6DF5D6FF" w14:textId="0B45F85D" w:rsidR="00AC498A" w:rsidRDefault="00AC498A" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1655C7DA" w14:textId="73E0B548" w:rsidR="00AC498A" w:rsidRDefault="00AC498A" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0E97891D" w14:textId="6E504CA7" w:rsidR="00AC498A" w:rsidRDefault="00AC498A" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A final comment on the Top Ten</w:t></w:r></w:p><w:p w14:paraId="19999B15" w14:textId="77777777" w:rsidR="003E67A8" w:rsidRDefault="003E67A8" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="186559D4" w14:textId="2BAE051D" w:rsidR="00AC498A" w:rsidRDefault="003E67A8" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It is said, correctly, that a person who has seen emptiness </w:t></w:r><w:r w:rsidR="00586BE6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>directly also enjoys an uncommon, direct perception of upcoming events for—say—the coming five centuries, relative to the times in which they themselves live.</w:t></w:r></w:p><w:p w14:paraId="4E06E88D" w14:textId="7A1439D8" w:rsidR="0049308A" w:rsidRDefault="0049308A" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="64BAA851" w14:textId="77777777" w:rsidR="000E25EF" w:rsidRDefault="0049308A" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>Which begs an interesting question here:</w:t></w:r><w:r w:rsidR="002F01E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Is it possible that Arya Nagarjuna could </w:t></w:r><w:r w:rsidR="002F01E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">foresee </w:t></w:r><w:r w:rsidR="002F01E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that certain </w:t></w:r><w:r w:rsidR="008B0DDB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>verses</w:t></w:r><w:r w:rsidR="002F01E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of his </w:t></w:r><w:r w:rsidR="002F01E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Sixty </w:t></w:r><w:r w:rsidR="008B0DDB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">would get lost in the shuffle; or ignored; or grossly misinterpreted?  </w:t></w:r><w:r w:rsidR="00C40891"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Could it be…that he was quite consciously setting up one of those </w:t></w:r><w:r w:rsidR="00D55AEF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">“means to an end” </w:t></w:r><w:r w:rsidR="004450F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">teaching situations, where he </w:t></w:r><w:r w:rsidR="00D9063F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">poses us a riddle (or even </w:t></w:r><w:r w:rsidR="007800E3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>pre-</w:t></w:r><w:r w:rsidR="00D9063F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">poses an imperfect answer to the riddle) </w:t></w:r><w:r w:rsidR="00F55848"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>and then allows us our own personal moment of discovery, when we solve the riddle on our own?</w:t></w:r></w:p><w:p w14:paraId="67A4B879" w14:textId="77777777" w:rsidR="000E25EF" w:rsidRDefault="000E25EF" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="74FBFE63" w14:textId="568FA01A" w:rsidR="0049308A" w:rsidRPr="008B0DDB" w:rsidRDefault="000E25EF" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Was this all meant to be this way?</w:t></w:r></w:p><w:p w14:paraId="2624882A" w14:textId="628882AE" w:rsidR="00994F25" w:rsidRDefault="00994F25" w:rsidP="007F00AD"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="381A2301" w14:textId="77777777" w:rsidR="002D6D88" w:rsidRDefault="002D6D88" w:rsidP="002D6D88"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="613C0613" w14:textId="0962236C" w:rsidR="000C4D06" w:rsidRDefault="004101B3" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s go to The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s life</w:t></w:r></w:p><w:p w14:paraId="70BAD468" w14:textId="3D70DD4A" w:rsidR="004101B3" w:rsidRDefault="004101B3" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0045E47B" w14:textId="099DEE49" w:rsidR="0063472A" w:rsidRDefault="002E2135" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>When you</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>re writing an introduction to a vitally important book like this, it</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s a good strategy to get your important </w:t></w:r><w:r w:rsidR="00C306FE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>philosophical points in early; and then turn for example to the historical information, just in case people don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00C306FE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t make it very far into the</w:t></w:r><w:r w:rsidR="00E56A9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">se first few pages.  </w:t></w:r><w:r w:rsidR="007A3A96"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>So why don</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="007A3A96"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t we relax now, and enjoy</w:t></w:r><w:r w:rsidR="00A72A8B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a little review of The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00A72A8B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s </w:t></w:r><w:r w:rsidR="0063472A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>own life</w:t></w:r><w:r w:rsidR="00A72A8B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, and other such</w:t></w:r><w:r w:rsidR="0063472A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> topics?</w:t></w:r></w:p><w:p w14:paraId="7DC275AC" w14:textId="77777777" w:rsidR="0063472A" w:rsidRDefault="0063472A" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2DE64291" w14:textId="739069E0" w:rsidR="004101B3" w:rsidRDefault="00C25A43" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">First, we are pleased to </w:t></w:r><w:r w:rsidR="000A2D83"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>share with you that we have included a</w:t></w:r><w:r w:rsidR="00213519"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">n unusually </w:t></w:r><w:r w:rsidR="007823CE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">detailed biography of Arya Nagarjuna in the pages following this introduction.  </w:t></w:r><w:r w:rsidR="00695AB0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">There is a typical problem with people who lived, like Nagarjuna, thousands of years ago (think Jesus, or Confucius) that we have little real information </w:t></w:r><w:r w:rsidR="00D54183"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">about their </w:t></w:r><w:r w:rsidR="00785762"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">personal development and </w:t></w:r><w:r w:rsidR="00D54183"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">life, beyond </w:t></w:r><w:r w:rsidR="0072083C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">vague or overly </w:t></w:r><w:r w:rsidR="009205D3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">complimentary </w:t></w:r><w:r w:rsidR="006646C3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>generalities.</w:t></w:r></w:p><w:p w14:paraId="063ABC9D" w14:textId="16628311" w:rsidR="00FA0006" w:rsidRDefault="00FA0006" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5C4AE736" w14:textId="426F0A41" w:rsidR="00FA0006" w:rsidRDefault="00FA0006" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We are fortunate then that we have </w:t></w:r><w:r w:rsidR="00AF4347"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a fascinating biographical picture of The Arya assembled from native sources </w:t></w:r><w:r w:rsidR="00075813"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">by </w:t></w:r><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a native master, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Khen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Rinpoche </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Geshe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Lobsang</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tharchin</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, a very high </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>geshe</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00390E0E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> and </w:t></w:r><w:r w:rsidR="00365AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">former abbot of Sera </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00365AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Mey</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00365AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Monastery who lived 1921-2004.  </w:t></w:r><w:r w:rsidR="00840EFF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">With the permission of his translator and collaborator Dr. Artemus Engle, </w:t></w:r><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">we include here the biography which was prepared for their publication, </w:t></w:r><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s Letter</w:t></w:r><w:r w:rsidR="004E2A8D" w:rsidRPr="004E2A8D"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="9"/></w:r><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—a great translation of Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s personal letter of instruction to the ancient Indian king </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Udayibhadra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, and the commentary upon this letter composed by Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> teacher and student, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Jetsun</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Rendawa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Shunnu</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Lodru</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006E3F45"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="0058030F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>(1348-1412)</w:t></w:r><w:r w:rsidR="008834E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—who was also a major influence upon </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="008834E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="008834E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je, our main author here.</w:t></w:r><w:r w:rsidR="00763F31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00763F31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00763F31"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> we invite you to turn to those pages now; </w:t></w:r><w:r w:rsidR="00290184"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>enjoy the biography; and then return here to the introduction.</w:t></w:r></w:p><w:p w14:paraId="1773B355" w14:textId="4CB388BD" w:rsidR="00D52DF2" w:rsidRDefault="00D52DF2" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5BB62D73" w14:textId="77777777" w:rsidR="000253FB" w:rsidRDefault="00521B8B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">We can add a few details about The Arya as well.  </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0029112F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>First of all</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="0029112F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00600F7D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">some description of </w:t></w:r><w:r w:rsidR="00600F7D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">what kind </w:t></w:r><w:r w:rsidR="00600F7D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00600F7D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00600F7D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> he was: what manner of person among those who have seen emptiness directly.</w:t></w:r></w:p><w:p w14:paraId="052F7E80" w14:textId="77777777" w:rsidR="000253FB" w:rsidRDefault="000253FB" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1E9191BB" w14:textId="66146B66" w:rsidR="00D52DF2" w:rsidRDefault="00B16D6E" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">In general terms, the process of even passing through the necessary </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">preparation </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>to see emptiness directly is said to require millions of years</w:t></w:r><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">; and </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>so</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> it</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s no surprise that </w:t></w:r><w:r w:rsidR="00B11F8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">credible </w:t></w:r><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>reports</w:t></w:r><w:r w:rsidR="006A46E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (really based upon their </w:t></w:r><w:r w:rsidR="006A46E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">writings </w:t></w:r><w:r w:rsidR="006A46E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidR="006A46E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>deeds</w:t></w:r><w:r w:rsidR="006A46E7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of people who have attained the rank of an </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00017AAC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> in our world average about one per five hundred years.</w:t></w:r></w:p><w:p w14:paraId="29E40D37" w14:textId="2CDBB313" w:rsidR="0055215D" w:rsidRDefault="0055215D" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0371AD4F" w14:textId="118E2BEB" w:rsidR="0055215D" w:rsidRDefault="0055215D" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The </w:t></w:r><w:r w:rsidR="007D673F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">native </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">catalog to the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Derge</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> edition of the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="003817A9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Collection of </w:t></w:r><w:r w:rsidR="00A97685"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the entire body of Buddhist commentaries from ancient India surviving in Tibetan translation </w:t></w:r><w:r w:rsidR="00357BDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is itself one of the greatest pieces of bibliographical science ever written; </w:t></w:r><w:r w:rsidR="00C72811"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">it dates, </w:t></w:r><w:r w:rsidR="00357BDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">as we have noted, </w:t></w:r><w:r w:rsidR="00D51122"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">from </w:t></w:r><w:r w:rsidR="00357BDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:r w:rsidR="00683697"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>bout</w:t></w:r><w:r w:rsidR="00357BDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> 173</w:t></w:r><w:r w:rsidR="0053168B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>0</w:t></w:r><w:r w:rsidR="00357BDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="00BC09A8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidR="00AC7BC4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>This work</w:t></w:r><w:r w:rsidR="00BC09A8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> specifically mentions that Arya Nagarjuna had attained the first bodhisattva level, which is known as </w:t></w:r><w:r w:rsidR="00710590"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Perfect Happiness</w:t></w:r><w:r w:rsidR="00381A89"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>;</w:t></w:r><w:r w:rsidR="006379DF"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="10"/></w:r><w:r w:rsidR="005A1103"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> and this is repeated elsewhere throughout the ancient tradition.</w:t></w:r></w:p><w:p w14:paraId="07F56776" w14:textId="6C8EC0C1" w:rsidR="00710590" w:rsidRDefault="00710590" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3B85905E" w14:textId="53A876A7" w:rsidR="00710590" w:rsidRDefault="00631E3F" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">That is, in general there are two kinds of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>aryas</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">: two types of people who see emptiness directly.  </w:t></w:r><w:r w:rsidR="0079096A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">One is a bodhisattva, meaning a person who is dedicated to becoming enlightened so that they can serve countless living beings living upon countless worlds.  The other is yet to reach this </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0079096A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>motivation, but</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="0079096A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00AF178D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>has undergone</w:t></w:r><w:r w:rsidR="0079096A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> th</w:t></w:r><w:r w:rsidR="00E518C3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>at</w:t></w:r><w:r w:rsidR="0079096A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> ultimate insight into how things work.</w:t></w:r></w:p><w:p w14:paraId="39BBA6B3" w14:textId="6EF705CE" w:rsidR="00121584" w:rsidRDefault="00121584" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="15A69571" w14:textId="58175605" w:rsidR="00121584" w:rsidRDefault="00121584" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">When we see emptiness directly on the bodhisattva track, we have simultaneously reached </w:t></w:r><w:r w:rsidR="00D40C6A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that first bodhisattva level, Perfect Happiness; and this then is the kind of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00D40C6A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00D40C6A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> that The Arya was.</w:t></w:r></w:p><w:p w14:paraId="124BD0B1" w14:textId="0191C5BC" w:rsidR="00D40C6A" w:rsidRDefault="00D40C6A" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="505B6FF3" w14:textId="00580466" w:rsidR="00D40C6A" w:rsidRDefault="00687712" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Beyond that, certain qualities stand out to us even as we just read what he wrote, 20 centuries ago.  </w:t></w:r><w:r w:rsidR="00360451"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">First, we can say that he valued </w:t></w:r><w:r w:rsidR="00360451"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">brevity: </w:t></w:r><w:r w:rsidR="00360451"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nagarjuna always says what he wants to say, in the clearest and briefest words possible, and then moves on.</w:t></w:r><w:r w:rsidR="00E93A85"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  He can write </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00E93A85"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>flowerly</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00E93A85"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> things, but he chooses not to.  He wants to respect our time; and that </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00E93A85"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>in itself is</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00E93A85"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a high kind of morality.</w:t></w:r></w:p><w:p w14:paraId="4BAD5B67" w14:textId="54985E8B" w:rsidR="00E93A85" w:rsidRDefault="00E93A85" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="746FEC29" w14:textId="395AE5DF" w:rsidR="00E93A85" w:rsidRPr="00F97277" w:rsidRDefault="00D96CEF" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Secondly—but perhaps primarily—Nagarjuna has a keen sense of the irony of life.  </w:t></w:r><w:r w:rsidR="001A4895"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">He is willing to laugh at himself, and at the mess </w:t></w:r><w:r w:rsidR="00223BA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">of mortality that </w:t></w:r><w:r w:rsidR="001A4895"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>we have all put ourselves into.</w:t></w:r><w:r w:rsidR="00223BA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  He is </w:t></w:r><w:r w:rsidR="00223BA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">funny, </w:t></w:r><w:r w:rsidR="00223BA8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>on a deep and meaningful level.</w:t></w:r><w:r w:rsidR="00F97277"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  But at the same </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00F97277"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>time</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00F97277"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> we can feel a </w:t></w:r><w:r w:rsidR="00F97277"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">deep sense of </w:t></w:r><w:r w:rsidR="00F97277"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">compassion: </w:t></w:r><w:r w:rsidR="00F97277"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">he has obviously devoted his entire life to </w:t></w:r><w:r w:rsidR="00085782"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the labor of pulling us all out of that mortality.</w:t></w:r></w:p><w:p w14:paraId="1865DE69" w14:textId="17121FF7" w:rsidR="00223BA8" w:rsidRDefault="00223BA8" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2D60F497" w14:textId="6DD4055C" w:rsidR="00223BA8" w:rsidRDefault="0095515F" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Nagarjuna is </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">courageous.  </w:t></w:r><w:r w:rsidR="006128F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Very much like the Tibetan spiritual hero Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006128F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006128F9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, he </w:t></w:r><w:r w:rsidR="001D50B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is not afraid to approach and master any topic or idea, regardless of how very difficult it may </w:t></w:r><w:r w:rsidR="004F0015"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>prove to crack.</w:t></w:r><w:r w:rsidR="00EE7434"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  This pair </w:t></w:r><w:r w:rsidR="009B22C0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>are</w:t></w:r><w:r w:rsidR="00EE7434"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> also </w:t></w:r><w:r w:rsidR="00EE7434"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">persistent, </w:t></w:r><w:r w:rsidR="00EE7434"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and they will </w:t></w:r><w:r w:rsidR="001363EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">both </w:t></w:r><w:r w:rsidR="00EE7434"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>continue digging into a concept until they are fully satisfied that they grasp it fully.</w:t></w:r></w:p><w:p w14:paraId="3C72A5E1" w14:textId="15528B32" w:rsidR="00D449DF" w:rsidRDefault="00D449DF" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1AB2CA91" w14:textId="3043B6D0" w:rsidR="00D449DF" w:rsidRPr="00D449DF" w:rsidRDefault="00F97277" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>T</w:t></w:r><w:r w:rsidR="00D449DF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">hey both </w:t></w:r><w:r w:rsidR="00D449DF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>love books—</w:t></w:r><w:r w:rsidR="00D449DF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the ancient classics.  </w:t></w:r><w:r w:rsidR="003C0CBB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Nagarjuna, as we can see from his biography, took the trouble to travel essentially to a foreign planet (of the nagas) to </w:t></w:r><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>recover</w:t></w:r><w:r w:rsidR="00E41E1C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> ancienter classics</w:t></w:r><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> that were missing in this world; and we know from Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Xuanzang</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> personal notes in the 7</w:t></w:r><w:r w:rsidR="006D672C" w:rsidRPr="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:vertAlign w:val="superscript"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>th</w:t></w:r><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> century that he had organized a major library of philosophical </w:t></w:r><w:r w:rsidR="00A67A1A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>treasures</w:t></w:r><w:r w:rsidR="006D672C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  </w:t></w:r><w:r w:rsidR="001F74F8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And who can forget the image of Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="001F74F8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="001F74F8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> digging around the hundreds of manuscripts in one of the first attempts at a Buddhist canon, </w:t></w:r><w:r w:rsidR="007E76D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>at the</w:t></w:r><w:r w:rsidR="001E5601"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> monastery of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="001E5601"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsel</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="001E5601"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00937C4A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">circa </w:t></w:r><w:r w:rsidR="001E5601"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>1387</w:t></w:r><w:r w:rsidR="007E76D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>?</w:t></w:r><w:r w:rsidR="00E60778"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="11"/></w:r></w:p><w:p w14:paraId="4C14CBF1" w14:textId="54E0C453" w:rsidR="00EE7434" w:rsidRDefault="00EE7434" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4DD893F2" w14:textId="2C9117EB" w:rsidR="00EE7434" w:rsidRDefault="00BE1938" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">They can both </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>write;</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which is no small thing!</w:t></w:r><w:r w:rsidR="00126FC4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  The Arya, much more than Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00126FC4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00126FC4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, enjoys writing in lines of poetry, and seems to have a sensitive—almost musical—ear, which comes out even after his Sanskrit is translated into Tibetan.</w:t></w:r><w:r w:rsidR="005C6D02"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  It almost seems as though “hearing” the faint and exquisite “sound” of emptiness has tuned his senses.</w:t></w:r></w:p><w:p w14:paraId="7C8B1119" w14:textId="7E1BD8CD" w:rsidR="00201138" w:rsidRDefault="00201138" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0D591FE5" w14:textId="2F294B91" w:rsidR="00201138" w:rsidRDefault="00201138" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5E44B611" w14:textId="2C521B45" w:rsidR="00201138" w:rsidRDefault="00201138" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>A note on Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s name</w:t></w:r></w:p><w:p w14:paraId="05CC3DF1" w14:textId="0770EBCB" w:rsidR="00201138" w:rsidRDefault="00201138" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="41FCB7FD" w14:textId="6E932D75" w:rsidR="0015392B" w:rsidRDefault="00267C2A" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Just a quick note, in case you weren</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t aware; the name “Nagarjuna” itself means something like “Master</w:t></w:r><w:r w:rsidR="00760021"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of the Dragons</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.”  </w:t></w:r><w:r w:rsidR="00BD06A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As you will see from his biography, Nagarjuna was intent on recovering some important books that had been taken off by the dragons, </w:t></w:r><w:r w:rsidR="00BD06A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">who—as everybody knows, especially from Smaug in </w:t></w:r><w:r w:rsidR="00BD06A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The Hobbit</w:t></w:r><w:r w:rsidR="00BD06A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—love to steal &amp; horde shiny </w:t></w:r><w:r w:rsidR="00823C9F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:noProof/><w:lang w:eastAsia="en-US"/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="114300" distR="114300" simplePos="0" relativeHeight="251670528" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" wp14:anchorId="2EF27EBB" wp14:editId="32DF6959"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="column"><wp:posOffset>0</wp:posOffset></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>512445</wp:posOffset></wp:positionV><wp:extent cx="2286635" cy="2011680"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:wrapSquare wrapText="bothSides"/><wp:docPr id="12" name="Picture 12"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="12" name="Picture 12"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId10"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="2286635" cy="2011680"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic><wp14:sizeRelH relativeFrom="page"><wp14:pctWidth>0</wp14:pctWidth></wp14:sizeRelH><wp14:sizeRelV relativeFrom="page"><wp14:pctHeight>0</wp14:pctHeight></wp14:sizeRelV></wp:anchor></w:drawing></w:r><w:r w:rsidR="00BD06A3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>&amp; valuable things.</w:t></w:r></w:p><w:p w14:paraId="7210120A" w14:textId="066E4EA5" w:rsidR="0015392B" w:rsidRDefault="0015392B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="121288CA" w14:textId="07EC48E3" w:rsidR="00201138" w:rsidRDefault="00660C39" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The Arya used his powers of persuasion to </w:t></w:r><w:r w:rsidR="0049675B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">bring the dragons (or </w:t></w:r><w:r w:rsidR="0049675B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nagas, </w:t></w:r><w:r w:rsidR="0049675B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which is like an ancient Indian water dragon) under his thrall, mastering them so strongly that they would even take forms like cobras to gather over his shaved monk</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="0049675B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s head and shade him from the sun</w:t></w:r><w:r w:rsidR="00313166"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  This is how we see him in the traditional carving here, which </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00313166"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>by the way notes</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00313166"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> in the writing below that “he was an </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00313166"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00313166"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, who had laid his holy eyes upon the true nature of reality.”</w:t></w:r></w:p><w:p w14:paraId="0A009AB8" w14:textId="543C473B" w:rsidR="006D0814" w:rsidRDefault="006D0814" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="278579BA" w14:textId="4C7B8CA9" w:rsidR="006D0814" w:rsidRDefault="006D0814" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The second half of Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s name </w:t></w:r><w:r w:rsidR="00BF04BD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">seems to have </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">come from the name of perhaps the greatest hero of many thousands of years of Indian mythology: the </w:t></w:r><w:r w:rsidR="00CB1FDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">ultimate </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>archer</w:t></w:r><w:r w:rsidR="00CB1FDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> and </w:t></w:r><w:r w:rsidR="00AF0BD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>moral genius</w:t></w:r><w:r w:rsidR="00CB1FDD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Arjuna, </w:t></w:r><w:r w:rsidR="00013ECB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>from the Bhagavad Gita—which predates The Arya by about 500 years</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="002907D0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  There is something of a story behind this name Arjuna in itself.</w:t></w:r></w:p><w:p w14:paraId="6BEF8D23" w14:textId="600658E5" w:rsidR="002907D0" w:rsidRDefault="002907D0" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="232327C0" w14:textId="7AA9D7B2" w:rsidR="009378B1" w:rsidRPr="00624F0C" w:rsidRDefault="009378B1" w:rsidP="009378B1"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Nearly all Sanskrit words are built from a verbal root, and there is one which is pronounced </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>irj</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">technically represented as </w:t></w:r><w:r w:rsidRPr="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:sym w:font="Symbol" w:char="F0D6"/></w:r><w:r w:rsidR="00F9028E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatino" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>ṛ</w:t></w:r><w:r w:rsidRPr="009378B1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>j</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>.  This has a base meaning, according to the great</w:t></w:r><w:r w:rsidR="004E2A75"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> father of</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> American Sanskrit</w:t></w:r><w:r w:rsidR="004E2A75"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> studies</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>, William Dwight Whitney (1827-1894), of “to direct, stretch, or attain.”</w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">  It came into the Sanskrit word </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>raja—</w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">meaning “king,” or literally “the one who directs everybody”—and thence to the Latin </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">rex, </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">with the same meaning (Tyrannosaurus Rex, “King of the Tyrant Lizards”).  This then morphed into our English </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">regal, </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>royal.</w:t></w:r></w:p><w:p w14:paraId="0F46D0A1" w14:textId="2ABE7161" w:rsidR="008E5806" w:rsidRDefault="008E5806" w:rsidP="009378B1"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4A46B9C1" w14:textId="7E59B7DD" w:rsidR="00184599" w:rsidRDefault="008E5806" w:rsidP="0096498E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>We also have another root from Indo-European, a mother language of the Western world linked with Sanskrit.</w:t></w:r><w:r w:rsidR="00A4237C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">  Here, </w:t></w:r><w:r w:rsidR="00671A74" w:rsidRPr="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:sym w:font="Symbol" w:char="F0D6"/></w:r><w:r w:rsidR="00F9028E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>arg</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">has a base meaning of </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">shining, </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">or </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">brilliant, </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidR="00624F0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>bright white.</w:t></w:r><w:r w:rsidR="00184599"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidR="00184599"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>We even see this root in the Eng</w:t></w:r><w:r w:rsidR="0025749D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>l</w:t></w:r><w:r w:rsidR="00184599"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">ish verb </w:t></w:r><w:r w:rsidR="00184599"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">to argue, </w:t></w:r><w:r w:rsidR="00184599"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>which originally meant “to make lucid, or clear.”</w:t></w:r></w:p><w:p w14:paraId="586DE50B" w14:textId="77777777" w:rsidR="00184599" w:rsidRDefault="00184599" w:rsidP="0096498E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2B7D3C94" w14:textId="0AC75D29" w:rsidR="0096498E" w:rsidRDefault="00ED2B6B" w:rsidP="0096498E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">We </w:t></w:r><w:r w:rsidR="00FA6077"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">also </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">see </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00F642A6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>arg</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> in the word </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>argent—</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">Latin </w:t></w:r><w:r w:rsidR="00495B93"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">and then English </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>for “silver,” a</w:t></w:r><w:r w:rsidR="00D16B1F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>long with</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> Argentina, “Land of Silver.”</w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">  It is even conceivable that </w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">argent </w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>in this sense is related</w:t></w:r><w:r w:rsidR="00EB642C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> to </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00EB642C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>—</w:t></w:r><w:r w:rsidR="0090622F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>with a base meaning of “gone higher,” or “gone beyond”—</w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">through a very fundamental root </w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:sym w:font="Symbol" w:char="F0D6"/></w:r><w:r w:rsidR="0096498E" w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatino" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">ṛ </w:t></w:r><w:r w:rsidR="0096498E" w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatino" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">or </w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:sym w:font="Symbol" w:char="F0D6"/></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="0096498E" w:rsidRPr="003904B9"><w:rPr><w:rFonts w:ascii="Palatino" w:hAnsi="Palatino" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>ṛ</w:t></w:r><w:r w:rsidR="0096498E" w:rsidRPr="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>ch</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00EB642C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">meaning </w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>“to go</w:t></w:r><w:r w:rsidR="00674EED"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>,</w:t></w:r><w:r w:rsidR="0096498E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve"> to send</w:t></w:r><w:r w:rsidR="00EB642C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="00674EED"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidR="00C851D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">  We see then the white &amp; shining silver as a “noble” metal, or high among metals.</w:t></w:r></w:p><w:p w14:paraId="6CE41BD4" w14:textId="060C81DD" w:rsidR="00C851D6" w:rsidRDefault="00C851D6" w:rsidP="0096498E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr></w:pPr></w:p><w:p w14:paraId="28DEB9DA" w14:textId="75168EEB" w:rsidR="00C851D6" w:rsidRPr="00616DC1" w:rsidRDefault="00BD1C03" w:rsidP="0096498E"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">This would tie into the ancient use of </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="001A0E38"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r w:rsidR="001A0E38"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve">Aryan </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">to refer to the lighter-skinned invaders of north India, who </w:t></w:r><w:r w:rsidR="00FF58CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">some 4,000 years ago </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">pushed the darker, indigenous Dravidian peoples down to the south, where they still live today.  </w:t></w:r><w:r w:rsidR="00602F05"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t xml:space="preserve">This became the unfortunate, ignorant foundation for the caste system of historical India—where </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00602F05"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t>arya</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00602F05"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00602F05"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Cambria"/></w:rPr><w:t>came to refer to higher-caste, more-white.</w:t></w:r></w:p><w:p w14:paraId="67105540" w14:textId="7E89CAC2" w:rsidR="008E5806" w:rsidRPr="00616DC1" w:rsidRDefault="008E5806" w:rsidP="009378B1"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="60FD24F7" w14:textId="5F3F8018" w:rsidR="00BF04BD" w:rsidRDefault="00AA33DB" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Thus</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> in traditional </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sansksrit</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">/Tibetan glossaries we also see </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">arjuna </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">defined </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a leader, </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">or </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">one who asserts authority </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(Tib: </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>srid</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>sgrub</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>)</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in the way that Nagarjuna asserted his authority over the </w:t></w:r><w:r w:rsidR="00B93E64"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nagas.  </w:t></w:r><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Th</w:t></w:r><w:r w:rsidR="00F13752"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is </w:t></w:r><w:r w:rsidR="00B964D1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is </w:t></w:r><w:r w:rsidR="00F13752"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>reflected in how the</w:t></w:r><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> great Tibetan historian, Buton Rinpoche, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Rinchen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Drup</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (</w:t></w:r><w:r w:rsidR="00623E11"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>1290-1364)</w:t></w:r><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">—who </w:t></w:r><w:r w:rsidR="003105D7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>as we</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="003105D7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ve mentioned was as well</w:t></w:r><w:r w:rsidR="00455A6F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">prominent in assembling the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="001871EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Collection—</w:t></w:r><w:r w:rsidR="00FD7523"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>explains The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00FD7523"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s name:</w:t></w:r></w:p><w:p w14:paraId="746C12A0" w14:textId="71136AB3" w:rsidR="00E02DBB" w:rsidRDefault="00E02DBB" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1DB7050F" w14:textId="41102C2C" w:rsidR="009B231B" w:rsidRDefault="00E02DBB" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">naga </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in the name </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Nagarjuna </w:t></w:r><w:r w:rsidR="00F76355"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">refers to those water dragons called </w:t></w:r><w:r w:rsidR="00F76355"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">nagas.  </w:t></w:r><w:r w:rsidR="00F76355"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">He was referred to as </w:t></w:r><w:r w:rsidR="0007705B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>this</w:t></w:r><w:r w:rsidR="00F76355"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="000D4646"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidR="006804AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>dragon</w:t></w:r><w:r w:rsidR="000D4646"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidR="006804AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="009B231B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">first of all because he refused to remain on the dry land between the two </w:t></w:r><w:r w:rsidR="00D80D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">extremes, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00D80D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the two </w:t></w:r><w:r w:rsidR="009B231B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>shorelines</w:t></w:r><w:r w:rsidR="00D80D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>,</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00D80D5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of things never changing, or stopping altogether; </w:t></w:r><w:r w:rsidR="00261BC7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">rather, he </w:t></w:r><w:r w:rsidR="00C051C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>had been reborn with</w:t></w:r><w:r w:rsidR="000D433F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>in</w:t></w:r><w:r w:rsidR="00C051C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the vast reaches of the way of all things.</w:t></w:r></w:p><w:p w14:paraId="59D67FC3" w14:textId="77777777" w:rsidR="009B231B" w:rsidRDefault="009B231B" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="10F1487F" w14:textId="0132A887" w:rsidR="00E02DBB" w:rsidRDefault="009B157A" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>L</w:t></w:r><w:r w:rsidR="006804AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ike those acquisitive creatures</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, Nagarjuna</w:t></w:r><w:r w:rsidR="006804AE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> was lord over a hoard of the jewel treasures of the scriptures</w:t></w:r><w:r w:rsidR="00D91A40"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>; and like a dragon he could incinerate and clarify things, with the light of his eyes alone.</w:t></w:r></w:p><w:p w14:paraId="0BE7871F" w14:textId="715D3B71" w:rsidR="001A0320" w:rsidRDefault="001A0320" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="027BCC89" w14:textId="0C5A7976" w:rsidR="001A0320" w:rsidRDefault="001A0320" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">arjuna </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">part of his name refers to a person who holds authority over others; for Nagarjuna was one who held reign over the kingdom of the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>teachings, and</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> kept authority over the armies of the enemy of negative qualities</w:t></w:r><w:r w:rsidR="00532DD7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, subduing them entirely.</w:t></w:r></w:p><w:p w14:paraId="05F24EA8" w14:textId="3BC02BA5" w:rsidR="00B27FCC" w:rsidRDefault="00B27FCC" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="56571DA6" w14:textId="3F37EC2B" w:rsidR="00B27FCC" w:rsidRDefault="00B27FCC" w:rsidP="00C734EF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="0021723E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>thus</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> we combine </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">naga </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">arjuna </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">into </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nagarjuna</w:t></w:r><w:r w:rsidR="00BC4014"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r><w:r w:rsidR="007207D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:r w:rsidR="007207D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The text of </w:t></w:r><w:r w:rsidR="007207D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Clarifying the Verses </w:t></w:r><w:r w:rsidR="007207D6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>puts it this way:</w:t></w:r></w:p><w:p w14:paraId="552E062E" w14:textId="77E18E96" w:rsidR="00E259BF" w:rsidRDefault="00E259BF" w:rsidP="00E259BF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3493DAB5" w14:textId="2D8266D6" w:rsidR="00C1525D" w:rsidRDefault="00C1525D" w:rsidP="00933500"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>He abandoned the dry land</w:t></w:r></w:p><w:p w14:paraI
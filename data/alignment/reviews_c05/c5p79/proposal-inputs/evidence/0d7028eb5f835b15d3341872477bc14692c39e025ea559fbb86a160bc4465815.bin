a"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s the point that Master Chandrakirti is making here.  </w:t></w:r><w:r w:rsidR="0098583F" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">We can start </w:t></w:r><w:r w:rsidR="00713CA4" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">our explanation </w:t></w:r><w:r w:rsidR="00057987" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">from </w:t></w:r><w:r w:rsidR="00500C45" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that found in the </w:t></w:r><w:r w:rsidR="00500C45" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Essence of Eloquence</w:t></w:r><w:r w:rsidR="0005469D"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>:</w:t></w:r></w:p><w:p w14:paraId="6CC5B9E7" w14:textId="77777777" w:rsidR="00897664" w:rsidRPr="002427B7" w:rsidRDefault="00897664" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6ED54CF3" w14:textId="7451C1D5" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="00B95472" w:rsidP="00897664"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">What that work says is that </w:t></w:r><w:r w:rsidR="00C40D99" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">it would be incorrect to consider, as our subject under consideration, </w:t></w:r><w:r w:rsidR="00BB4F17" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>just a simple form of the power of the eye or such, without regard</w:t></w:r><w:r w:rsidR="005A715E" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> to distinctions—held in the system of either party—between the two realities.</w:t></w:r></w:p><w:p w14:paraId="07F5E990" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="69F766D2" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="78B0EE45" w14:textId="59EDF97D" w:rsidR="000A1EA8" w:rsidRPr="002427B7" w:rsidRDefault="000A1EA8" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A71</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="533069A5" w14:textId="38EF4AF6" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">MIG SOGS DE RANG BZHIN LA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KHRUL BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I TSAD MA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I RNYED DON MA YIN PAR LEGS LDAN RANG NYID KYIS KHAS BLANGS PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I PHYIR, </w:t></w:r></w:p><w:p w14:paraId="0351B33D" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="7055EBE5" w14:textId="6FD1836F" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="008E7F9B" w:rsidP="0047162D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And that</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s because Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Bhavaviveka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> himself accepts the idea that </w:t></w:r><w:r w:rsidR="00BE1A85" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the eye, or whichever sense power it may be, cannot be something which is perceived by an accurate perception which is mistaken about the nature of its object.</w:t></w:r></w:p><w:p w14:paraId="2B47AE00" w14:textId="49E24F0E" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="77EAFF80" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0F848B44" w14:textId="02E262AE" w:rsidR="000A1EA8" w:rsidRPr="002427B7" w:rsidRDefault="000A1EA8" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A72</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="0D58D8F9" w14:textId="1DD2190C" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">KHYAB STE, DE LTA NA YUL GYI RANG BZHIN LA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KHRUL BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I SHES PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I RNYED DON DANG DE LA MA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KHRUL BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I SHES PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I RNYED DON GNYIS DNGOS </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">GAL YIN PAS NA MIG SOGS DE YUL GYI RANG MTSAN LA MA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KHRUL BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I SHES PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I RNYED DON DU </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GYUR LA, DON DAM PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I KHYAD PAR DOR BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I MIG SOGS TZAM PO </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>JAL MI RUNG BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR,</w:t></w:r></w:p><w:p w14:paraId="2D0926CC" w14:textId="77777777" w:rsidR="0047162D" w:rsidRPr="002427B7" w:rsidRDefault="0047162D" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="35D60DDE" w14:textId="44D7FA5A" w:rsidR="0047162D" w:rsidRPr="002427B7" w:rsidRDefault="0047162D" w:rsidP="0047162D"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Just because Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Bhavaviveka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> accepts that idea doesn</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>t prove that it would be incorrect to consider, as our subject under consideration, just a simple form of the power of the eye or such, without regard to distinctions—held in the system of either party—between the two realities.</w:t></w:r></w:p><w:p w14:paraId="255D3699" w14:textId="4A6E1805" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="007E4463" w:rsidP="007E4463"><w:pPr><w:pStyle w:val="NoSpacing"/><w:tabs><w:tab w:val="left" w:pos="430"/></w:tabs><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:tab/></w:r></w:p><w:p w14:paraId="35A88972" w14:textId="6DB3AAA6" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="00C97D47" w:rsidP="007E4463"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And yet it </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">does </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">prove that; after all, it would be a direct contradiction for one thing to be both </w:t></w:r><w:r w:rsidR="00E87A03" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>an</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> object which is perceived by a state of mind </w:t></w:r><w:r w:rsidR="008C0022" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>that</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> is mistaken about the nature of its object; </w:t></w:r><w:r w:rsidR="00E87A03" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and at the same time be an object which is perceived by a state of mind </w:t></w:r><w:r w:rsidR="00EF6459" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>that</w:t></w:r><w:r w:rsidR="00E87A03" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> is not mistaken about the nature of its object.  </w:t></w:r><w:r w:rsidR="00917732" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>As such</w:t></w:r><w:r w:rsidR="00CF08F3" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, the eye power—or whatever it may be—would be an object which is perceived by a state of mind which is not mistaken about the actual expression of this object; and given that, it would be incorrect to say that this state of mind </w:t></w:r><w:r w:rsidR="002C13EE" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>were considering just a general form of the eye or whatever, without regard to any distinction of existing in an ultimate sense.</w:t></w:r></w:p><w:p w14:paraId="294291CF" w14:textId="1435888F" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="79E072B6" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3C1158D4" w14:textId="73C05DFE" w:rsidR="000A1EA8" w:rsidRPr="002427B7" w:rsidRDefault="000A1EA8" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>[</w:t></w:r><w:r w:rsidR="006264EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>A73</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t>]</w:t></w:r></w:p><w:p w14:paraId="329D9905" w14:textId="48FBFCD9" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">MIG SOGS KYI RANG MTSAN SNANG BA LA LTOS TE MA </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>KHRUL BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I TSAD MAS NI MIG SOGS DON DAM PAR YOD PAR </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>JAL DGOS KYI</w:t></w:r><w:r w:rsidR="00F346A6" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00AF05AB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>DON DAM PA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00AF05AB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>I KHYAD PAR DOR BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00AF05AB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">I MIG SOGS TZAM PO </w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="00AF05AB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>JAL MI RUNG BA</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00AF05AB" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:eastAsia="Times New Roman" w:hAnsi="Palatino Linotype" w:cs="Times New Roman"/><w:color w:val="222222"/><w:lang w:eastAsia="en-US" w:bidi="bo-CN"/></w:rPr><w:t>I PHYIR</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, RTAGS SNGA MA LEGS LDAN RANG GI KHAS BLANGS KYIS </w:t></w:r><w:r w:rsidR="00DA1AF1" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">[f. </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>45</w:t></w:r><w:r w:rsidR="00DA1AF1" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">a] </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>GRUB STE,</w:t></w:r></w:p><w:p w14:paraId="4FEF3B31" w14:textId="27BEAD9B" w:rsidR="002C3A15" w:rsidRPr="002427B7" w:rsidRDefault="002C3A15" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0057672C" w14:textId="1201B415" w:rsidR="009D5C41" w:rsidRPr="002427B7" w:rsidRDefault="00560E80" w:rsidP="007362B6"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:right="720" w:hanging="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Relative to the appearance of the actual expression of the eye or such, </w:t></w:r><w:r w:rsidR="009308AC" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>an accurate perception which was not mistaken would have to be considering an eye or such</w:t></w:r><w:r w:rsidR="00411162" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> as something that existed in an ultimate sense; but it would be wrong to say that it was considering just the general form of the eye and the like, without regard to the distinction of it being ultimate.  </w:t></w:r><w:r w:rsidR="002664E5" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As such, the first part of the reason given here is validated by Master </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="002664E5" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Bhavaviveka</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="002664E5" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="002664E5" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> own position.</w:t></w:r></w:p><w:p w14:paraId="7107DFE4" w14:textId="77777777" w:rsidR="009D5C41" w:rsidRPr="002427B7" w:rsidRDefault="009D5C41" w:rsidP="00FE6AFF"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3ADC9BE3" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Helvetica"/><w:bCs/><w:lang w:bidi="b
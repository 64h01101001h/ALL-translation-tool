"FFFFFF"/></w:rPr><w:t>龙树</w:t></w:r><w:r w:rsidR="00A85F8C" w:rsidRPr="00A85F8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00BB202A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t>L</w:t></w:r><w:r w:rsidR="00A85F8C" w:rsidRPr="008153BF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">ong </w:t></w:r><w:r w:rsidR="00BB202A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t>S</w:t></w:r><w:r w:rsidR="00A85F8C" w:rsidRPr="008153BF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:i/><w:iCs/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t>hu</w:t></w:r><w:r w:rsidR="00A85F8C" w:rsidRPr="00A85F8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype" w:cs="Arial"/><w:color w:val="222222"/><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t>)</w:t></w:r><w:r w:rsidR="00A85F8C" w:rsidRPr="00A85F8C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>.</w:t></w:r></w:p><w:p w14:paraId="4AC4EEEC" w14:textId="000EBA77" w:rsidR="004A5062" w:rsidRDefault="004A5062" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="50141BD4" w14:textId="130B4CB3" w:rsidR="004A5062" w:rsidRDefault="00BB1689" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Finally</w:t></w:r><w:r w:rsidR="004A5062"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, in the ancient books we sometimes see </w:t></w:r><w:r w:rsidR="00D05F5E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00D05F5E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s</w:t></w:r><w:r w:rsidR="004A5062"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> name listed as Nagarjuna Garbha.  The Tibetans translated the latter part as “heart,” or “essence,” so we can render the whole as “Essence of the Dragon Master.”  The point is that h</w:t></w:r><w:r w:rsidR="0002499C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">is one obsession is trying to get us to understand the concept of </w:t></w:r><w:r w:rsidR="0002499C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">emptiness, </w:t></w:r><w:r w:rsidR="0002499C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>at the very heart of all things.  And it</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="0002499C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s no coincidence that this same word often refers to “Buddha nature,” or the “womb of the coming Buddha” </w:t></w:r><w:r w:rsidR="006A6175"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which li</w:t></w:r><w:r w:rsidR="0002499C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">es within </w:t></w:r><w:r w:rsidR="006A6175"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>each</w:t></w:r><w:r w:rsidR="0002499C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of us, woman or man.</w:t></w:r></w:p><w:p w14:paraId="0C16BF8A" w14:textId="4F5FDE6D" w:rsidR="00C33F97" w:rsidRDefault="00C33F97" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2BE4E2A0" w14:textId="77777777" w:rsidR="00C33F97" w:rsidRDefault="00C33F97" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="3766655E" w14:textId="67A7AB0D" w:rsidR="00C33F97" w:rsidRDefault="00C33F97" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Teachers &amp; </w:t></w:r><w:r w:rsidR="00A52D1E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>disciples</w:t></w:r></w:p><w:p w14:paraId="2659EDF6" w14:textId="77777777" w:rsidR="00A52D1E" w:rsidRPr="00C33F97" w:rsidRDefault="00A52D1E" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="68F4CC2F" w14:textId="12DF82FC" w:rsidR="00AA2EFB" w:rsidRDefault="00B749D8" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:noProof/><w:lang w:eastAsia="en-US"/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="114300" distR="114300" simplePos="0" relativeHeight="251671552" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" wp14:anchorId="58A299F2" wp14:editId="7E96DBCC"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="column"><wp:posOffset>5759</wp:posOffset></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>916940</wp:posOffset></wp:positionV><wp:extent cx="2621280" cy="2359660"/><wp:effectExtent l="0" t="0" r="0" b="2540"/><wp:wrapSquare wrapText="bothSides"/><wp:docPr id="16" name="Picture 16"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="16" name="Picture 16"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId11"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="2621280" cy="2359660"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic><wp14:sizeRelH relativeFrom="page"><wp14:pctWidth>0</wp14:pctWidth></wp14:sizeRelH><wp14:sizeRelV relativeFrom="page"><wp14:pctHeight>0</wp14:pctHeight></wp14:sizeRelV></wp:anchor></w:drawing></w:r><w:r w:rsidR="00C33F97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Any time we </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00C33F97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>look into</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00C33F97"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the life of a great Buddhist teacher, it helps to </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00A52D1E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>geoposition</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00A52D1E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> them between their major teachers &amp; major disciples.  </w:t></w:r><w:r w:rsidR="006C1C87"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The first</w:t></w:r><w:r w:rsidR="005A3D18"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, of course, to see what may have been the major influences on their own development; the second to determine somewhat of their own personality, to see what kind of person they attracted—and how successfully they mentored them.  </w:t></w:r><w:r w:rsidR="001B58C3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>And both, of course, to gather further insight into their primary philosophical interests.</w:t></w:r></w:p><w:p w14:paraId="00FF318B" w14:textId="5466675A" w:rsidR="001B58C3" w:rsidRDefault="001B58C3" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="30A6B29A" w14:textId="56407630" w:rsidR="001B58C3" w:rsidRDefault="00600717" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Of Arya Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s own teachers, </w:t></w:r><w:r w:rsidR="002447CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>common monastic tradition points to one main person: the tantric sage Saraha</w:t></w:r><w:r w:rsidR="00684B5A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (seen at left)</w:t></w:r><w:r w:rsidR="002447CC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="00186942"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>known primarily for his</w:t></w:r><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00186942"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">spiritual songs, or </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00186942"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>doh</w:t></w:r><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>—</w:t></w:r><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">many of which still survive in the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Collection</w:t></w:r><w:r w:rsidR="005C5EAB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, especially in a work entitled </w:t></w:r><w:r w:rsidR="005C5EAB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">The Treasure </w:t></w:r><w:r w:rsidR="00B73B62"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Chest</w:t></w:r><w:r w:rsidR="005C5EAB"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of Spiritual Songs (Doha Kosha)</w:t></w:r><w:r w:rsidR="0020566C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  </w:t></w:r><w:r w:rsidR="008818E4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">A favorite topic of these songs was the Great Seal, or </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="008818E4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Mahamudra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="008818E4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, which we mentioned earl</w:t></w:r><w:r w:rsidR="0003601F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>ier</w:t></w:r><w:r w:rsidR="008818E4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> in conjunction with the final verse.</w:t></w:r></w:p><w:p w14:paraId="788852B3" w14:textId="7C20D8A5" w:rsidR="008818E4" w:rsidRDefault="008818E4" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="59127F5A" w14:textId="0F6E115A" w:rsidR="008818E4" w:rsidRDefault="00510078" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Mahamudra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, in its correct interpretation, refers to the practice of getting at the subject of emptiness—the ultimate nature of things—by carefully observing and thinking about how our own mind thinks, and the principle of dependence as revealed therein.  And this obviously deeply affected the student, Nagarjuna.</w:t></w:r></w:p><w:p w14:paraId="0C9C5E86" w14:textId="65E2F054" w:rsidR="0096755A" w:rsidRDefault="0096755A" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="38E842BF" w14:textId="4700C057" w:rsidR="004A293B" w:rsidRDefault="0096755A" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Saraha is also known to have written </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00B34376"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a number of</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00B34376"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> brief pieces </w:t></w:r><w:r w:rsidR="00067FF6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>on the secret practices of Avalokiteshvara, or Loving Eyes—as well as a number of esoteric lineages such as that of the Secret Collection, or Guhya Samaja</w:t></w:r><w:r w:rsidR="004A293B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">.  All of these, tradition says, were passed down </w:t></w:r><w:r w:rsidR="004A293B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>to Nagarjuna himself; and this is reflected in the latter</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="004A293B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>s known writings—which we will soon discuss.</w:t></w:r></w:p><w:p w14:paraId="07ADCFAE" w14:textId="77777777" w:rsidR="004A293B" w:rsidRDefault="004A293B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4E2AA274" w14:textId="5A37A1F3" w:rsidR="0096755A" w:rsidRDefault="00505FA3" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Finally, we</w:t></w:r><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> see in the </w:t></w:r><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Blue Annals </w:t></w:r><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Saraha</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s own teacher listed as the king </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Visukalpa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, which is sometimes rendered in Tibetan as </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Visukawa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> (Bi-</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>su</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>-ka-</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>wa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">).  </w:t></w:r><w:r w:rsidR="007F43EF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Pabongka</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Rinpoche in a lineage tree states that </w:t></w:r><w:r w:rsidR="00005D04"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">in the earlier part of his life, </w:t></w:r><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Saraha was </w:t></w:r><w:r w:rsidR="00005D04"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>known</w:t></w:r><w:r w:rsidR="00B46DD5"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> as “the Brahmin Rahula.”</w:t></w:r><w:r w:rsidR="004F3F4B"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="13"/></w:r></w:p><w:p w14:paraId="4585FD24" w14:textId="404D15B6" w:rsidR="00203F0B" w:rsidRDefault="00203F0B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6846B378" w14:textId="4433E6A7" w:rsidR="00203F0B" w:rsidRDefault="00203F0B" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As for </w:t></w:r><w:r w:rsidR="00990E10"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">his own disciples, </w:t></w:r><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">there is one that he was so close to that they are referred to as “the </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Father</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> &amp; the Son,” a sometimes appellation for an extremely close master/disciple relationship which is also applied to Je </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsongkapa</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> and his two closest disciples, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Gyaltsab</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je and </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Kedrup</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Je.  The son in this case is the sage </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Aryadeva</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, who is best known to us for his </w:t></w:r><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">400 Verses, </w:t></w:r><w:r w:rsidR="00F30606"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>in explanation of emptiness.</w:t></w:r></w:p><w:p w14:paraId="162467D7" w14:textId="0DB06E69" w:rsidR="00B50A85" w:rsidRDefault="00B50A85" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="44887AAD" w14:textId="4481DF2F" w:rsidR="00B50A85" w:rsidRPr="00B50A85" w:rsidRDefault="00B50A85" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">There is also a tradition—which we see repeated in the </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Blue Annals—</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">that Arya Nagarjuna had a group of four close disciples: </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sakyamitra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Aryadeva</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Nagabodhi</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, and </w:t></w:r><w:r w:rsidR="003D4909"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Chandrakirti himself.</w:t></w:r><w:r w:rsidR="00A54C59"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:footnoteReference w:id="14"/></w:r><w:r w:rsidR="003D4909"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00A54C59"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Listings </w:t></w:r><w:r w:rsidR="00342003"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">like this have no doubt contributed to the </w:t></w:r><w:r w:rsidR="003B2A20"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">tradition that The Arya lived for centuries, since </w:t></w:r><w:r w:rsidR="00101263"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">some of the four are separated—as far as we know now—by </w:t></w:r><w:r w:rsidR="00F27CB6"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>almost</w:t></w:r><w:r w:rsidR="00101263"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> 500 years.</w:t></w:r></w:p><w:p w14:paraId="718AACD6" w14:textId="70157105" w:rsidR="00D53CCD" w:rsidRDefault="00D53CCD" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="019DC096" w14:textId="1BF1E009" w:rsidR="00D53CCD" w:rsidRDefault="00D53CCD" w:rsidP="00662F99"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="284A2C93" w14:textId="51C1EE46" w:rsidR="00AB0A19" w:rsidRDefault="00AB0A19" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Arya Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s works from </w:t></w:r><w:r w:rsidR="006747A2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00676067"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>:</w:t></w:r></w:p><w:p w14:paraId="7666DB75" w14:textId="50127575" w:rsidR="00676067" w:rsidRDefault="002E552F" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>a</w:t></w:r><w:r w:rsidR="00676067"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> statistical summary</w:t></w:r></w:p><w:p w14:paraId="46D5831B" w14:textId="08137CBA" w:rsidR="00E50A0F" w:rsidRDefault="00E50A0F" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6EA49DD8" w14:textId="585BEE69" w:rsidR="00E50A0F" w:rsidRDefault="00572087" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">There is a tradition in the great </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsongkapian</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> monasteries of Tibet which says that we learn about a sage</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s life not from their biography, but from their writings.  We have done a thorough study of compositions attributed to Arya Nagarjuna in the afore-mentioned catalog to the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00A05F2B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Derge</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00A05F2B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> edition </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> Collection of Buddhist works from ancient India which survive in Tibetan translation.</w:t></w:r><w:r w:rsidR="006130AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  We have </w:t></w:r><w:r w:rsidR="00AF0257"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">as well </w:t></w:r><w:r w:rsidR="006130AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>made some additional comments based upon the</w:t></w:r><w:r w:rsidR="006757F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="00714E37"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">native </w:t></w:r><w:r w:rsidR="006757F3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>catalog to the</w:t></w:r><w:r w:rsidR="006130AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="006130AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sertri</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="006130AC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> or “Golden Calligraphy</w:t></w:r><w:r w:rsidR="00AF0257"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>” edition.</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  We here present to you our results, as a </w:t></w:r><w:r w:rsidR="00B94F3E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>deeper look into the character</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> of our primary author in the present volume.</w:t></w:r></w:p><w:p w14:paraId="6DA67F83" w14:textId="2776A6BF" w:rsidR="00627EE7" w:rsidRDefault="00627EE7" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0DE7C56E" w14:textId="0B694E46" w:rsidR="00627EE7" w:rsidRDefault="00627EE7" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t xml:space="preserve">To summarize, </w:t></w:r><w:r w:rsidR="00154B93"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00154B93"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Derge</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00154B93"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> catalog attributes some 120 works to The Arya which survive in that edition, in Tibetan translation.  This count does not include three works (mentioned below) </w:t></w:r><w:r w:rsidR="007C784A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>which the author of the catalog (</w:t></w:r><w:r w:rsidR="006B00E1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the</w:t></w:r><w:r w:rsidR="000A7705"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> “Great Editor” </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="000A7705"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tsultrim</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="000A7705"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="000A7705"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Rinchen</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="000A7705"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">, </w:t></w:r><w:r w:rsidR="006B00E1" w:rsidRPr="00EE5F48"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>1697</w:t></w:r><w:r w:rsidR="00A630D3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>-</w:t></w:r><w:r w:rsidR="006B00E1" w:rsidRPr="00EE5F48"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>1774</w:t></w:r><w:r w:rsidR="000A7705"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">) </w:t></w:r><w:r w:rsidR="00FD5696"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">says that they were aware of, but which had not </w:t></w:r><w:r w:rsidR="00C612A9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">yet </w:t></w:r><w:r w:rsidR="007D1865"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>r</w:t></w:r><w:r w:rsidR="00FD5696"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">eached Tibet.  </w:t></w:r><w:r w:rsidR="00092E01"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The count further </w:t></w:r><w:r w:rsidR="004056A4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>does not include two works sometimes attributed to The Arya but which our editor (and we would agree</w:t></w:r><w:r w:rsidR="0003197C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>; listed below</w:t></w:r><w:r w:rsidR="004056A4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">) </w:t></w:r><w:r w:rsidR="0084441F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>doubts</w:t></w:r><w:r w:rsidR="00A873C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> were </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00A873C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>actually written</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00A873C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> by him.</w:t></w:r></w:p><w:p w14:paraId="4FD0DA16" w14:textId="1A4B6638" w:rsidR="00501FDA" w:rsidRDefault="00501FDA" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="599D3F38" w14:textId="681F0D0D" w:rsidR="00501FDA" w:rsidRDefault="00501FDA" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Let</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s take a statistical snapshot of the content of The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s works, </w:t></w:r><w:r w:rsidR="006D1584"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>and then list the works themselves individually</w:t></w:r><w:r w:rsidR="00577E53"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> in the appendic</w:t></w:r><w:r w:rsidR="00DE7C9C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>es</w:t></w:r><w:r w:rsidR="006D1584"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">, since they are so very important to the entire Buddhism.  </w:t></w:r><w:r w:rsidR="008C7B0A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>We count the total folios</w:t></w:r><w:r w:rsidR="008D6CE2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> here</w:t></w:r><w:r w:rsidR="008C7B0A"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> (two pages each, front &amp; back) as 614, which in our Diamond Cutter Classics format would work out quite close to 5,000 pages of English.</w:t></w:r><w:r w:rsidR="00AE2660"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  The average folios for each work are 5; or the equivalent of 40 English pages.  A great number of works (brief poems or eulogies) are but a single </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00AE2660"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>folio;</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00AE2660"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="004B4BA3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">while </w:t></w:r><w:r w:rsidR="00AE2660"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">the longest </w:t></w:r><w:r w:rsidR="00864299"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>compositions run around 70 folios (just over 500 English pages).</w:t></w:r></w:p><w:p w14:paraId="757291B3" w14:textId="474C810E" w:rsidR="004B4BA3" w:rsidRDefault="004B4BA3" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5CFFC7D5" w14:textId="6DB9900D" w:rsidR="004B4BA3" w:rsidRDefault="002F711A" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Sertri</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Catalog lists about 15 additional works, some of which may be works in the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Derge</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> under an alternate name or translation.  </w:t></w:r><w:r w:rsidR="005B4DB3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">It should be noted that this catalog is also missing a significant number of the works </w:t></w:r><w:r w:rsidR="00737A39"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>by</w:t></w:r><w:r w:rsidR="005B4DB3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> The Arya reported in the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="005B4DB3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Derge</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="005B4DB3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> catalog.</w:t></w:r></w:p><w:p w14:paraId="4AC60BF3" w14:textId="6D9CE351" w:rsidR="005B4DB3" w:rsidRDefault="005B4DB3" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="36C996A8" w14:textId="040F1C9B" w:rsidR="00A0434F" w:rsidRDefault="00A0434F" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>As for subject matter, we can divide the topics of Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s works broadly into four categories: praises (eulogies) and related pieces; formal works on the Diamond Way (Vajrayana, or secret Buddhism); </w:t></w:r><w:r w:rsidR="009C5CA3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>philosophical works; and secular works.</w:t></w:r></w:p><w:p w14:paraId="372E0D94" w14:textId="7CCBAB79" w:rsidR="009C5CA3" w:rsidRDefault="009C5CA3" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2C7E3074" w14:textId="085C40C8" w:rsidR="009C5CA3" w:rsidRDefault="00F25384" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>The section on praises includes 21 works for a total of 32 folios, which represents 18% of The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s writings, and 5% of the page quantity</w:t></w:r><w:r w:rsidR="00126FC4"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">—which is to say, Nagarjuna was indeed fond of this </w:t></w:r><w:r w:rsidR="00B54F91"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>vehicle: of presenting even deep philosophical concepts disguised as a</w:t></w:r><w:r w:rsidR="00566D5C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> heartfelt</w:t></w:r><w:r w:rsidR="00B54F91"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> ode either to a person or</w:t></w:r><w:r w:rsidR="003858B3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> to</w:t></w:r><w:r w:rsidR="00B54F91"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> an idea.</w:t></w:r></w:p><w:p w14:paraId="342693E8" w14:textId="4704F3F6" w:rsidR="008D721E" w:rsidRDefault="008D721E" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2632DC57" w14:textId="7F445E87" w:rsidR="00D67164" w:rsidRDefault="00220C21" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">The writings on the Diamond Way </w:t></w:r><w:r w:rsidR="002D6286"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>include 53 works, amounting to 44% of The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="002D6286"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s total </w:t></w:r><w:r w:rsidR="00684C6B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">title </w:t></w:r><w:r w:rsidR="002D6286"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">output, in 35% of the page quantity.  </w:t></w:r><w:r w:rsidR="0057344C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">We ascertain here 18 different categories of the secret teachings, </w:t></w:r><w:r w:rsidR="00853FE3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">listed </w:t></w:r><w:r w:rsidR="0057344C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>as follows</w:t></w:r><w:r w:rsidR="00636730"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>—which again is itself a tribute to Nagarjuna</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00636730"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>s primary teacher, the sage Saraha.</w:t></w:r></w:p><w:p w14:paraId="77F9EC72" w14:textId="77777777" w:rsidR="00D67164" w:rsidRDefault="00D67164" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2410058D" w14:textId="6D37FD0B" w:rsidR="008D721E" w:rsidRPr="00730AF1" w:rsidRDefault="000B325E" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">We have added an asterisk </w:t></w:r><w:r w:rsidR="000416BA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>where the category seems to have received relatively more attention</w:t></w:r><w:r w:rsidR="004C1902"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> from The Arya.</w:t></w:r><w:r w:rsidR="00D24401"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  And it</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="00D24401"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">s worthwhile to note here that an entire section of the many secret titles in the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00D24401"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00D24401"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> is actually named from him; this is</w:t></w:r><w:r w:rsidR="00730AF1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00730AF1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t>Klu-sgrub</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00730AF1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/></w:rPr><w:t xml:space="preserve"> lugs </w:t></w:r><w:r w:rsidR="00730AF1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">or “Nagarjuna System” </w:t></w:r><w:r w:rsidR="00E331DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">category within the tantras of the “unsurpassed” class devoted to </w:t></w:r><w:r w:rsidR="00E331DE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:lastRenderedPageBreak/><w:t>the Secret Collection.</w:t></w:r><w:r w:rsidR="00BE718F"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:footnoteReference w:id="15"/></w:r><w:r w:rsidR="00446A4B"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">  It is also noteworthy that </w:t></w:r><w:r w:rsidR="000C11E2"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Nagarjuna felt that </w:t></w:r><w:r w:rsidR="00221141"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">a proper practitioner of the deep secret teachings should at the same time have a strong footing in the </w:t></w:r><w:r w:rsidR="00F25910"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>bodhisattva pledges and vows; and so important works on this topic have been included among his tantric writings within the various catalogs</w:t></w:r><w:r w:rsidR="00D16DBF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">—as noted </w:t></w:r><w:r w:rsidR="00FB39DA"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>following.</w:t></w:r></w:p><w:p w14:paraId="6587365E" w14:textId="0F3DAE0F" w:rsidR="0057344C" w:rsidRDefault="0057344C" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4C4B3D3B" w14:textId="6024ACC9" w:rsidR="0057344C" w:rsidRDefault="0057344C" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">1) </w:t></w:r><w:r w:rsidR="00D67164"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>*</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Tara, </w:t></w:r><w:r w:rsidR="00060CD3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>the Lady of Liberation</w:t></w:r></w:p><w:p w14:paraId="133E54FA" w14:textId="7A057228" w:rsidR="00060CD3" w:rsidRDefault="00060CD3" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">2) </w:t></w:r><w:r w:rsidR="00D67164"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>*</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Mahakala, the Great Ebony One</w:t></w:r></w:p><w:p w14:paraId="68AF81AF" w14:textId="3DF97240" w:rsidR="00636730" w:rsidRDefault="00636730" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">3) </w:t></w:r><w:r w:rsidR="00D67164"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>*</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Guhya Samaja, the Secret Collection</w:t></w:r></w:p><w:p w14:paraId="2D2222BB" w14:textId="16257C00" w:rsidR="00636730" w:rsidRDefault="00636730" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">4) </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="000B325E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Vajradhara</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="000B325E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, the Keeper of the Diamond</w:t></w:r></w:p><w:p w14:paraId="3712D834" w14:textId="3079F334" w:rsidR="000B325E" w:rsidRDefault="000B325E" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">5) </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00677AFF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Panchakrama</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00677AFF"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>, the Five Stages</w:t></w:r></w:p><w:p w14:paraId="5173D001" w14:textId="4C63C9D2" w:rsidR="00677AFF" w:rsidRDefault="00677AFF" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">6) </w:t></w:r><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Krodhadeva</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Pancha, the Five Fierce Angels</w:t></w:r></w:p><w:p w14:paraId="2B425375" w14:textId="706887E1" w:rsidR="00677AFF" w:rsidRDefault="00677AFF" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">7) </w:t></w:r><w:r w:rsidR="00DE5E6C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>*Vajrapani, the Holder of the Diamond</w:t></w:r></w:p><w:p w14:paraId="7531B00E" w14:textId="2CBFF76E" w:rsidR="00DE5E6C" w:rsidRDefault="00DE5E6C" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">8) </w:t></w:r><w:r w:rsidR="00EC7640"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">Mudras (including </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="00EC7640"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Mahamudra</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="00EC7640"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>), the Seals, or Partners</w:t></w:r></w:p><w:p w14:paraId="56D104E9" w14:textId="2CE8AE4B" w:rsidR="00EC7640" w:rsidRDefault="00EC7640" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">9) Bodhisattva Practice </w:t></w:r><w:r w:rsidR="00F5054E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>in</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> the secret teachings</w:t></w:r></w:p><w:p w14:paraId="4DD98E0C" w14:textId="2E79AE41" w:rsidR="00EC7640" w:rsidRDefault="00EC7640" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">10) </w:t></w:r><w:r w:rsidR="00CC7DAE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Secret songs</w:t></w:r></w:p><w:p w14:paraId="0D1ECF55" w14:textId="192CF5D1" w:rsidR="00CC7DAE" w:rsidRDefault="00CC7DAE" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>11) Secret vows</w:t></w:r></w:p><w:p w14:paraId="2963604A" w14:textId="77777777" w:rsidR="00CC7DAE" w:rsidRDefault="00CC7DAE" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">12) Prajna </w:t></w:r><w:proofErr w:type="gramStart"/><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Paramita;</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="6CDF1B74" w14:textId="3DF0AD1D" w:rsidR="00CC7DAE" w:rsidRDefault="00CC7DAE" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440" w:firstLine="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>the Perfection of Wisdom as a secret teaching</w:t></w:r></w:p><w:p w14:paraId="552E07ED" w14:textId="74A03DDC" w:rsidR="00CC7DAE" w:rsidRDefault="00CC7DAE" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">13) </w:t></w:r><w:r w:rsidR="003A698E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Manjushri, Gentle Voice</w:t></w:r></w:p><w:p w14:paraId="42721CA1" w14:textId="1FE34BE2" w:rsidR="003A698E" w:rsidRDefault="00055A9B" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>14) *Avalokiteshvara, Loving Eyes</w:t></w:r></w:p><w:p w14:paraId="6DE2CF3A" w14:textId="2BFCF0C6" w:rsidR="00055A9B" w:rsidRDefault="00153E02" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">15) </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="0027333F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>Utpanna</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="0027333F"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve"> Krama, the Completion Stage</w:t></w:r></w:p><w:p w14:paraId="21ADB133" w14:textId="756912CF" w:rsidR="0027333F" w:rsidRDefault="0027333F" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t xml:space="preserve">16) </w:t></w:r><w:r w:rsidR="00AE2EB3"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>General secret rituals</w:t></w:r></w:p><w:p w14:paraId="5B039432" w14:textId="54F6EC70" w:rsidR="00AE2EB3" w:rsidRDefault="00AE2EB3" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>17) Hayagriva, Horse Throat</w:t></w:r></w:p><w:p w14:paraId="1FD95949" w14:textId="2A404AE2" w:rsidR="00AE2EB3" w:rsidRDefault="00AE2EB3" w:rsidP="009F6401"><w:pPr><w:pStyle w:val="NoSpacing"/><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr><w:t>18) Miscellaneous tantras</w:t></w:r></w:p><w:p w14:paraId="4AC840B3" w14:textId="77777777" w:rsidR="00CC7DAE" w:rsidRDefault="00CC7DAE" w:rsidP="00AB0A19"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/></w:rPr></w:pPr></w:p><w:p w14:paraId="59A88F6B" w14:textId="370F82A8" w:rsidR="00E67343" w:rsidRDefault="00C90CC4" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">As for philosophical works, The Arya has composed 39 titles in 333 folios, which amounts to exactly a third of his total works in 54% of his folios.  </w:t></w:r><w:r w:rsidR="00EF1FDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">These are the titles that are most well known in present times, including for example </w:t></w:r><w:r w:rsidR="00EF1FDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Wisdom </w:t></w:r><w:r w:rsidR="00EF1FDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(his greatest work); the </w:t></w:r><w:r w:rsidR="00EF1FDE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">String of Precious Jewels; </w:t></w:r><w:r w:rsidR="00E67343"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the </w:t></w:r><w:r w:rsidR="00E67343"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">Letter to a Friend; </w:t></w:r><w:r w:rsidR="00E67343"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">and </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00E67343"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>of course</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00E67343"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> the current </w:t></w:r><w:r w:rsidR="00E67343"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:i/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Sixty Verses.</w:t></w:r><w:r w:rsidR="00B603EE"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">    We can broadly divide this category into original philosophical compositions; commentaries upon </w:t></w:r><w:r w:rsidR="00D42FC9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the ancient sutras; and then epistles, </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="00D42FC9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>advices</w:t></w:r><w:proofErr w:type="gramEnd"/><w:r w:rsidR="00D42FC9"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>, and prayers.</w:t></w:r><w:r w:rsidR="002B60BC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">  It should be </w:t></w:r><w:r w:rsidR="00940156"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>noted</w:t></w:r><w:r w:rsidR="002B60BC"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> that the epistles are essentially as pithy and crucial as the formal philosophical works.</w:t></w:r></w:p><w:p w14:paraId="59EA0AC4" w14:textId="02ABDDF8" w:rsidR="00EE44FF" w:rsidRDefault="00EE44FF" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="166F21A1" w14:textId="75EBE7B8" w:rsidR="00EE44FF" w:rsidRDefault="00EE44FF" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>The final category of The Arya</w:t></w:r><w:r w:rsidR="00204B17" w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>’</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">s writings, the secular section, </w:t></w:r><w:r w:rsidR="00C40AAD"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>subsumes</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> seven different works accounting for only about 5% of his total writings, and folios.  Included here are five compositions on the topic of classical medicine.</w:t></w:r></w:p><w:p w14:paraId="76CBF43F" w14:textId="20165D0B" w:rsidR="008B5442" w:rsidRDefault="008B5442" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2AA5F7BA" w14:textId="56010873" w:rsidR="008B5442" w:rsidRDefault="008B5442" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">For interested readers, we have included in Appendix </w:t></w:r><w:r w:rsidR="00D013ED"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>C</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> a summary, by topic, of all the separate works of Nagarjuna generally reported in </w:t></w:r><w:r w:rsidR="008130B8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">the Tibetan </w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidR="008130B8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Tengyur</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidR="008130B8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> catalogs</w:t></w:r><w:r w:rsidR="00AE1438"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> mentioned above.</w:t></w:r></w:p><w:p w14:paraId="1A2DA23D" w14:textId="63B5CBB6" w:rsidR="00F932D0" w:rsidRDefault="00F932D0" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="5054DEE1" w14:textId="62F74ECE" w:rsidR="00F932D0" w:rsidRDefault="00F932D0" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="44971259" w14:textId="09E21FC7" w:rsidR="00F932D0" w:rsidRDefault="00F932D0" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Six Books on the Logic of Emptiness</w:t></w:r></w:p><w:p w14:paraId="42E9D4FC" w14:textId="389FE61D" w:rsidR="00F932D0" w:rsidRDefault="00F932D0" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:b/><w:bCs/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="6A1ED99D" w14:textId="16B20C13" w:rsidR="008B32F2" w:rsidRDefault="00F932D0" w:rsidP="00C90CC4"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:iCs/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palat
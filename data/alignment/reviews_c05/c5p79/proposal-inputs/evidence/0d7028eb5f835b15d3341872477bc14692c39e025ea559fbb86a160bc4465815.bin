inotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>the state of wisdom we use to realize this point</w:t></w:r><w:r w:rsidR="00646A0C"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="001B1226"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">constitutes the path to free ourselves from this world of pain; and </w:t></w:r><w:r w:rsidR="0082009E"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">(3) </w:t></w:r><w:r w:rsidR="009274E8"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>explaining how—by accustoming ourselves to this wisdom—we achieve the result.</w:t></w:r></w:p><w:p w14:paraId="362C3297" w14:textId="77777777" w:rsidR="009274E8" w:rsidRPr="002427B7" w:rsidRDefault="009274E8" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4665E55C" w14:textId="77777777" w:rsidR="007C0381" w:rsidRPr="002427B7" w:rsidRDefault="007C0381" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2C1296C6" w14:textId="77432EFC" w:rsidR="00796B50" w:rsidRDefault="00796B50" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:sz w:val="20"/><w:szCs w:val="20"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>[N13]</w:t></w:r></w:p><w:p w14:paraId="4E1CE63E" w14:textId="23E8C4DB" w:rsidR="007C038
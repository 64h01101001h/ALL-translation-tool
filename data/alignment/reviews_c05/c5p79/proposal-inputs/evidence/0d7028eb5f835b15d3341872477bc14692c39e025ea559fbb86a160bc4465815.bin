bo-CN"/></w:rPr><w:t>I have created for myself</w:t></w:r></w:p><w:p w14:paraId="10E0DEAE" w14:textId="467BCC7B" w:rsidR="003E6CA7" w:rsidRDefault="003E6CA7" w:rsidP="0001732E"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Some pure white karma,</w:t></w:r></w:p><w:p w14:paraId="0981CB6D" w14:textId="211EAF56" w:rsidR="003E6CA7" w:rsidRDefault="003E6CA7" w:rsidP="0001732E"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>Free of any impurity.</w:t></w:r></w:p><w:p w14:paraId="7A979747" w14:textId="77777777" w:rsidR="003E6CA7" w:rsidRDefault="003E6CA7" w:rsidP="0001732E"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="4892F8C9" w14:textId="3F768221" w:rsidR="003E6CA7" w:rsidRDefault="00E6389F" w:rsidP="0001732E"><w:pPr><w:ind w:left="1440"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">And I dedicate </w:t></w:r><w:r w:rsidR="00E314C1"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">all </w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>that karma</w:t></w:r></w:p><w:p w14:paraId="37648CDC" w14:text
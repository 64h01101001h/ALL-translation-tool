7B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">I CHOS NI </w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>JIG RTEN PA</w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>I CHOS DANG CHOS MTSUNGS PAR MI RIGS</w:t></w:r><w:r w:rsidR="00B94E52" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>PA</w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">I PHYIR TE, LUGS </w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>‘</w:t></w:r><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">DI NI THUN MONG MA YIN NO ZHES MKHAS PA RNAMS KYIS NGES PAR </w:t></w:r><w:proofErr w:type="gramStart"/><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>BYA</w:t></w:r><w:r w:rsidRPr="00204B17"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>’</w:t></w:r><w:r w:rsidR="004F7A60" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>O,,</w:t></w:r><w:proofErr w:type="gramEnd"/></w:p><w:p w14:paraId="0495B7B7" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="7EB5A033" w14:textId="2EBDF61D" w:rsidR="004F7A60" w:rsidRPr="002427B7" w:rsidRDefault="004F7A60" w:rsidP="00A902FD"><w:pPr><w:pStyle w:val="NoSpacing"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">And this is because </w:t></w:r><w:r w:rsidR="00D21BA5" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">it is illogical to say that </w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t xml:space="preserve">things which are beyond the world are equivalent to things of the world.  </w:t></w:r><w:r w:rsidR="00892791" w:rsidRPr="002427B7"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:t>My goal is that wise ones among you should come to realize, “This is truly a unique system!”</w:t></w:r><w:r w:rsidRPr="002427B7"><w:rPr><w:rStyle w:val="FootnoteReference"/><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:bCs/></w:rPr><w:footnoteReference w:id="227"/></w:r></w:p><w:p w14:paraId="18CFB1A0" w14:textId="77777777" w:rsidR="004F7A60" w:rsidRPr="0
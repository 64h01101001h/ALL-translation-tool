es-ES" w:bidi="bo-CN"/></w:rPr><w:t>GAL LO ZHE NA,</w:t></w:r></w:p><w:p w14:paraId="4BB28EFA" w14:textId="77777777" w:rsidR="002F2B2C" w:rsidRPr="00F06A5B" w:rsidRDefault="002F2B2C" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:val="es-ES" w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="2B2BF259" w14:textId="3B06D41D" w:rsidR="002F2B2C" w:rsidRDefault="002F2B2C" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>One may begin with the following claim—</w:t></w:r></w:p><w:p w14:paraId="0BBDFD07" w14:textId="77777777" w:rsidR="002F2B2C" w:rsidRDefault="002F2B2C" w:rsidP="007C0381"><w:pPr><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr></w:p><w:p w14:paraId="36B7EB0D" w14:textId="6297DD74" w:rsidR="002F2B2C" w:rsidRDefault="00121082" w:rsidP="00003F43"><w:pPr><w:ind w:left="720" w:right="720"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">It would be wrong to describe the fact that a child had not been born as “a child was born.”  Just so, it would be a contradiction to </w:t></w:r><w:r w:rsidR="006805D0"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t xml:space="preserve">say that the literal meaning of the term “dependence” was </w:t></w:r><w:r w:rsidR="00823429"><w:rPr><w:rFonts w:ascii="Palatino Linotype" w:hAnsi="Palatino Linotype"/><w:lang w:bidi="bo-CN"/></w:rPr><w:t>“</w:t></w:r><w:r
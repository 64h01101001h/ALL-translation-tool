MASTER KEYS ['meta', 'unified_entries', 'curated_entries', 'glossary_entries'] CORPUS KEYS [{'acip': ', , MAndLA, ,', 'wylie': ', maNDla,', 'english': 'mandel', 'course': 'C01'}, {'acip': ',SA GZHI SPOS KYIS BYUGS SHING ME TOG BKRAM,', 'wylie': 'sa gzhi spos kyis byugs shing me tog bkram', 'english': 'sashi pukyi jukshing metok tram,', 'course': 'C01'}, {'acip': ",RI RAB GLING BZHI NYI ZLAS BRGYAN PA 'DI,", 'wylie': "ri rab gling bzhi nyi zlas brgyan pa 'di", 'english': 'rirab lingshi nyinde gyenpa di,', 'course': 'C01'}, {'acip': ',SANGS RGYAS ZHING DU DMIGS TE DBUL BAR BGYI,', 'wylie': 'sangs rgyas zhing du dmigs te dbul bar bgyi', 'english': 'sangye shingdu mikte ulwar gyi,', 'course': 'C01'}, {'acip': ",'GRO KUN RNAM DAG ZHING LA SPYOD PAR SHOG, ,", 'wylie': "'gro kun rnam dag zhing la spyod par shog,", 'english': 'drokun namdak shingla chupar shok.', 'course': 'C01'}, {'acip': ",AI Dm GU RU RA{tn} MAnd LA Km NI{ry}'A TA YA MI, ,", 'wylie': "ai dM gu ru ra maND la kM ni'a ta ya mi,", 'english': 'Idam guru ratna mandalakam niryatayami. Offering the Mandala Here is the great Earth, Filled with the smell of incense, Covered with a blanket of flowers, The Great Mountain, The Four Continents, Wearing a jewel Of the Sun, and Moon. In my mind I make them The Paradise of a Buddha, And offer it all to You. By this deed May every living being Experience The Pure World. Idam guru ratna mandalakam niryatayami.', 'course': 'C01'}, {'acip': ", , SKYABS 'GRO SEMS BSKYED, ,", 'wylie': ", skyabs 'gro sems bskyed,", 'english': 'kyabdro semkye', 'course': 'C01'}, {'acip': ',SANGS RGYAS CHOS DANG TSOGS KYI MCHOG RNAMS LA,', 'wylie': 'sangs rgyas chos dang tshogs kyi mchog rnams la', 'english': 'sangye chudang tsokyi choknam la,', 'course': 'C01'}, {'acip': ',BYANG CHUB BAR DU BDAG NI SKYABS SU MCHIS,', 'wylie': 'byang chub bar du bdag ni skyabs su mchis', 'english': 'jangchub bardu dakni kyabsu chi,', 'course': 'C01'}, {'acip': ",BDAG GIS SBYIN SOGS BGYIS PA'I BSOD NAMS KYIS,", 'wy
# Build trees
cmake-build/
Testing/

# Generated databases and release artifacts — reproducible from the HGM
# data project's release packages (tools/build_spine.py, tools/build_reference_db.py)
build/
data/*.gz
data/*.json
data/*.tsv
data/extracted/

# The user's own data — never versioned
progress.db
progress.db-*
library/
analyses/

# macOS noise
.DS_Store
~$*.docx
editions/
dist/
cmake-build-release/

# data corpora deliberately outside version control (large source
# payloads; their DERIVED indexes are tracked): caption files, raw
# research transcripts, scanned-dictionary PDFs, sanitizer build
build-asan/
data/teaching/*captions/
data/research/gmr_cataloging/
data/das/*.pdf
data/teaching/teaching_moments.json
xcode/
cmake-build-asan/
__pycache__/

# press transcripts (build artefacts, never tracked)
press*.log
ios/DiamondDrills/drills.json

# Kawachen Tibetan Reader audio (itibet.org) — in-house use only.
# Adam holds permission from Kawachen to USE these recordings; that is not
# permission to redistribute, and this repository is public. The audio is
# therefore a generated local asset, like the iOS drill pack: harvested by
# tools/kawachen_harvest.py, never committed. See docs/KAWACHEN_READER_FORMAT.md.
data/audio/kawachen/*
# ...but the manifest is tracked: it is our only record of what each
# recording says, it holds no audio and no third-party prose, and until
# now it existed in exactly one place on one machine. A directory-level
# ignore stops git descending, so the star above is required for these
# negations to bite at all.
!data/audio/kawachen/manifest.csv
!data/audio/kawachen/manifest.json
data/audio/kawachen/by-sound/

# Xcode per-user state. ios/TibetanTrainer.xcodeproj is GENERATED by
# tools/make_ios_project.py; the project file itself is tracked so the repo
# opens in Xcode, but everything Xcode scribbles per-user is not.
**/xcuserdata/
**/*.xcworkspace/xcuserdata/
ios/build/

# Apple Developer Team ID, read by tools/make_ios_project.py. Not a secret —
# it is stamped into every provisioning profile — but this repo is public, so
# it stays local. Never put a password or an App Store Connect .p8 key here.
ios/DeveloperTeam.txt

# Craig Preston, How to Read Classical Tibetan (Snow Lion 2003) — OCR of Adam's
# own copy, for in-house engine development. Same standing as the Kawachen
# audio: owning the book is permission to USE it here, not to redistribute it,
# and this repository is public. What belongs in the repo is the GRAMMAR
# extracted from it (docs/standards/PRESTON_SYNTAX.md), never the text.
data/reference/preston/*

# Reference grammars, local only. Jaschke (1883) and Hannah (1912) are public
# domain by age and COULD be committed; they are not, because 6MB of page scan
# does not belong in a repo that has already had to have a blob stripped from
# its history. What belongs here is the grammar extracted from them.
#
# These two matter for a specific reason (docs/standards/PRESTON_SYNTAX.md):
# every table in allcore descends from one lineage — Hopkins, Napper, Wilson,
# Preston — and nothing checks them against anything outside it. These are
# outside it. They can say whether our tables are RIGHT or only self-consistent.
data/reference/grammars/*
